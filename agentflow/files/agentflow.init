#!/bin/sh /etc/rc.common

START=93
USE_PROCD=1

get_config() {
	config_get_bool enabled "$1" enabled 0
	config_get data_dir "$1" data_dir ""
	config_get home_dir "$1" home_dir ""
	# Web transport is private; legacy bind settings cannot expose it.
	host=127.0.0.1
	config_get port "$1" port "9000"
}

valid_persistent_dir() {
	case "$1" in
		/mnt/?*/*) ;;
		*) return 1 ;;
	esac
	case "$1" in
		*//*|*/./*|*/../*|*/.|*/..|*/|*[!A-Za-z0-9_./-]*) return 1 ;;
	esac
	return 0
}

prepare_private_dir() {
	valid_persistent_dir "$1" || return 1
	[ ! -L "$1" ] || return 1
	mkdir -p "$1" || return 1
	[ -d "$1" ] && [ ! -L "$1" ] || return 1
	chmod 0700 "$1" || return 1
}

start_service() {
	config_load agentflow
	config_foreach get_config agentflow
	[ "$enabled" = 1 ] || return 1

	[ -x /usr/sbin/agentflow ] || {
		logger -t agentflow "missing executable: /usr/sbin/agentflow"
		return 1
	}
	valid_persistent_dir "$data_dir" || {
		logger -t agentflow "configure an AgentFlow data directory on persistent storage"
		return 1
	}
	[ ! -L "$data_dir" ] || {
		logger -t agentflow "AgentFlow data directory cannot be a symbolic link"
		return 1
	}
	mkdir -p "$data_dir" || return 1
	[ -n "$home_dir" ] || home_dir="$data_dir/home"
	prepare_private_dir "$data_dir/data" || return 1
	prepare_private_dir "$home_dir" || return 1
	for directory in .config .cache .local .local/share .local/state; do
		prepare_private_dir "$home_dir/$directory" || return 1
	done
	HOME="$home_dir"
	PATH="/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
	export HOME PATH
	case "$port" in ''|*[!0-9]*) return 1 ;; esac
	[ "$port" -ge 1024 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null || return 1

	logger -t agentflow "starting AgentFlow on $host:$port"
	procd_open_instance
	procd_set_param command /usr/sbin/agentflow
	procd_set_param env \
		"AGENT_FLOW_DATA=$data_dir/data" \
		"AGENT_FLOW_HOST=$host" \
		"AGENT_FLOW_PORT=$port" \
		"AGENTFLOW_PROVIDER_MODE=1" \
		"HOME=$HOME" \
		"PATH=$PATH" \
		"XDG_CONFIG_HOME=$HOME/.config" \
		"XDG_CACHE_HOME=$HOME/.cache" \
		"XDG_DATA_HOME=$HOME/.local/share" \
		"XDG_STATE_HOME=$HOME/.local/state"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "agentflow"
}
