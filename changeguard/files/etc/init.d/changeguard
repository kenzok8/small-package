#!/bin/sh /etc/rc.common
START=15
STOP=89
USE_PROCD=1
BIN=/usr/sbin/changeguard_bin
CONFIG=/etc/changeguard/config.json
BIN=$(/usr/libexec/changeguard-package runtime-path) || exit 1
start_service() {
 "$BIN" initialize --config "$CONFIG" >/dev/null || return 1
 procd_open_instance
 procd_set_param command "$BIN" serve --config "$CONFIG"
 procd_set_param respawn 3600 5 0
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_set_param file "$CONFIG"
 procd_close_instance
}
boot() {
 "$BIN" initialize --config "$CONFIG" >/dev/null || return 1
 "$BIN" boot-recover --config "$CONFIG" || logger -t changeguard 'early recovery needs attention; inspect boot-status'
 start
}
