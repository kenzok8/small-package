#!/bin/sh
set -eu
[ -n "${IPKG_INSTROOT:-}" ] && exit 0
bin=/usr/sbin/changeguard_bin
config=/etc/changeguard/config.json
phase=${1:-}
run_checked() {
 response=$("$bin" "$@" --config "$config") || { printf '%s\n' "$response" >&2; return 1; }
}
migrate_config() {
 [ -f "$config" ] || return 0
 local tmp
 tmp="${config}.migrate.$$"
 umask 077
 if ! /usr/bin/ucode -e '
  import { readfile } from "fs";
  let value = json(readfile("/dev/stdin"));
  if (type(value) != "object")
   exit(1);
  delete value.http;
  print(value);
 ' < "$config" > "$tmp"; then
  rm -f "$tmp"
  return 1
 fi
 if ! mv -f "$tmp" "$config"; then
  rm -f "$tmp"
  return 1
 fi
}
stop_service() {
 if pidof changeguard_bin >/dev/null 2>&1; then
  printf '%s\n' 'ChangeGuard stopped for upgrade; any active protection has failed.' >&2
 fi
 /etc/init.d/changeguard stop >/dev/null 2>&1 || true
}
resolve_runtime() {
 local context runtime digest actual
 [ -f "$config" ] || return 0
 context=$(jsonfilter -i "$config" -e '@.recoveryConfig' 2>/dev/null) || context=
 [ -n "$context" ] || context="$config"
 [ -f "$context" ] || return 1
 runtime=$(jsonfilter -i "$context" -e '@.recoveryRuntime.path' 2>/dev/null) || runtime=
 [ -n "$runtime" ] || return 0
 digest=$(jsonfilter -i "$context" -e '@.recoveryRuntime.sha256' 2>/dev/null) || return 1
 [ -n "$digest" ] && [ -x "$runtime" ] || return 1
 actual=$(sha256sum "$runtime") || return 1
 [ "${actual%% *}" = "$digest" ] || return 1
 bin="$runtime"
}
case "$phase" in
 runtime-path)
  resolve_runtime || exit 1
  printf '%s\n' "$bin"
 ;;
 run)
  shift
  resolve_runtime || exit 1
  exec "$bin" "$@"
 ;;
 preinst)
  stop_service
 ;;
 prerm)
  stop_service
  /etc/init.d/changeguard disable
 ;;
 postinst)
  migrate_config
  run_checked initialize
  run_checked sync-backend
  run_checked refresh-runtime
  /etc/init.d/changeguard enable
  /etc/init.d/changeguard restart
 ;;
 *) exit 2 ;;
esac
