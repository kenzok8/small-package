+func TestResponseTtlCachePublicationUsesCopyOnWrite(t *testing.T) {
+	now := time.Now()
+	ctrl := newTestDnsController()
+	ctrl.log = logrus.New()
+	setTestDnsControllerRuntime(ctrl, func(rt *dnsControllerRuntimeState) {
+		rt.responseTtl = 45
+		rt.newCache = func(_ string, answers, ns, extra []dnsmessage.RR, deadline, originalDeadline time.Time) (*DnsCache, error) {
+			return &DnsCache{Answer: answers, NS: ns, Extra: extra, Deadline: deadline, OriginalDeadline: originalDeadline}, nil
+		}
+	})
+	msg := new(dnsmessage.Msg)
+	msg.SetReply(&dnsmessage.Msg{Question: []dnsmessage.Question{{Name: "copy-on-write.test.", Qtype: dnsmessage.TypeA, Qclass: dnsmessage.ClassINET}}})
+	msg.Answer = responseTtlTestCache(now).Answer
+	msg.Ns = responseTtlTestCache(now).NS
+	msg.Extra = responseTtlTestCache(now).Extra
+	if err := ctrl.NormalizeAndCacheDnsResp_(msg, "copy-on-write"); err != nil {
+		t.Fatal(err)
+	}
+	if got := msg.Answer[1].Header().Ttl; got != 45 {
+		t.Fatalf("outgoing A TTL = %d, want 45", got)
+	}
+	if got := msg.Answer[0].Header().Ttl; got != 300 {
+		t.Fatalf("outgoing CNAME TTL = %d, want upstream 300", got)
+	}
+	if got := msg.Ns[0].Header().Ttl; got != 300 {
+		t.Fatalf("outgoing authority TTL = %d, want upstream 300", got)
+	}
+	if got := msg.Extra[0].Header().Ttl; got != 300 {
+		t.Fatalf("outgoing additional A TTL = %d, want upstream 300", got)
+	}
+	if got := msg.Extra[1].Header().Ttl; got != 0x00008000 {
+		t.Fatalf("outgoing OPT flags = %#x, want unchanged", got)
+	}
+	value, ok := ctrl.dnsCache.Load("copy-on-write")
+	if !ok {
+		t.Fatal("cache entry was not published")
+	}
+	cache := value.(*DnsCache)
+	if got := cache.Answer[1].Header().Ttl; got != 300 {
+		t.Fatalf("published cache A TTL = %d, want upstream 300", got)
+	}
+	for name, deadline := range map[string]time.Time{"deadline": cache.Deadline, "original deadline": cache.OriginalDeadline} {
+		remaining := deadline.Sub(now)
+		if remaining < 299*time.Second || remaining > 301*time.Second {
+			t.Fatalf("%s remaining = %v, want upstream TTL 300s", name, remaining)
+		}
+	}
+}
