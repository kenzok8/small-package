+func TestResponseTtlRawUdpMissAndCachedHit(t *testing.T) {
+	for _, responseTtl := range []int{0, 45} {
+		t.Run(dnsmessage.TypeToString[dnsmessage.TypeA]+"/ttl="+time.Duration(responseTtl).String(), func(t *testing.T) {
+			req, client := newDNSResponseUDPTestPair(t)
+			logger := newDNSListenerTestLogger()
+			routing := newPhase0NamedUpstreamRouting(t, logger, "u", "192.0.2.11:53")
+			response := dnsAResponseMsg(phase0NamedUpstreamScopeQName, "198.51.100.11")
+			response.Answer = append([]dnsmessage.RR{
+				&dnsmessage.CNAME{Hdr: dnsmessage.RR_Header{Name: phase0NamedUpstreamScopeQName, Rrtype: dnsmessage.TypeCNAME, Class: dnsmessage.ClassINET, Ttl: 60}, Target: "address.test."},
+			}, response.Answer...)
+			response.Ns = []dnsmessage.RR{&dnsmessage.TXT{Hdr: dnsmessage.RR_Header{Name: "authority.test.", Rrtype: dnsmessage.TypeTXT, Class: dnsmessage.ClassINET, Ttl: 60}, Txt: []string{"authority"}}}
+			response.Extra = []dnsmessage.RR{&dnsmessage.A{Hdr: dnsmessage.RR_Header{Name: "additional.test.", Rrtype: dnsmessage.TypeA, Class: dnsmessage.ClassINET, Ttl: 60}, A: net.ParseIP("192.0.2.2").To4()}}
+			response.SetEdns0(1232, true)
+			response.IsEdns0().SetZ(0x0040)
+			optTtl := response.IsEdns0().Hdr.Ttl
+
+			var forwards atomic.Int32
+			installCorpusDnsForwarderFactory(t, func(*componentdns.Upstream, dialArgument, *logrus.Logger) (DnsForwarder, error) {
+				return &stubDnsForwarder{forward: func(context.Context, []byte) (*dnsmessage.Msg, error) {
+					forwards.Add(1)
+					return response.Copy(), nil
+				}}, nil
+			})
+			stored := make(chan struct{}, 1)
+			option := phase0NamedUpstreamControllerOption(logger)
+			option.ResponseTtl = responseTtl
+			option.CacheAccessCallback = func(*DnsCache) error {
+				select {
+				case stored <- struct{}{}:
+				default:
+				}
+				return nil
+			}
+			controller, err := NewDnsController(routing, option)
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() { _ = controller.Close() })
+
+			query := new(dnsmessage.Msg)
+			query.SetQuestion(phase0NamedUpstreamScopeQName, dnsmessage.TypeA)
+			queryWire, err := query.Pack()
+			if err != nil {
+				t.Fatal(err)
+			}
+			index, upstream, err := routing.RequestSelect(context.Background(), phase0NamedUpstreamScopeQName, dnsmessage.TypeA)
+			if err != nil {
+				t.Fatal(err)
+			}
+			cacheKey := controller.responseCacheKey(controller.cacheKey(phase0NamedUpstreamScopeQName, dnsmessage.TypeA), req, index, upstream)
+			if err := client.SetReadDeadline(time.Now().Add(time.Second)); err != nil {
+				t.Fatal(err)
+			}
+			if err := controller.dialSend(context.Background(), req, queryWire, query.Id, upstream, nil, cacheKey); err != nil {
+				t.Fatal(err)
+			}
+			buf := make([]byte, dnsmessage.MaxMsgSize)
+			n, _, err := client.ReadFromUDPAddrPort(buf)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var miss dnsmessage.Msg
+			if err := miss.Unpack(buf[:n]); err != nil {
+				t.Fatal(err)
+			}
+			wantAddressTtl := uint32(60)
+			if responseTtl > 0 {
+				wantAddressTtl = uint32(responseTtl)
+			}
+			if miss.Answer[0].Header().Ttl != 60 || miss.Answer[1].Header().Ttl != wantAddressTtl || miss.Ns[0].Header().Ttl != 60 || miss.Extra[0].Header().Ttl != 60 || miss.Extra[1].Header().Ttl != optTtl {
+				t.Fatalf("raw miss changed non-address data or returned wrong address TTL: answer=%v ns=%v extra=%v", miss.Answer, miss.Ns, miss.Extra)
+			}
+			select {
+			case <-stored:
+			case <-time.After(time.Second):
+				t.Fatal("asynchronous cache was not populated")
+			}
+
+			writer := &dnsCorpusCaptureWriter{}
+			if err := controller.HandleWithResponseWriter_(context.Background(), query.Copy(), req, writer); err != nil {
+				t.Fatal(err)
+			}
+			hit := writer.Message()
+			if hit == nil || len(hit.Answer) != 2 {
+				t.Fatalf("cached hit = %#v, want two answers", hit)
+			}
+			if responseTtl > 0 {
+				if got := hit.Answer[1].Header().Ttl; got != uint32(responseTtl) {
+					t.Fatalf("cached hit A TTL = %d, want %d", got, responseTtl)
+				}
+			} else if got := hit.Answer[1].Header().Ttl; got == 0 || got > 60 {
+				t.Fatalf("cached hit A TTL = %d, want real remaining TTL in [1,60]", got)
+			}
+			if got := forwards.Load(); got != 1 {
+				t.Fatalf("forwarder calls = %d, want 1 (second request must hit cache)", got)
+			}
+		})
+	}
+}
