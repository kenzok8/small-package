+func assertResponseTtlPolicy(t *testing.T, wire []byte, responseTtl, remainingTtl uint32) {
+	t.Helper()
+	var msg dnsmessage.Msg
+	if err := msg.Unpack(wire); err != nil {
+		t.Fatalf("unpack response: %v", err)
+	}
+	if got := msg.Answer[0].Header().Ttl; got != remainingTtl {
+		t.Fatalf("CNAME TTL = %d, want remaining TTL %d", got, remainingTtl)
+	}
+	for _, i := range []int{1, 2} {
+		if got := msg.Answer[i].Header().Ttl; got != responseTtl {
+			t.Fatalf("address answer %d TTL = %d, want %d", i, got, responseTtl)
+		}
+	}
+	if len(msg.Ns) != 1 || msg.Ns[0].Header().Ttl != remainingTtl {
+		t.Fatalf("authority section = %#v, want one record with TTL %d", msg.Ns, remainingTtl)
+	}
+	if len(msg.Extra) != 2 {
+		t.Fatalf("additional section length = %d, want 2", len(msg.Extra))
+	}
+	if got := msg.Extra[0].Header().Ttl; got != remainingTtl {
+		t.Fatalf("additional A TTL = %d, want remaining TTL %d", got, remainingTtl)
+	}
+	if got := msg.Extra[1].Header().Ttl; got != 0x00008000 {
+		t.Fatalf("OPT flags = %#x, want unchanged", got)
+	}
+}
