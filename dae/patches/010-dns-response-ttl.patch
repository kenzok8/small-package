+func TestResponseTtlInPlacePreservesNodataSections(t *testing.T) {
+	now := time.Now()
+	cache := &DnsCache{
+		Deadline:         now.Add(30 * time.Second),
+		OriginalDeadline: now.Add(30 * time.Second),
+		NS: []dnsmessage.RR{
+			&dnsmessage.SOA{
+				Hdr:     dnsmessage.RR_Header{Name: "nodata.test.", Rrtype: dnsmessage.TypeSOA, Class: dnsmessage.ClassINET, Ttl: 300},
+				Ns:      "ns.nodata.test.",
+				Mbox:    "hostmaster.nodata.test.",
+				Serial:  1,
+				Refresh: 3600,
+				Retry:   600,
+				Expire:  86400,
+				Minttl:  300,
+			},
+		},
+		Extra: []dnsmessage.RR{
+			&dnsmessage.A{Hdr: dnsmessage.RR_Header{Name: "ns.nodata.test.", Rrtype: dnsmessage.TypeA, Class: dnsmessage.ClassINET, Ttl: 300}, A: net.ParseIP("192.0.2.53").To4()},
+			&dnsmessage.OPT{Hdr: dnsmessage.RR_Header{Name: ".", Rrtype: dnsmessage.TypeOPT, Class: 1232, Ttl: 0x00008000}},
+		},
+	}
+	req := new(dnsmessage.Msg)
+	req.SetQuestion("nodata.test.", dnsmessage.TypeA)
+	req.Answer = []dnsmessage.RR{&dnsmessage.A{Hdr: dnsmessage.RR_Header{Name: "old.test.", Rrtype: dnsmessage.TypeA, Class: dnsmessage.ClassINET, Ttl: 1}, A: net.ParseIP("192.0.2.1").To4()}}
+	req.Ns = []dnsmessage.RR{&dnsmessage.TXT{Hdr: dnsmessage.RR_Header{Name: "old.test.", Rrtype: dnsmessage.TypeTXT, Class: dnsmessage.ClassINET, Ttl: 1}, Txt: []string{"old"}}}
+	req.Extra = []dnsmessage.RR{&dnsmessage.OPT{Hdr: dnsmessage.RR_Header{Name: ".", Rrtype: dnsmessage.TypeOPT, Class: 512, Ttl: 0}}}
+
+	wire, err := cache.fillIntoWithTTLAndResponseTtlInPlace(req, now, 45)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got dnsmessage.Msg
+	if err := got.Unpack(wire); err != nil {
+		t.Fatal(err)
+	}
+	if len(got.Answer) != 0 {
+		t.Fatalf("NODATA answer count = %d, want 0", len(got.Answer))
+	}
+	if len(got.Ns) != 1 {
+		t.Fatalf("authority count = %d, want 1", len(got.Ns))
+	}
+	soa, ok := got.Ns[0].(*dnsmessage.SOA)
+	if !ok || soa.Ns != "ns.nodata.test." || soa.Hdr.Ttl != 30 {
+		t.Fatalf("authority SOA = %#v, want ns.nodata.test. with TTL 30", got.Ns[0])
+	}
+	if len(got.Extra) != 2 {
+		t.Fatalf("additional count = %d, want 2", len(got.Extra))
+	}
+	additional, ok := got.Extra[0].(*dnsmessage.A)
+	if !ok || !additional.A.Equal(net.ParseIP("192.0.2.53")) || additional.Hdr.Ttl != 30 {
+		t.Fatalf("additional A = %#v, want 192.0.2.53 with TTL 30", got.Extra[0])
+	}
+	opt, ok := got.Extra[1].(*dnsmessage.OPT)
+	if !ok || opt.Hdr.Class != 1232 || opt.Hdr.Ttl != 0x00008000 {
+		t.Fatalf("OPT = %#v, want class 1232 and flags %#x", got.Extra[1], uint32(0x00008000))
+	}
+}
