+func TestResponseTtlMaterializationPolicy(t *testing.T) {
+	now := time.Now()
+	for _, responseTtl := range []int{0, 45} {
+		cache := responseTtlTestCache(now)
+		if err := cache.prepackResponseWithTTLAndResponseTtl("alias.test.", dnsmessage.TypeA, 30, responseTtl, now); err != nil {
+			t.Fatalf("response_ttl=%d prepack: %v", responseTtl, err)
+		}
+		wantAddressTtl := uint32(30)
+		if responseTtl > 0 {
+			wantAddressTtl = uint32(responseTtl)
+		}
+		assertResponseTtlPolicy(t, cache.packedResponse.Load().wire, wantAddressTtl, 30)
+
+		req := new(dnsmessage.Msg)
+		req.SetQuestion("alias.test.", dnsmessage.TypeA)
+		wire, err := cache.fillIntoWithTTLAndResponseTtlInPlace(req, now, responseTtl)
+		if err != nil {
+			t.Fatalf("response_ttl=%d in-place: %v", responseTtl, err)
+		}
+		assertResponseTtlPolicy(t, wire, wantAddressTtl, 30)
+	}
+}
