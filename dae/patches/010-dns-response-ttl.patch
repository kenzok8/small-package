+func TestResponseTtlRefreshesStalePackedPolicy(t *testing.T) {
+	now := time.Now()
+	cache := responseTtlTestCache(now)
+	cache.Deadline = now.Add(-time.Second)
+	cache.deadlineNano.Store(cache.Deadline.UnixNano())
+	if err := cache.prepackResponseWithTTLAndResponseTtl("alias.test.", dnsmessage.TypeA, 30, 0, now.Add(-time.Minute)); err != nil {
+		t.Fatal(err)
+	}
+	wire := cache.getStaleResponseWithResponseTtl("alias.test.", dnsmessage.TypeA, now, 60, 45)
+	assertResponseTtlPolicy(t, wire, 45, 30)
+	bounded := clampWireRecordTtls(wire, 30)
+	var stale dnsmessage.Msg
+	if err := stale.Unpack(bounded); err != nil {
+		t.Fatal(err)
+	}
+	if got := stale.Answer[1].Header().Ttl; got != 30 {
+		t.Fatalf("stale address TTL = %d, want min(response_ttl=45, stale_reply_ttl=30)", got)
+	}
+}
