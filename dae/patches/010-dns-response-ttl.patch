+			routingMatcher: &RoutingMatcher{domainMatcher: responseTtlDomainMatcher{}},
+		},
+		controlPlaneDNSRuntime: controlPlaneDNSRuntime{dnsResponseTtl: 15},
+	}
+	if _, err := candidate.RestorePreparedDNSRuntimeForRollback(previous, true, false); err != nil {
+		t.Fatal(err)
+	}
+	if candidate.dnsController != nil || previous.dnsController == nil {
+		t.Fatal("rollback did not transfer the DNS controller to the previous generation")
+	}
+	if got := previous.dnsController.currentResponseTtl(); got != 15 {
+		t.Fatalf("rollback response_ttl = %d, want previous value 15", got)
+	}
+}
