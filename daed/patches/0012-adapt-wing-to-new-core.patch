+func probeLatencyFast(ctx context.Context, d *dialer.Dialer) (*dialer.LatencyProbeResult, error) {
+	opt, err := d.TcpCheckOptionRaw.Option()
+	if err != nil {
+		return nil, err
+	}
+	network, err := netproxy.ParseMagicNetwork(d.TcpCheckOptionRaw.ResolverNetwork)
+	if err != nil {
+		return nil, err
+	}
+	result := &dialer.LatencyProbeResult{CheckedAt: time.Now()}
+	var messages []string
+	for _, probe := range []struct {
+		index int
+		ip    netip.Addr
+	}{
+		{index: dialer.IdxTcp4, ip: opt.Ip4},
+		{index: dialer.IdxTcp6, ip: opt.Ip6},
+	} {
+		if !probe.ip.IsValid() {
+			continue
+		}
+		probeCtx, cancel := context.WithTimeout(ctx, 1500*time.Millisecond)
+		started := time.Now()
+		ok, probeErr := d.HttpCheck(probeCtx, probe.index, opt.Url, probe.ip, opt.Method, network.Mark, network.Mptcp)
+		cancel()
+		if ok {
+			latency := time.Since(started)
+			if !result.Alive || latency < result.Latency {
+				result.Latency = latency
+			}
+			result.Alive = true
+		} else if probeErr != nil {
+			messages = append(messages, probeErr.Error())
+		}
+	}
+	if !result.Alive {
+		result.Message = strings.Join(messages, "; ")
+		if result.Message == "" {
+			result.Message = "no latency result"
+		}
+	}
+	return result, nil
+}
