@@ -0,0 +1,33 @@
+package dae
+
+import (
+	"errors"
+	"reflect"
+	"testing"
+)
+
+func TestCloseReloadResourcesOrder(t *testing.T) {
+	var got []string
+	err := closeReloadResources(
+		func() error { got = append(got, "old-listener"); return nil },
+		func() error { got = append(got, "staged-listener"); return nil },
+		func() error { got = append(got, "new-control-plane"); return nil },
+		func() error { got = append(got, "old-control-plane"); return nil },
+	)
+	if err != nil {
+		t.Fatalf("closeReloadResources() error = %v", err)
+	}
+	want := []string{"old-listener", "staged-listener", "new-control-plane", "old-control-plane"}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("close order = %v, want %v", got, want)
+	}
+}
+
+func TestCloseReloadResourcesJoinsErrors(t *testing.T) {
+	one := errors.New("old listener")
+	two := errors.New("old control plane")
+	err := closeReloadResources(func() error { return one }, func() error { return two })
+	if !errors.Is(err, one) || !errors.Is(err, two) {
+		t.Fatalf("joined error = %v, want both close errors", err)
+	}
+}
