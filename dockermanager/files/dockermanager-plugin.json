{
  "schemaVersion": 1,
  "id": "dockermanager",
  "name": "Docker Manager",
  "icon": "logo.svg",
  "staticRoot": "/usr/share/dockermanager/www",
  "desktop": {
    "mode": "module",
    "entry": "desktop-entry.js",
    "isolation": "shadow-dom"
  },
  "standalone": {
    "entry": "index.html",
    "basePath": "/apps/dockermanager/"
  },
  "config": {
    "providerOrder": ["uci"],
    "providers": {
      "uci": {
        "type": "uci"
      }
    }
  },
  "auth": { "mode": "passthrough" },
  "backend": {
    "type": "http",
    "transport": "unix",
    "scheme": "http",
    "values": {
      "socketPath": {
        "default": "/var/run/dockermanager.sock",
        "keys": {
          "uci": "dockermanager.@dockermanager[0].socket_path"
        }
      }
    },
    "upstreamBasePath": "/apps/dockermanager/",
    "apiPath": "api/",
    "pathMode": "preserve"
  },
  "window": {
    "width": 1180,
    "height": 760,
    "singleton": true
  },
  "capabilities": ["docker", "compose", "multi-target"],
  "categories": ["system"]
}
