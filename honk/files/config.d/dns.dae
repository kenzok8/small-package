# dns.dae
dns {
    bind:'tcp+udp://[::]:53530'
    client_subnet:auto
    #ipversion_prefer:4
    upstream {
        local: 'udp://127.0.0.1:53' -> direct
        remote: 'tcp+udp://dns.google:53'
    }
    routing {
        request {
            qtype(https) -> reject
            qname(geosite:gfw) -> remote
            fallback: local
        }
        response {
            upstream(remote) -> accept
            qname(geosite:private) -> accept
            ip(geoip:cn) -> accept
            fallback: remote
        }
    }
}
