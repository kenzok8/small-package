{
  "schemaVersion": 1,
  "id": "kspeeder",
  "name": "KSpeeder",
  "icon": "logo.png",
  "staticRoot": "/usr/share/kspeeder/www",
  "desktop": {
    "mode": "iframe",
    "target": {
      "scheme": "http",
      "hostMode": "request-host",
      "port": {
        "default": 5003,
        "keys": {
          "uci": "istoreenhance.@istoreenhance[0].adminport"
        }
      },
      "path": "/"
    },
    "access": {
      "scope": "lan",
      "blockedTitle": "请在局域网内打开 KSpeeder",
      "blockedMessage": "KSpeeder 运行在设备的独立服务端口，请连接设备所在局域网后再打开。"
    }
  },
  "standalone": {
    "entry": "index.html",
    "basePath": "/apps/kspeeder/",
    "externalOpen": {
      "enabled": true,
      "label": "打开 KSpeeder 独立页面",
      "scheme": "http",
      "hostMode": "request-host",
      "defaultPort": 5003,
      "path": "/"
    }
  },
  "config": {
    "providerOrder": ["uci"],
    "providers": {
      "uci": {
        "type": "uci"
      }
    }
  },
  "backend": {
    "type": "http",
    "scheme": "http",
    "host": "127.0.0.1",
    "portFromUci": "istoreenhance.@istoreenhance[0].adminport",
    "defaultPort": 5003,
    "upstreamBasePath": "/",
    "apiPath": "api/",
    "pathMode": "strip-public-base"
  },
  "window": {
    "width": 1040,
    "height": 700,
    "singleton": true
  },
  "capabilities": ["docker-acceleration", "registry-mirror", "cache"],
  "categories": ["network", "docker"]
}
