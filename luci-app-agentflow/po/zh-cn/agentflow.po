msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8"

msgid "AgentFlow"
msgstr "AgentFlow"

msgid "AgentFlow orchestrates projects and independently installed coding agents."
msgstr "AgentFlow 用于编排项目和独立安装的编码智能体。"

msgid "Enable"
msgstr "启用"

msgid "Global settings"
msgstr "全局设置"

msgid "Data directory"
msgstr "数据目录"

msgid "Data directory cannot be empty."
msgstr "数据目录不能为空。"

msgid "Please select a disk as the data directory."
msgstr "请选择硬盘作为数据目录。"

msgid "Required. AgentFlow stores its configuration, database and workspace data under this directory."
msgstr "必需。AgentFlow 在此目录中保存配置、数据库和工作区数据。"

msgid "AgentFlow home directory"
msgstr "AgentFlow 主目录"

msgid "Optional. New installations use <data directory>/home. An upgraded installation may retain its previous HOME so credentials are not moved silently."
msgstr "可选。新安装使用 <数据目录>/home；升级安装可保留原 HOME，避免静默移动凭据。"

msgid "Please select a disk as the home directory."
msgstr "请选择硬盘作为主目录。"

msgid "Checking AgentFlow service"
msgstr "正在检查 AgentFlow 服务"

msgid "Collecting data..."
msgstr "正在获取数据……"

msgid "AgentFlow service is running"
msgstr "AgentFlow 服务运行中"

msgid "AgentFlow service is not running"
msgstr "AgentFlow 服务未运行"

msgid "The service is ready. AgentFlow uses independently installed coding agents."
msgstr "服务已就绪。AgentFlow 使用独立安装的编码智能体。"

msgid "Start the service to use AgentFlow."
msgstr "请启动服务后使用 AgentFlow。"

msgid "Application entry is unavailable."
msgstr "应用入口当前不可用。"

msgid "Open AgentFlow"
msgstr "打开 AgentFlow"

msgid "Local network access"
msgstr "局域网访问"

msgid "Copy"
msgstr "复制"

msgid "Copied"
msgstr "已复制"

msgid "AgentFlow keeps its own login and is exposed only through the application gateway."
msgstr "AgentFlow 使用自己的登录体系，并且仅通过应用网关提供访问。"

msgid "Coding agents"
msgstr "编码智能体"

msgid "Coding agents are installed and upgraded by their independent plugins. AgentFlow only invokes providers that are ready."
msgstr "编码智能体由各自独立插件安装和升级；AgentFlow 只调用已经就绪的提供方。"

msgid "Ready"
msgstr "已就绪"

msgid "Not installed"
msgstr "未安装"

msgid "Manage"
msgstr "管理"

msgid "Version"
msgstr "版本"

msgid "No independent coding agent plugin was detected. Install Codex, Claude Code, OpenCode or Kimi from the app store."
msgstr "未检测到独立编码智能体插件。请从应用商店安装 Codex、Claude Code、OpenCode 或 Kimi。"
