{
	"luci-app-clashoo": {
		"description": "Grant access for luci-app-clashoo",
		"read": {
			"uci": [ "clashoo" ]
		},
		"write": {
			"cgi-io": [ "download" ],
			"file": {
				"/tmp/clashoo-backup/export.*": [ "read" ]
			},
			"uci": [ "clashoo" ],
			"ubus": {
				"luci.clashoo": [ "*" ]
			}
		}
	}
}
