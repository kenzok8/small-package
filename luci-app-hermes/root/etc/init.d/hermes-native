#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=10

SERVICE_NAME=hermes-native
RUNTIME=/usr/share/hermes/shared-runtime.lua

start_service() {
	local backend enabled base bind port
	backend="$(uci -q get 'hermes.@main[0].backend' 2>/dev/null || echo native)"
	enabled="$(uci -q get 'hermes.@main[0].native_enabled' 2>/dev/null || echo 0)"
	base="$(uci -q get 'hermes.@main[0].native_base_dir' 2>/dev/null || true)"
	bind="$(uci -q get 'hermes.@main[0].native_bind' 2>/dev/null || echo 0.0.0.0)"
	port="$(uci -q get 'hermes.@main[0].native_port' 2>/dev/null || echo 18787)"

	[ "$backend" = native ] || [ "${HERMES_NATIVE_FORCE_START:-0}" = 1 ] || return 0
	[ "$enabled" = 1 ] || [ "${HERMES_NATIVE_FORCE_START:-0}" = 1 ] || return 0
	case "$base" in /mnt/*) ;; *) return 1 ;; esac
	case "$port" in ''|*[!0-9]*) return 1 ;; esac
	[ "$port" -gt 1024 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null || return 1
	case "$bind" in 0.0.0.0|127.0.0.1) ;; *) return 1 ;; esac

	local current="$base/current"
	local binding="$current/runtime.json"
	/usr/bin/lua "$RUNTIME" inspect "$binding" >/dev/null 2>&1 || return 1
	id hermes >/dev/null 2>&1 && [ "$(id -u hermes)" -gt 0 ] || return 1
	mkdir -p "$base/data/.hermes/webui" "$base/data/workspace" "$base/log" || return 1
	chown -R hermes:hermes "$base/data" || return 1
	chmod 700 "$base/data" "$base/data/.hermes" || return 1

	procd_open_instance gateway
	procd_set_param command /usr/bin/lua "$RUNTIME" as-app "$binding" \
		--shell -c "exec hermes gateway run --external-supervisor --force"
	procd_set_param env \
		HERMES_DISABLE_LAZY_INSTALLS=1 \
		PYTHONUNBUFFERED=1
	procd_set_param respawn 3600 10 5
	procd_set_param limits core="0 0" nofile="1024 8192"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance webui
	procd_set_param command /usr/bin/lua "$RUNTIME" as-app "$binding" \
		python "$current/webui/server.py"
	procd_set_param env \
		HERMES_WEBUI_AGENT_DIR="$current/agent" \
		HERMES_WEBUI_HOST="$bind" \
		HERMES_WEBUI_PORT="$port" \
		HERMES_WEBUI_STATE_DIR="$base/data/.hermes/webui" \
		HERMES_WEBUI_DEFAULT_WORKSPACE="$base/data/workspace" \
		HERMES_WEBUI_PYTHON="$current/venv/bin/python" \
		HERMES_WEBUI_SHUTDOWN_DRAIN_SECONDS=2 \
		HERMES_DISABLE_LAZY_INSTALLS=1 \
		HERMES_WEBUI_AUTO_INSTALL=0 \
		PYTHONUNBUFFERED=1
	procd_set_param respawn 3600 10 5
	procd_set_param limits core="0 0" nofile="1024 8192"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger hermes
}
