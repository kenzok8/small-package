config homeproxy 'infra'
	option __warning 'DO NOT EDIT THIS SECTION, OR YOU ARE ON YOUR OWN!'
	option common_port '20,21,22,25,53,80,110,119,123,143,389,443,465,514,563,587,636,853,873,989,990,993,995,1194,1883,3306,3389,5222,5432,5671,5672,5900,6379,6443,6514,8080,8443,8883,9418'
	option mixed_port '5330'
	option dns_port '5333'
	option ntp_server 'nil'
	option udp_timeout '300'
	option tun_name 'singtun0'
	option tun_addr4 '172.19.0.1/30'
	option tun_addr6 'fdfe:dcba:9876::1/126'
	option tun_mtu '9000'
	option clash_api_port 'auto'

config homeproxy 'config'
	option routing_mode 'bypass_mainland_china'
	option routing_port 'common'
	option multi_queue '1'
	option ipv6_support '1'
	option main_node 'nil'
	option main_urltest_interval '60'
	option main_urltest_tolerance '60'
	option main_urltest_interrupt_exist_connections '0'
	option dns_server 'https://dns.quad9.net/dns-query'
	option china_dns_server 'https://dns.alidns.com/dns-query'
	option log_level 'warn'
	option dashboard_enabled '0'
	option dashboard_port '9095'

config homeproxy 'control'
	option lan_whitelist_mode '0'

config homeproxy 'diversion'
	option __warning 'DO NOT EDIT THIS SECTION, OR YOU ARE ON YOUR OWN!'

config homeproxy 'tailscale'
	option enabled '0'
	option accept_routes '0'
	option exit_node_allow_lan_access '0'
	option advertise_exit_node '0'

config homeproxy 'subscription'
	option auto_update '0'
	option allow_insecure '0'
	option packet_encoding 'xudp'
	option user_agent 'homeproxy'
	option update_via_proxy '0'
	option auto_update_time '0 */6 * * *'
	option filter_nodes 'disabled'

config homeproxy 'server'
	option enabled '0'
	option log_level 'warn'
