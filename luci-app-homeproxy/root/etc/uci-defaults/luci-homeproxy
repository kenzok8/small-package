#!/bin/sh

ucode "/etc/homeproxy/scripts/migrate_config.uc" || exit 1

if ! /usr/libexec/homeproxy-runtime-init; then
	printf '%s\n' 'HomeProxy: failed to initialize runtime ports.' >&2
	exit 1
fi

if ! uci -q batch <<-EOF >"/dev/null"
	delete firewall.homeproxy_pre

	delete firewall.homeproxy_forward

	delete firewall.homeproxy_input
	set firewall.homeproxy_input=include
	set firewall.homeproxy_input.type=nftables
	set firewall.homeproxy_input.path="/var/run/homeproxy/fw4_input.nft"
	set firewall.homeproxy_input.position="chain-pre"
	set firewall.homeproxy_input.chain="input"

	delete firewall.homeproxy_post
	commit firewall
EOF
then
	printf '%s\n' 'HomeProxy: failed to configure firewall includes.' >&2
	exit 1
fi

rm -rf /tmp/luci-*
rm -f /etc/homeproxy/dashboard/.etag
[ ! -d /etc/homeproxy/dashboard ] || chmod -R a+rX /etc/homeproxy/dashboard
[ ! -f /var/run/homeproxy/sing-box-c.json ] || \
	/etc/init.d/homeproxy restart >/dev/null 2>&1 || \
	printf '%s\n' 'HomeProxy: failed to restart the running service after upgrade.' >&2
exit 0
