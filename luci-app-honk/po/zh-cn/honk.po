msgid "Available after Honk is initialized, running, and its API is ready."
msgstr "Honk 完成初始化、正在运行且 API 就绪后即可使用。"

msgid "A previous operation did not finish cleanly."
msgstr "上一次操作未能正常结束。"

msgid "Another Honk operation is in progress."
msgstr "Honk 正在执行其他操作。"

msgid "Complete initial setup before enabling Honk."
msgstr "请先完成首次设置，再启用 Honk。"

msgid "Complete initial setup before starting Honk."
msgstr "请先完成首次设置，再启动 Honk。"

msgid "Complete initial setup from the management panel."
msgstr "请先在管理面板完成首次设置。"

msgid "Could not read Honk status."
msgstr "无法读取 Honk 状态。"

msgid "Could not save Honk settings."
msgstr "无法保存 Honk 设置。"

msgid "The curl command is missing. Install the curl package and try again."
msgstr "缺少 curl 命令，请先安装 curl 包（apk add curl 或 opkg install curl）后重试。"

msgid "Save failed. Check the settings and system status."
msgstr "保存失败，请检查设置和系统状态。"

msgid "System check failed."
msgstr "系统检查失败。"

msgid "Repair failed."
msgstr "修复失败。"

msgid "Backup failed."
msgstr "备份失败。"

msgid "Restore failed."
msgstr "恢复失败。"

msgid "Doona is not ready yet."
msgstr "Doona 尚未就绪。"

msgid "Doona is not ready yet. Check the overview for status."
msgstr "Doona 尚未就绪，请在概况页查看状态。"

msgid "Go to overview"
msgstr "前往概况页"

msgid "Honk could not restart."
msgstr "Honk 重启失败。"

msgid "Honk could not start."
msgstr "Honk 启动失败。"

msgid "Honk could not stop."
msgstr "Honk 停止失败。"

msgid "Honk is disabled."
msgstr "Honk 当前未启用。"

msgid "Honk is already running."
msgstr "Honk 已在运行。"

msgid "Honk is enabled but currently stopped."
msgstr "Honk 已启用，但当前未运行。"

msgid "Honk is running, but its management interface is not ready."
msgstr "Honk 正在运行，但管理界面尚未就绪。"

msgid "Honk is stopped. Start it from the overview to open Doona."
msgstr "Honk 已停止，请先到概况页启动服务，再打开 Doona。"

msgid "Honk restarted."
msgstr "Honk 已重启。"

msgid "Honk started."
msgstr "Honk 已启动。"

msgid "Honk stopped."
msgstr "Honk 已停止。"

msgid "Honk system configuration is unavailable."
msgstr "Honk 系统配置不可用。"

msgid "Honk configuration is unavailable."
msgstr "Honk 配置不可用。"

msgid "Honk reported a system issue."
msgstr "Honk 检测到系统问题。"

msgid "Initialization failed. Check the system status."
msgstr "初始化失败，请检查系统状态。"

msgid "Operation failed. Check Honk status."
msgstr "操作失败，请检查 Honk 状态。"

msgid "Settings saved and applied."
msgstr "设置已保存并应用。"

msgid "Refreshing status…"
msgstr "正在刷新状态……"

msgid "Settings could not be applied. The previous settings were restored."
msgstr "设置应用失败，已恢复到之前的设置。"

msgid "Start Honk to open Doona."
msgstr "启动 Honk 后即可打开 Doona。"

msgid "System maintenance needs recovery."
msgstr "系统维护需要恢复处理。"

msgid "The listen port is already in use."
msgstr "监听端口已被占用。"

msgid "The listen port is invalid."
msgstr "监听端口无效。"

msgid "The managed Honk service is not healthy."
msgstr "Honk 托管服务状态异常。"

msgid "The selected LAN network is invalid or unavailable."
msgstr "所选 LAN 网络无效或不可用。"

msgid "The selected LAN network is unavailable."
msgstr "所选 LAN 网络不可用。"

msgid "An unmanaged Honk core process is running."
msgstr "检测到非托管的 Honk 核心进程正在运行。"

msgid "Version information"
msgstr "版本信息"

msgid "Backup and restore"
msgstr "备份与恢复"

msgid "Backup downloaded."
msgstr "备份已下载。"

msgid "Backup failed: %s"
msgstr "备份失败：%s"

msgid "Backup restored."
msgstr "备份已恢复。"

msgid "Choose a backup archive to upload…"
msgstr "请选择要上传的备份文件……"

msgid "Choose a LAN network and a port from 1024 to 65535."
msgstr "请选择 LAN 网络，并将端口设置为 1024 至 65535。"

msgid "Checks Honk system components and reports detected issues."
msgstr "检查 Honk 系统组件并报告发现的问题。"

msgid "Checking…"
msgstr "正在检查……"

msgid "Could not load LAN networks: %s"
msgstr "无法读取 LAN 网络：%s"

msgid "Could not read current settings: %s"
msgstr "无法读取当前设置：%s"

msgid "Could not read Honk status: %s"
msgstr "无法读取 Honk 状态：%s"

msgid "Core version"
msgstr "核心版本"

msgid "Create a backup archive or restore one from your computer."
msgstr "创建备份文件，或从电脑上传备份进行恢复。"

msgid "Download backup"
msgstr "下载备份"

msgid "Create the Honk administrator account. The password is sent only for this request and is not saved by this page."
msgstr "创建 Honk 管理员账号。密码只会随本次请求发送，本页面不会保存密码。"

