				;;
			initialize)
				exec "$CONTROL" initialize
				;;
			settings)
				# First boot records intent in UCI and keeps the template; initialization renders it,
				# after which the panel edits config.dae directly.
				if [ "$(config_owner /etc/honk/config.dae)" = file ] && [ "$(uci -q get honk.main.initialized)" = 1 ]; then
					settings_file_apply
				else
					exec "$CONTROL" settings
				fi
				;;
			probe_subscription)
				probe_subscription
				;;
			reset_admin)
				reset_admin
				;;
			add_subscription)
				add_subscription
				;;
			add_nodes)
				add_nodes
				;;
			import_dae)
				import_dae
				;;
			config_read)
				config_read
				;;
			config_draft_read)
				config_draft_read
				;;
			lan_candidates)
				lan_candidates
				;;
			config_validate)
				config_validate
				;;
			config_save)
				config_save
				;;
			config_merge_preview)
				config_merge_preview
				;;
			config_merge_apply)
				config_merge_apply
				;;
			config_apply)
				config_apply
				;;
			config_detach)
				exec "$CONTROL" detach
				;;
			system_read)
				system_read
				;;
			system_save)
				system_save
				;;
			system_panel)
				exec "$CONTROL" panel-managed
				;;
			repair)
				exec "$CONTROL" repair
				;;
			recover)
				# Only recover finishes an interrupted maintenance transaction; expose it in the panel
				exec "$CONTROL" recover
				;;
			backup)
				start_job backup
				;;
			restore)
				start_job restore
				;;
			restore_prepare)
				restore_prepare
				;;
			reset)
				reset_request=$(head -c 512)
				reset_device=
				reset_ip=
				if [ -n "$reset_request" ]; then
					json_load "$reset_request" 2>/dev/null || { emit_result false invalid_request; return 1; }
					json_get_var reset_device lan_device
					json_get_var reset_ip lan_ip
				fi
				case "$reset_device" in ''|*[!A-Za-z0-9_.:-]*) emit_result false invalid_request; return 1 ;; esac
				case "$reset_ip" in ''|*[!0-9.]*) emit_result false invalid_request; return 1 ;; esac
				start_job reset "$reset_device|$reset_ip"
				;;
			job_status)
				job_status
				;;
			logs)
				logs
				;;
			update_check)
				start_job update_check
				;;
			update_apply)
				start_job update_apply
				;;
			start)
				begin_mutation
				if ! service_ready_config; then emit_result false "${config_error:-not_initialized}"; exit 1; fi
				old_enabled=$(uci -q get honk.main.enabled || echo 0)
				if ! set_enabled 1; then emit_result false settings_write_failed; exit 1; fi
				managed_pid=$(honk_lifecycle_managed_pid 2>/dev/null)
				if [ -n "$managed_pid" ]; then
					if honk_lifecycle_runtime_owned "$managed_pid"; then emit_result true already_running; else set_enabled "$old_enabled" >/dev/null 2>&1; emit_result false managed_service_unhealthy; exit 1; fi
				elif honk_lifecycle_start 30; then
					emit_result true started
				else
					honk_lifecycle_stop 30 >/dev/null 2>&1 || :
					set_enabled "$old_enabled" >/dev/null 2>&1
					emit_result false start_failed
					exit 1
				fi
				;;
			stop)
				begin_mutation
				old_enabled=$(uci -q get honk.main.enabled || echo 0)
				if ! set_enabled 0; then emit_result false settings_write_failed; exit 1; fi
				if honk_lifecycle_stop 30; then emit_result true stopped; else set_enabled "$old_enabled" >/dev/null 2>&1; emit_result false stop_failed; exit 1; fi
				;;
			restart)
				begin_mutation
				if ! service_ready_config; then emit_result false "${config_error:-not_initialized}"; exit 1; fi
				old_enabled=$(uci -q get honk.main.enabled || echo 0)
				if ! set_enabled 1; then emit_result false settings_write_failed; exit 1; fi
				if [ -n "$(honk_lifecycle_managed_pid 2>/dev/null)" ]; then
					:
				elif pidof honk-core >/dev/null 2>&1; then
					set_enabled "$old_enabled" >/dev/null 2>&1
					emit_result false unmanaged_core_running
					exit 1
				fi
				if honk_lifecycle_restart 30; then emit_result true restarted; else set_enabled "$old_enabled" >/dev/null 2>&1; emit_result false restart_failed; exit 1; fi
				;;
			*)
				emit_result false unknown_method
				exit 1
				;;
		esac
		;;
	*)
		exit 2
		;;
esac
