{
	"luci-app-honk": {
		"description": "Grant access for luci-app-honk",
		"read": {
			"ubus": {
				"luci.honk": [ "*" ]
			},
			"uci": [ "honk" ],
			"file": [
				"/etc/honk/config.dae",
				"/etc/honk/config.d/dns.dae",
				"/etc/honk/config.d/node.dae",
				"/etc/honk/config.d/route.dae",
				"/etc/honk/zashboard/*"
			]
		},
		"write": {
			"ubus": {
				"luci.honk": [ "*" ]
			},
			"uci": [ "honk" ],
			"file": [
				"/etc/honk/config.dae",
				"/etc/honk/config.d/dns.dae",
				"/etc/honk/config.d/node.dae",
				"/etc/honk/config.d/route.dae",
				"/etc/honk/zashboard/*"
			]
		}
	}
}
