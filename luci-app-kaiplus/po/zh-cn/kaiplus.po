msgstr "Content-Type: text/plain; charset=UTF-8"

msgid "KaiPlus"
msgstr "酷友社AI"

msgid "KaiPlus is an AI workspace and session service."
msgstr "酷友社AI 是一款 AI 工作区与会话服务。"

msgid "Global settings"
msgstr "全局设置"

msgid "Enable"
msgstr "启用"

msgid "Data directory"
msgstr "数据目录"

msgid "Required. KaiPlus stores workspace, cache, config, and state under this directory."
msgstr "必填。酷友社AI 会在此目录中保存工作区、缓存、配置和状态数据。"

msgid "Access port"
msgstr "访问端口"

msgid "KaiPlus is available at http://router-address:port/apps/kaiplus/."
msgstr "可通过 http://路由器地址:端口/apps/kaiplus/ 访问酷友社AI。"

msgid "The KaiPlus service is running."
msgstr "酷友社AI 服务正在运行。"

msgid "The KaiPlus service is not running."
msgstr "酷友社AI 服务未运行。"

msgid "Access mode: LinkEase Desktop proxy."
msgstr "访问模式：LinkEase Desktop 代理。"

msgid "Access mode: external port."
msgstr "访问模式：外部端口。"

msgid "External port access is disabled."
msgstr "外部端口访问已禁用。"

msgid "Click to open KaiPlus"
msgstr "点击打开酷友社AI"

msgid "Classic KAI"
msgstr "经典版 KAI"

msgid "Classic KAI is not installed. Install it now?"
msgstr "尚未安装经典版 KAI，是否现在安装？"

msgid "Task log window is not available."
msgstr "任务日志窗口不可用。"

msgid "Starting installation..."
msgstr "正在启动安装……"

msgid "Failed to start KAI installation."
msgstr "无法启动经典版 KAI 安装任务。"

msgid "Status"
msgstr "状态"

msgid "Collecting data..."
msgstr "正在获取数据……"
