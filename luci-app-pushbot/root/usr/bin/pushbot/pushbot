# 检测 cpu 状态
function cpu_load(){
	if [ ! -z "$temperature_enable" ] && [ "$temperature_enable" -eq "1" ] && [ ! -z "$temperature" ]; then
		[ -z "$temperature_time" ] && temperature_time=`date +%s`
		local cpu_wendu=`soc_temp`;
		[ -z "$cpu_wendu" ] && echo "`date "+%Y-%m-%d %H:%M:%S"`  【！！！】无法读取设备温度，请检查命令" >> ${logfile}

		if [ `expr $cpu_wendu \> $temperature` -eq "1" ]; then
			echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！警报！！】 CPU 温度过高: ${cpu_wendu}" >> ${logfile}
		else
			temperature_time=`date +%s`
		fi

		if [ "$((`date +%s`-$temperature_time))" -ge "300" ] && [ -z "$temperaturecd_time" ]; then
			title="CPU 温度过高！"
			temperaturecd_time=`date +%s`
			echo "`date "+%Y-%m-%d %H:%M:%S"` ${disturb_text} CPU 温度过高: ${cpu_wendu}" >> ${logfile}
			if [ "$table_enable" = "1" ]; then
				content="${content}${str_splitline}${str_title_start}${font_fail} CPU 温度过高${font_end}${str_title_end}$(table_body "当前温度" "${cpu_wendu}℃" "状态" "已连续五分钟超过预设" "提示" "接下来一小时不再提示")"
			else
				content="${content}${str_splitline}${str_title_start}${font_fail} CPU 温度过高${font_end}${str_title_end}${str_linefeed}${str_tab}CPU 温度已连续五分钟超过预设${str_linefeed}${str_tab}接下来一小时不再提示${str_linefeed}${str_tab}当前温度：${cpu_wendu}℃"
			fi
		elif [ ! -z "$temperaturecd_time" ] && [ "$((`date +%s`-$temperaturecd_time))" -ge "3300" ] ;then
			unset temperaturecd_time
		fi
	fi

	if [ ! -z "$cpuload_enable" ] && [ "$cpuload_enable" -eq "1" ] && [ ! -z "$cpuload" ]; then
		[ -z "$cpuload_time" ] && cpuload_time=`date +%s`
		local cpu_fuzai=`cat /proc/loadavg|awk '{print $1}'` 2>/dev/null
		[ -z "$cpu_fuzai" ] && echo "`date "+%Y-%m-%d %H:%M:%S"`  【！！！】无法读取设备负载，请检查命令" >> ${logfile}

		if [ `expr $cpu_fuzai \> $cpuload` -eq "1" ]; then
			echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！警报！！】 CPU 负载过高: ${cpu_fuzai}" >> ${logfile}
			cputop log
		else
			cpuload_time=`date +%s`
		fi

		if [ "$((`date +%s`-$cpuload_time))" -ge "300" ] && [ -z "$cpucd_time" ]; then
			unset getlogtop
			if [ ! -z "$title" ] && ( echo "$title"|grep -q "过高" ); then
				title="设备报警！"
			else
				title="CPU 负载过高！"
			fi
			cpucd_time=`date +%s`
			echo "`date "+%Y-%m-%d %H:%M:%S"` ${disturb_text} CPU 负 载过高: ${cpu_fuzai}" >> ${logfile}
			if [ "$table_enable" = "1" ]; then
				content="${content}${str_splitline}${font_fail}CPU 负载过高${font_end}$(table_body "当前负载" "${cpu_fuzai}" "状态" "已连续五分钟超过预设" "提示" "接下来一小时不再提示")"
			else
				content="${content}${str_splitline}${font_fail}CPU 负载过高${font_end}${str_linefeed}${str_tab}CPU 负载已连续五分钟超过预设${str_linefeed}${str_tab}接下来一小时不再提示${str_linefeed}${str_tab}当前负载：${cpu_fuzai}"
			fi
			cputop
		elif [ ! -z "$cpucd_time" ] && [ "$((`date +%s`-$cpucd_time))" -ge "3300" ] ;then
			unset cpucd_time
		fi
	fi
}

function cputop(){
	[ -z "$1" ] && content="${content}${str_splitline}${str_title_start} 当前 CPU 占用前三的进程${str_title_end}"
	local gettop=`top -bn 1|grep -v "top -bn 1"`
	for i in `seq 5 7`; do
		local top_name=`echo "${gettop}"|awk 'NR=='${i}|awk '{print ($8 ~ /\/bin\/sh|\/bin\/bash/) ? $9 : $8}'`
		local top_load=`echo "${gettop}"|awk 'NR=='${i}|awk '{print $7}'`
		local temp_top="${top_name} ${top_load}"
		[ ! -z "$1" ] && local logtop="$logtop  $temp_top"
		[ -z "$1" ] && content="${content}${str_linefeed}${str_tab}${temp_top}"
	done
	unset i
	[ ! -z "$1" ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！警报！！】 CPU 占用前三: ${logtop}" >> ${logfile}
}

# 生成日志监控文件，避免后台影响 wait 语句
function get_syslog(){
	kill -9 `pgrep -f "logread -f -p notice"` 2>/dev/null
	[ -z "$web_logged" ] && [ -z "$ssh_logged" ] && [ -z "$web_login_failed" ] && [ -z "$ssh_login_failed" ] && [ -z "$wifi_connected" ] && [ -z "$wifi_auth_failed" ] && return
	rm -f ${dir}login_monitor >/dev/null 2>&1

cat>${dir}get_syslog<<EOF
#!/bin/sh
logread -f -p notice >> ${dir}login_monitor &
EOF
	chmod 0755 ${dir}get_syslog && ${dir}get_syslog
	rm -f ${dir}get_syslog >/dev/null 2>&1

}

# 登录提醒通知
function login_send(){
	[ -z "$web_logged" ] && [ -z "$ssh_logged" ] && [ -z "$web_login_failed" ] && [ -z "$ssh_login_failed" ] && [ -z "$wifi_connected" ] && [ -z "$wifi_auth_failed" ] && return
	[ ! -f ${dir}login_monitor ] && [ ! -f ${dir}wifi_check ] && [ -z "$wifi_connected" ] && [ -z "$wifi_auth_failed" ] && return
	cat ${dir}login_monitor|grep -i "accepted login"|awk '{print $4" "$NF}' >> ${dir}web_login
	cat ${dir}login_monitor|grep -i "Password auth succeeded\|Pubkey auth succeeded"|grep -Eo "[0-9]{2}:[0-9]{2}:[0-9]{2}.*[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}"|awk '{print $1" "$NF" "$5}' >> ${dir}ssh_login
	cat ${dir}login_monitor|grep -i "failed login"|grep -Eo "[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}" >> ${dir}web_failed
	cat ${dir}login_monitor|grep -i "Bad password attempt\|Login attempt for nonexistent user from"|grep -Eo "[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}" >> ${dir}ssh_failed
	echo "" > ${dir}login_monitor
	# 无参对账由主循环统一执行，带参封禁仍在登录失败分支即时处理。
	
	local login_ip_list=`cat ${dir}web_login|awk '{print $2}'|grep -v "^$"|sort -u|head -n1`
	for login_ip in $login_ip_list; do
		[ -z "$login_ip" ] && continue
		ip_in_whitelist "$login_ip" && continue
		local web_login_time=`cat ${dir}web_login|grep -w ${login_ip}|awk '{print $1}'|grep -v "^$"|sort -u|head -n1`
		local web_login_mode=`cat ${dir}web_login|grep -w ${login_ip}|awk '{print $3}'|grep -v "^$"|sort -u|head -n1`
		if [ ! -z "$web_logged" ] && [ "$web_logged" -eq "1" ]; then
			# 低频通知检查（模式3）：同一来源Web登录，在时间窗口内只通知一次
			if ! check_dnd_limit "web_login" "$login_ip" "$dnd_low_range"; then
				echo "`date "+%Y-%m-%d %H:%M:%S"` ${disturb_text}设备 ${login_ip} 通过 Web 登录（低频跳过）" >> ${logfile}
				continue
			fi
			if [ "$table_enable" = "1" ]; then
				local info="$(table_body "时间" "${web_login_time}" "设备 IP" "${login_ip}" "登录方式" "${web_login_mode}")"
				if [ -z "$title" ]; then
					title="${login_ip} 通过 Web 登录了路由器"
					content="${content}${str_splitline}${str_title_start}${font_success} 登录信息${font_end}${str_title_end}${info}"
				elif ( echo "$title"|grep -q "登录了路由器" ); then
					title="${login_ip} ${title}"
					content="${content}${str_splitline}${info}"
				else
					title="设备状态变化"
					content="${content}${str_splitline}${str_title_start}${font_success} 登录成功来源${font_end}${str_title_end}${info}"
				fi
			else
				if [ -z "$title" ]; then
					title="${login_ip} 通过 Web 登录了路由器"
					content="${content}${str_splitline}${str_title_start}${font_success} 登录信息${font_end}${str_title_end}${str_linefeed}${str_tab}时间：${str_space}${str_space}${str_space}${str_space}${str_space}${web_login_time}${str_linefeed}${str_tab}设备 IP： ${str_space}${str_space}${str_space}${str_space}${login_ip}${content_mode}"
				elif ( echo "$title"|grep -q "登录了路由器" ); then
					title="${login_ip} ${title}"
					content="${content}${str_splitline}${str_tab}时间：${str_space}${str_space}${str_space}${str_space}${str_space}${web_login_time}${str_linefeed}${str_tab}设备 IP： ${str_space}${str_space}${str_space}${str_space}${login_ip}${content_mode}"
				else
					title="设备状态变化"
					content="${content}${str_splitline}${str_title_start}${font_success} 登录成功来源${font_end}${str_title_end}${str_linefeed}${str_tab}时间：${str_space}${str_space}${str_space}${str_space}${str_space}${web_login_time}${str_linefeed}${str_tab}设备 IP： ${str_space}${str_space}${str_space}${str_space}${login_ip}${content_mode}"
				fi
			fi
		fi
		echo "`date "+%Y-%m-%d %H:%M:%S"` ${disturb_text}设备 ${login_ip} 通过 web ${web_login_mode} 登录了路由器 " >> ${logfile}
	done
	echo "" > ${dir}web_login
	unset login_ip login_ip_list

	local login_ip_list=`cat ${dir}ssh_login|awk '{print $2}'|grep -v "^$"|sort -u|head -n1`
	for login_ip in $login_ip_list; do
		[ -z "$login_ip" ] && continue
		ip_in_whitelist "$login_ip" && continue
		local ssh_login_time=`cat ${dir}ssh_login|grep -w ${login_ip}|awk '{print $1}'|grep -v "^$"|sort -u|head -n1`
		local ssh_login_mode=`cat ${dir}ssh_login|grep -w ${login_ip}|awk '{print $3}'|grep -v "^$"|sort -u|head -n1`
		[ ! -z "$ssh_login_mode" ] && local content_mode="${str_linefeed}${str_tab}登录方式： ${str_space}${str_space}${str_space}${str_space}${ssh_login_mode}"
		if [ ! -z "$ssh_logged" ] && [ "$ssh_logged" -eq "1" ]; then
			# 低频通知检查（模式3）：同一来源SSH登录，在时间窗口内只通知一次
			if ! check_dnd_limit "ssh_login" "$login_ip" "$dnd_low_range"; then
				echo "`date "+%Y-%m-%d %H:%M:%S"` ${disturb_text}设备 ${login_ip} 通过 SSH 登录（低频跳过）" >> ${logfile}
				continue
			fi
			if [ "$table_enable" = "1" ]; then
				local info="$(table_body "时间" "${ssh_login_time}" "设备 IP" "${login_ip}" "登录方式" "${ssh_login_mode}")"
				if [ -z "$title" ]; then
					title="${login_ip} 通过 SSH 登录了路由器"
					content="${content}${str_splitline}${str_title_start}${font_success} 登录成功来源${font_end}${str_title_end}${info}"
				elif ( echo "$title"|grep -q "登录了路由器" ); then
					title="${login_ip} ${title}"
					content="${content}${str_splitline}${info}"
				else
					title="设备状态变化"
					content="${content}${str_splitline}${str_title_start}${font_success} 登录成功来源${font_end}${str_title_end}${info}"
				fi
			else
				if [ -z "$title" ]; then
					title="${login_ip} 通过 SSH 登录了路由器"
					content="${content}${str_splitline}${str_title_start}${font_success} 登录成功来源${font_end}${str_title_end}${str_linefeed}${str_tab}时间：${str_space}${str_space}${str_space}${str_space}${str_space}${ssh_login_time}${str_linefeed}${str_tab}设备 IP： ${str_space}${str_space}${str_space}${str_space}${login_ip}${content_mode}"
				elif ( echo "$title"|grep -q "登录了路由器" ); then
					title="${login_ip} ${title}"
					content="${content}${str_splitline}${str_tab}时间：${str_space}${str_space}${str_space}${str_space}${str_space}${ssh_login_time}${str_linefeed}${str_tab}设备 IP： ${str_space}${str_space}${str_space}${str_space}${login_ip}${content_mode}"
				else
					title="设备状态变化"
					content="${content}${str_splitline}${str_title_start}${font_success} 登录成功来源${str_title_end}${str_linefeed}${str_tab}时间：${str_space}${str_space}${str_space}${str_space}${str_space}${ssh_login_time}${str_linefeed}${str_tab}设备 IP： ${str_space}${str_space}${str_space}${str_space}${login_ip}${content_mode}"
				fi
			fi
		fi
		echo "`date "+%Y-%m-%d %H:%M:%S"` 【info】设备 ${login_ip} 通过 SSH ${ssh_login_mode} 登录了路由器 " >> ${logfile}
	done
	echo "" > ${dir}ssh_login
	unset login_ip login_ip_list

	local login_ip_list=`cat ${dir}web_failed|awk '{print $1}'|grep -v "^$"|sort -u|head -n1`
	for login_ip in $login_ip_list; do
		[ -z "$login_ip" ] && continue
			# 本机地址硬保护：本机探测/回环即使失败也不拉黑，清除记录避免阻塞队列
		is_local_address "$login_ip" && { sed -i "/^${login_ip}$/d" ${dir}web_failed 2>/dev/null; continue; }
		ip_in_whitelist "$login_ip" && { sed -i "/^${login_ip}$/d" ${dir}web_failed 2>/dev/null; continue; }
		local web_login_sum=`cat ${dir}web_failed|grep -w "${login_ip}"|wc -l`
		if [ -z "$login_max_num" ]; then
			local login_max_num=5   # 未配置时默认 5 次失败触发拉黑，避免空值比较异常
		fi
		if [ "$web_login_sum" -ge "$login_max_num" ] ;then
			if [ ! -z "$web_login_failed" ] && [ "$web_login_failed" -eq "1" ]; then
				if [ "$table_enable" = "1" ]; then
					local info="$(table_body "设备 IP" "${login_ip}")"
					if [ -z "$title" ]; then
						title="${login_ip} 通过 Web 频繁尝试登录"
						content="${content}${str_splitline}${str_title_start}${font_fail} 登录失败来源${font_end}${str_title_end}${info}"
					elif ( echo "$title"|grep -q "频繁尝试登录" ); then
						title="${login_ip} ${title}"
						content="${content}${str_splitline}${info}"
					else
						title="设备状态变化"
						content="${content}${str_splitline}${str_title_start}${font_fail} 登录失败来源${font_end}${str_title_end}${info}"
					fi
				else
					if [ -z "$title" ]; then
						title="${login_ip} 通过 Web 频繁尝试登录"
						content="${content}${str_splitline}${str_title_start}${font_fail} 登录失败来源${font_end}${str_title_end}${str_linefeed}${str_tab}设备 IP： ${str_space}${str_space}${str_space}${str_space}${login_ip}"
					elif ( echo "$title"|grep -q "频繁尝试登录" ); then
						title="${login_ip} ${title}"
						content="${content}${str_splitline}${str_tab}设备 IP： ${str_space}${str_space}${str_space}${str_space}${login_ip}"
					else
						title="设备状态变化"
						content="${content}${str_splitline}${str_title_start}${font_fail} 登录失败来源${font_end}${str_title_end}${str_linefeed}${str_tab}设备 IP： ${str_space}${str_space}${str_space}${str_space}${login_ip}"
					fi
				fi
			fi
			# 只有拉黑功能启用时才执行拉黑操作
			if [ "$web_login_black" = "1" ]; then
				# 先尝试拉黑（add_ip_black 内部会做本机/白名单保护），
				# 成功(未被拦截)才清除失败记录；被拦截则保留记录供后续重试。
				if add_ip_black $login_ip; then
					sed -i "/^${login_ip}$/d" ${dir}web_failed
					echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】设备 ${login_ip} 通过 Web 频繁尝试登录" >> ${logfile}
				else
					echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】设备 ${login_ip} 触发拉黑但未成功，保留记录待后续确认" >> ${logfile}
				fi
			fi
		fi
	done
	unset login_ip

	local login_ip_list=`cat ${dir}ssh_failed|awk '{print $1}'|grep -v "^$"|sort -u|head -n1`
	for login_ip in $login_ip_list; do
		[ -z "$login_ip" ] && continue
		# 本机地址硬保护：本机探测/回环即使失败也不拉黑，清除记录避免阻塞队列
		is_local_address "$login_ip" && { sed -i "/^${login_ip}$/d" ${dir}ssh_failed 2>/dev/null; continue; }
		ip_in_whitelist "$login_ip" && { sed -i "/^${login_ip}$/d" ${dir}ssh_failed 2>/dev/null; continue; }
		local ssh_login_sum=`cat ${dir}ssh_failed|grep -w "${login_ip}"|wc -l`
		if [ -z "$login_max_num" ]; then
			local login_max_num=5   # 未配置时默认 5 次失败触发拉黑，避免空值比较异常
		fi
		if [ "$ssh_login_sum" -ge "$login_max_num" ] ;then
			if [ ! -z "$ssh_login_failed" ] && [ "$ssh_login_failed" -eq "1" ]; then
				if [ "$table_enable" = "1" ]; then
					local info="$(table_body "设备 IP" "${login_ip}")"
					if [ -z "$title" ]; then
						title="${login_ip} 通过 SSH 频繁尝试登录"
						content="${content}${str_splitline}${str_title_start}${font_fail} 登录失败来源${font_end}${str_title_end}${info}"
					elif ( echo "$title"|grep -q "频繁尝试登录" ); then
						title="${login_ip} ${title}"
						content="${content}${str_splitline}${info}"
					else
						title="设备状态变化"
						content="${content}${str_splitline}${str_title_start}${font_fail} 登录失败来源${font_end}${str_title_end}${info}"
					fi
				else
					if [ -z "$title" ]; then
						title="${login_ip} 通过 SSH 频繁尝试登录"
						content="${content}${str_splitline}${str_title_start}${font_fail} 登录失败来源${font_end}${str_title_end}${str_linefeed}${str_tab}设备 IP： ${str_space}${str_space}${str_space}${str_space}${login_ip}"
					elif ( echo "$title"|grep -q "频繁尝试登录" ); then
						title="${login_ip} ${title}"
						content="${content}${str_splitline}${str_tab}设备 IP： ${str_space}${str_space}${str_space}${str_space}${login_ip}"
					else
						title="设备状态变化"
						content="${content}${str_splitline}${str_title_start}${font_fail} 登录失败来源${font_end}${str_title_end}${str_linefeed}${str_tab}设备 IP： ${str_space}${str_space}${str_space}${str_space}${login_ip}"
					fi
				fi
			fi
			# 只有拉黑功能启用时才执行拉黑操作
			if [ "$web_login_black" = "1" ]; then
				# 先尝试拉黑，成功(未被保护拦截)才清除失败记录
				if add_ip_black $login_ip; then
					sed -i "/^${login_ip}$/d" ${dir}ssh_failed
					echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】设备 ${login_ip} 通过 SSH 频繁尝试登录" >> ${logfile}
				else
					echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】设备 ${login_ip} 触发拉黑但被本机/白名单保护拦截，保留记录待后续确认" >> ${logfile}
				fi
			fi
		fi
	done
	unset login_ip

	# ── WiFi 连接/认证失败检测 ──
	# MT798x 等内核级 WiFi 日志不被 logread -f 捕获，改用 logread 读取最近日志
	if [ "$wifi_connected" = "1" ] || [ "$wifi_auth_failed" = "1" ]; then
		if [ ! -z "$wlan_interface" ]; then
			# 获取当前在线 WiFi 设备 MAC 列表（iwinfo 兼容 MTK 闭源和标准开源驱动）
			# 两套驱动统一精准判断：
			#   开源 mac80211：iw station get → authorized=yes（WPA 握手完成）
			#   MTK 闭源：dmesg SETKEYS DONE（内核级 WPA 握手完成标记）
			local wifi_cur_macs=""
			local wifi_cur_ssids=""
			# 闭源驱动：一次性读取 dmesg SETKEYS DONE 的 MAC 列表（0.02s）
			local _setkeys_macs=""
			if ! iw dev >/dev/null 2>&1; then
				_setkeys_macs=$(dmesg 2>/dev/null | grep "SETKEYS DONE" | grep -ioE "from [0-9a-f:]+" | sed 's/from //i' | tr 'A-Z' 'a-z')
			fi
			for _wif in $wlan_interface; do
				local _assoc=$(iwinfo ${_wif} assoclist 2>/dev/null)
				[ ! -z "$_assoc" ] && [ "$_assoc" != "No station connected" ] && {
					local _macs=$(echo "$_assoc" | grep -ioE "([0-9a-f]{2}:){5}[0-9a-f]{2}" | tr 'A-Z' 'a-z')
					local _ssid=$(iwinfo ${_wif} info 2>/dev/null | sed -n 's/.*ESSID: *"//;s/"$//p')
					for _m in $_macs; do
						local _authorized=""
						# 开源 mac80211：用 iw 检查 authorized
						_authorized=$(iw dev ${_wif} station get $_m 2>/dev/null | grep "authorized:" | awk '{print $2}')
						# MTK 闭源：iw 不可用 → _authorized 为空 → 改用 dmesg SETKEYS DONE
						if [ -z "$_authorized" ] && [ ! -z "$_setkeys_macs" ]; then
							echo "$_setkeys_macs" | grep -q -i -w "$_m" && _authorized="yes"
						fi
						if [ "$_authorized" = "yes" ]; then
							wifi_cur_macs="${wifi_cur_macs} ${_m}"
							wifi_cur_ssids="${wifi_cur_ssids} ${_ssid}"
						fi
					done
				}
			done

			# 读取上次在线列表
			local wifi_prev_macs=""
			[ -f "${dir}wifi_cur" ] && wifi_prev_macs=$(cat ${dir}wifi_cur 2>/dev/null)
			# 保存当前列表
			echo "$wifi_cur_macs" > ${dir}wifi_cur

			# WiFi 连接通知：当前有、上次没有 = 新连接
			# 两套驱动已在采集阶段统一过滤，进到这里的都是 authorized=yes 的真连接
			if [ "$wifi_connected" = "1" ]; then
				local _new_macs="" _new_ssids="" _new_count=0 _idx=0
				for wifi_mac in $wifi_cur_macs; do
					[ -z "$wifi_mac" ] && continue
					[ -f "${dir}wifi_notified" ] && grep -q -i -w "${wifi_mac}" ${dir}wifi_notified 2>/dev/null && continue
					echo "$wifi_prev_macs" | grep -q -i -w "${wifi_mac}" && continue
					# 低频通知检查（模式3）：同一设备WiFi连接通知，在时间窗口内只通知一次
					if ! check_dnd_limit "wifi_conn" "$wifi_mac" "$dnd_low_range"; then
						echo "`date "+%Y-%m-%d %H:%M:%S"` ${disturb_text}WiFi 设备 ${wifi_mac} 已连接（低频跳过）" >> ${logfile}
						echo "$wifi_mac" >> ${dir}wifi_notified
						continue
					fi
					echo "$wifi_mac" >> ${dir}wifi_notified
					_new_count=$((_new_count + 1))
					local _ssid=$(echo "$wifi_cur_ssids" | awk -v n=$((_idx+1)) '{print $n}')
					[ -z "$_ssid" ] && _ssid="unknown"
					_new_macs="${_new_macs} ${wifi_mac}"
					_new_ssids="${_new_ssids} ${_ssid}"
				_idx=$((_idx + 1))
				done
				if [ "$_new_count" -gt "0" ]; then
					# 构造 MAC 显示文本（优先显示主机名，无匹配则回落 MAC）
					local _mac_text=""
					if [ "$_new_count" -eq 1 ]; then
						local _dev_mac=$(echo "$_new_macs" | awk '{print $1}')
						local _dev_name=$(getname "" "${_dev_mac}")
						{ [ -z "$_dev_name" ] || [ "$_dev_name" = "unknown" ]; } && _mac_text="${_dev_mac}" || _mac_text="${_dev_name}"
					elif [ "$_new_count" -le 3 ]; then
						local _parts=""
						for _m in $_new_macs; do
							local _n=$(getname "" "${_m}")
							{ [ -z "$_n" ] || [ "$_n" = "unknown" ]; } && _n="${_m}"
							_parts="${_parts}${_parts:+, }${_n}"
						done
						_mac_text="${_parts}"
					else
						_mac_text="多个"
					fi
					# 取第一个 SSID
					local _ssid_text=$(echo "$_new_ssids" | awk '{print $1}')
					[ -z "$_ssid_text" ] && _ssid_text="unknown"
					local wifi_time=$(date "+%Y-%m-%d %H:%M:%S")
					echo "`date "+%Y-%m-%d %H:%M:%S"` WiFi 设备 ${_mac_text} 已连接" >> ${logfile}
					if [ "$table_enable" = "1" ]; then
						local wifi_detail_rows=""
						local _didx=0
						for _dm in $_new_macs; do
							local _dn=$(echo "$_new_ssids" | awk -v n=$((_didx+1)) '{print $n}')
							local _dname=$(getname "" "${_dm}")
							[ "$_dname" = "unknown" ] && _dname="${_dm}"
							wifi_detail_rows="${wifi_detail_rows}$(table_rows "${_dname}" "${_dn}")"
							_didx=$((_didx + 1))
						done
						local wifi_info="$(table_header "设备" "**SSID**")${wifi_detail_rows}"
						if [ -z "$title" ]; then
							title="${_mac_text} WiFi 设备已连接"
						fi
						content="${content}${str_splitline}${str_title_start}${font_success} WiFi 连接${font_end}${str_title_end}${wifi_info}"
					else
						if [ -z "$title" ]; then
							title="${_mac_text} WiFi 设备已连接"
						fi
						content="${content}${str_splitline}${str_title_start}${font_success} WiFi 连接${font_end}${str_title_end}${str_linefeed}${str_tab}时间：${str_space}${wifi_time}"
						local _didx_t=0
						for _dm_t in $_new_macs; do
							local _dn_t=$(echo "$_new_ssids" | awk -v n=$((_didx_t+1)) '{print $n}')
							local _dname_t=$(getname "" "${_dm_t}")
							{ [ -z "$_dname_t" ] || [ "$_dname_t" = "unknown" ]; } && _dname_t="${_dm_t}"
							content="${content}${str_linefeed}${str_tab}${_dname_t}（${_dn_t}）"
							_didx_t=$((_didx_t + 1))
						done
					fi
				fi
			fi

			# WiFi 离线通知：上次有、当前没有 + 离线时长 > sleeptime*2
			if [ "$wifi_connected" = "1" ]; then
				local _now=$(date +%s)
				for wifi_mac in $wifi_prev_macs; do
					[ -z "$wifi_mac" ] && continue
					echo "$wifi_cur_macs" | grep -q -i -w "${wifi_mac}" && continue
					# 已离线通知过的 MAC 不重复
					[ -f "${dir}wifi_offline_notified" ] && grep -q -i -w "${wifi_mac}" ${dir}wifi_offline_notified 2>/dev/null && continue
					# 记录首次发现离线时间
					local _offline_file="${dir}wifi_offline_${wifi_mac}"
					if [ -f "$_offline_file" ]; then
						local _first_seen=$(cat "$_offline_file" 2>/dev/null)
						local _duration=$((_now - _first_seen))
						if [ "$_duration" -ge "$((sleeptime * 2))" ]; then
							echo "$wifi_mac" >> ${dir}wifi_offline_notified
							rm -f "$_offline_file"
							# 离线后清除连接通知记录，设备重新连接时可再次通知
							sed -i "/${wifi_mac}/Id" ${dir}wifi_notified 2>/dev/null
							# 低频通知检查（模式3）：同一设备WiFi离线通知，在时间窗口内只通知一次
							if ! check_dnd_limit "wifi_disc" "$wifi_mac" "$dnd_low_range"; then
								echo "`date "+%Y-%m-%d %H:%M:%S"` ${disturb_text}WiFi 设备 ${wifi_mac} 已离线（低频跳过）" >> ${logfile}
								continue
							fi
							echo "`date "+%Y-%m-%d %H:%M:%S"` WiFi 设备 ${wifi_mac} 已离线" >> ${logfile}
							local wifi_time=$(date "+%Y-%m-%d %H:%M:%S")
							local wifi_offline_dur=$(time_for_humans $_duration)
							if [ "$table_enable" = "1" ]; then
								local wifi_info="$(table_body "时间" "${wifi_time}" "MAC" "${wifi_mac}" "离线时长" "${wifi_offline_dur}")"
								if [ -z "$title" ]; then
									title="WiFi 设备已离线"
									content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 离线${font_end}${str_title_end}${wifi_info}"
								elif ( echo "$title"|grep -q "WiFi" ); then
									title="${wifi_mac} ${title}"
									content="${content}${str_splitline}${wifi_info}"
								else
									title="设备状态变化"
									content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 离线${font_end}${str_title_end}${wifi_info}"
								fi
							else
								if [ -z "$title" ]; then
									title="WiFi 设备已离线"
									content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 离线${font_end}${str_title_end}${str_linefeed}${str_tab}时间：${str_space}${wifi_time}${str_linefeed}${str_tab}MAC：${str_space}${wifi_mac}${str_linefeed}${str_tab}离线时长：${str_space}${wifi_offline_dur}"
								elif ( echo "$title"|grep -q "WiFi" ); then
									title="${wifi_mac} ${title}"
									content="${content}${str_splitline}${str_linefeed}${str_tab}时间：${str_space}${wifi_time}${str_linefeed}${str_tab}MAC：${str_space}${wifi_mac}${str_linefeed}${str_tab}离线时长：${str_space}${wifi_offline_dur}"
								else
									title="设备状态变化"
									content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 离线${font_end}${str_title_end}${str_linefeed}${str_tab}时间：${str_space}${wifi_time}${str_linefeed}${str_tab}MAC：${str_space}${wifi_mac}${str_linefeed}${str_tab}离线时长：${str_space}${wifi_offline_dur}"
								fi
							fi
						fi
					else
						echo "$_now" > "$_offline_file"
					fi
				done
			fi
		fi
	fi

	# WiFi 认证失败检测
	# MTK 闭源驱动（mt_wifi 模块）：内核时间戳增量 + 按 MAC 分组（只统计新事件，按设备分组，不重复累计）
	# 开源驱动（hostapd/wpa_supplicant）：原有增量计数方案（保持不变）
	if [ "$wifi_auth_failed" = "1" ]; then
		if lsmod 2>/dev/null | grep -q "^mt_wifi"; then
			# ── MTK 闭源驱动：内核时间戳增量 + 按 MAC 分组 ──
			# 失败事件格式：[6513950.363098] ... Rcv AUTH seq#1, Alg=3, Status=126 from [wcid=1023]86:1f:35:0c:19:bb
			# 提取 (内核时间 MAC) 对，用内核时间戳过滤"上次报告时间"之后的新事件，
			# 避免重复累计报告；成功事件（SETKEYS DONE / Status=0）不在统计范围
			local _fail_events=$(logread 2>/dev/null | tail -1000 | grep "Rcv AUTH seq#1, Alg=3, Status=126" | sed -n 's/.*\[\([0-9.]*\)\].*from \[wcid=[0-9]*\]\([0-9a-fA-F:]*\).*/\1 \2/p')
			local _last_time=0
			[ -f "${dir}wifi_fail_last_time" ] && _last_time=$(cat ${dir}wifi_fail_last_time 2>/dev/null)
			[ -z "$_last_time" ] && _last_time=0
			local _new_events=$(echo "$_fail_events" | awk -v t="$_last_time" '$1+0 > t+0')
			local _new_count=0
			[ ! -z "$_new_events" ] && _new_count=$(echo "$_new_events" | wc -l)
			local _threshold=${login_max_num:-5}
			if [ "$_new_count" -ge "$_threshold" ]; then
				# 按 MAC 分组统计：每行 "MAC 次数"（不去重——多频段/多接口的真实失败都应计入，攻击提醒需反映真实强度）
				local _mac_stats=$(echo "$_new_events" | awk '{count[$2]++} END {for (mac in count) print mac, count[mac]}' | sort)
				# 更新状态文件为最新事件时间（避免下次重复报告本批事件）
				local _max_time=$(echo "$_fail_events" | awk '{print $1}' | sort -n | tail -1)
				[ ! -z "$_max_time" ] && echo "$_max_time" > ${dir}wifi_fail_last_time
				# 日志中补充 MAC 分组信息
				local _mac_summary=$(echo "$_mac_stats" | awk '{printf "%s: %d次, ", $1, $2}' | sed 's/, $//')
				echo "`date "+%Y-%m-%d %H:%M:%S"` ${disturb_text}WiFi 认证失败 ${_new_count} 次（${_mac_summary}）" >> ${logfile}
				if [ "$table_enable" = "1" ]; then
					local _mac_rows=""
					local _mm _mc
					while read -r _mm _mc; do
						[ -z "$_mm" ] && continue
						_mac_rows="${_mac_rows}$(table_rows "${_mm}" "${_mc} 次")"
					done <<MACROWS
$_mac_stats
MACROWS
					local _wifi_fail_info="$(table_header "失败MAC" "**次数**")${_mac_rows}"
					if [ -z "$title" ]; then
						title="WiFi 认证失败警告"
						content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 认证失败${font_end}${str_title_end}${_wifi_fail_info}"
					elif ( echo "$title"|grep -q "WiFi" ); then
						content="${content}${str_splitline}${_wifi_fail_info}"
					else
						title="设备状态变化"
						content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 认证失败${font_end}${str_title_end}${_wifi_fail_info}"
					fi
				else
					local _mac_detail=$(echo "$_mac_stats" | awk -v lf="${str_linefeed}" -v tab="${str_tab}" 'NR>1{printf "%s", lf} {printf "%s%s：%s 次", tab, $1, $2}')
					local _wifi_fail_detail="失败 MAC：${str_linefeed}${_mac_detail}"
					if [ -z "$title" ]; then
						title="WiFi 认证失败警告"
						content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 认证失败${font_end}${str_title_end}${str_linefeed}${_wifi_fail_detail}"
					elif ( echo "$title"|grep -q "WiFi" ); then
						content="${content}${str_splitline}${str_linefeed}${_wifi_fail_detail}"
					else
						title="设备状态变化"
						content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 认证失败${font_end}${str_title_end}${str_linefeed}${_wifi_fail_detail}"
					fi
				fi
			fi
		else
			# ── 开源驱动：原有增量计数逻辑 ──
			local _wifi_cur_log=$(logread 2>/dev/null | tail -200)
			local _wifi_cur_count=$(echo "$_wifi_cur_log" | grep -i "PSK-MISMATCH\|deauthenticated due to local auth failure\|verify confirm fail\|EAPOL-Key MIC invalid" | wc -l)
			local _wifi_prev_count=0
			[ -f "${dir}wifi_fail_count" ] && _wifi_prev_count=$(cat ${dir}wifi_fail_count 2>/dev/null)
			echo "$_wifi_cur_count" > ${dir}wifi_fail_count
			local _new_fails=$((_wifi_cur_count - _wifi_prev_count))
			[ "$_new_fails" -lt "0" ] && _new_fails=0
			local _threshold=${login_max_num:-5}
			if [ "$_wifi_cur_count" -ge "$_threshold" ] && { [ "$_wifi_prev_count" -lt "$_threshold" ] || [ "$_new_fails" -gt "0" ]; }; then
				# 提取失败 MAC（开源驱动优先从 logread 提取，MTK 闭源驱动从 dmesg 提取）
				local _wifi_fail_mac=""
				# 开源驱动：从 logread 提取（格式包含 MAC）
				_wifi_fail_mac=$(echo "$_wifi_cur_log" | grep -i "PSK-MISMATCH\|deauthenticated due to local auth failure\|verify confirm fail\|EAPOL-Key MIC invalid" | grep -ioE "([0-9a-f]{2}:){5}[0-9a-f]{2}" | tail -1)
				# MTK 闭源驱动：从 logread 提取所有不同的认证失败 MAC（Alg=3, Status=126）
				if [ -z "$_wifi_fail_mac" ]; then
					_wifi_fail_mac=$(logread 2>/dev/null | tail -500 | grep "Rcv AUTH seq#1, Alg=3, Status=126" | grep -ioE "([0-9a-f]{2}:){5}[0-9a-f]{2}" | sort -u | tr '\n' ',' | sed 's/,$//')
				fi
				echo "`date "+%Y-%m-%d %H:%M:%S"` ${disturb_text}WiFi 认证失败 ${_wifi_cur_count} 次${_wifi_fail_mac:+（MAC: ${_wifi_fail_mac}）}" >> ${logfile}
				if [ "$table_enable" = "1" ]; then
					local _wifi_fail_info="$(table_body "失败次数" "${_wifi_cur_count}")"
					[ ! -z "$_wifi_fail_mac" ] && _wifi_fail_info="${_wifi_fail_info}$(table_rows "MAC" "${_wifi_fail_mac}")"
					if [ -z "$title" ]; then
						title="WiFi 认证失败警告"
						content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 认证失败${font_end}${str_title_end}${_wifi_fail_info}"
					elif ( echo "$title"|grep -q "WiFi" ); then
						content="${content}${str_splitline}${_wifi_fail_info}"
					else
						title="设备状态变化"
						content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 认证失败${font_end}${str_title_end}${_wifi_fail_info}"
					fi
				else
					local _wifi_fail_detail="失败次数：${_wifi_cur_count}"
					[ ! -z "$_wifi_fail_mac" ] && _wifi_fail_detail="MAC：${_wifi_fail_mac}${str_linefeed}${str_tab}${_wifi_fail_detail}"
					if [ -z "$title" ]; then
						title="WiFi 认证失败警告"
						content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 认证失败${font_end}${str_title_end}${str_linefeed}${str_tab}${_wifi_fail_detail}"
					elif ( echo "$title"|grep -q "WiFi" ); then
						content="${content}${str_splitline}${str_linefeed}${str_tab}${_wifi_fail_detail}"
					else
						title="设备状态变化"
						content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 认证失败${font_end}${str_title_end}${str_linefeed}${str_tab}${_wifi_fail_detail}"
					fi
				fi
		fi
		fi
	fi
}

# 白名单匹配：支持单个 IP 或标准 IP 段（CIDR，如 10.1.1.0/24、2001:db8::/32）
# 命中白名单返回 0，否则返回 1。任何拉黑动作前必须调用此函数。
# 本机地址保护：target 是否为本机任一接口地址或回环地址。
# 与白名单不同 —— 这是硬保护，任何情况下本机地址都禁止进入黑名单
# （误拉黑自己会断掉 Web/SSH 访问）。匹配 local_addrs 精确条目。
function is_local_address(){
	local target=$(printf '%s\n' "$1" | blacklist_members)
	[ -n "$target" ] || return 1
	printf '%s\n' "$local_addrs" | blacklist_members | grep -qxF "$target"
}

function ip_in_whitelist(){
	local target=$(printf '%s\n' "$1" | blacklist_members)
	[ -z "$target" ] && return 1
	[ -z "$ip_white_list" ] && return 1
	local entry
	for entry in $ip_white_list; do
		[ -z "$entry" ] && continue
		# 精确 IP 匹配（v4/v6）
		if echo "$entry" | grep -q "/"; then
			# CIDR 网段匹配
			local net="${entry%/*}" prefix="${entry#*/}"
			echo "$prefix" | grep -qE "^[0-9]{1,3}$" || continue
			if echo "$net" | grep -q ":"; then
				# IPv6 CIDR
				if [ "$prefix" -le 128 ] 2>/dev/null && ipv6_in_network "$target" "$net" "$prefix"; then
					return 0
				fi
			else
				# IPv4 CIDR
				if [ "$prefix" -le 32 ] 2>/dev/null && ipv4_in_network "$target" "$net" "$prefix"; then
					return 0
				fi
			fi
		elif [ "$(printf '%s\n' "$entry" | blacklist_members)" = "$target" ]; then
			# 精确匹配
			return 0
		fi
	done
	return 1
}

# IPv4 CIDR 匹配：target 是否在 net/prefix 内（纯算术，无外部依赖）
function ipv4_in_network(){
	local target="$1" net="$2" prefix="$3"
	# 简单校验 IP 格式（4 段 0-255）
	echo "$target" | grep -qE "^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$" || return 1
	echo "$net" | grep -qE "^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$" || return 1
	local a1 a2 a3 a4 b1 b2 b3 b4 i mask=0
	IFS=. read -r a1 a2 a3 a4 <<EOF
$target
EOF
	IFS=. read -r b1 b2 b3 b4 <<EOF
$net
EOF
	# 拼接 32 位整数（shell 算术，busybox ash 支持）
	local t=$(( (a1<<24) + (a2<<16) + (a3<<8) + a4 ))
	local n=$(( (b1<<24) + (b2<<16) + (b3<<8) + b4 ))
	# 计算掩码
	i=$prefix; mask=0
	while [ "$i" -gt 0 ]; do
		mask=$(( (mask<<1) | 1 ))
		i=$((i-1))
	done
	mask=$(( mask << (32-prefix) ))
	[ $(( t & mask )) -eq $(( n & mask )) ]
}

# IPv6 展开：把压缩形式（含 ::，如 2001:db8::1 / ::1 / 2001:db8::）展开为完整 8 段，
# 输出空格分隔（"2001 db8 0 0 0 0 0 1"）。无 :: 的地址直接转空格分隔（不足 8 段补零兜底）。
# 用 shell 前后分割而非 awk split 空字段，规避 gawk/busybox 对尾随空字段处理的差异。
function expand_v6(){
	local addr="$1" head="" tail="" i
	[ -z "$addr" ] && return 1
	local nhead=0 ntail=0 zeros=0 out=""
	case "$addr" in
		*::*)
			head="${addr%%::*}"
			tail="${addr##*::}"
			[ -n "$head" ] && nhead=$(echo "$head" | awk -F: '{print NF}')
			[ -n "$tail" ] && ntail=$(echo "$tail" | awk -F: '{print NF}')
			zeros=$((8 - nhead - ntail))
			[ "$zeros" -lt 0 ] && zeros=0
			[ -n "$head" ] && out="$(echo "$head" | tr ':' ' ')"
			i=0
			while [ "$i" -lt "$zeros" ]; do out="$out 0"; i=$((i+1)); done
			[ -n "$tail" ] && out="$out $(echo "$tail" | tr ':' ' ')"
			echo "$out" | sed 's/^ *//'
			;;
		*)
			out=$(echo "$addr" | tr ':' ' ')
			zeros=$((8 - $(echo "$out" | wc -w)))
			[ "$zeros" -lt 0 ] && zeros=0
			i=0
			while [ "$i" -lt "$zeros" ]; do out="$out 0"; i=$((i+1)); done
			echo "$out"
			;;
	esac
}

# IPv6 CIDR 匹配：先展开压缩地址为完整 8 段，再逐段（16 位）比较，
# 十六进制转十进制用 printf "%d"（busybox 支持 0x 前缀，不依赖 gawk 的 strtonum）
function ipv6_in_network(){
	local target="$1" net="$2" prefix="$3"
	echo "$target" | grep -qE "^[0-9a-fA-F:]+$" || return 1
	echo "$net" | grep -qE "^[0-9a-fA-F:]+$" || return 1
	[ "$prefix" -le 0 ] && return 0
	[ "$prefix" -gt 128 ] && prefix=128
	local tlist nlist i=0 tg ng t n bits shift
	tlist=$(expand_v6 "$target")
	nlist=$(expand_v6 "$net")
	while [ "$i" -lt 8 ]; do
		tg=$(echo "$tlist" | awk -v i=$((i+1)) '{print $i}' 2>/dev/null)
		ng=$(echo "$nlist" | awk -v i=$((i+1)) '{print $i}' 2>/dev/null)
		t=$(printf "%d" "0x${tg:-0}" 2>/dev/null)
		[ -z "$t" ] && t=0
		n=$(printf "%d" "0x${ng:-0}" 2>/dev/null)
		[ -z "$n" ] && n=0
		bits=$((prefix - i*16))
		if [ "$bits" -ge 16 ]; then
			[ "$t" -ne "$n" ] && return 1
		elif [ "$bits" -gt 0 ]; then
			shift=$((16-bits))
			[ $(( t >> shift )) -ne $(( n >> shift )) ] && return 1
		else
			break
		fi
		i=$((i+1))
	done
	return 0
}

# 拉黑时长解析：纯数字=秒（兼容旧配置）；支持单字符单位后缀
#   h/H 小时  d/D 天  w/W 周  M 月(=30天)  m 分钟  y/Y 年(=365天)
# 例：3600、1h、2D、1W、1M、1Y；0/空 = 永久拉黑。输出统一秒数。
function parse_timeout(){
	local v="$1" num unit mult=1
	[ -z "$v" ] && { echo 0; return; }
	num=$(echo "$v" | grep -oE "^[0-9]+")
	[ -z "$num" ] && { echo 0; return; }
	unit=$(echo "$v" | grep -oE "[a-zA-Z]+$")
	case "$unit" in
		h|H) mult=3600 ;;
		d|D) mult=86400 ;;
		w|W) mult=604800 ;;
		M)   mult=2592000 ;;
		m)   mult=60 ;;
		y|Y) mult=31536000 ;;
		*)   mult=1 ;;
	esac
	echo $((num * mult))
}

# 地址统一排序；IPv6 展开后比较，忽略大小写和前导零。
function blacklist_members(){
	awk '
	function emit(s, a,b,c,n,m,i,j,out) {
		if (s ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {
			n=split(s,a,"."); for(i=1;i<=n;i++) if(a[i]+0>255) return
			printf "%d.%d.%d.%d\n",a[1],a[2],a[3],a[4]; return
		}
		if (s !~ /:/ || s ~ /[^0-9a-fA-F:]/) return
		s=tolower(s); n=split(s,a,"::"); if(n>2) return
		m=split(a[1],b,":"); if(a[1]=="") m=0
		j=n==2?split(a[2],c,":"):0; if(a[2]=="") j=0
		if((n==1 && m!=8) || (n==2 && m+j>=8)) return
		out=""; for(i=1;i<=8;i++) {
			if(i<=m) s=b[i]; else if(i>8-j) s=c[i-(8-j)]; else s="0"
			if(length(s)>4 || s=="") return
			sub(/^0+/,"",s); if(s=="") s="0"
			out=out sprintf("%s%s",i==1?"":":",s)
		}
		print out
	}
	{ for(k=1;k<=NF;k++) emit($k) }' | LC_ALL=C sort -u
}

function blacklist_error(){
	echo "$(date '+%Y-%m-%d %H:%M:%S') 【防火墙】【失败】$1，保留同步状态，下轮重试" >> "$logfile"
	return 1
}

# 同轮复用快照。查询失败不能当作空集；缺失集合单独标记，供恢复使用。
function blacklist_snapshot(){
	local raw names set family
	bl_snapshot_ready=0
	bl_members=""; bl_exists4=0; bl_exists6=0
	if [ "$firewall_mode" = "nft" ]; then
		bl_rules=$(nft -a list chain inet fw4 input 2>/dev/null) || { blacklist_error "读取 nft INPUT 规则失败"; return 1; }
		for family in 4 6; do
			set=pushbot_blacklist; [ "$family" = 6 ] && set=pushbot_blacklist6
			if raw=$(nft list set inet fw4 "$set" 2>/dev/null); then
				[ "$family" = 4 ] && bl_exists4=1 || bl_exists6=1
				raw=$(printf '%s\n' "$raw" | sed -n '/elements = {/,/}/p' |
					sed 's/.*elements = {//;s/}.*//' | tr ',' '\n' | awk '{print $1}')
				bl_members="$bl_members $raw"
			else
				names=$(nft list sets 2>/dev/null) || { blacklist_error "读取 nft 集合失败"; return 1; }
				if printf '%s\n' "$names" | grep -qE "^[[:space:]]*set $set[[:space:]]*\\{"; then
					blacklist_error "读取 $set 成员失败"; return 1
				fi
			fi
		done
	else
		bl_rules=$(iptables -S INPUT 2>/dev/null) || { blacklist_error "读取 iptables INPUT 规则失败"; return 1; }
		if raw=$(ipset save ip_blacklist 2>/dev/null); then
			bl_exists4=1
			bl_members=$(printf '%s\n' "$raw" | awk '$1=="add" && $2=="ip_blacklist" {print $3}')
		else
			names=$(ipset list -n 2>/dev/null) || { blacklist_error "读取 ipset 集合失败"; return 1; }
			if printf '%s\n' "$names" | grep -qxF ip_blacklist; then
				blacklist_error "读取 ipset 成员失败"; return 1
			fi
		fi
	fi
	bl_members=$(printf '%s\n' "$bl_members" | blacklist_members)
	bl_snapshot_ready=1
}

function need_blacklist_sync(){
	local state="/usr/bin/pushbot/api/.ip_blacklist.state" old
	bl_snapshot_ready=0
	blacklist_snapshot || return 1
	[ ! -f "$state.prev" ] || [ ! -f "$ip_blacklist_path" ] && return 0
	cmp -s "$state.prev" "$ip_blacklist_path" || return 0
	[ "$(cat "$state.onoff" 2>/dev/null)" != "${web_login_black:-0}" ] && return 0
	[ "$(cat "$state.timeout" 2>/dev/null)" != "$(parse_timeout "${ip_black_timeout:-0}")" ] && return 0
	old=$(blacklist_members < "$state.prevset" 2>/dev/null)
	[ "$old" != "$bl_members" ] && return 0
	# ── 内核规则完整性检查（仅首次启动 / fw4 重启后执行一次）──
	# 上面的检查覆盖了配置/文件/set 内容变化，变化时立即同步。
	# 下面检查的是内核 set 和 DROP 规则是否完整，用于 fw4 重启后自动恢复。
	# 此类检查涉及多次 nft/iptables 查询，若在主循环每轮都执行代价较高，
	# 且系统短暂不稳定时可能误判（规则还没恢复就触发无意义重建）。
	# 方案：用 boot_marker 控制，每次 pushbot 重启后仅首次进入时执行一次。
	# ── 内核规则完整性检查（仅首次启动 / fw4 重启后执行一次）──
	# boot_marker 在 pushbot 启动时创建，首次检查后删除，下次重启再创建。
	# 不检查黑名单文件是否非空——反向同步可能已清空文件，但 set/规则仍需验证。
	if [ "$web_login_black" = 1 ]; then
		local boot_marker="${state}.boot"
		if [ -f "$boot_marker" ]; then
			rm -f "$boot_marker"
			[ "$bl_exists4" = 0 ] && return 0
			if [ "$firewall_mode" = nft ]; then
				[ "$bl_exists6" = 0 ] && return 0
				printf '%s\n' "$bl_rules" | grep -qE '^[[:space:]]*ip saddr @pushbot_blacklist[[:space:]]+drop([[:space:]]|$)' || return 0
				printf '%s\n' "$bl_rules" | grep -qE '^[[:space:]]*ip6 saddr @pushbot_blacklist6[[:space:]]+drop([[:space:]]|$)' || return 0
			else
				printf '%s\n' "$bl_rules" | grep -qxF -- '-A INPUT -m set --match-set ip_blacklist src -j DROP' || return 0
			fi
		fi
	fi
	bl_snapshot_ready=0
	return 1
}

# 仅写发生变化的文件，复用原有 .tmp。
function blacklist_store(){
	{ [ -z "$2" ] || printf '%s\n' "$2"; } > "$ip_blacklist_path.tmp" || return 1
	cmp -s "$ip_blacklist_path.tmp" "$1" || cp "$ip_blacklist_path.tmp" "$1"
}

# 文件保留用户增删，只剔除上轮内核有、这轮确认消失的旧成员。
# ponytail: 本轮快照不是跨进程事务；若并发写入成为常态，再共用短临界区。
function add_ip_black(){
	local state="/usr/bin/pushbot/api/.ip_blacklist.state"
	local timeout=$(parse_timeout "${ip_black_timeout:-0}") onoff="${web_login_black:-0}"
	local requested previous prevset desired="" expired="" user_deleted="" ip family set exists members
	local old_timeout=$(cat "$state.timeout" 2>/dev/null) reset=false cleanup=false
	local added="" restored="" before changed=false rules_restored=false
	if [ -n "$1" ] && { is_local_address "$1" || ip_in_whitelist "$1"; }; then
		echo "$(date '+%Y-%m-%d %H:%M:%S') 【防火墙】IP $1 是本机或白名单地址，跳过拉黑" >> "$logfile"
		return 1
	fi
	if [ -n "$1" ] || [ "$bl_snapshot_ready" != 1 ]; then
		blacklist_snapshot || return 1
	fi
	bl_snapshot_ready=0
	before="$bl_members"
	requested=""
	if [ -f "$ip_blacklist_path" ]; then
		requested=$(cat "$ip_blacklist_path") || { blacklist_error "读取黑名单失败"; return 1; }
	fi
	requested=$(printf '%s\n%s\n' "$requested" "$1" | blacklist_members)
	previous=$(blacklist_members < "$state.prev" 2>/dev/null)
	prevset=$(blacklist_members < "$state.prevset" 2>/dev/null)
	local explicit=$(printf '%s\n' "$1" | blacklist_members)
	[ -z "$1" ] || [ -n "$explicit" ] || { blacklist_error "IP 地址无效"; return 1; }
	if [ "$firewall_mode" != nft ] && [ -n "$explicit" ] && [ "${explicit#*:}" != "$explicit" ]; then
		blacklist_error "当前 ipset 后端不支持 IPv6"; return 1
	fi
	for ip in $previous; do
		printf '%s\n' "$requested" | grep -qxF "$ip" || user_deleted="$user_deleted $ip"
	done
	if [ "$onoff" = 1 ]; then
		# set_changed: 当前 set 与上次快照不一致 → 内核重启/超时移除等非预期变化
		# 此时 set 中"丢失"的 IP 不应标记为 expired（到期移除），而是重新添加。
		local set_changed=false
		[ "$before" != "$prevset" ] && set_changed=true
		for ip in $requested; do
			is_local_address "$ip" && continue
			ip_in_whitelist "$ip" && continue
			exists="$bl_exists4"; case "$ip" in *:*) exists="$bl_exists6";; esac
			# 判断 IP 是否在当前 set 中
			local in_before=false
			printf '%s\n' "$before" | grep -qxF "$ip" && in_before=true
			# 判断 IP 是否在上次快照中
			local in_prevset=false
			printf '%s\n' "$prevset" | grep -qxF "$ip" && in_prevset=true
			# 判断 IP 是否在上次文件中
			local in_previous=false
			printf '%s\n' "$previous" | grep -qxF "$ip" && in_previous=true
			
			# 超时过期检测：set 存在，IP 在上次快照和文件中，但不在当前 set 中
			# 这说明 IP 因为超时被 nftables 自动移除，应该标记为 expired 并从文件中删除
			if [ "$exists" = 1 ] && [ "$timeout" -gt 0 ] && $in_prevset && $in_previous && ! $in_before; then
				expired="$expired $ip"
			else
				# 其他情况：新增 IP、已在 set 中的 IP、或 set 不存在需要重建
				desired="$desired $ip"
			fi
		done
	fi
	desired=$(printf '%s\n' "$desired" | blacklist_members)
	[ "$old_timeout" != "$timeout" ] && reset=true
	[ -z "$desired" ] && cleanup=true
	if [ "$firewall_mode" = nft ]; then
		# 一个事务处理规则、集合及元素；不重复添加已有成员，不刷新其倒计时。
		{
			if $cleanup || $reset; then
				printf '%s\n' "$bl_rules" | awk '/@pushbot_blacklist(6)?[[:space:]]/ && /# handle / {print "delete rule inet fw4 input handle " $NF}'
				[ "$bl_exists4" = 1 ] && echo 'delete set inet fw4 pushbot_blacklist'
				[ "$bl_exists6" = 1 ] && echo 'delete set inet fw4 pushbot_blacklist6'
			fi
			if ! $cleanup; then
				for family in 4 6; do
					set=pushbot_blacklist; exists="$bl_exists4"
					[ "$family" = 6 ] && { set=pushbot_blacklist6; exists="$bl_exists6"; }
					if $reset || [ "$exists" = 0 ]; then
						[ "$timeout" = 0 ] &&
							echo "add set inet fw4 $set { type ipv${family}_addr; }" ||
							echo "add set inet fw4 $set { type ipv${family}_addr; timeout ${timeout}s; }"
					fi
					local proto=ip; [ "$family" = 6 ] && proto=ip6
					if $reset || ! printf '%s\n' "$bl_rules" | grep -qE "^[[:space:]]*$proto saddr @$set[[:space:]]+drop([[:space:]]|$)"; then
						echo "insert rule inet fw4 input $proto saddr @$set drop"
						rules_restored=true
					fi
				done
				for ip in $desired; do
					if $reset || ! printf '%s\n' "$before" | grep -qxF "$ip"; then
						set=pushbot_blacklist; case "$ip" in *:*) set=pushbot_blacklist6;; esac
						echo "add element inet fw4 $set { $ip }"
					fi
				done
				if ! $reset; then
					for ip in $before; do
						if ! printf '%s\n' "$desired" | grep -qxF "$ip"; then
							set=pushbot_blacklist; case "$ip" in *:*) set=pushbot_blacklist6;; esac
							echo "delete element inet fw4 $set { $ip }"
						fi
					done
				fi
			fi
			:
		} > "$ip_blacklist_path.tmp" || { blacklist_error "写入 nft 事务失败"; return 1; }
		if [ -s "$ip_blacklist_path.tmp" ]; then
			nft -f "$ip_blacklist_path.tmp" 2>> "$logfile" || { blacklist_error "更新 nft 黑名单失败"; return 1; }
			changed=true
		fi
	else
		# ipset 同样增量更新；只有时长变化才重建。
		if $cleanup || $reset; then
			local rule
			for rule in $(printf '%s\n' "$bl_rules" | grep -xF -- '-A INPUT -m set --match-set ip_blacklist src -j DROP' | awk '{print NR}'); do
				iptables -D INPUT -m set --match-set ip_blacklist src -j DROP 2>> "$logfile" || { blacklist_error "删除 iptables 规则失败"; return 1; }
			done
			if [ "$bl_exists4" = 1 ]; then
				ipset destroy ip_blacklist 2>> "$logfile" || { blacklist_error "删除 ipset 集合失败"; return 1; }
			fi
			bl_exists4=0; bl_rules=""; changed=true
		fi
		if ! $cleanup; then
			if [ "$bl_exists4" = 0 ]; then
				ipset create ip_blacklist hash:ip timeout "$timeout" 2>> "$logfile" || { blacklist_error "创建 ipset 集合失败"; return 1; }
				changed=true
			fi
			if ! printf '%s\n' "$bl_rules" | grep -qxF -- '-A INPUT -m set --match-set ip_blacklist src -j DROP'; then
				iptables -I INPUT -m set --match-set ip_blacklist src -j DROP 2>> "$logfile" || { blacklist_error "插入 iptables 规则失败"; return 1; }
				rules_restored=true
				changed=true
			fi
			for ip in $desired; do
				case "$ip" in *:*) continue;; esac
				if $reset || ! printf '%s\n' "$before" | grep -qxF "$ip"; then
					ipset add ip_blacklist "$ip" 2>> "$logfile" || { blacklist_error "添加 ipset 成员失败"; return 1; }
					changed=true
				fi
			done
			if ! $reset; then
				for ip in $before; do
					if ! printf '%s\n' "$desired" | grep -qxF "$ip"; then
						ipset del ip_blacklist "$ip" 2>> "$logfile" || { blacklist_error "删除 ipset 成员失败"; return 1; }
						changed=true
					fi
				done
			fi
		fi
	fi
	if $changed; then
		blacklist_snapshot || return 1
		bl_snapshot_ready=0
	fi
	members="$desired"
	[ "$firewall_mode" != nft ] && members=$(printf '%s\n' "$desired" | grep -v :)
	if [ "$bl_members" != "$members" ]; then
		blacklist_error "黑名单复核不一致"; return 1
	fi
	# 防火墙确认成功后再回写文件和快照；失败不提交成功状态。
	blacklist_store "$ip_blacklist_path" "$desired" &&
		blacklist_store "$state.prev" "$desired" &&
		blacklist_store "$state.prevset" "$bl_members" &&
		blacklist_store "$state.onoff" "$onoff" &&
		blacklist_store "$state.timeout" "$timeout" || { blacklist_error "保存黑名单同步状态失败"; return 1; }
	rm -f "$ip_blacklist_path.tmp"
	for ip in $bl_members; do
		if ! printf '%s\n' "$before" | grep -qxF "$ip"; then
			if [ "$ip" != "$explicit" ] && printf '%s\n' "$previous" | grep -qxF "$ip"; then
				restored="$restored $ip"
			else
				added="$added $ip"
			fi
		fi
	done
	[ -z "$added" ] || echo "$(date '+%Y-%m-%d %H:%M:%S') 【防火墙】【新增封禁】${added# }" >> "$logfile"
	[ -z "$restored" ] || echo "$(date '+%Y-%m-%d %H:%M:%S') 【防火墙】【恢复封禁】${restored# }" >> "$logfile"
	[ -z "$user_deleted" ] || echo "$(date '+%Y-%m-%d %H:%M:%S') 【防火墙】【手动解封】${user_deleted# }" >> "$logfile"
	[ -z "$expired" ] || echo "$(date '+%Y-%m-%d %H:%M:%S') 【防火墙】【到期或内核移除】${expired# }" >> "$logfile"
	if $cleanup && $changed; then
		echo "$(date '+%Y-%m-%d %H:%M:%S') 【防火墙】已清空黑名单规则和集合" >> "$logfile"
	elif $reset; then
		echo "$(date '+%Y-%m-%d %H:%M:%S') 【防火墙】封禁时长已更新为 $timeout 秒" >> "$logfile"
	elif $rules_restored && [ -z "$added$restored" ]; then
		echo "$(date '+%Y-%m-%d %H:%M:%S') 【防火墙】已恢复黑名单 DROP 规则" >> "$logfile"
	fi
	return 0
}

# 发送定时数据
function send(){
	# 运行时兜底：非测试模式下每次发送前再查一次总开关（uci 直读最新值）。
	# 防御：残留 crontab、用户自写 crontab、以及未来绕过分发的新调用路径。
	# send test（渠道测试）不拦，允许总开关关闭时主动测试。
	if [ -z "$1" ]; then
		[ "`uci -q get pushbot.pushbot.pushbot_enable`" = "1" ] || return 0
	fi
	[ ! -z "$1" ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【测试】开始测试渠道" >> ${logfile} || echo "`date "+%Y-%m-%d %H:%M:%S"` 【定时数据】创建定时任务" >> ${logfile}
	pushbot_disturb;local send_disturb=$?
	get_config "send_title" "router_status" "router_temp" "router_wan" "client_list" "google_check_count"

	[ -z "$send_title" ] && local send_title="路由状态："
	[ -z "$google_check_count" ] && local google_check_count="3"
	[ ! -z "$1" ] && local send_title="发送测试：" && local send_content="${str_splitline}${str_title_start}内容1${str_title_end}${str_linefeed}${str_tab}设备1${str_linefeed}${str_tab}设备2${str_splitline}${str_title_start}内容2${str_title_end}${str_linefeed}${str_tab}设备3${str_linefeed}${str_tab}设备4"
	# 在线设备列表已由主进程(pushbot_first)维护, send 直接读取, 避免与主进程并发竞争 FIFO(fd1)导致死锁
	[ -z "$1" ] && [ ! -z "$client_list" ] && [ "$client_list" -eq "1" ] && > ${dir}send_enable.lock

	if [ -z "$1" ] && [ ! -z "$router_status" ] && [ "$router_status" -eq "1" ]; then
		local systemload=`cat /proc/loadavg|awk '{print $1" "$2" "$3}'`
		local cpuload=`getcpu`
		local ramload=`free -m|sed -n '2p'|awk '{printf "%.2f%%\n",($3/$2)*100}'`
		# 全球互联检测: 尝试 google_check_count 次(默认3), 1 次成功即视为连通
		local Qwai="000"
		local Qwai_count=${google_check_count:-3}
		[ "$Qwai_count" -lt "1" ] && local Qwai_count="3"
		for i in `seq 1 ${Qwai_count}`; do
			Qwai=`curl -o /dev/null --connect-timeout 3 -m 3 -s -w %{http_code} https://www.google.com`
			[ "$Qwai" = "200" ] || [ "$Qwai" = "301" ] || [ "$Qwai" = "302" ] && break
			[ "$i" -lt "$Qwai_count" ] && sleep 1
		done
		if [[ "$Qwai" -eq "200" ]] || [[ "$Qwai" -eq "301" ]] || [[ "$Qwai" -eq "302" ]]; then
			local Qwai_status="已连通！"
		else
			local Qwai_status="已断开！"
		fi
		local systemstatustime=`cat /proc/uptime|awk -F. '{run_days=$1 / 86400;run_hour=($1 % 86400)/3600;run_minute=($1 % 3600)/60;run_second=$1 % 60;printf("运行时间：%d天%d时%d分%d秒",run_days,run_hour,run_minute,run_second)}'`;unset run_days run_hour run_minute run_second
		if [ "$table_enable" = "1" ]; then
			local send_content="${send_content}${str_splitline}${str_title_start}${font_module} 系统运行状态${font_end}${str_title_end}$(table_body "平均负载" "${systemload}" "CPU占用" "${cpuload}${percentsym}" "内存占用" "${ramload}${percentsym}" "全球互联" "${Qwai_status}" "运行时间" "${systemstatustime#运行时间：}")"
		else
			local send_content="${send_content}${str_splitline}${str_title_start}${font_module} 系统运行状态${font_end}${str_title_end}"
			local send_content="${send_content}${str_linefeed}${str_tab}平均负载：${systemload}"
			local send_content="${send_content}${str_linefeed}${str_tab}CPU占用：${cpuload}${percentsym}"
			local send_content="${send_content}${str_linefeed}${str_tab}内存占用：${ramload}${percentsym}"
			local send_content="${send_content}${str_linefeed}${str_tab}全球互联：${Qwai_status}"
			local send_content="${send_content}${str_linefeed}${str_tab}${systemstatustime}"
		fi
	fi

	if [ -z "$1" ] && [ ! -z "$router_temp" ] && [ "$router_temp" -eq "1" ]; then
		local cputemp=`soc_temp`
		if [ "$table_enable" = "1" ]; then
			[ ! -z "$cputemp" ] && local send_content="${send_content}${str_splitline}${str_title_start}${font_module} 设备温度${font_end}${str_title_end}$(table_body "CPU" "${cputemp}℃")"
			[ -z "$cputemp" ] && local send_content="${send_content}${str_splitline}${str_title_start}${font_fail} 设备温度${font_end}${str_title_end}$(table_body "CPU" "无法获取")"
		else
			[ ! -z "$cputemp" ] && local send_content="${send_content}${str_splitline}${str_title_start}${font_module} 设备温度${font_end}${str_title_end}${str_linefeed}${str_tab}CPU：${cputemp}℃"
			[ -z "$cputemp" ] && local send_content="${send_content}${str_splitline}${str_title_start}${font_fail} 设备温度${font_end}${str_title_end}${str_linefeed}${str_tab}无法获取设备温度"
		fi
	fi

	if [ -z "$1" ] && [ ! -z "$router_wan" ] && [ "$router_wan" -eq "1" ]; then
		local send_wanIP=`getip wanipv4`
		# 判断用户所选接口是否为 LAN：以 UCI/ubus 接口角色为准（非 wan/wan6 即 LAN，
		# 不依赖 IP 是否私网——运营商可能给 WAN 私网 IP）。无论 LAN/WAN，外网 IP
		# 均探测并显示（getip 内部按接口类型选择出口：LAN 走默认路由，WAN 绑定接口）。
		local wan_lan_mode=0
		if [ ! -z "$ipv4_interface" ]; then
			iface_is_lan "$ipv4_interface" && wan_lan_mode=1
		fi
		# 无论 LAN/WAN 都探测外网 IP（出口策略在 getip 内部处理）
		local send_hostIP=`getip hostipv4`
		# 接口 IP 为私网时标注非公网（仅 WAN 模式；LAN 模式接口本身私网属正常，不标注）
		local wanIP_note=""
		[ "$wan_lan_mode" -eq "0" ] && [ ! -z "$send_wanIP" ] && [ "$send_wanIP" != "获取失败" ] && is_private_ip "$send_wanIP" 4 && wanIP_note=" (非公网IP)"
		local wanIP6_note=""
		if [ "$table_enable" = "1" ]; then
			local send_content="${send_content}${str_splitline}${str_title_start}${font_module} WAN 口信息${font_end}${str_title_end}$(table_body "接口IP" "${send_wanIP}${wanIP_note}" "外网IP" "${send_hostIP}")"
			if [ ! -z "$pushbot_ipv6" ] && [ "$pushbot_ipv6" -ne "0" ]; then
				local send_wanIPv6=`getip wanipv6`
				local send_hostIPv6=`getip hostipv6`
				[ "$wan_lan_mode" -eq "0" ] && [ ! -z "$send_wanIPv6" ] && [ "$send_wanIPv6" != "获取失败" ] && is_private_ip "$send_wanIPv6" 6 && wanIP6_note=" (非公网IP)"
				local send_content="${send_content}$(table_rows "IPv6" "${send_wanIPv6}${wanIP6_note}" "外网v6" "${send_hostIPv6}")"
			fi
			# 外网 IP 与接口 IP 不一致提示（仅 WAN 模式；LAN 模式接口 IP 私网、外网 IP 公网必然不一致，提示无意义）
			[ "$wan_lan_mode" -eq "0" ] && [ ! -z "$send_wanIP" ] && [ ! -z "$send_hostIP" ] && [ "$send_hostIP" != "获取失败" ] && ( ! echo "$send_wanIP"|grep -q -w ${send_hostIP} ) && local send_content="${send_content}$(table_rows "提示" "外网 ip 与接口 ip 不一致，不是公网 ip")"
			local interfaceuptime=`getinterfaceuptime`
			[ ! -z "$interfaceuptime" ] && local wanstatustime=`getinterfaceuptime|awk -F. '{run_days=$1 / 86400;run_hour=($1 % 86400)/3600;run_minute=($1 % 3600)/60;run_second=$1 % 60;printf("在线时间：%d天%d时%d分%d秒",run_days,run_hour,run_minute,run_second)}'` && unset run_days run_hour run_minute run_second
			[ ! -z "$wanstatustime" ] && local send_content="${send_content}$(table_rows "在线时间" "${wanstatustime#在线时间：}")"
		else
			local send_content="${send_content}${str_splitline}${str_title_start}${font_module} WAN 口信息${font_end}${str_title_end}${str_linefeed}${str_tab}接口ip:${send_wanIP}${wanIP_note}${str_linefeed}${str_tab}外网ip:${send_hostIP}"
			if [ ! -z "$pushbot_ipv6" ] && [ "$pushbot_ipv6" -ne "0" ]; then
				local send_wanIPv6=`getip wanipv6`
				local send_hostIPv6=`getip hostipv6`
				[ "$wan_lan_mode" -eq "0" ] && [ ! -z "$send_wanIPv6" ] && [ "$send_wanIPv6" != "获取失败" ] && is_private_ip "$send_wanIPv6" 6 && wanIP6_note=" (非公网IP)"
				local send_content="${send_content}${str_linefeed}${str_tab}ipv6 :${send_wanIPv6}${wanIP6_note}${str_linefeed}${str_tab}外网v6:${send_hostIPv6}"
			fi
			[ "$wan_lan_mode" -eq "0" ] && [ ! -z "$send_wanIP" ] && [ ! -z "$send_hostIP" ] && [ "$send_hostIP" != "获取失败" ] && ( ! echo "$send_wanIP"|grep -q -w ${send_hostIP} ) && local send_content="${send_content}${str_linefeed}${str_tab}外网 ip 与接口 ip 不一致，你的 ip 不是公网 ip"
			local interfaceuptime=`getinterfaceuptime`
			[ ! -z "$interfaceuptime" ] && local wanstatustime=`getinterfaceuptime|awk -F. '{run_days=$1 / 86400;run_hour=($1 % 86400)/3600;run_minute=($1 % 3600)/60;run_second=$1 % 60;printf("在线时间：%d天%d时%d分%d秒",run_days,run_hour,run_minute,run_second)}'` && unset run_days run_hour run_minute run_second
			local send_content="${send_content}${str_linefeed}${str_tab}${wanstatustime}"
		fi
	fi

	if [ -z "$1" ] && [ ! -z "$client_list" ] && [ "$client_list" -eq "1" ]; then
		wait
		local IPLIST=`cat ${dir}ipAddress 2>/dev/null|awk '{print $1}'`
		[ -f ${dir}ipAddress ] && local logrow=$(grep -c "" ${dir}ipAddress) || local logrow="0"
		[ "$logrow" -eq "0" ] && local send_content="${send_content}${str_splitline}${str_title_start}${font_fail} 当前无在线设备${font_end}${str_title_end}" || local send_content="${send_content}${str_splitline}${str_title_start}${font_module} 现有在线设备 ${logrow} 台${font_end}${str_title_end}"
		if [ "$table_enable" = "1" ]; then
			local send_content="${send_content}$(table_header "设备" "**在线信息**")"
		fi
		for ip in $IPLIST; do
			local time_up=`cat ${dir}ipAddress|grep -w ${ip}|awk '{print $4}'|grep -v "^$"|sort -u|head -n1`
			local time1=`date +%s`
			local time1=$(time_for_humans `expr ${time1} - ${time_up}`)
			local ip_mac=`getmac ${ip}`
			local ip_name=`getname ${ip} ${ip_mac}`
			local ip_total=`usage get ${ip_mac}`
			if [ "$table_enable" = "1" ]; then
				[ ! -z "$ip_total" ] && local ip_total="${ip_total}"
			else
				[ ! -z "$ip_total" ] && local ip_total="总计流量：${ip_total}  "
			fi
			local ip_name=`cut_str $ip_name 27`
			if [ "$table_enable" = "1" ]; then
				# 每个设备 2 行 2 列: 第一行 设备名+流量, 第二行 IP+时长
				local send_content="${send_content}$(table_rows "${font_client}${ip_name}${font_end}" "${ip_total}" "${ip}" "${time1}")"
			else
				local send_content="${send_content}${str_linefeed}${str_tab}${font_client}【${ip_name}】${font_end2}  ${ip}${str_linefeed}${str_tab}${ip_total}在线 ${time1}"
			fi
			unset ip_total time_down time_up time1 ip_mac ip_name
		done
	fi

	[ ! -z "$device_name" ] && local send_title="【$device_name】${send_title}"
	[ -z "$send_content" ] && local send_content="${str_splitline}${str_title_start} 我遇到了一个难题${str_title_end}${str_linefeed}${str_tab}定时发送选项错误，你没有选择需要发送的项目，该怎么办呢${str_splitline}"
	# 去掉开头 str_splitline 字面(避免与模板"时间后换行"叠加成 3 空行)
	send_content=$(printf '%s' "$send_content" | sed 's/^\\n\\n---\\n\\n//; s/^\\n\\n//')
	# 清洗双引号为单引号, 避免 eval echo 展开模板后破坏 JSON(飞书等卡片模板对特殊字符敏感)
	send_title=`echo "$send_title"|tr '"' "'"`
	send_content=`echo "$send_content"|tr '"' "'"`
	device_name=`echo "$device_name"|tr '"' "'"`
	# WxPusher: 检查 uid 和 topics 是否至少有一个
	if ( echo "${jsonpath}"|grep -q "wxpusher" ) && [ "$wxpusher_uids" = "[]" ] && [ "$wxpusher_topics" = "[]" ]; then
		echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】WxPusher：User IDs 或 Topic IDs 至少填写一个" >> ${logfile}
		return 1
	fi
	[ "$send_disturb" -eq "0" ] && diy_send "${send_title}" "${send_content}" "${jsonpath}" >/dev/null 2>&1
	local send_rc=$?
	if [ ! -z "$1" ]; then
		[ $send_rc -ne 0 ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】渠道测试失败，请检查网络或设置信息" >> ${logfile} || echo "`date "+%Y-%m-%d %H:%M:%S"` ${disturb_text}渠道测试完成" >> ${logfile}
	else
		[ $send_rc -ne 0 ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】定时推送失败，请检查网络或设置信息" >> ${logfile} || echo "`date "+%Y-%m-%d %H:%M:%S"` ${disturb_text}定时推送任务完成" >> ${logfile}
	fi
	deltemp
}

# 保存脚本参数（函数内 $1 不继承调用者，需全局变量传递）
SCRIPT_ARG="$1"

# 初始化
read_config

# ── 流量数据源探测（缓存到 /tmp，OpenWrt 重启后重新探测） ──
function init_traffic_source() {
	# 读取缓存
	traffic_source="none"
	if [ -f "${dir}traffic_source" ]; then
		traffic_source=$(cat ${dir}traffic_source 2>/dev/null)
		return
	fi

	# 缓存为空：检测到 nlbw 就优先使用，否则用 wrtbw
	if command -v nlbw >/dev/null 2>&1; then
		traffic_source="nlbw"
	elif [ -f "/usr/sbin/wrtbwmon" ]; then
		traffic_source="wrtbw"
	fi
	echo "$traffic_source" > ${dir}traffic_source
	echo "`date "+%Y-%m-%d %H:%M:%S"` 【检测到流量工具：${traffic_source}】" >> ${logfile}
}

# ── nlbw 启动健康检查（仅前两轮轮询执行）──
# 场景：系统重启后 nlbwmon 未就绪，缓存却已写入 nlbw
# 策略：第1轮若无效则重启 nlbwmon；第2轮仍无效则降级 wrtbw
function check_nlbw_health() {
	[ "$traffic_source" != "nlbw" ] && return
	local check_file="${dir}nlbw_check_round"
	local round=0
	[ -f "$check_file" ] && round=$(cat "$check_file" 2>/dev/null)
	[ "$round" -ge 2 ] && return
	round=$((round + 1))
	echo "$round" > "$check_file"

	local rows=$(nlbw -c csv -s, -q -n -g mac 2>/dev/null | awk -F',' 'NR>1 && $1!="mac" {n++} END{print n+0}')
	[ "${rows:-0}" -gt 0 ] && return

	# nlbw 不可用
	if [ "$round" -eq 1 ]; then
		echo "`date "+%Y-%m-%d %H:%M:%S"` 【流量工具】nlbw 不可用，尝试重启 nlbwmon..." >> ${logfile}
		/etc/init.d/nlbwmon restart >/dev/null 2>&1
	else
		echo "`date "+%Y-%m-%d %H:%M:%S"` 【流量工具】nlbw 仍不可用，降级到 wrtbw" >> ${logfile}
		traffic_source="wrtbw"
		echo "wrtbw" > ${dir}traffic_source
	fi
}

# ── 防火墙模式探测（缓存到 /tmp，OpenWrt 重启后重新探测） ──
function init_firewall_mode() {
	# 读取缓存
	firewall_mode=""
	if [ -f "${dir}firewall_mode" ]; then
		firewall_mode=$(cat ${dir}firewall_mode 2>/dev/null)
		return
	fi

	# 缓存为空，重新探测
	if command -v nft >/dev/null 2>&1; then
		firewall_mode="nft"
	else
		firewall_mode="iptables"
	fi
	echo "$firewall_mode" > ${dir}firewall_mode
	echo "`date "+%Y-%m-%d %H:%M:%S"` 【检测到防火墙：${firewall_mode}】" >> ${logfile}
}

# 主进程启动或 blacklist 命令时探测
if [ "$1" != "usage" ] && [ "$1" != "soc" ] && [ "$1" != "client" ] && [ "$1" != "test" ]; then
	init_traffic_source
	init_firewall_mode
fi

# usage 命令：只读取流量源缓存（不探测）
if [ "$1" = "usage" ]; then
	traffic_source="none"
	if [ -f "${dir}traffic_source" ]; then
		traffic_source=$(cat ${dir}traffic_source 2>/dev/null)
	fi
fi

# 供外部查询流量(LuCI 在线设备表格):pushbot usage list / pushbot usage get <mac> [bytes]
# 注意:必须放在 deltemp 之前,避免查询时误删主循环的 pushbot.lock
if [ "$1" = "usage" ]; then
	usage ${2} ${3} ${4}
	exit
fi

deltemp
pushbot_cron

# 限制并发进程
[ -z "$thread_num" ] || [ "$thread_num" -eq "0" ] && thread_num=5
[ -e ${dir}fd1 ] || mkfifo ${dir}fd1
exec 5<>${dir}fd1
rm -f ${dir}fd1 >/dev/null 2>&1
for i in `seq 1 $thread_num`; do
	echo >&5
done
unset i

# 启动参数
if [ "$1" ] ;then
	# blacklist 只需读取黑名单配置，不需要流量源探测
	if [ "$1" = "blacklist" ]; then
		get_config "pushbot_enable" "web_login_black" "pushbot_whitelist" "pushbot_blacklist" "pushbot_interface" "MAC_online_list" "MAC_offline_list" "ip_white_list" "ip_black_timeout" "ip_black_persist"
		# 只有拉黑功能启用时才执行
		if [ "$web_login_black" = "1" ]; then
			init_firewall_mode
			add_ip_black
		fi
		exit
	fi
	# 重检防火墙：清除缓存并重新探测
	if [ "$1" = "check_firewall" ]; then
		get_config "web_login_black"
		if [ "$web_login_black" = "1" ]; then
			rm -f ${dir}firewall_mode
			init_firewall_mode
		fi
		exit
	fi
	# 重检流量源：清除缓存并重新探测
	if [ "$1" = "check_traffic" ]; then
		rm -f ${dir}traffic_source ${dir}nlbw_check_round
		init_traffic_source
		exit
	fi
	# 重置流量：按流量源分别清除（reset_regularly 的零点任务调用）
	if [ "$1" = "reset_traffic" ]; then
		init_traffic_source
		if [ "$traffic_source" = "nlbw" ]; then
			# nlbwmon：删除当前会计区间数据库（-I 1 = 每月1号开始 → 文件名 YYYYMM01）
			# 必须重启 nlbwmon，否则内存中的统计会在下次 commit(4h) 时重建文件
			/etc/init.d/nlbwmon stop >/dev/null 2>&1
			rm -f /var/lib/nlbwmon/$(date +%Y%m)01.db /var/lib/nlbwmon/$(date +%Y%m)01.db.gz >/dev/null 2>&1
			/etc/init.d/nlbwmon start >/dev/null 2>&1
		else
			# wrtbwmon：删除 usage 数据库
			rm -f /tmp/pushbot/usage.db /tmp/pushbot/usage6.db >/dev/null 2>&1
		fi
		exit
	fi
	# 重检无线接口：清除缓存并重新探测
	if [ "$1" = "check_wireless" ]; then
		rm -f ${dir}wlan_interface
		[ "$iw_version" ] && wlan_interface=`iw dev|grep Interface|awk '{print $2}'` >/dev/null 2>&1
		local _wifi_sys=$(ls /sys/class/net/*/wireless 2>/dev/null | sed 's|/sys/class/net/||;s|/wireless||;s/:$//')
		for _w in $_wifi_sys; do
			echo "$wlan_interface" | grep -q -w "$_w" || wlan_interface="${wlan_interface} ${_w}"
		done
		echo "$wlan_interface" > ${dir}wlan_interface
		if [ ! -z "$wlan_interface" ]; then
			echo "`date "+%Y-%m-%d %H:%M:%S"` 【检测到无线接口：${wlan_interface}】" >> ${logfile}
		else
			echo "`date "+%Y-%m-%d %H:%M:%S"` 【未检测到无线接口】" >> ${logfile}
		fi
		exit
	fi
	# 定时任务(crontab)入口：总开关关闭时拒绝发送（兜底残留 crontab；test 主动测试不拦）
	if [ "$1" = "send" ]; then
		get_config pushbot_enable
		[ "$pushbot_enable" = "1" ] || exit 0
		send
	fi
	[ $1 == "soc" ] && echo `soc_temp` > ${dir}soc_tmp
	[ $1 == "client" ] && get_client
	[ $1 == "test" ] && send test
	exit
fi

# 载入在线设备
pushbot_init;[ $? -eq 1 ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】读取设置出错，请检查设置项 " >> ${logfile} && exit
echo "`date "+%Y-%m-%d %H:%M:%S"` 【初始化】载入在线设备" >> ${logfile}
> ${dir}send_enable.lock && pushbot_first && deltemp
echo "`date "+%Y-%m-%d %H:%M:%S"` 【初始化】初始化完成" >> ${logfile}

# 首次启动标记：供 need_blacklist_sync 的内核规则检查只执行一次
# 启动时创建 → 首次检查时删除 → 下次重启再创建
touch /usr/bin/pushbot/api/.ip_blacklist.state.boot 2>/dev/null

# 循环（仅当明确启用 =1 时运行；0/空/读取失败均不进入，脚本自然退出，不空转）
while [ "$pushbot_enable" = "1" ]; do
	deltemp
	usage update
	check_nlbw_health
	pushbot_disturb;disturb=$?

	# 外网IP变化检测
	[ -f ${dir}ipAddress ] && ipAddress_logrow=$(grep -c "" ${dir}ipAddress) || ipAddress_logrow="0";
	if [ $ipAddress_logrow -ne "0" ]; then
		online_list=`cat ${dir}ipAddress|awk '{print $2}'|grep -v "^$"|sort -u`
		for online_mac in $online_list; do
			[ ! -z "$online_mac" ] && mac_online_status="`echo "$mark_mac_list"|grep -i $online_mac|grep -v "^$"|sort -u|head -n1`${mac_online_status}"
		done
	fi

	if [ "$pushbot_ipv4" -ne "0" ] || [ "$pushbot_ipv6" -ne "0" ]; then
		rand_geturl
		ip_changes
	fi

	# 设备列表
	if [ ! -f "${dir}send_enable.lock" ]; then
		[ ! -z "$title" ] && echo "$title" > ${dir}title
		[ ! -z "$content" ] && echo "$content" > ${dir}content
		pushbot_first
		[ -f "${dir}title" ] && title=`cat ${dir}title` && rm -f ${dir}title >/dev/null 2>&1
		[ -f "${dir}content" ] && content=`cat ${dir}content` && rm -f ${dir}content >/dev/null 2>&1
	fi

	# 离线缓存区推送
	[ ! -f "${dir}send_enable.lock" ] && down_send

	# 当前设备列表
	[ ! -z "$content" ] && [ ! -f "${dir}send_enable.lock" ] && current_device

	# 无人值守任务
	[ ! -f "${dir}send_enable.lock" ] && unattended

	# CPU 检测
	[ ! -f "${dir}send_enable.lock" ] && cpu_load

	# 异常流量检测
	[ ! -f "${dir}send_enable.lock" ] && get_client_usage

	# 登录提醒通知
	[ ! -f "${dir}send_enable.lock" ] && login_send

	# 黑名单周期同步：内核 set 超时移除的元素同步回文件
	# （避免"超时已解除拉黑但文件仍保留"的文件/内核不一致）
	if [ "$web_login_black" = "1" ] && [ ! -f "${dir}send_enable.lock" ]; then
		if need_blacklist_sync; then
			add_ip_black
		fi
	fi

	# 通知
	if [ ! -f "${dir}send_enable.lock" ] && [ ! -z "$title" ] && [ ! -z "$content" ]; then
		[ ! -z "$device_name" ] && title="【$device_name】$title"
		( echo "$lite_enable"|grep -q "content" ) && content="$title"
		# 清洗双引号为单引号，避免 eval echo 展开模板后破坏 JSON（与 send() 一致）
		title=`echo "$title"|tr '"' "'"`
		content=`echo "$content"|tr '"' "'"`
		device_name=`echo "$device_name"|tr '"' "'"`
		# WxPusher: 检查 uid 和 topics 是否至少有一个
		if ( echo "${jsonpath}"|grep -q "wxpusher" ) && [ "$wxpusher_uids" = "[]" ] && [ "$wxpusher_topics" = "[]" ]; then
			echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】WxPusher：User IDs 或 Topic IDs 至少填写一个" >> ${logfile}
		else
			[ "$disturb" -eq "0" ] && diy_send "${title}" "${content}" "${jsonpath}" >/dev/null 2>&1
			[ $? -eq 1 ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】推送失败，请检查网络或设置信息 " >> ${logfile}
		fi
	fi
	
	while [ -f "${dir}send_enable.lock" ]; do
		sleep $sleeptime
	done
	sleep $sleeptime
done
