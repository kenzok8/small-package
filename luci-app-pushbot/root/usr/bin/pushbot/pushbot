# 推送
function diy_send(){
	# ntfy: 纯文本消息(body=内容) + Title/Priority/Token headers(移动端不渲染 markdown, 用纯文本)
	if ( echo "${3}"|grep -q "ntfy" ); then
		# topic 固定使用设备名称(device_name)
		[ "$ntfy_srv_enable" != "1" ] && ntfy_server="https://ntfy.sh"
		[ "$ntfy_token_enable" != "1" ] && ntfy_token=""
		local ntfy_topic="$device_name"
		local ntfy_url=`/usr/bin/jq -r '.url' ${3}` && local ntfy_url=`eval echo ${ntfy_url} 2>/dev/null`
		[ -z "$ntfy_url" ] && return 1
		local ntfy_msg=`echo "$2"|sed 's/\*\*//g; s/<font[^>]*>//g; s/<\/font>//g'`
		local ntfy_ct=`/usr/bin/jq -r '.content_type' ${3}` 2>/dev/null; [ -z "$ntfy_ct" ] && local ntfy_ct="text/plain"
		local ntfy_extra=""
		[ ! -z "$ntfy_token" ] && local ntfy_extra="-H \"Authorization: Bearer ${ntfy_token}\""
		[ ! -z "$ntfy_priority" ] && [ "$ntfy_priority" != "default" ] && local ntfy_extra="${ntfy_extra} -H \"Priority: ${ntfy_priority}\""
		curl -s -m 15 --fail -H "Title: ${1}" -H "Content-Type: ${ntfy_ct}" ${ntfy_extra} -d "${ntfy_msg}" "${ntfy_url}"
		return $?
	fi
	# gotify: 自建服务器推送(调试中), X-Gotify-Key 认证 + JSON body
	if ( echo "${3}"|grep -q "gotify" ); then
		local gotify_url=`/usr/bin/jq -r '.url' ${3}` && local gotify_url=`eval echo ${gotify_url} 2>/dev/null`
		[ -z "$gotify_url" ] && return 1
		local gotify_msg=`echo "$2"|sed 's/\*\*//g; s/<font[^>]*>//g; s/<\/font>//g'`
		local gotify_title=`echo "$1"|sed 's/\*\*//g; s/<font[^>]*>//g; s/<\/font>//g'`
		[ -z "$gotify_priority" ] && local gotify_priority="5"
		curl -s -m 15 --fail -H "X-Gotify-Key: ${gotify_token}" -H "Content-Type: application/json" -d "{\"title\":\"${gotify_title}\",\"message\":\"${gotify_msg}\",\"priority\":${gotify_priority}}" "${gotify_url}"
		return $?
	fi
	( ! echo "$lite_enable"|grep -q "content" ) && ( ! echo "$lite_enable"|grep -q "nowtime" ) && local nowtime=`date "+%Y-%m-%d %H:%M:%S"`
	local diyurl=`/usr/bin/jq -r .url ${3}` && local diyurl=`eval echo ${diyurl} 2>/dev/null`
	local type=`/usr/bin/jq -r '.type' ${3}` && local type=`eval echo ${type} 2>/dev/null`
	local data=`/usr/bin/jq -r '.data' ${3}` && local data=`eval echo ${data} 2>/dev/null`
	local content_type=`/usr/bin/jq -r '.content_type' ${3}`
	/usr/bin/jq ".type + $type" ${jsonpath} > ${tempjsonpath}
	/usr/bin/jq -r '.[]' ${tempjsonpath}|grep -w "null" && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】参数值错误，请检查设置项  `/usr/bin/jq -r '.' ${tempjsonpath}|grep "null"`" >> ${logfile} && return 1
	[ -f ${tempjsonpath} ] && local logrow=$(grep -c "" ${tempjsonpath}) || local logrow="0"
	[ $logrow -eq "0" ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】json 文件生成失败，请检查文件格式" >> ${logfile} && return 1
	/usr/bin/jq -r '.[]' ${tempjsonpath}|grep "null" && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】参数变量生成失败，请检查设置项 `/usr/bin/jq -r '.' ${tempjsonpath}|grep "null"`" >> ${logfile}
	
	curl -m 15 --fail -X POST -H "$content_type" -d "${data}" "${diyurl}"
}

