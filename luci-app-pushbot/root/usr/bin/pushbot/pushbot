# 创建计划任务
function pushbot_cron(){
	function del_cron(){
		( echo `crontab -l 2>/dev/null`|grep -q "pushbot" ) && crontab -l > conf && sed -i "/pushbot/d" conf && crontab conf && rm -f conf >/dev/null 2>&1
	}
	function re_cron(){
		/etc/init.d/cron stop
		/etc/init.d/cron start
	}
	del_cron
	if [ -z "$pushbot_enable" ]; then
		re_cron
		return
	fi

	# 重置流量
	if [ ! -z "$reset_regularly" ] && [ "$reset_regularly" -eq "1" ]; then
		crontab -l 2>/dev/null > conf && echo -e "0 0 * * * rm /tmp/pushbot/usage.db >/dev/null 2>&1" >> conf && crontab conf && rm -f conf >/dev/null 2>&1
		crontab -l 2>/dev/null > conf && echo -e "0 0 * * * rm /tmp/pushbot/usage6.db >/dev/null 2>&1" >> conf && crontab conf && rm -f conf >/dev/null 2>&1
	fi
	# 定时/间隔严格互斥，以 crontab 开关为准（1=定时发送，2=间隔发送）
	# 避免切换模式后残留字段（regular_time* / interval_time）误触发错误分支
	if [ "$crontab" = "2" ] && [ ! -z "$interval_time" ]; then
		# 间隔发送
		crontab -l 2>/dev/null > conf && echo -e "0 */$interval_time * * * /usr/bin/pushbot/pushbot send &" >> conf && crontab conf && rm -f conf >/dev/null 2>&1
	elif [ "$crontab" = "1" ] && { [ ! -z "$regular_time" ] || [ ! -z "$regular_time_2" ] || [ ! -z "$regular_time_3" ]; }; then
		# 定时发送（兼容旧配置：crontab 未设置但 regular_time* 有值）
		# 第二、三时段值为 0 时视为"禁用"残留（旧版把 Disabled 存成 0），过滤掉；
		# 主时段 regular_time=0 是合法的"0 点发送"，保留。
		[ ! -z "$regular_time_2" ] && [ "$regular_time_2" != "0" ] && local regular_time_2=",${regular_time_2}" || local regular_time_2=""
		[ ! -z "$regular_time_3" ] && [ "$regular_time_3" != "0" ] && local regular_time_3=",${regular_time_3}" || local regular_time_3=""
		crontab -l 2>/dev/null > conf && echo -e "0 $regular_time$regular_time_2$regular_time_3 * * * /usr/bin/pushbot/pushbot send &" >> conf && crontab conf && rm -f conf >/dev/null 2>&1
	elif [ -z "$crontab" ] && { [ ! -z "$regular_time" ] || [ ! -z "$regular_time_2" ] || [ ! -z "$regular_time_3" ] || [ ! -z "$interval_time" ]; }; then
		# 旧版兼容：crontab 未设置时，按 legacy 逻辑（定时优先，其次间隔）
		if [ ! -z "$regular_time" ] || [ ! -z "$regular_time_2" ] || [ ! -z "$regular_time_3" ]; then
			[ ! -z "$regular_time_2" ] && [ "$regular_time_2" != "0" ] && local regular_time_2=",${regular_time_2}" || local regular_time_2=""
			[ ! -z "$regular_time_3" ] && [ "$regular_time_3" != "0" ] && local regular_time_3=",${regular_time_3}" || local regular_time_3=""
			crontab -l 2>/dev/null > conf && echo -e "0 $regular_time$regular_time_2$regular_time_3 * * * /usr/bin/pushbot/pushbot send &" >> conf && crontab conf && rm -f conf >/dev/null 2>&1
		elif [ ! -z "$interval_time" ]; then
			crontab -l 2>/dev/null > conf && echo -e "0 */$interval_time * * * /usr/bin/pushbot/pushbot send &" >> conf && crontab conf && rm -f conf >/dev/null 2>&1
		fi
	fi
	re_cron
}

# 免打扰检测
function pushbot_disturb(){
	# 模式3：低频通知，全天候生效，由 check_dnd_limit 控制去重，不受时间段限制
	[ "$pushbot_sheep" = "3" ] && return 0
	[ -z "$pushbot_sheep" ] || [ -z "$starttime" ] || [ -z "$endtime" ] && return 0
	if [ `date +%H` -ge $endtime -a $starttime -lt $endtime ] || [ `date +%H` -lt $starttime -a $starttime -lt $endtime ] || [ `date +%H` -lt $starttime -a `date +%H` -ge $endtime -a $starttime -gt $endtime ]; then
		unset sheep_starttime
		rm -f ${dir}sheep_usage ${dir}old_sheep_usage  2>/dev/null
		disturb_text=`/usr/bin/jq -r '._api' ${jsonpath}`
		return 0
	else
		[ -z "$sheep_starttime" ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【免打扰】夜深了，该休息了" >> ${logfile} && sheep_starttime=`date +%s`
		if [ "$pushbot_sheep" -eq "1" ] ;then
			while [ `date +%H` -lt "$endtime" ]; do
				enable_detection
				sleep $sleeptime
			done
		elif  [ "$pushbot_sheep" -eq "2" ] ;then
			disturb_text="【免打扰】"
			return 1
		fi
	fi
}

# 低频通知去重（仅模式3启用时生效）
# category: 类别（如 device, wifi_conn, wifi_disc, web_login, ssh_login）
# value: 标识值（MAC 或 IP）
# window: 时间窗口（支持秒/分/时/天，如 "1800" "30m" "1h" "8h" "1d"）
# 返回：0=可以发送，1=跳过（已在低频窗口内发送过）
function check_dnd_limit(){
	local category="$1"
	local value="$2"
	local window_raw="${3:-1800}"
	
	# 模式3才启用低频检查
	[ "$pushbot_sheep" != "3" ] && return 0
	
	local window_sec=$(parse_timeout "$window_raw")
	[ "$window_sec" -le 0 ] && window_sec=1800  # 默认30分钟
	
	local now=$(date +%s)
	local state_file="${dir}dnd_${category}_${value}"
	
	# 检查状态文件
	if [ -f "$state_file" ]; then
		local last=$(cat "$state_file" 2>/dev/null)
		[ $((now - last)) -lt "$window_sec" ] && return 1  # 在窗口内，跳过
	fi
	
	# 记录本次时间戳
	echo "$now" > "$state_file"
	return 0  # 可以发送
}

