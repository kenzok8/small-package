	[ -f "${dir}ipAddress" ] && [ -z "$tmp_name" ] && local tmp_name=`cat ${dir}ipAddress|grep -w ${1}|awk '{print $3}'|grep -v "^$"|sort -u|head -n1`
	[ -f "${dir}tmp_downlist" ] && [ -z "$tmp_name" ] && local tmp_name=`cat ${dir}tmp_downlist|grep -w ${1}|awk '{print $3}'|grep -v "^$"|sort -u|head -n1`
	( ! echo "$tmp_name"|grep -q -w "unknown\|*" ) && [ ! -z "$tmp_name" ] && echo "$tmp_name" && return || unset tmp_name # 为unknown时重新读取
	[ -f "/var/dhcp.leases" ] && [ -z "$tmp_name" ] && local tmp_name=`cat /var/dhcp.leases|grep -w ${1}|awk '{print $4}'|grep -v "^$"|sort -u|head -n1`
	( ! echo "$tmp_name"|grep -q -w "unknown\|*" ) && [ ! -z "$tmp_name" ] && echo "$tmp_name" && return || unset tmp_name # 为unknown时重新读取
	[ -z "$dhcp_config" ] && dhcp_config=`uci show dhcp|grep "ip\|mac\|name"`
	for dhcp_config_str in "host" "domain"; do
		local dhcp_ip_n=`echo "$dhcp_config"|grep -w ^dhcp.@${dhcp_config_str}.*ip=.${1}|sed -nr 's#^dhcp.(.*).ip.*#\1#gp'` 2>/dev/null
		[ ! -z "$dhcp_ip_n" ] && [ -z "$tmp_name" ] && local tmp_name=`uci get dhcp.${dhcp_ip_n}.name` 2>/dev/null
		local dhcp_mac_n=`echo "$dhcp_config"|grep -i ^dhcp.@${dhcp_config_str}.*mac=.${2}|sed -nr 's#^dhcp.(.*).mac.*#\1#gp'` 2>/dev/null
		[ ! -z "$dhcp_mac_n" ] && [ -z "$tmp_name" ] && local tmp_name=`uci get dhcp.${dhcp_ip_n}.name` 2>/dev/null
		[ ! -z "$tmp_name" ] && break
	done
	( ! echo "$tmp_name"|grep -q -w "unknown\|*" ) && [ ! -z "$tmp_name" ] && echo "$tmp_name" && return || unset tmp_name # 为unknown时重新读取
	[ -f "$oui_base" ] && local tmp_name=$(cat $oui_base|grep -i $(echo "$2"|cut -c 1,2,4,5,7,8)|sed -nr 's#^.*16)..(.*)#\1#gp'|sed 's/ /_/g')
	[ ! -z "$oui_data" ] && [ "$oui_data" -eq "4" ] && local tmp_name=$(curl -sS "https://standards-oui.ieee.org/oui/oui.txt"|grep -i $(echo "$2"|cut -c 1,2,4,5,7,8)|sed -nr 's#^.*16)..(.*)#\1#gp'|sed 's/ /_/g')
	[ -z "$tmp_name" ] && local tmp_name="unknown"
	echo "$tmp_name"
}

# 查询设备接口
function getinterface(){
	[ -f "${dir}ipAddress" ] && local ip_interface=`cat ${dir}ipAddress|grep -w ${1}|awk '{print $5}'|grep -v "^$"|sort -u|head -n1`
	[ -f "${dir}tmp_downlist" ] && [ -z "$ip_interface" ] && local ip_interface=`cat ${dir}tmp_downlist|grep -w ${1}|awk '{print $5}'|grep -v "^$"|sort -u|head -n1`
	if [ -z "$ip_interface" ] && [ ! -z "$wlan_interface" ]; then
		for interface in $wlan_interface; do
			local ip_interface=`iw dev $interface station dump 2>/dev/null|grep Station|grep -i -w ${1}|sed -nr 's#^.*on (.*))#\1#gp'` >/dev/null 2>&1
			[ ! -z "$ip_interface" ] && echo "$ip_interface" && return
		done
	fi
	[ -z "$ip_interface" ] && local ip_interface=`cat /proc/net/arp|grep "0x2\|0x6"|grep -i -w ${1}|awk '{print $6}'|grep -v "^$"|sort -u|head -n1`
	echo "$ip_interface"
}

# ping
function getping(){
	[ "$iw_version" ] && local wlan_online=`iw dev ${ip_interface} station dump|grep -i -w ${ip_mac}|grep Station` >/dev/null 2>&1
	[ "$wlan_online" ] && return 0
	for i in `seq 1 ${3}`; do
		( ! echo "$ip_ms"|grep -q "ms" ) && local ip_ms=$( arping -I `cat /proc/net/arp|grep -w ${1}|awk '{print $6}'|grep -v "^$"|sort -u|head -n1` -c 20 -f -w ${2} $1 ) 2>/dev/null
		( ! echo "$ip_ms"|grep -q "ms" ) && local ip_ms=`ping -c 5 -w ${2} ${1}|grep -v '100% packet loss'` 2>/dev/null
		( ! echo "$ip_ms"|grep -q "ms" ) && sleep 1
	done
	( echo "$ip_ms"|grep -q "ms" )
}

# CPU 占用率
function getcpu(){
	local AT=$(cat /proc/stat|grep "^cpu "|awk '{print $2+$3+$4+$5+$6+$7+$8 " " $2+$3+$4+$7+$8}')
	sleep 3
	local BT=$(cat /proc/stat|grep "^cpu "|awk '{print $2+$3+$4+$5+$6+$7+$8 " " $2+$3+$4+$7+$8}')
	printf "%.01f%%" $(echo ${AT} ${BT}|awk '{print (($4-$2)/($3-$1))*100}')
}

# 获取SOC温度 （取所有传感器温度最大值）
function soc_temp(){
	[ -z "$soc_code" ] && local soctemp=`sensors 2>/dev/null|grep °C|sed -nr 's#^.*:.*\+(.*)°C .*#\1#gp'|sort -nr|head -n1`
	[ -z "$soc_code" ] && [ -z "$soctemp" ] && local soctemp=`cat /sys/class/thermal/thermal_zone*/temp 2>/dev/null|sort -nr|head -n1|cut -c-2`
	[ "$soc_code" == "pve" ] && [ ! -z "$pve_host" ] && local soctemp=`ssh -i ~/.ssh/id_rsa root@${pve_host} -p ${pve_port} sensors 2>/dev/null|grep °C|sed -nr 's#^.*:.*\+(.*)°C .*#\1#gp'|sort -nr|head -n1`
	[ ! -z "$soctemp" ] && echo "$soctemp" && return
	[ ! -z "$soc_code" ] && eval `echo "$soc_code"` 2>/dev/null
}

# 流量数据查询（数据源由全局变量 traffic_source 决定，启动时一次性探测）
function usage(){
	[ ! "$1" ] && return
	if [ $1 == "update" ] ;then
		# nlbwmon 为实时 daemon（socket 查询），无需手动刷新；仅 wrtbwmon 时需要
		if [ "$traffic_source" = "nlbw" ]; then
			return
		fi
		# ---- wrtbwmon 路径 ----
		[ ! -f "/usr/sbin/wrtbwmon" ] && return
		function version_ge() {
			local a=$(echo "$1"|sed 's/-r[0-9]*$//;s/[^0-9.]//g') b=$(echo "$2"|sed 's/-r[0-9]*$//;s/[^0-9.]//g')
			local a1=$(echo "$a"|cut -d. -f1) a2=$(echo "$a"|cut -d. -f2) a3=$(echo "$a"|cut -d. -f3)
			local b1=$(echo "$b"|cut -d. -f1) b2=$(echo "$b"|cut -d. -f2) b3=$(echo "$b"|cut -d. -f3)
			[ "${a1:-0}" -gt "${b1:-0}" ] 2>/dev/null && return 0
			[ "${a1:-0}" -lt "${b1:-0}" ] 2>/dev/null && return 1
			[ "${a2:-0}" -gt "${b2:-0}" ] 2>/dev/null && return 0
			[ "${a2:-0}" -lt "${b2:-0}" ] 2>/dev/null && return 1
			[ "${a3:-0}" -ge "${b3:-0}" ] 2>/dev/null
		}
		local wrv=$(echo "$wr_version"|sed 's/-r[0-9]*$//')
		if [ ! -z "$wrv" ] && version_ge "$wrv" "1.2.0"; then
			wrtbwmon -f ${dir}usage.db >/dev/null 2>&1
		else
			wrtbwmon update ${dir}usage.db >/dev/null 2>&1
		fi
		local dbrows_after=$(grep -c "," ${dir}usage.db 2>/dev/null)
		[ -z "$dbrows_after" ] && dbrows_after="0"
		[ "$dbrows_after" -gt "1" ] && return
		if [ ! -z "$wrv" ] && version_ge "$wrv" "1.2.0"; then
			wrtbwmon update ${dir}usage.db >/dev/null 2>&1
		else
			wrtbwmon -f ${dir}usage.db >/dev/null 2>&1
		fi
		local dbrows_after2=$(grep -c "," ${dir}usage.db 2>/dev/null)
		[ -z "$dbrows_after2" ] && dbrows_after2="0"
		[ "$dbrows_after2" -gt "1" ] && return
		wrtbwmon setup ${dir}usage.db >/dev/null 2>&1
		wrtbwmon update ${dir}usage.db >/dev/null 2>&1
		return
	elif [ $1 == "get" ] ;then
		local tmptotal=""
		if [ "$traffic_source" = "nlbw" ] && [ ! -z "$2" ]; then
			tmptotal=$(nlbw -c csv -s, -q -n -g mac 2>/dev/null | awk -F',' -v m="$(echo "$2"|tr 'A-Z' 'a-z')" 'NR>1 && $1==m {print $3+$5; exit}')
		fi
		# wrtbw 回落（nlbw 模式下 MAC 不在 nlbw 中时回落，wrtbw 模式下直接走这里）
		if [ "$traffic_source" = "wrtbw" ] || [ -z "$tmptotal" ]; then
			local dbrows=$(grep -c "," ${dir}usage.db 2>/dev/null)
			[ -z "$dbrows" ] && dbrows="0"
			if [ "$dbrows" -gt "1" ]; then
				[ -z "$total_n" ] && total_n=`cat ${dir}usage.db|head -n1|grep "total"|sed 's/,/\n/g'|awk '/total/{print NR}'` 2>/dev/null
				[ -z "$total_n" ] && total_n="6"
				[ "$2" ] && local tmptotal2=`cat ${dir}usage.db|sed 's/,,,/,0,0,/g'|sed 's/,,/,0,/g'|sed 's/,/ /g'|grep -i -w ${2}|awk "{print "'$'$total_n"}"|grep -v "^$"|sort -u|head -n1` 2>/dev/null
			fi
			[ ! -z "$tmptotal2" ] && tmptotal="$tmptotal2"
		fi
		[ -z "$tmptotal" ] && local tmptotal="0"
		[ ! "$3" ] && echo `bytes_for_humans ${tmptotal}` || echo "$tmptotal"
	elif [ $1 == "list" ] ;then
		# 输出 "mac total_bytes" 列表(供 LuCI 在线设备表格)
		if [ "$traffic_source" = "nlbw" ]; then
			nlbw -c csv -s, -q -n -g mac 2>/dev/null | awk -F',' 'NR>1 && $1!="mac" {print tolower($1)" "$3+$5}'
			return
		fi
		# wrtbw 模式
		local dbrows=$(grep -c "," ${dir}usage.db 2>/dev/null)
		[ -z "$dbrows" ] && dbrows="0"
		if [ "$dbrows" -gt "1" ]; then
			[ -z "$total_n" ] && total_n=`cat ${dir}usage.db|head -n1|grep "total"|sed 's/,/\n/g'|awk '/total/{print NR}'` 2>/dev/null
			[ -z "$total_n" ] && total_n="6"
			cat ${dir}usage.db|sed 's/,,,/,0,0,/g'|sed 's/,,/,0,/g'|sed 's/,/ /g'|grep -v "^#"|grep -v "^$"|awk -v n="$total_n" 'NR>1 && $1!="mac" {print tolower($1)" "$n}'
		fi
	elif [ $1 == "down" ] ;then
		[ "$2" ] && sed -i "/,${2},/d" ${dir}usage.db 2>/dev/null
	fi
}

# 流量数据单位换算
function bytes_for_humans {
	[ ! "$1" ] && return
	[ "$1" -gt 1073741824 ] && echo "`awk 'BEGIN{printf "%.2f\n",'$1'/'1073741824'}'` G" && return
	[ "$1" -gt 1048576 ] && echo "`awk 'BEGIN{printf "%.2f\n",'$1'/'1048576'}'` M" && return
	[ "$1" -gt 1024 ] && echo "`awk 'BEGIN{printf "%.2f\n",'$1'/'1024'}'` K" && return
	echo "${1} bytes"
}

# 设备异常流量检测
function get_client_usage(){
	[ -z "$client_usage" ] && return
	[ "$client_usage" -ne "1" ] && return
	[ -z "$client_usage_max" ] && return
	[ -z "$get_client_usage_time" ] && get_client_usage_time=`date +%s`
	( echo $client_usage_max|sed -r 's/.*(.)$/\1/'|grep -q "K\|k" ) && client_usage_max=`expr ${client_usage_max%?} \* 1024`
	( echo $client_usage_max|sed -r 's/.*(.)$/\1/'|grep -q "M\|m" ) && client_usage_max=`expr ${client_usage_max%?} \* 1048576`
	( echo $client_usage_max|sed -r 's/.*(.)$/\1/'|grep -q "G\|g" ) && client_usage_max=`expr ${client_usage_max%?} \* 1073741824`
	[ -z "$client_usage_disturb" ] && client_usage_disturb="0"
	[ "$client_usage_disturb" -eq "0" ] && [ -f "${dir}ipAddress" ] && local MACLIST=`cat ${dir}ipAddress|awk '{print $2}'|grep -v "^$"|sort -u`
	[ "$client_usage_disturb" -eq "1" ] && [ ! -z "$client_usage_whitelist" ] && local MACLIST=`echo "$client_usage_whitelist"`
	[ -z "$MACLIST" ] && return

	if [ "$((`date +%s`-$get_client_usage_time))" -ge "$sleeptime" ] && [ "$sleeptime" -ge "10" ]; then
		> ${dir}client_usage_aliases
		local _now=$(date +%s)
		for mac in $MACLIST; do
			( ! cat ${dir}ipAddress|grep -q -i -w $mac|grep -v "^$"|sort -u|head -n1 ) && continue
			echo "$mac" `usage get ${mac} bytes` >> ${dir}client_usage_aliases
			[ -f "${dir}old_client_usage_aliases" ] && get_client_usage_bytes=`cat ${dir}old_client_usage_aliases|grep -i -w $mac|awk '{print $2}'|grep -v "^$"|sort -u|head -n1` || continue
			[ -z "$get_client_usage_bytes" ] && get_client_usage_bytes="0"
			# 上线首屏静默：设备在线时间不足 2 个检测周期，记录快照但不触发告警
			local _up_ts=$(cat ${dir}ipAddress|grep -i -w ${mac}|awk '{print $4}'|grep -v "^$"|sort -u|head -n1)
			[ ! -z "$_up_ts" ] && [ "$((_now - _up_ts))" -lt "$((sleeptime * 2))" ] && continue
			if [ "$((`usage get ${mac} bytes`-$get_client_usage_bytes))" -ge "$client_usage_max" ]; then
				local ip=`cat ${dir}ipAddress|grep -i -w $mac|awk '{print $1}'|grep -v "^$"|sort -u|head -n1`
				local ip_name=`getname ${ip} ${mac}`
				local tmp_usage=$(bytes_for_humans $(expr `usage get ${mac} bytes` - ${get_client_usage_bytes}))
				local time_up=`cat ${dir}ipAddress|grep -w ${ip}|awk '{print $4}'|grep -v "^$"|sort -u|head -n1`
				local ip_total=`usage get $mac`
				local time1=`date +%s`
				local time1=$(time_for_humans `expr ${time1} - ${time_up}`)
				if [ "$table_enable" = "1" ]; then
					[ ! -z "$ip_total" ] && local ip_total_v="$ip_total" || local ip_total_v=""
					local info="$(table_body "客户端名" "${ip_name}" "客户端IP" "${ip}" "客户端MAC" "${mac}" "总计流量" "${ip_total_v}" "检测间隔内流量" "${tmp_usage}" "在线时间" "${time1}")"
					if [ -z "$title" ]; then
						title="${ip_name} 流量异常"
						content="${content}${str_splitline}${str_title_start}${font_fail} 设备流量异常${font_end}${str_title_end}${info}"
					elif ( echo "$title"|grep -q "流量异常" ); then
						title="${ip_name} ${title}"
						content="${content}${str_splitline}${info}"
					else
						title="设备状态变化"
						content="${content}${str_splitline}${str_title_start}${font_fail} 设备流量异常${font_end}${str_title_end}${info}"
					fi
				else
					[ ! -z "$ip_total" ] && local ip_total="${str_linefeed}${str_tab}总计流量： ${str_space}${str_space}${str_space}${str_space}${ip_total}"
					if [ -z "$title" ]; then
						title="${ip_name} 流量异常"
						content="${content}${str_splitline}${str_title_start}${font_fail} 设备流量异常${font_end}${str_title_end}${str_linefeed}${str_tab}客户端名：${str_space}${str_space}${str_space}${str_space}${str_space}${ip_name}${str_linefeed}${str_tab}客户端IP： ${str_space}${str_space}${str_space}${str_space}${ip}${str_linefeed}${str_tab}客户端MAC：${str_space}${str_space}${str_space}${str_space}${mac}$ip_total${str_linefeed}${str_tab}检测间隔内流量： ${str_space}${str_space}${tmp_usage}${str_linefeed}${str_tab}在线时间： ${str_space}${str_space}${str_space}${str_space}${time1}"
					elif ( echo "$title"|grep -q "流量异常" ); then
						title="${ip_name} ${title}"
						content="${content}${str_splitline}${str_tab}客户端名：${str_space}${str_space}${str_space}${str_space}${str_space}${ip_name}${str_linefeed}${str_tab}客户端IP： ${str_space}${str_space}${str_space}${str_space}${ip}${str_linefeed}${str_tab}客户端MAC：${str_space}${str_space}${str_space}${str_space}${mac}$ip_total${str_linefeed}${str_tab}检测间隔内流量： ${str_space}${str_space}${str_space}${tmp_usage}${str_linefeed}${str_tab}在线时间： ${str_space}${str_space}${str_space}${str_space}${time1}"
					else
						title="设备状态变化"
						content="${content}${str_splitline}${str_title_start}${font_fail} 设备流量异常${font_end}${str_title_end}${str_linefeed}${str_tab}客户端名：${str_space}${str_space}${str_space}${str_space}${str_space}${ip_name}${str_linefeed}${str_tab}客户端IP： ${str_space}${str_space}${str_space}${str_space}${ip}${str_linefeed}${str_tab}客户端MAC：${str_space}${str_space}${str_space}${str_space}${mac}$ip_total${str_linefeed}${str_tab}检测间隔内流量： ${str_space}${str_space}${str_space}${tmp_usage}${str_linefeed}${str_tab}在线时间： ${str_space}${str_space}${str_space}${str_space}${time1}"
					fi
				fi
			fi
		done
		cat ${dir}client_usage_aliases > ${dir}old_client_usage_aliases
		get_client_usage_time=`date +%s`
	fi
}

# 时间单位换算
function time_for_humans {
	[ ! "$1" ] && return
	if [ "$1" -lt 60 ]; then
		echo "${1} 秒"
	elif [ "$1" -lt 3600 ]; then
		local usetime_min=`expr $1 / 60`
		local usetime_sec=`expr $usetime_min \* 60`
		local usetime_sec=`expr $1 - $usetime_sec`
		echo "${usetime_min} 分 ${usetime_sec} 秒"
	elif [ "$1" -lt 86400 ]; then
		local usetime_hour=`expr $1 / 3600`
		local usetime_min=`expr $usetime_hour \* 3600`
		local usetime_min=`expr $1 - $usetime_min`
		local usetime_min=`expr $usetime_min / 60`
		echo "${usetime_hour} 小时 ${usetime_min} 分"
	else
		local usetime_day=`expr $1 / 86400`
		local usetime_hour=`expr $usetime_day \* 86400`
		local usetime_hour=`expr $1 - $usetime_hour`
		local usetime_hour=`expr $usetime_hour / 3600`
		echo "${usetime_day} 天 ${usetime_hour} 小时"
	fi
}

# 计算字符真实长度
function length_str {
	[ ! "$1" ] && return
	# 显示宽度: ASCII 按 1, UTF-8 多字节(中文等)按 2 — busybox awk 兼容(无 gensub/\u 转义)
	echo "$1" | awk '{ n=0; i=1; L=length($0); while(i<=L){ c=substr($0,i,1); if (c < "\200") { n+=1; i+=1 } else { n+=2; i+=3 } } print n }'
}

# 截取字符，避免中文乱码
function cut_str {
	[ ! "$1" ] && return
	[ ! "$2" ] && return
	[ `length_str $1` -le "$2" ] && echo "$1" && return
	local temp_length=$2
	while [ $(length_str `echo "$1"|cut -c -$temp_length`) -lt "$2" ]; do
		temp_length=`expr $temp_length + 1`
	done
	while [ $(printf "%d" \'`echo "$1"|cut -c $temp_length`) -ge "128" ] && [ $(printf "%d" \'`echo "$1"|cut -c $temp_length`) -lt "224" ]; do
		temp_length=`expr $temp_length + 1`
	done
	temp_length=`expr $temp_length - 1`
	echo $(echo "$1"|cut -c -$temp_length)"..."
}

# 随机数
function rand(){
    local min=$1
    local max=$(($2- $min + 1))
    local num=$(date +%s%N)
    echo $(($num % $max + $min))
}

# 在线设备列表
function pushbot_first(){
	[ -f "${dir}ipAddress" ] && local IPLIST=`cat ${dir}ipAddress|awk '{print $1}'|grep -v "^$"|sort -u`
	for ip in $IPLIST; do
		read -t 15 -u 5
		{
			down $ip
			echo "" >&5
		}&
	done
	wait
	unset ip IPLIST
	local IPLIST=`cat /proc/net/arp|grep "0x2\|0x6"|awk '{print $1}'|grep -v "^169.254."|grep -v "^$"|sort -u|grep -oE '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}'`
	for ip in $IPLIST; do
		read -t 15 -u 5
		{
			up $ip
			echo "" >&5
		}&
	done
	wait
}
# 创建计划任务
function pushbot_cron(){
	function del_cron(){
		( echo `crontab -l 2>/dev/null`|grep -q "pushbot" ) && crontab -l > conf && sed -i "/pushbot/d" conf && crontab conf && rm -f conf >/dev/null 2>&1
	}
	function re_cron(){
		/etc/init.d/cron stop
		/etc/init.d/cron start
	}
	del_cron
	# 总开关关闭(=0)/空/异常值都不注册定时任务：
	# 旧代码只判 [ -z ]（"0" 非空→false），导致关闭后 crontab 照常注册、cron 继续 send
	if [ -z "$pushbot_enable" ] || [ "$pushbot_enable" != "1" ]; then
		re_cron
		return
	fi

	# 重置流量（零点执行，由 reset_traffic 按流量源分别清除）
	if [ ! -z "$reset_regularly" ] && [ "$reset_regularly" -eq "1" ]; then
		crontab -l 2>/dev/null > conf && echo -e "0 0 * * * /usr/bin/pushbot/pushbot reset_traffic >/dev/null 2>&1" >> conf && crontab conf && rm -f conf >/dev/null 2>&1
	fi
	# 定时/间隔严格互斥，以 crontab 开关为准（1=定时发送，2=间隔发送）
	# 避免切换模式后残留字段（regular_time* / interval_time）误触发错误分支
	if [ "$crontab" = "2" ] && [ ! -z "$interval_time" ]; then
		# 间隔发送
		crontab -l 2>/dev/null > conf && echo -e "0 */$interval_time * * * /usr/bin/pushbot/pushbot send &" >> conf && crontab conf && rm -f conf >/dev/null 2>&1
	elif [ "$crontab" = "1" ] && { [ ! -z "$regular_time" ] || [ ! -z "$regular_time_2" ] || [ ! -z "$regular_time_3" ]; }; then
		# 定时发送（兼容旧配置：crontab 未设置但 regular_time* 有值）
		# 第二、三时段值为 0 时视为"禁用"残留（旧版把 Disabled 存成 0），过滤掉；
		# 主时段 regular_time=0 是合法的"0 点发送"，保留。
		[ ! -z "$regular_time_2" ] && [ "$regular_time_2" != "0" ] && local regular_time_2=",${regular_time_2}" || local regular_time_2=""
		[ ! -z "$regular_time_3" ] && [ "$regular_time_3" != "0" ] && local regular_time_3=",${regular_time_3}" || local regular_time_3=""
		crontab -l 2>/dev/null > conf && echo -e "0 $regular_time$regular_time_2$regular_time_3 * * * /usr/bin/pushbot/pushbot send &" >> conf && crontab conf && rm -f conf >/dev/null 2>&1
	elif [ -z "$crontab" ] && { [ ! -z "$regular_time" ] || [ ! -z "$regular_time_2" ] || [ ! -z "$regular_time_3" ] || [ ! -z "$interval_time" ]; }; then
		# 旧版兼容：crontab 未设置时，按 legacy 逻辑（定时优先，其次间隔）
		if [ ! -z "$regular_time" ] || [ ! -z "$regular_time_2" ] || [ ! -z "$regular_time_3" ]; then
			[ ! -z "$regular_time_2" ] && [ "$regular_time_2" != "0" ] && local regular_time_2=",${regular_time_2}" || local regular_time_2=""
			[ ! -z "$regular_time_3" ] && [ "$regular_time_3" != "0" ] && local regular_time_3=",${regular_time_3}" || local regular_time_3=""
			crontab -l 2>/dev/null > conf && echo -e "0 $regular_time$regular_time_2$regular_time_3 * * * /usr/bin/pushbot/pushbot send &" >> conf && crontab conf && rm -f conf >/dev/null 2>&1
		elif [ ! -z "$interval_time" ]; then
			crontab -l 2>/dev/null > conf && echo -e "0 */$interval_time * * * /usr/bin/pushbot/pushbot send &" >> conf && crontab conf && rm -f conf >/dev/null 2>&1
		fi
	fi
	re_cron
}

# 免打扰检测
function pushbot_disturb(){
	# 模式3：低频通知，全天候生效，由 check_dnd_limit 控制去重，不受时间段限制
	[ "$pushbot_sheep" = "3" ] && return 0
	[ -z "$pushbot_sheep" ] || [ -z "$starttime" ] || [ -z "$endtime" ] && return 0
	if [ `date +%H` -ge $endtime -a $starttime -lt $endtime ] || [ `date +%H` -lt $starttime -a $starttime -lt $endtime ] || [ `date +%H` -lt $starttime -a `date +%H` -ge $endtime -a $starttime -gt $endtime ]; then
		unset sheep_starttime
		rm -f ${dir}sheep_usage ${dir}old_sheep_usage  2>/dev/null
		disturb_text=`/usr/bin/jq -r '._api' ${jsonpath}`
		return 0
	else
		[ -z "$sheep_starttime" ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【免打扰】夜深了，该休息了" >> ${logfile} && sheep_starttime=`date +%s`
		if [ "$pushbot_sheep" -eq "1" ] ;then
			while [ `date +%H` -lt "$endtime" ]; do
				enable_detection
				sleep $sleeptime
			done
		elif  [ "$pushbot_sheep" -eq "2" ] ;then
			disturb_text="【免打扰】"
			return 1
		fi
	fi
}

# 低频通知去重（仅模式3启用时生效）
# category: 类别（如 device, wifi_conn, wifi_disc, web_login, ssh_login）
# value: 标识值（MAC 或 IP）
# window: 时间窗口（支持秒/分/时/天，如 "1800" "30m" "1h" "8h" "1d"）
# 返回：0=可以发送，1=跳过（已在低频窗口内发送过）
function check_dnd_limit(){
	local category="$1"
	local value="$2"
	local window_raw="${3:-1800}"
	
	# 模式3才启用低频检查
	[ "$pushbot_sheep" != "3" ] && return 0
	
	local window_sec=$(parse_timeout "$window_raw")
	[ "$window_sec" -le 0 ] && window_sec=1800  # 默认30分钟
	
	local now=$(date +%s)
	local state_file="${dir}dnd_${category}_${value}"
	
	# 检查状态文件
	if [ -f "$state_file" ]; then
		local last=$(cat "$state_file" 2>/dev/null)
		[ $((now - last)) -lt "$window_sec" ] && return 1  # 在窗口内，跳过
	fi
	
	# 记录本次时间戳
	echo "$now" > "$state_file"
	return 0  # 可以发送
}

# 文件锁
function LockFile(){
	if [ $1 = "lock" ] ;then
		[ ! -f "${dir}pushbot.lock" ] && > ${dir}pushbot.lock && return
		while [ -f "${dir}pushbot.lock" ]; do
			enable_detection 1
		done
		LockFile lock
	fi
	[ $1 = "unlock" ] && rm -f ${dir}pushbot.lock >/dev/null 2>&1
	return 0
}

