						content="${content}${str_splitline}${str_title_start}${font_fail} 登录失败来源${font_end}${str_title_end}${str_linefeed}${str_tab}设备 IP： ${str_space}${str_space}${str_space}${str_space}${login_ip}"
					fi
				fi
			fi
			# 只有拉黑功能启用时才执行拉黑操作
			if [ "$web_login_black" = "1" ]; then
				# 先尝试拉黑（add_ip_black 内部会做本机/白名单保护），
				# 成功(未被拦截)才清除失败记录；被拦截则保留记录供后续重试。
				if add_ip_black $login_ip; then
					sed -i "/^${login_ip}$/d" ${dir}web_failed
					echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】设备 ${login_ip} 通过 Web 频繁尝试登录" >> ${logfile}
				else
					echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】设备 ${login_ip} 触发拉黑但被本机/白名单保护拦截，保留记录待后续确认" >> ${logfile}
				fi
			fi
		fi
	done
	unset login_ip

	local login_ip_list=`cat ${dir}ssh_failed|awk '{print $1}'|grep -v "^$"|sort -u|head -n1`
	for login_ip in $login_ip_list; do
		[ -z "$login_ip" ] && continue
		# 本机地址硬保护：本机探测/回环即使失败也不拉黑，清除记录避免阻塞队列
		is_local_address "$login_ip" && { sed -i "/^${login_ip}$/d" ${dir}ssh_failed 2>/dev/null; continue; }
		ip_in_whitelist "$login_ip" && { sed -i "/^${login_ip}$/d" ${dir}ssh_failed 2>/dev/null; continue; }
		local ssh_login_sum=`cat ${dir}ssh_failed|grep -w "${login_ip}"|wc -l`
		if [ -z "$login_max_num" ]; then
			local login_max_num=5   # 未配置时默认 5 次失败触发拉黑，避免空值比较异常
		fi
		if [ "$ssh_login_sum" -ge "$login_max_num" ] ;then
			if [ ! -z "$ssh_login_failed" ] && [ "$ssh_login_failed" -eq "1" ]; then
				if [ "$table_enable" = "1" ]; then
					local LF='\n'
					local info="${LF}| **设备 IP** | ${login_ip} |${LF}| --- | --- |"
					if [ -z "$title" ]; then
						title="${login_ip} 通过 SSH 频繁尝试登录"
						content="${content}${str_splitline}${str_title_start}${font_fail} 登录失败来源${font_end}${str_title_end}${info}"
					elif ( echo "$title"|grep -q "频繁尝试登录" ); then
						title="${login_ip} ${title}"
						content="${content}${str_splitline}${info}"
					else
						title="设备状态变化"
						content="${content}${str_splitline}${str_title_start}${font_fail} 登录失败来源${font_end}${str_title_end}${info}"
					fi
				else
					if [ -z "$title" ]; then
						title="${login_ip} 通过 SSH 频繁尝试登录"
						content="${content}${str_splitline}${str_title_start}${font_fail} 登录失败来源${font_end}${str_title_end}${str_linefeed}${str_tab}设备 IP： ${str_space}${str_space}${str_space}${str_space}${login_ip}"
					elif ( echo "$title"|grep -q "频繁尝试登录" ); then
						title="${login_ip} ${title}"
						content="${content}${str_splitline}${str_tab}设备 IP： ${str_space}${str_space}${str_space}${str_space}${login_ip}"
					else
						title="设备状态变化"
						content="${content}${str_splitline}${str_title_start}${font_fail} 登录失败来源${font_end}${str_title_end}${str_linefeed}${str_tab}设备 IP： ${str_space}${str_space}${str_space}${str_space}${login_ip}"
					fi
				fi
			fi
			# 只有拉黑功能启用时才执行拉黑操作
			if [ "$web_login_black" = "1" ]; then
				# 先尝试拉黑，成功(未被保护拦截)才清除失败记录
				if add_ip_black $login_ip; then
					sed -i "/^${login_ip}$/d" ${dir}ssh_failed
					echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】设备 ${login_ip} 通过 SSH 频繁尝试登录" >> ${logfile}
				else
					echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】设备 ${login_ip} 触发拉黑但被本机/白名单保护拦截，保留记录待后续确认" >> ${logfile}
				fi
			fi
		fi
	done
	unset login_ip

	# ── WiFi 连接/认证失败检测 ──
	# MT798x 等内核级 WiFi 日志不被 logread -f 捕获，改用 logread 读取最近日志
	if [ "$wifi_connected" = "1" ] || [ "$wifi_auth_failed" = "1" ]; then
		if [ ! -z "$wlan_interface" ]; then
			# 获取当前在线 WiFi 设备 MAC 列表（iwinfo 兼容 MTK 闭源和标准开源驱动）
			# 两套驱动统一精准判断：
			#   开源 mac80211：iw station get → authorized=yes（WPA 握手完成）
			#   MTK 闭源：dmesg SETKEYS DONE（内核级 WPA 握手完成标记）
			local wifi_cur_macs=""
			local wifi_cur_ssids=""
			# 闭源驱动：一次性读取 dmesg SETKEYS DONE 的 MAC 列表（0.02s）
			local _setkeys_macs=""
			if ! iw dev >/dev/null 2>&1; then
				_setkeys_macs=$(dmesg 2>/dev/null | grep "SETKEYS DONE" | grep -ioE "from [0-9a-f:]+" | sed 's/from //i' | tr 'A-Z' 'a-z')
			fi
			for _wif in $wlan_interface; do
				local _assoc=$(iwinfo ${_wif} assoclist 2>/dev/null)
				[ ! -z "$_assoc" ] && [ "$_assoc" != "No station connected" ] && {
					local _macs=$(echo "$_assoc" | grep -ioE "([0-9a-f]{2}:){5}[0-9a-f]{2}" | tr 'A-Z' 'a-z')
					local _ssid=$(iwinfo ${_wif} info 2>/dev/null | sed -n 's/.*ESSID: *"//;s/"$//p')
					for _m in $_macs; do
						local _authorized=""
						# 开源 mac80211：用 iw 检查 authorized
						_authorized=$(iw dev ${_wif} station get $_m 2>/dev/null | grep "authorized:" | awk '{print $2}')
						# MTK 闭源：iw 不可用 → _authorized 为空 → 改用 dmesg SETKEYS DONE
						if [ -z "$_authorized" ] && [ ! -z "$_setkeys_macs" ]; then
							echo "$_setkeys_macs" | grep -q -i -w "$_m" && _authorized="yes"
						fi
						if [ "$_authorized" = "yes" ]; then
							wifi_cur_macs="${wifi_cur_macs} ${_m}"
							wifi_cur_ssids="${wifi_cur_ssids} ${_ssid}"
						fi
					done
				}
			done

			# 读取上次在线列表
			local wifi_prev_macs=""
			[ -f "${dir}wifi_cur" ] && wifi_prev_macs=$(cat ${dir}wifi_cur 2>/dev/null)
			# 保存当前列表
			echo "$wifi_cur_macs" > ${dir}wifi_cur

			# WiFi 连接通知：当前有、上次没有 = 新连接
			# 两套驱动已在采集阶段统一过滤，进到这里的都是 authorized=yes 的真连接
			if [ "$wifi_connected" = "1" ]; then
				local _new_macs="" _new_ssids="" _new_count=0 _idx=0
				for wifi_mac in $wifi_cur_macs; do
					[ -z "$wifi_mac" ] && continue
					[ -f "${dir}wifi_notified" ] && grep -q -i -w "${wifi_mac}" ${dir}wifi_notified 2>/dev/null && continue
					echo "$wifi_prev_macs" | grep -q -i -w "${wifi_mac}" && continue
					# 低频通知检查（模式3）：同一设备WiFi连接通知，在时间窗口内只通知一次
					if ! check_dnd_limit "wifi_conn" "$wifi_mac" "$dnd_low_range"; then
						echo "`date "+%Y-%m-%d %H:%M:%S"` ${disturb_text}WiFi 设备 ${wifi_mac} 已连接（低频跳过）" >> ${logfile}
						echo "$wifi_mac" >> ${dir}wifi_notified
						continue
					fi
					echo "$wifi_mac" >> ${dir}wifi_notified
					_new_count=$((_new_count + 1))
					local _ssid=$(echo "$wifi_cur_ssids" | awk -v n=$((_idx+1)) '{print $n}')
					[ -z "$_ssid" ] && _ssid="unknown"
					_new_macs="${_new_macs} ${wifi_mac}"
					_new_ssids="${_new_ssids} ${_ssid}"
				_idx=$((_idx + 1))
				done
				if [ "$_new_count" -gt "0" ]; then
					# 构造 MAC 显示文本（优先显示主机名，无匹配则回落 MAC）
					local _mac_text=""
					if [ "$_new_count" -eq 1 ]; then
						local _dev_mac=$(echo "$_new_macs" | awk '{print $1}')
						local _dev_name=$(getname "" "${_dev_mac}")
						{ [ -z "$_dev_name" ] || [ "$_dev_name" = "unknown" ]; } && _mac_text="${_dev_mac}" || _mac_text="${_dev_name}"
					elif [ "$_new_count" -le 3 ]; then
						local _parts=""
						for _m in $_new_macs; do
							local _n=$(getname "" "${_m}")
							{ [ -z "$_n" ] || [ "$_n" = "unknown" ]; } && _n="${_m}"
							_parts="${_parts}${_parts:+, }${_n}"
						done
						_mac_text="${_parts}"
					else
						_mac_text="多个"
					fi
					# 取第一个 SSID
					local _ssid_text=$(echo "$_new_ssids" | awk '{print $1}')
					[ -z "$_ssid_text" ] && _ssid_text="unknown"
					local wifi_time=$(date "+%Y-%m-%d %H:%M:%S")
					echo "`date "+%Y-%m-%d %H:%M:%S"` WiFi 设备 ${_mac_text} 已连接" >> ${logfile}
					if [ "$table_enable" = "1" ]; then
						local LF='\n'
						local wifi_detail_rows=""
						local _didx=0
						for _dm in $_new_macs; do
							local _dn=$(echo "$_new_ssids" | awk -v n=$((_didx+1)) '{print $n}')
							local _dname=$(getname "" "${_dm}")
							[ "$_dname" = "unknown" ] && _dname="${_dm}"
							wifi_detail_rows="${wifi_detail_rows}${LF}| **${_dname}** | ${_dn} |"
							_didx=$((_didx + 1))
						done
						local wifi_info="${LF}| **设备** | **SSID** |${LF}| --- | --- |${wifi_detail_rows}"
						if [ -z "$title" ]; then
							title="${_mac_text} WiFi 设备已连接"
						fi
						content="${content}${str_splitline}${str_title_start}${font_success} WiFi 连接${font_end}${str_title_end}${wifi_info}"
					else
						if [ -z "$title" ]; then
							title="${_mac_text} WiFi 设备已连接"
						fi
						content="${content}${str_splitline}${str_title_start}${font_success} WiFi 连接${font_end}${str_title_end}${str_linefeed}${str_tab}时间：${str_space}${wifi_time}"
						local _didx_t=0
						for _dm_t in $_new_macs; do
							local _dn_t=$(echo "$_new_ssids" | awk -v n=$((_didx_t+1)) '{print $n}')
							local _dname_t=$(getname "" "${_dm_t}")
							{ [ -z "$_dname_t" ] || [ "$_dname_t" = "unknown" ]; } && _dname_t="${_dm_t}"
							content="${content}${str_linefeed}${str_tab}${_dname_t}（${_dn_t}）"
							_didx_t=$((_didx_t + 1))
						done
					fi
				fi
			fi

			# WiFi 离线通知：上次有、当前没有 + 离线时长 > sleeptime*2
			if [ "$wifi_connected" = "1" ]; then
				local _now=$(date +%s)
				for wifi_mac in $wifi_prev_macs; do
					[ -z "$wifi_mac" ] && continue
					echo "$wifi_cur_macs" | grep -q -i -w "${wifi_mac}" && continue
					# 已离线通知过的 MAC 不重复
					[ -f "${dir}wifi_offline_notified" ] && grep -q -i -w "${wifi_mac}" ${dir}wifi_offline_notified 2>/dev/null && continue
					# 记录首次发现离线时间
					local _offline_file="${dir}wifi_offline_${wifi_mac}"
					if [ -f "$_offline_file" ]; then
						local _first_seen=$(cat "$_offline_file" 2>/dev/null)
						local _duration=$((_now - _first_seen))
						if [ "$_duration" -ge "$((sleeptime * 2))" ]; then
							echo "$wifi_mac" >> ${dir}wifi_offline_notified
							rm -f "$_offline_file"
							# 离线后清除连接通知记录，设备重新连接时可再次通知
							sed -i "/${wifi_mac}/Id" ${dir}wifi_notified 2>/dev/null
							# 低频通知检查（模式3）：同一设备WiFi离线通知，在时间窗口内只通知一次
							if ! check_dnd_limit "wifi_disc" "$wifi_mac" "$dnd_low_range"; then
								echo "`date "+%Y-%m-%d %H:%M:%S"` ${disturb_text}WiFi 设备 ${wifi_mac} 已离线（低频跳过）" >> ${logfile}
								continue
							fi
							echo "`date "+%Y-%m-%d %H:%M:%S"` WiFi 设备 ${wifi_mac} 已离线" >> ${logfile}
							local wifi_time=$(date "+%Y-%m-%d %H:%M:%S")
							local wifi_offline_dur=$(time_for_humans $_duration)
							if [ "$table_enable" = "1" ]; then
								local LF='\n'
								local wifi_info="${LF}| **时间** | ${wifi_time} |${LF}| --- | --- |${LF}| **MAC** | ${wifi_mac} |${LF}| **离线时长** | ${wifi_offline_dur} |"
								if [ -z "$title" ]; then
									title="WiFi 设备已离线"
									content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 离线${font_end}${str_title_end}${wifi_info}"
								elif ( echo "$title"|grep -q "WiFi" ); then
									title="${wifi_mac} ${title}"
									content="${content}${str_splitline}${wifi_info}"
								else
									title="设备状态变化"
									content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 离线${font_end}${str_title_end}${wifi_info}"
								fi
							else
								if [ -z "$title" ]; then
									title="WiFi 设备已离线"
									content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 离线${font_end}${str_title_end}${str_linefeed}${str_tab}时间：${str_space}${wifi_time}${str_linefeed}${str_tab}MAC：${str_space}${wifi_mac}${str_linefeed}${str_tab}离线时长：${str_space}${wifi_offline_dur}"
								elif ( echo "$title"|grep -q "WiFi" ); then
									title="${wifi_mac} ${title}"
									content="${content}${str_splitline}${str_linefeed}${str_tab}时间：${str_space}${wifi_time}${str_linefeed}${str_tab}MAC：${str_space}${wifi_mac}${str_linefeed}${str_tab}离线时长：${str_space}${wifi_offline_dur}"
								else
									title="设备状态变化"
									content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 离线${font_end}${str_title_end}${str_linefeed}${str_tab}时间：${str_space}${wifi_time}${str_linefeed}${str_tab}MAC：${str_space}${wifi_mac}${str_linefeed}${str_tab}离线时长：${str_space}${wifi_offline_dur}"
								fi
							fi
						fi
					else
						echo "$_now" > "$_offline_file"
					fi
				done
			fi
		fi
	fi

	# WiFi 认证失败检测
	# MTK 闭源驱动（mt_wifi 模块）：内核时间戳增量 + 按 MAC 分组（只统计新事件，按设备分组，不重复累计）
	# 开源驱动（hostapd/wpa_supplicant）：原有增量计数方案（保持不变）
	if [ "$wifi_auth_failed" = "1" ]; then
		if lsmod 2>/dev/null | grep -q "^mt_wifi"; then
			# ── MTK 闭源驱动：内核时间戳增量 + 按 MAC 分组 ──
			# 失败事件格式：[6513950.363098] ... Rcv AUTH seq#1, Alg=3, Status=126 from [wcid=1023]86:1f:35:0c:19:bb
			# 提取 (内核时间 MAC) 对，用内核时间戳过滤"上次报告时间"之后的新事件，
			# 避免重复累计报告；成功事件（SETKEYS DONE / Status=0）不在统计范围
			local _fail_events=$(logread 2>/dev/null | tail -1000 | grep "Rcv AUTH seq#1, Alg=3, Status=126" | sed -n 's/.*\[\([0-9.]*\)\].*from \[wcid=[0-9]*\]\([0-9a-fA-F:]*\).*/\1 \2/p')
			local _last_time=0
			[ -f "${dir}wifi_fail_last_time" ] && _last_time=$(cat ${dir}wifi_fail_last_time 2>/dev/null)
			[ -z "$_last_time" ] && _last_time=0
			local _new_events=$(echo "$_fail_events" | awk -v t="$_last_time" '$1+0 > t+0')
			local _new_count=0
			[ ! -z "$_new_events" ] && _new_count=$(echo "$_new_events" | wc -l)
			local _threshold=${login_max_num:-5}
			if [ "$_new_count" -ge "$_threshold" ]; then
				# 按 MAC 分组统计：每行 "MAC 次数"（不去重——多频段/多接口的真实失败都应计入，攻击提醒需反映真实强度）
				local _mac_stats=$(echo "$_new_events" | awk '{count[$2]++} END {for (mac in count) print mac, count[mac]}' | sort)
				# 更新状态文件为最新事件时间（避免下次重复报告本批事件）
				local _max_time=$(echo "$_fail_events" | awk '{print $1}' | sort -n | tail -1)
				[ ! -z "$_max_time" ] && echo "$_max_time" > ${dir}wifi_fail_last_time
				# 日志中补充 MAC 分组信息
				local _mac_summary=$(echo "$_mac_stats" | awk '{printf "%s: %d次, ", $1, $2}' | sed 's/, $//')
				echo "`date "+%Y-%m-%d %H:%M:%S"` ${disturb_text}WiFi 认证失败 ${_new_count} 次（${_mac_summary}）" >> ${logfile}
				if [ "$table_enable" = "1" ]; then
					local LF='\n'
					local _mac_rows=$(echo "$_mac_stats" | awk '{printf "\\n| %s | %s 次 |", $1, $2}')
					local _wifi_fail_info="${LF}| **失败MAC** | **次数** |${LF}| --- | --- |${_mac_rows}"
					if [ -z "$title" ]; then
						title="WiFi 认证失败警告"
						content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 认证失败${font_end}${str_title_end}${_wifi_fail_info}"
					elif ( echo "$title"|grep -q "WiFi" ); then
						content="${content}${str_splitline}${_wifi_fail_info}"
					else
						title="设备状态变化"
						content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 认证失败${font_end}${str_title_end}${_wifi_fail_info}"
					fi
				else
					local _mac_detail=$(echo "$_mac_stats" | awk -v lf="${str_linefeed}" -v tab="${str_tab}" 'NR>1{printf "%s", lf} {printf "%s%s：%s 次", tab, $1, $2}')
					local _wifi_fail_detail="失败 MAC：${str_linefeed}${_mac_detail}"
					if [ -z "$title" ]; then
						title="WiFi 认证失败警告"
						content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 认证失败${font_end}${str_title_end}${str_linefeed}${_wifi_fail_detail}"
					elif ( echo "$title"|grep -q "WiFi" ); then
						content="${content}${str_splitline}${str_linefeed}${_wifi_fail_detail}"
					else
						title="设备状态变化"
						content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 认证失败${font_end}${str_title_end}${str_linefeed}${_wifi_fail_detail}"
					fi
				fi
			fi
		else
			# ── 开源驱动：原有增量计数逻辑 ──
			local _wifi_cur_log=$(logread 2>/dev/null | tail -200)
			local _wifi_cur_count=$(echo "$_wifi_cur_log" | grep -i "PSK-MISMATCH\|deauthenticated due to local auth failure\|verify confirm fail\|EAPOL-Key MIC invalid" | wc -l)
			local _wifi_prev_count=0
			[ -f "${dir}wifi_fail_count" ] && _wifi_prev_count=$(cat ${dir}wifi_fail_count 2>/dev/null)
			echo "$_wifi_cur_count" > ${dir}wifi_fail_count
			local _new_fails=$((_wifi_cur_count - _wifi_prev_count))
			[ "$_new_fails" -lt "0" ] && _new_fails=0
			local _threshold=${login_max_num:-5}
			if [ "$_wifi_cur_count" -ge "$_threshold" ] && { [ "$_wifi_prev_count" -lt "$_threshold" ] || [ "$_new_fails" -gt "0" ]; }; then
				# 提取失败 MAC（开源驱动优先从 logread 提取，MTK 闭源驱动从 dmesg 提取）
				local _wifi_fail_mac=""
				# 开源驱动：从 logread 提取（格式包含 MAC）
				_wifi_fail_mac=$(echo "$_wifi_cur_log" | grep -i "PSK-MISMATCH\|deauthenticated due to local auth failure\|verify confirm fail\|EAPOL-Key MIC invalid" | grep -ioE "([0-9a-f]{2}:){5}[0-9a-f]{2}" | tail -1)
				# MTK 闭源驱动：从 logread 提取所有不同的认证失败 MAC（Alg=3, Status=126）
				if [ -z "$_wifi_fail_mac" ]; then
					_wifi_fail_mac=$(logread 2>/dev/null | tail -500 | grep "Rcv AUTH seq#1, Alg=3, Status=126" | grep -ioE "([0-9a-f]{2}:){5}[0-9a-f]{2}" | sort -u | tr '\n' ',' | sed 's/,$//')
				fi
				echo "`date "+%Y-%m-%d %H:%M:%S"` ${disturb_text}WiFi 认证失败 ${_wifi_cur_count} 次${_wifi_fail_mac:+（MAC: ${_wifi_fail_mac}）}" >> ${logfile}
				if [ "$table_enable" = "1" ]; then
					local LF='\n'
					local _wifi_fail_info="${LF}| **失败次数** | ${_wifi_cur_count} |"
					[ ! -z "$_wifi_fail_mac" ] && _wifi_fail_info="${_wifi_fail_info}${LF}| **MAC** | ${_wifi_fail_mac} |"
					if [ -z "$title" ]; then
						title="WiFi 认证失败警告"
						content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 认证失败${font_end}${str_title_end}${_wifi_fail_info}"
					elif ( echo "$title"|grep -q "WiFi" ); then
						content="${content}${str_splitline}${_wifi_fail_info}"
					else
						title="设备状态变化"
						content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 认证失败${font_end}${str_title_end}${_wifi_fail_info}"
					fi
				else
					local _wifi_fail_detail="失败次数：${_wifi_cur_count}"
					[ ! -z "$_wifi_fail_mac" ] && _wifi_fail_detail="MAC：${_wifi_fail_mac}${str_linefeed}${str_tab}${_wifi_fail_detail}"
					if [ -z "$title" ]; then
						title="WiFi 认证失败警告"
						content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 认证失败${font_end}${str_title_end}${str_linefeed}${str_tab}${_wifi_fail_detail}"
					elif ( echo "$title"|grep -q "WiFi" ); then
						content="${content}${str_splitline}${str_linefeed}${str_tab}${_wifi_fail_detail}"
					else
						title="设备状态变化"
						content="${content}${str_splitline}${str_title_start}${font_fail} WiFi 认证失败${font_end}${str_title_end}${str_linefeed}${str_tab}${_wifi_fail_detail}"
					fi
				fi
		fi
		fi
	fi
}

# 白名单匹配：支持单个 IP 或标准 IP 段（CIDR，如 10.1.1.0/24、2001:db8::/32）
# 命中白名单返回 0，否则返回 1。任何拉黑动作前必须调用此函数。
# 本机地址保护：target 是否为本机任一接口地址或回环地址。
# 与白名单不同 —— 这是硬保护，任何情况下本机地址都禁止进入黑名单
# （误拉黑自己会断掉 Web/SSH 访问）。匹配 local_addrs 精确条目。
function is_local_address(){
	local target="$1"
	[ -z "$target" ] && return 1
	# v6 归一化：展开为完整 8 段并转小写，避免压缩/完整形式、大小写差异导致
	# 本机地址漏判被拉黑（ip 命令输出压缩形式，登录日志可能是完整形式）。
	# v4 无此问题，保持原样精确比较。
	local target_norm="$target" a a_norm
	if echo "$target" | grep -q ":"; then
		target_norm=$(expand_v6 "$target" 2>/dev/null | tr 'A-F' 'a-f')
	fi
	for a in $local_addrs; do
		[ -z "$a" ] && continue
		a_norm="$a"
		if echo "$a" | grep -q ":"; then
			a_norm=$(expand_v6 "$a" 2>/dev/null | tr 'A-F' 'a-f')
		fi
		[ "$a_norm" = "$target_norm" ] && return 0
	done
	return 1
}

function ip_in_whitelist(){
	local target="$1"
	[ -z "$target" ] && return 1
	[ -z "$ip_white_list" ] && return 1
	local entry
	for entry in $ip_white_list; do
		[ -z "$entry" ] && continue
		# 精确 IP 匹配（v4/v6）
		if echo "$entry" | grep -q "/"; then
			# CIDR 网段匹配
			local net="${entry%/*}" prefix="${entry#*/}"
			echo "$prefix" | grep -qE "^[0-9]{1,3}$" || continue
			if echo "$net" | grep -q ":"; then
				# IPv6 CIDR
				if [ "$prefix" -le 128 ] 2>/dev/null && ipv6_in_network "$target" "$net" "$prefix"; then
					return 0
				fi
			else
				# IPv4 CIDR
				if [ "$prefix" -le 32 ] 2>/dev/null && ipv4_in_network "$target" "$net" "$prefix"; then
					return 0
				fi
			fi
		elif [ "$entry" = "$target" ]; then
			# 精确匹配
			return 0
		fi
	done
	return 1
}

# IPv4 CIDR 匹配：target 是否在 net/prefix 内（纯算术，无外部依赖）
function ipv4_in_network(){
	local target="$1" net="$2" prefix="$3"
	# 简单校验 IP 格式（4 段 0-255）
	echo "$target" | grep -qE "^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$" || return 1
	echo "$net" | grep -qE "^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$" || return 1
	local a1 a2 a3 a4 b1 b2 b3 b4 i mask=0
	IFS=. read -r a1 a2 a3 a4 <<EOF
$target
EOF
	IFS=. read -r b1 b2 b3 b4 <<EOF
$net
EOF
	# 拼接 32 位整数（shell 算术，busybox ash 支持）
	local t=$(( (a1<<24) + (a2<<16) + (a3<<8) + a4 ))
	local n=$(( (b1<<24) + (b2<<16) + (b3<<8) + b4 ))
	# 计算掩码
	i=$prefix; mask=0
	while [ "$i" -gt 0 ]; do
		mask=$(( (mask<<1) | 1 ))
		i=$((i-1))
	done
	mask=$(( mask << (32-prefix) ))
	[ $(( t & mask )) -eq $(( n & mask )) ]
}

# IPv6 展开：把压缩形式（含 ::，如 2001:db8::1 / ::1 / 2001:db8::）展开为完整 8 段，
# 输出空格分隔（"2001 db8 0 0 0 0 0 1"）。无 :: 的地址直接转空格分隔（不足 8 段补零兜底）。
# 用 shell 前后分割而非 awk split 空字段，规避 gawk/busybox 对尾随空字段处理的差异。
function expand_v6(){
	local addr="$1" head="" tail="" i
	[ -z "$addr" ] && return 1
	local nhead=0 ntail=0 zeros=0 out=""
	case "$addr" in
		*::*)
			head="${addr%%::*}"
			tail="${addr##*::}"
			[ -n "$head" ] && nhead=$(echo "$head" | awk -F: '{print NF}')
			[ -n "$tail" ] && ntail=$(echo "$tail" | awk -F: '{print NF}')
			zeros=$((8 - nhead - ntail))
			[ "$zeros" -lt 0 ] && zeros=0
			[ -n "$head" ] && out="$(echo "$head" | tr ':' ' ')"
			i=0
			while [ "$i" -lt "$zeros" ]; do out="$out 0"; i=$((i+1)); done
			[ -n "$tail" ] && out="$out $(echo "$tail" | tr ':' ' ')"
			echo "$out" | sed 's/^ *//'
			;;
		*)
			out=$(echo "$addr" | tr ':' ' ')
			zeros=$((8 - $(echo "$out" | wc -w)))
			[ "$zeros" -lt 0 ] && zeros=0
			i=0
			while [ "$i" -lt "$zeros" ]; do out="$out 0"; i=$((i+1)); done
			echo "$out"
			;;
	esac
}

# IPv6 CIDR 匹配：先展开压缩地址为完整 8 段，再逐段（16 位）比较，
# 十六进制转十进制用 printf "%d"（busybox 支持 0x 前缀，不依赖 gawk 的 strtonum）
function ipv6_in_network(){
	local target="$1" net="$2" prefix="$3"
	echo "$target" | grep -qE "^[0-9a-fA-F:]+$" || return 1
	echo "$net" | grep -qE "^[0-9a-fA-F:]+$" || return 1
	[ "$prefix" -le 0 ] && return 0
	[ "$prefix" -gt 128 ] && prefix=128
	local tlist nlist i=0 tg ng t n bits shift
	tlist=$(expand_v6 "$target")
	nlist=$(expand_v6 "$net")
	while [ "$i" -lt 8 ]; do
		tg=$(echo "$tlist" | awk -v i=$((i+1)) '{print $i}' 2>/dev/null)
		ng=$(echo "$nlist" | awk -v i=$((i+1)) '{print $i}' 2>/dev/null)
		t=$(printf "%d" "0x${tg:-0}" 2>/dev/null)
		[ -z "$t" ] && t=0
		n=$(printf "%d" "0x${ng:-0}" 2>/dev/null)
		[ -z "$n" ] && n=0
		bits=$((prefix - i*16))
		if [ "$bits" -ge 16 ]; then
			[ "$t" -ne "$n" ] && return 1
		elif [ "$bits" -gt 0 ]; then
			shift=$((16-bits))
			[ $(( t >> shift )) -ne $(( n >> shift )) ] && return 1
		else
			break
		fi
		i=$((i+1))
	done
	return 0
}

# 拉黑时长解析：纯数字=秒（兼容旧配置）；支持单字符单位后缀
#   h/H 小时  d/D 天  w/W 周  M 月(=30天)  m 分钟  y/Y 年(=365天)
# 例：3600、1h、2D、1W、1M、1Y；0/空 = 永久拉黑。输出统一秒数。
function parse_timeout(){
	local v="$1" num unit mult=1
	[ -z "$v" ] && { echo 0; return; }
	num=$(echo "$v" | grep -oE "^[0-9]+")
	[ -z "$num" ] && { echo 0; return; }
	unit=$(echo "$v" | grep -oE "[a-zA-Z]+$")
	case "$unit" in
		h|H) mult=3600 ;;
		d|D) mult=86400 ;;
		w|W) mult=604800 ;;
		M)   mult=2592000 ;;
		m)   mult=60 ;;
		y|Y) mult=31536000 ;;
		*)   mult=1 ;;
	esac
	echo $((num * mult))
}

# 检查是否需要同步黑名单（文件/配置/内核是否有变化）
function need_blacklist_sync(){
	local bl_state="/usr/bin/pushbot/api/.ip_blacklist.state"
	local prev_file="${bl_state}.prev"
	local prev_onoff_file="${bl_state}.onoff"
	local prev_timeout_file="${bl_state}.timeout"
	local cur_onoff="${web_login_black:-0}"
	local cur_timeout=$(parse_timeout "${ip_black_timeout:-0}")

	# 如果是首次运行（prev_file 不存在），需要同步
	if [ ! -f "$prev_file" ]; then
		return 0
	fi

	# 检查 1：黑名单开关变化
	local prev_onoff=""
	[ -f "$prev_onoff_file" ] && prev_onoff=$(cat "$prev_onoff_file" 2>/dev/null)
	[ "$prev_onoff" != "$cur_onoff" ] && return 0

	# 检查 2：拉黑时长变化
	local prev_timeout=""
	[ -f "$prev_timeout_file" ] && prev_timeout=$(cat "$prev_timeout_file" 2>/dev/null)
	[ "$prev_timeout" != "$cur_timeout" ] && return 0

	# 检查 3：黑名单文件变化（用户手动增删）
	# 仅当文件存在时比较（不存在说明首次或路径变更，需同步）
	if [ -f "${ip_blacklist_path}" ] && [ -f "$prev_file" ]; then
		if ! cmp -s "$prev_file" "${ip_blacklist_path}" 2>/dev/null; then
			return 0
		fi
	else
		# 文件缺失：需同步（首次或 UCI 路径变更）
		[ ! -f "${ip_blacklist_path}" ] && return 0
	fi

	# 检查 4：内核 set 缺失（fw4 重启/路由重启清空了 nft set）
	# 只在 set 为空时才需要同步（set 非空说明规则已生效，不需要重复执行）
	if [ "$cur_onoff" = "1" ] && [ -s "${ip_blacklist_path}" ]; then
		if command -v nft >/dev/null 2>&1; then
			local set_count=$(nft list set inet fw4 pushbot_blacklist 2>/dev/null | grep -c "elements = {" || echo "0")
			if [ "$set_count" -eq "0" ]; then
				return 0
			fi
		fi
	fi

	# 无变化
	return 1
}

# 添加黑名单 — 支持 nftables / iptables 双模式
function add_ip_black(){
	# 本机地址硬保护：本机接口地址/回环永不拉黑（误拉黑自己会断访问）
	# 返回 1 表示"被保护拦截未拉黑"，调用方可据此保留失败记录供后续重试
	if [ -n "$1" ] && is_local_address "$1"; then
		echo "`date \"+%Y-%m-%d %H:%M:%S\"` 【防火墙】IP $1 是本机地址，跳过拉黑" >> ${logfile}
		return 1
	fi
	# 白名单优先：命中白名单（含网段）的 IP 永不拉黑
	if [ -n "$1" ] && ip_in_whitelist "$1"; then
		echo "`date \"+%Y-%m-%d %H:%M:%S\"` 【防火墙】IP $1 命中白名单，跳过拉黑" >> ${logfile}
		return 1
	fi
	# 只添加不存在的 IP，避免重复行（精确匹配整行）
	if [ -n "$1" ]; then
		if ! grep -q -x "$1" "${ip_blacklist_path}" 2>/dev/null; then
			echo "$1" >> ${ip_blacklist_path}
		fi
	fi
	
	# 判断是否需要更新防火墙：黑名单文件变化 或 开关状态变化 或 内核规则丢失
	# prev/onoff 存持久目录（/usr/bin/pushbot/api/），避免 /tmp 清理后
	# 内核检测只查 set 存在性而漏掉内容变化
	local need_update=false
	local prev_onoff=""
	local bl_state="/usr/bin/pushbot/api/.ip_blacklist.state"
	# 拉黑时长统一解析为秒（支持 3600 / 1h / 2D / 1W / 1M，0=永久）
	local bl_timeout_sec=$(parse_timeout "${ip_black_timeout:-0}")
	# timeout 配置变化必须触发重建（set 的 timeout 属性只能在创建时设定，
	# 否则 nft add set 对已存在 set 报错、直接加元素不会更新超时）
	[ -f "${bl_state}.timeout" ] && [ "$(cat ${bl_state}.timeout)" != "$bl_timeout_sec" ] && need_update=true
	[ -f "${bl_state}.onoff" ] && prev_onoff=$(cat ${bl_state}.onoff)
	local cur_onoff="${web_login_black:-0}"
	[ "$prev_onoff" != "$cur_onoff" ] && need_update=true
	echo "$cur_onoff" > ${bl_state}.onoff
	# 带参调用 = 新拉黑事件（登录失败/手动拉黑）：即使文件已有该 IP（上次超时残留），
	# 也必须重建 set 使其重新生效，否则超时移除后的"再次拉黑"会因 need_update=false 被跳过
	if [ -n "$1" ]; then
		need_update=true
	fi
	
	# ── 反向同步判定：防火墙是否发生了"主动变化"（到期移除）──
	# 设计（乐观并发控制）：
	#   · 新增/删除/清空/失败拉黑 = 文件→防火墙方向，文件是变更源
	#   · set 条目到期 = 防火墙→文件方向，set 是变更源
	# 用 prev_set 快照（上次同步的 set 元素）判定：
	#   · 当前 set ≠ prev_set → 期间防火墙主动变了（有到期）→ 以 set 为准清文件残留
	#   · 当前 set == prev_set → 防火墙未主动变 → 文件是权威，用户增删清直接生效
	# 两者方向相反，故不能无条件以 set 覆盖文件（否则用户删除会被 set 复活）。
	local prev_set_file="${bl_state}.prevset"
	local fw_changed=false
	if [ -f "$prev_set_file" ] && [ -n "$cur_onoff" ] && [ "$cur_onoff" != "0" ]; then
		if command -v nft >/dev/null 2>&1; then
			if nft list set inet fw4 pushbot_blacklist >/dev/null 2>&1; then
				nft list set inet fw4 pushbot_blacklist 2>/dev/null | grep -Eo "[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}" > ${ip_blacklist_path}.setcur
				nft list set inet fw4 pushbot_blacklist6 2>/dev/null | grep -oE "elements = \{ [^}]*\}" | grep -oE "[0-9a-fA-F:]+:[0-9a-fA-F:]+" >> ${ip_blacklist_path}.setcur
				cmp -s "$prev_set_file" "${ip_blacklist_path}.setcur" || fw_changed=true
			fi
		elif command -v ipset >/dev/null 2>&1; then
			if ipset list ip_blacklist >/dev/null 2>&1; then
				ipset list ip_blacklist 2>/dev/null | grep -Eo "[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}" > ${ip_blacklist_path}.setcur
				cmp -s "$prev_set_file" "${ip_blacklist_path}.setcur" || fw_changed=true
			fi
		fi
	fi
	# 防火墙主动变了（有到期）：以 set 为准重写文件，清掉已到期残留；
	# 并合并"用户本次新增"的 IP（当前文件有、prev_file 无 = 用户主动加的，
	# 如编辑界面追加新 IP；反向同步用 set 覆盖会误抹掉它）。
	# 注意：用户若明知某 IP 已到期仍想重新拉黑，需通过带参调用（界面"拉黑"按钮），
	# 或等残留被清后再次添加；纯文本编辑无法区分"残留"与"主动重拉"，以 prev_file 快照判定。
	local prev_file="${bl_state}.prev"
	if $fw_changed; then
		# 记录用户本次新增（当前文件 - prev_file）
		local user_added=""
		if [ -f "$prev_file" ]; then
			for ip_new in `cat ${ip_blacklist_path} 2>/dev/null`; do
				grep -qx "$ip_new" "$prev_file" 2>/dev/null || user_added="${user_added} $ip_new"
			done
		fi
		[ -f "${ip_blacklist_path}.setcur" ] && sort -u ${ip_blacklist_path}.setcur > ${ip_blacklist_path} || > ${ip_blacklist_path}
		# 合并用户新增（含带参 $1）
		if [ -n "$1" ] && ! grep -q -x "$1" "${ip_blacklist_path}" 2>/dev/null; then
			echo "$1" >> ${ip_blacklist_path}
		fi
		for ip_new in $user_added; do
			if ! grep -q -x "$ip_new" "${ip_blacklist_path}" 2>/dev/null; then
				echo "$ip_new" >> ${ip_blacklist_path}
			fi
		done
	fi
	rm -f ${ip_blacklist_path}.setcur
	
	if ! $need_update && [ -f "$prev_file" ]; then
		cmp -s "$prev_file" "${ip_blacklist_path}" || need_update=true
	fi
	cp "${ip_blacklist_path}" "$prev_file" 2>/dev/null || true
	
	# 内核状态检测：fw4 重启/路由重启会清空 nft set 与规则，
	# 但文件未变时上面的 diff 判断会跳过重建 → 拉黑静默失效。
	# 直接查内核：拉黑开启且有 IP 时，set 或 rule 缺失即强制重建。
	if ! $need_update && [ -n "$cur_onoff" ] && [ "$cur_onoff" != "0" ] && [ -s "${ip_blacklist_path}" ]; then
		if command -v nft >/dev/null 2>&1; then
			nft list set inet fw4 pushbot_blacklist >/dev/null 2>&1 || need_update=true
			nft list set inet fw4 pushbot_blacklist6 >/dev/null 2>&1 || need_update=true
			grep "@pushbot_blacklist" | grep -v "@pushbot_blacklist6" | grep -q . || need_update=true
		else
			ipset list ip_blacklist >/dev/null 2>&1 || need_update=true
			iptables -C INPUT -m set --match-set ip_blacklist src -j DROP >/dev/null 2>&1 || need_update=true
		fi
	fi
	
	if ! $need_update; then
		# 无变化：仍做"set→文件"反向同步，把内核超时已移除的元素从文件清掉。
		# （文件是待拉黑登记，set 是生效中权威含 timeout；两者必须一致）
		if [ -n "$cur_onoff" ] && [ "$cur_onoff" != "0" ]; then
			if command -v nft >/dev/null 2>&1; then
				if nft list set inet fw4 pushbot_blacklist >/dev/null 2>&1; then
					nft list set inet fw4 pushbot_blacklist 2>/dev/null | grep -Eo "[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}" > ${ip_blacklist_path}.tmp
					nft list set inet fw4 pushbot_blacklist6 2>/dev/null | grep -oE "elements = \{ [^}]*\}" | grep -oE "[0-9a-fA-F:]+:[0-9a-fA-F:]+" >> ${ip_blacklist_path}.tmp
					if [ -s "${ip_blacklist_path}.tmp" ]; then
						sort -u ${ip_blacklist_path}.tmp > ${ip_blacklist_path}
					else
						rm -f ${ip_blacklist_path}.tmp
						> ${ip_blacklist_path}
					fi
				fi
			elif command -v ipset >/dev/null 2>&1; then
				ipset list ip_blacklist 2>/dev/null | grep -Eo "[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}" > ${ip_blacklist_path}.tmp
				if [ -s "${ip_blacklist_path}.tmp" ]; then
					mv ${ip_blacklist_path}.tmp ${ip_blacklist_path}
				else
					rm -f ${ip_blacklist_path}.tmp
					> ${ip_blacklist_path}
				fi
			fi
		fi
		return  # 无变化，跳过防火墙操作
	fi
	
	[ -f "${ip_blacklist_path}" ] && local logrow=$(grep -c "" ${ip_blacklist_path}) || local logrow="0"
	[ ! -f "${ip_blacklist_path}" ] && local logrow="0"
	
	# 收集有效 IP（IPv4 + IPv6 分离，防止混合进同一 set）
	local black_ips=""
	local black_ips6=""
	local ip_count=0
	# 如果自动拉黑功能已关闭，直接跳过 IP 收集以清空防火墙规则
	if [ -z "$web_login_black" ] || [ "$web_login_black" = "0" ]; then
		echo "`date \"+%Y-%m-%d %H:%M:%S\"` 【防火墙】自动拉黑功能已关闭，将清空防火墙拉黑策略" >> ${logfile}
	else
		for ip_black in `cat ${ip_blacklist_path} 2>/dev/null`; do
			# 本机地址硬保护：本机接口地址/回环不加入防火墙拉黑，
			# 且从黑名单文件中剔除（历史遗留的本机地址一并清理）
			if is_local_address "$ip_black"; then
				sed -i "/^${ip_black}$/d" ${ip_blacklist_path} 2>/dev/null
				echo "`date \"+%Y-%m-%d %H:%M:%S\"` 【防火墙】IP $ip_black 是本机地址，已从黑名单剔除" >> ${logfile}
				continue
			fi
			# 白名单优先：命中白名单（含网段）的 IP 不加入防火墙
			ip_in_whitelist "$ip_black" && continue
			# 逐行判断 v4 / v6，避免 v6 被 v4 正则误匹配出残片
			if echo "$ip_black" | grep -qE "^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$"; then
				ip_count=$((ip_count+1))
				[ -z "$black_ips" ] && black_ips="$ip_black" || black_ips="${black_ips},$ip_black"
			elif echo "$ip_black" | grep -qE "^[0-9a-fA-F:]+$"; then
				ip_count=$((ip_count+1))
				[ -z "$black_ips6" ] && black_ips6="$ip_black" || black_ips6="${black_ips6},$ip_black"
			fi
		done
	fi
	
	# 使用缓存的防火墙模式（init_firewall_mode 已探测）
	local use_nft=false
	if [ "$firewall_mode" = "nft" ]; then
		use_nft=true
	fi
	
	if $use_nft; then
		if [ $ip_count -le "0" ]; then
			# 如果没有变化且 set 不存在，跳过清空（避免重复执行）
			if ! $need_update && ! nft list set inet fw4 pushbot_blacklist >/dev/null 2>&1 && ! nft list set inet fw4 pushbot_blacklist6 >/dev/null 2>&1; then
				# 检查规则是否残留
				local rule_exists=$(nft list chain inet fw4 input 2>/dev/null | grep -c "@pushbot_blacklist" || echo "0")
				[ "$rule_exists" -eq "0" ] && return
			fi
			# 删除所有引用黑名单 set 的规则（v4/v6 各一条，必须全部删除，
			# 否则残留规则引用 set → nft delete set 报 in-use 失败 → 拉黑不解除）
			local del_rule_handles=$(nft -a list chain inet fw4 input 2>/dev/null | grep "@pushbot_blacklist" | grep -o "handle [0-9]*" | cut -d' ' -f2)
			for del_h in $del_rule_handles; do
				nft delete rule inet fw4 input handle $del_h 2>/dev/null || true
			done
			nft delete set inet fw4 pushbot_blacklist 2>/dev/null || true
			nft delete set inet fw4 pushbot_blacklist6 2>/dev/null || true
			if $need_update; then
				echo "`date \"+%Y-%m-%d %H:%M:%S\"` 【防火墙】黑名单列表为空，清空 nftables 防火墙拉黑策略" >> ${logfile}
			fi
			> ${ip_blacklist_path}
			cp "${ip_blacklist_path}" "$prev_file" 2>/dev/null
			rm -f "${bl_state}.prevset"
			return
		fi
		# IPv4 set（支持超时）
		# 仅当 timeout 配置变化时重建 set（nft add set 对已存在 set 报错，
		# 直接 add 不会更新 timeout；重建会让元素采用新 timeout 重新计时）。
		# timeout 未变时保持增量同步（保留未到期元素剩余时间）。
		local prev_timeout_file="${bl_state}.timeout"
		local prev_timeout=""
		[ -f "$prev_timeout_file" ] && prev_timeout=$(cat "$prev_timeout_file")
		local cur_timeout="$bl_timeout_sec"
		if [ "$prev_timeout" != "$cur_timeout" ]; then
			# set 被规则引用时 nft delete set 报 Resource busy，必须先删引用规则
			# （v4/v6 各一条，必须全部删除），重建后由下方"缺失时插入"逻辑恢复。
			local del_rule_handles=$(nft -a list chain inet fw4 input 2>/dev/null | grep "@pushbot_blacklist" | grep -o "handle [0-9]*" | cut -d' ' -f2)
			for del_h in $del_rule_handles; do
				nft delete rule inet fw4 input handle $del_h 2>/dev/null || true
			done
			nft delete set inet fw4 pushbot_blacklist 2>/dev/null || true
			nft delete set inet fw4 pushbot_blacklist6 2>/dev/null || true
			echo "$cur_timeout" > "$prev_timeout_file"
		fi
		if [ "$bl_timeout_sec" = "0" ]; then
			nft add set inet fw4 pushbot_blacklist { type ipv4_addr\; } 2>/dev/null || true
		else
			nft add set inet fw4 pushbot_blacklist { type ipv4_addr\; timeout ${bl_timeout_sec}s\; } 2>/dev/null || true
		fi
		# IPv6 set（支持超时）
		if [ "$bl_timeout_sec" = "0" ]; then
			nft add set inet fw4 pushbot_blacklist6 { type ipv6_addr\; } 2>/dev/null || true
		else
			nft add set inet fw4 pushbot_blacklist6 { type ipv6_addr\; timeout ${bl_timeout_sec}s\; } 2>/dev/null || true
		fi
		# 规则用 insert（链首优先，不被 accept 抢先），且只在缺失时插入
		if ! nft list chain inet fw4 input 2>/dev/null | grep "@pushbot_blacklist" | grep -v "@pushbot_blacklist6" | grep -q .; then
			nft insert rule inet fw4 input ip saddr @pushbot_blacklist drop 2>/dev/null || true
		fi
		if ! nft list chain inet fw4 input 2>/dev/null | grep -q "@pushbot_blacklist6"; then
			nft insert rule inet fw4 input ip6 saddr @pushbot_blacklist6 drop 2>/dev/null || true
		fi
		# 增量同步：不 flush 重建（会抹掉内核超时状态），只补齐 set 缺失元素。
		# 文件是"待拉黑"登记，set 是"生效中"权威（含 timeout，到期自动移除）。
		# 双向对账：
		#   · 文件有、set 没有 → add（新拉黑 / 重启恢复）
		#   · set 有、文件没有 → delete（用户删除；到期移除由内核处理，此处分不出、也无需删）
		#     注意：此处删除的是"set 存在但文件已移除"的 IP——即用户主动删除场景。
		{
			for ip_black in `echo "$black_ips"|tr ',' ' '`; do
				echo "add element inet fw4 pushbot_blacklist { $ip_black }"
			done
			for ip_black6 in `echo "$black_ips6"|tr ',' ' '`; do
				echo "add element inet fw4 pushbot_blacklist6 { $ip_black6 }"
			done
			# 删除 set 中文件里已不存在的元素（用户删除的 IP）
			for ip_del in `nft list set inet fw4 pushbot_blacklist 2>/dev/null | grep -oE "[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}"`; do
				grep -qx "$ip_del" "${ip_blacklist_path}" || echo "delete element inet fw4 pushbot_blacklist { $ip_del }"
			done
			for ip_del6 in `nft list set inet fw4 pushbot_blacklist6 2>/dev/null | grep -oE "elements = \{ [^}]*\}" | grep -oE "[0-9a-fA-F:]+:[0-9a-fA-F:]+"`; do
				grep -qx "$ip_del6" "${ip_blacklist_path}" || echo "delete element inet fw4 pushbot_blacklist6 { $ip_del6 }"
			done
		} | nft -f - 2>/dev/null || {
			# 老版本 nft 不支持 stdin -f 时退化为逐条
			for ip_black in `echo "$black_ips"|tr ',' ' '`; do
				nft add element inet fw4 pushbot_blacklist { $ip_black } 2>/dev/null || true
			done
			for ip_black6 in `echo "$black_ips6"|tr ',' ' '`; do
				nft add element inet fw4 pushbot_blacklist6 { $ip_black6 } 2>/dev/null || true
			done
			for ip_del in `nft list set inet fw4 pushbot_blacklist 2>/dev/null | grep -oE "[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}"`; do
				grep -qx "$ip_del" "${ip_blacklist_path}" || nft delete element inet fw4 pushbot_blacklist { $ip_del } 2>/dev/null || true
			done
			for ip_del6 in `nft list set inet fw4 pushbot_blacklist6 2>/dev/null | grep -oE "elements = \{ [^}]*\}" | grep -oE "[0-9a-fA-F:]+:[0-9a-fA-F:]+"`; do
				grep -qx "$ip_del6" "${ip_blacklist_path}" || nft delete element inet fw4 pushbot_blacklist6 { $ip_del6 } 2>/dev/null || true
			done
		}
		# 只有实际变化时才输出日志
		if $need_update; then
			echo "`date \"+%Y-%m-%d %H:%M:%S\"` 【防火墙】已 nftables 拉黑 ${black_ips}${black_ips6:+,$black_ips6}" >> ${logfile}
		fi
		# 回写黑名单文件（v4+v6）以内核 set 为准：超时移除的元素不在此列，自然从文件清除
		nft list set inet fw4 pushbot_blacklist 2>/dev/null | grep -Eo "[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}" > ${ip_blacklist_path}.tmp
		# v6 只抓 elements 行内的地址（跳过 set 头注释/flags 等单词）
		nft list set inet fw4 pushbot_blacklist6 2>/dev/null | grep -oE "elements = \{ [^}]*\}" | grep -oE "[0-9a-fA-F:]+:[0-9a-fA-F:]+" >> ${ip_blacklist_path}.tmp
		if [ -s "${ip_blacklist_path}.tmp" ]; then
			# 去重 + 过滤掉 set 头注释行可能的残留
			sort -u ${ip_blacklist_path}.tmp > ${ip_blacklist_path}
		else
			rm -f ${ip_blacklist_path}.tmp
		fi
	else
		ipset flush ip_blacklist >/dev/null 2>&1
		if [ $ip_count -le "0" ]; then
			iptables -D INPUT -m set --match-set ip_blacklist src -j DROP >/dev/null 2>&1
			ipset destroy ip_blacklist >/dev/null 2>&1
			if $need_update; then
				echo "`date \"+%Y-%m-%d %H:%M:%S\"` 【防火墙】黑名单列表为空，清空 iptables 防火墙拉黑策略" >> ${logfile}
			fi
			> ${ip_blacklist_path}
			cp "${ip_blacklist_path}" "$prev_file" 2>/dev/null
			rm -f "${bl_state}.prevset"
			return
		fi
		local log_enable="拉黑"
		[ -z "$debuglevel" ] && log_enable=""
		if [ -n "$log_enable" ]; then
			echo "`date \"+%Y-%m-%d %H:%M:%S\"` 【防火墙】拉黑功能已启用，且读取到黑名单列表，将生成防火墙策略" >> ${logfile}
		fi
		ipset list ip_blacklist >/dev/null 2>&1 || ipset create ip_blacklist hash:ip timeout ${bl_timeout_sec} >/dev/null 2>&1
		iptables -C INPUT -m set --match-set ip_blacklist src -j DROP >/dev/null 2>&1 || iptables -I INPUT -m set --match-set ip_blacklist src -j DROP >/dev/null 2>&1
		for ip_black in `echo "$black_ips"|tr ',' ' '`; do
			ipset -! add ip_blacklist $ip_black >/dev/null 2>&1
		done
		ipset list ip_blacklist 2>/dev/null | grep -Eo "[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}" > ${ip_blacklist_path}.tmp
		if [ -s "${ip_blacklist_path}.tmp" ]; then
			mv ${ip_blacklist_path}.tmp ${ip_blacklist_path}
		else
			rm -f ${ip_blacklist_path}.tmp
		fi
		# 只有实际变化时才输出日志
		if $need_update; then
			echo "`date \"+%Y-%m-%d %H:%M:%S\"` 【防火墙】已 iptables 拉黑 ${black_ips}" >> ${logfile}
		fi
	fi

	# 记录当前 set 元素快照（供下次判定防火墙是否主动变化——到期移除 vs 用户删除）
	# 必须在 set 更新完成后记录；若 set 不存在（关闭/首次）则清空快照。
	local prev_set_file="${bl_state}.prevset"
	if [ -n "$cur_onoff" ] && [ "$cur_onoff" != "0" ]; then
		if command -v nft >/dev/null 2>&1; then
			if nft list set inet fw4 pushbot_blacklist >/dev/null 2>&1; then
				nft list set inet fw4 pushbot_blacklist 2>/dev/null | grep -Eo "[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}" > "$prev_set_file" 2>/dev/null || true
				nft list set inet fw4 pushbot_blacklist6 2>/dev/null | grep -oE "elements = \{ [^}]*\}" | grep -oE "[0-9a-fA-F:]+:[0-9a-fA-F:]+" >> "$prev_set_file" 2>/dev/null || true
			fi
		elif command -v ipset >/dev/null 2>&1; then
			ipset list ip_blacklist 2>/dev/null | grep -Eo "[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}" > "$prev_set_file" 2>/dev/null || true
		fi
	else
		rm -f "$prev_set_file"
	fi
}

# 发送定时数据
function send(){
	[ ! -z "$1" ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【测试】开始测试渠道" >> ${logfile} || echo "`date "+%Y-%m-%d %H:%M:%S"` 【定时数据】创建定时任务" >> ${logfile}
	pushbot_disturb;local send_disturb=$?
	get_config "send_title" "router_status" "router_temp" "router_wan" "client_list" "google_check_count"

	[ -z "$send_title" ] && local send_title="路由状态："
	[ -z "$google_check_count" ] && local google_check_count="3"
	[ ! -z "$1" ] && local send_title="发送测试：" && local send_content="${str_splitline}${str_title_start}内容1${str_title_end}${str_linefeed}${str_tab}设备1${str_linefeed}${str_tab}设备2${str_splitline}${str_title_start}内容2${str_title_end}${str_linefeed}${str_tab}设备3${str_linefeed}${str_tab}设备4"
	# 在线设备列表已由主进程(pushbot_first)维护, send 直接读取, 避免与主进程并发竞争 FIFO(fd1)导致死锁
	[ -z "$1" ] && [ ! -z "$client_list" ] && [ "$client_list" -eq "1" ] && > ${dir}send_enable.lock

	if [ -z "$1" ] && [ ! -z "$router_status" ] && [ "$router_status" -eq "1" ]; then
		local systemload=`cat /proc/loadavg|awk '{print $1" "$2" "$3}'`
		local cpuload=`getcpu`
		local ramload=`free -m|sed -n '2p'|awk '{printf "%.2f%%\n",($3/$2)*100}'`
		# 全球互联检测: 尝试 google_check_count 次(默认3), 1 次成功即视为连通
		local Qwai="000"
		local Qwai_count=${google_check_count:-3}
		[ "$Qwai_count" -lt "1" ] && local Qwai_count="3"
		for i in `seq 1 ${Qwai_count}`; do
			Qwai=`curl -o /dev/null --connect-timeout 3 -m 3 -s -w %{http_code} https://www.google.com`
			[ "$Qwai" = "200" ] || [ "$Qwai" = "301" ] || [ "$Qwai" = "302" ] && break
			[ "$i" -lt "$Qwai_count" ] && sleep 1
		done
		if [[ "$Qwai" -eq "200" ]] || [[ "$Qwai" -eq "301" ]] || [[ "$Qwai" -eq "302" ]]; then
			local Qwai_status="已连通！"
		else
			local Qwai_status="已断开！"
		fi
		local systemstatustime=`cat /proc/uptime|awk -F. '{run_days=$1 / 86400;run_hour=($1 % 86400)/3600;run_minute=($1 % 3600)/60;run_second=$1 % 60;printf("运行时间：%d天%d时%d分%d秒",run_days,run_hour,run_minute,run_second)}'`;unset run_days run_hour run_minute run_second
		if [ "$table_enable" = "1" ]; then
			local LF='\n'
			local send_content="${send_content}${str_splitline}${str_title_start}${font_module} 系统运行状态${font_end}${str_title_end}${LF}| **平均负载** | ${systemload} |${LF}| --- | --- |${LF}| **CPU占用** | ${cpuload}${percentsym} |${LF}| **内存占用** | ${ramload}${percentsym} |${LF}| **全球互联** | ${Qwai_status} |${LF}| **运行时间** | ${systemstatustime#运行时间：} |"
		else
			local send_content="${send_content}${str_splitline}${str_title_start}${font_module} 系统运行状态${font_end}${str_title_end}"
			local send_content="${send_content}${str_linefeed}${str_tab}平均负载：${systemload}"
			local send_content="${send_content}${str_linefeed}${str_tab}CPU占用：${cpuload}${percentsym}"
			local send_content="${send_content}${str_linefeed}${str_tab}内存占用：${ramload}${percentsym}"
			local send_content="${send_content}${str_linefeed}${str_tab}全球互联：${Qwai_status}"
			local send_content="${send_content}${str_linefeed}${str_tab}${systemstatustime}"
		fi
	fi

	if [ -z "$1" ] && [ ! -z "$router_temp" ] && [ "$router_temp" -eq "1" ]; then
		local cputemp=`soc_temp`
		if [ "$table_enable" = "1" ]; then
			local LF='\n'
			[ ! -z "$cputemp" ] && local send_content="${send_content}${str_splitline}${str_title_start}${font_module} 设备温度${font_end}${str_title_end}${LF}| **CPU** | ${cputemp}℃ |${LF}| --- | --- |"
			[ -z "$cputemp" ] && local send_content="${send_content}${str_splitline}${str_title_start}${font_fail} 设备温度${font_end}${str_title_end}${LF}| **CPU** | 无法获取 |${LF}| --- | --- |"
		else
			[ ! -z "$cputemp" ] && local send_content="${send_content}${str_splitline}${str_title_start}${font_module} 设备温度${font_end}${str_title_end}${str_linefeed}${str_tab}CPU：${cputemp}℃"
			[ -z "$cputemp" ] && local send_content="${send_content}${str_splitline}${str_title_start}${font_fail} 设备温度${font_end}${str_title_end}${str_linefeed}${str_tab}无法获取设备温度"
		fi
	fi

	if [ -z "$1" ] && [ ! -z "$router_wan" ] && [ "$router_wan" -eq "1" ]; then
		local send_wanIP=`getip wanipv4`
		# 判断用户所选接口是否为 LAN：以 UCI/ubus 接口角色为准（非 wan/wan6 即 LAN，
		# 不依赖 IP 是否私网——运营商可能给 WAN 私网 IP）。无论 LAN/WAN，外网 IP
		# 均探测并显示（getip 内部按接口类型选择出口：LAN 走默认路由，WAN 绑定接口）。
		local wan_lan_mode=0
		if [ ! -z "$ipv4_interface" ]; then
			iface_is_lan "$ipv4_interface" && wan_lan_mode=1
		fi
		# 无论 LAN/WAN 都探测外网 IP（出口策略在 getip 内部处理）
		local send_hostIP=`getip hostipv4`
		# 接口 IP 为私网时标注非公网（仅 WAN 模式；LAN 模式接口本身私网属正常，不标注）
		local wanIP_note=""
		[ "$wan_lan_mode" -eq "0" ] && [ ! -z "$send_wanIP" ] && [ "$send_wanIP" != "获取失败" ] && is_private_ip "$send_wanIP" 4 && wanIP_note=" (非公网IP)"
		local wanIP6_note=""
		if [ "$table_enable" = "1" ]; then
			local LF='\n'
			local send_content="${send_content}${str_splitline}${str_title_start}${font_module} WAN 口信息${font_end}${str_title_end}${LF}| --- | --- |${LF}| **接口IP** | ${send_wanIP}${wanIP_note} |${LF}| **外网IP** | ${send_hostIP} |"
			if [ ! -z "$pushbot_ipv6" ] && [ "$pushbot_ipv6" -ne "0" ]; then
				local send_wanIPv6=`getip wanipv6`
				local send_hostIPv6=`getip hostipv6`
				[ "$wan_lan_mode" -eq "0" ] && [ ! -z "$send_wanIPv6" ] && [ "$send_wanIPv6" != "获取失败" ] && is_private_ip "$send_wanIPv6" 6 && wanIP6_note=" (非公网IP)"
				local send_content="${send_content}${LF}| **IPv6** | ${send_wanIPv6}${wanIP6_note} |${LF}| **外网v6** | ${send_hostIPv6} |"
			fi
			# 外网 IP 与接口 IP 不一致提示（仅 WAN 模式；LAN 模式接口 IP 私网、外网 IP 公网必然不一致，提示无意义）
			[ "$wan_lan_mode" -eq "0" ] && [ ! -z "$send_wanIP" ] && [ ! -z "$send_hostIP" ] && [ "$send_hostIP" != "获取失败" ] && ( ! echo "$send_wanIP"|grep -q -w ${send_hostIP} ) && local send_content="${send_content}${LF}| **提示** | 外网 ip 与接口 ip 不一致，不是公网 ip |"
			local interfaceuptime=`getinterfaceuptime`
			[ ! -z "$interfaceuptime" ] && local wanstatustime=`getinterfaceuptime|awk -F. '{run_days=$1 / 86400;run_hour=($1 % 86400)/3600;run_minute=($1 % 3600)/60;run_second=$1 % 60;printf("在线时间：%d天%d时%d分%d秒",run_days,run_hour,run_minute,run_second)}'` && unset run_days run_hour run_minute run_second
			[ ! -z "$wanstatustime" ] && local send_content="${send_content}${LF}| **在线时间** | ${wanstatustime#在线时间：} |"
		else
			local send_content="${send_content}${str_splitline}${str_title_start}${font_module} WAN 口信息${font_end}${str_title_end}${str_linefeed}${str_tab}接口ip:${send_wanIP}${wanIP_note}${str_linefeed}${str_tab}外网ip:${send_hostIP}"
			if [ ! -z "$pushbot_ipv6" ] && [ "$pushbot_ipv6" -ne "0" ]; then
				local send_wanIPv6=`getip wanipv6`
				local send_hostIPv6=`getip hostipv6`
				[ "$wan_lan_mode" -eq "0" ] && [ ! -z "$send_wanIPv6" ] && [ "$send_wanIPv6" != "获取失败" ] && is_private_ip "$send_wanIPv6" 6 && wanIP6_note=" (非公网IP)"
				local send_content="${send_content}${str_linefeed}${str_tab}ipv6 :${send_wanIPv6}${wanIP6_note}${str_linefeed}${str_tab}外网v6:${send_hostIPv6}"
			fi
			[ "$wan_lan_mode" -eq "0" ] && [ ! -z "$send_wanIP" ] && [ ! -z "$send_hostIP" ] && [ "$send_hostIP" != "获取失败" ] && ( ! echo "$send_wanIP"|grep -q -w ${send_hostIP} ) && local send_content="${send_content}${str_linefeed}${str_tab}外网 ip 与接口 ip 不一致，你的 ip 不是公网 ip"
			local interfaceuptime=`getinterfaceuptime`
			[ ! -z "$interfaceuptime" ] && local wanstatustime=`getinterfaceuptime|awk -F. '{run_days=$1 / 86400;run_hour=($1 % 86400)/3600;run_minute=($1 % 3600)/60;run_second=$1 % 60;printf("在线时间：%d天%d时%d分%d秒",run_days,run_hour,run_minute,run_second)}'` && unset run_days run_hour run_minute run_second
			local send_content="${send_content}${str_linefeed}${str_tab}${wanstatustime}"
		fi
	fi

	if [ -z "$1" ] && [ ! -z "$client_list" ] && [ "$client_list" -eq "1" ]; then
		wait
		local IPLIST=`cat ${dir}ipAddress 2>/dev/null|awk '{print $1}'`
		[ -f ${dir}ipAddress ] && local logrow=$(grep -c "" ${dir}ipAddress) || local logrow="0"
		[ "$logrow" -eq "0" ] && local send_content="${send_content}${str_splitline}${str_title_start}${font_fail} 当前无在线设备${font_end}${str_title_end}" || local send_content="${send_content}${str_splitline}${str_title_start}${font_module} 现有在线设备 ${logrow} 台${font_end}${str_title_end}"
		if [ "$table_enable" = "1" ]; then
			local LF='\n'
			local send_content="${send_content}${LF}| **设备** | **在线信息** |${LF}| --- | --- |"
		fi
		for ip in $IPLIST; do
			local time_up=`cat ${dir}ipAddress|grep -w ${ip}|awk '{print $4}'|grep -v "^$"|sort -u|head -n1`
			local time1=`date +%s`
			local time1=$(time_for_humans `expr ${time1} - ${time_up}`)
			local ip_mac=`getmac ${ip}`
			local ip_name=`getname ${ip} ${ip_mac}`
			local ip_total=`usage get ${ip_mac}`
			if [ "$table_enable" = "1" ]; then
				[ ! -z "$ip_total" ] && local ip_total="${ip_total}"
			else
				[ ! -z "$ip_total" ] && local ip_total="总计流量：${ip_total}  "
			fi
			local ip_name=`cut_str $ip_name 27`
			if [ "$table_enable" = "1" ]; then
				# 每个设备 2 行 2 列: 第一行 设备名+IP, 第二行 流量+时长
				local send_content="${send_content}${LF}| **${font_client}${ip_name}${font_end}** | ${ip_total} |${LF}| **${ip}** | ${time1} |"
			else
				local send_content="${send_content}${str_linefeed}${str_tab}${font_client}【${ip_name}】${font_end2}  ${ip}${str_linefeed}${str_tab}${ip_total}在线 ${time1}"
			fi
			unset ip_total time_down time_up time1 ip_mac ip_name
		done
	fi

	[ ! -z "$device_name" ] && local send_title="【$device_name】${send_title}"
	[ -z "$send_content" ] && local send_content="${str_splitline}${str_title_start} 我遇到了一个难题${str_title_end}${str_linefeed}${str_tab}定时发送选项错误，你没有选择需要发送的项目，该怎么办呢${str_splitline}"
	# 去掉开头 str_splitline 字面(避免与模板"时间后换行"叠加成 3 空行)
	send_content=$(printf '%s' "$send_content" | sed 's/^\\n\\n---\\n\\n//; s/^\\n\\n//')
	# 清洗双引号为单引号, 避免 eval echo 展开模板后破坏 JSON(飞书等卡片模板对特殊字符敏感)
	send_title=`echo "$send_title"|tr '"' "'"`
	send_content=`echo "$send_content"|tr '"' "'"`
	device_name=`echo "$device_name"|tr '"' "'"`
	[ "$send_disturb" -eq "0" ] && diy_send "${send_title}" "${send_content}" "${jsonpath}" >/dev/null 2>&1
	local send_rc=$?
	if [ ! -z "$1" ]; then
		[ $send_rc -ne 0 ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】渠道测试失败，请检查网络或设置信息" >> ${logfile} || echo "`date "+%Y-%m-%d %H:%M:%S"` ${disturb_text}渠道测试完成" >> ${logfile}
	else
		[ $send_rc -ne 0 ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】定时推送失败，请检查网络或设置信息" >> ${logfile} || echo "`date "+%Y-%m-%d %H:%M:%S"` ${disturb_text}定时推送任务完成" >> ${logfile}
	fi
	deltemp
}

# 保存脚本参数（函数内 $1 不继承调用者，需全局变量传递）
SCRIPT_ARG="$1"

# 初始化
read_config

# ── 流量数据源探测（缓存到 /tmp，OpenWrt 重启后重新探测） ──
function init_traffic_source() {
	# 读取缓存
	traffic_source="none"
	if [ -f "${dir}traffic_source" ]; then
		traffic_source=$(cat ${dir}traffic_source 2>/dev/null)
		return
	fi

	# 缓存为空，重新探测
	if command -v nlbw >/dev/null 2>&1 && [ -S /var/run/nlbwmon.sock ]; then
		_nlbw_rows=$(nlbw -c csv -s, -q -n -g mac 2>/dev/null | awk -F',' 'NR>1 && $1!="mac" {n++} END{print n+0}')
		[ "${_nlbw_rows:-0}" -gt "0" ] && traffic_source="nlbw"
	fi
	if [ "$traffic_source" = "none" ] && [ -f "/usr/sbin/wrtbwmon" ]; then
		traffic_source="wrtbw"
	fi
	echo "$traffic_source" > ${dir}traffic_source
	echo "`date "+%Y-%m-%d %H:%M:%S"` 【检测到流量工具：${traffic_source}】" >> ${logfile}
}

# ── 防火墙模式探测（缓存到 /tmp，OpenWrt 重启后重新探测） ──
function init_firewall_mode() {
	# 读取缓存
	firewall_mode=""
	if [ -f "${dir}firewall_mode" ]; then
		firewall_mode=$(cat ${dir}firewall_mode 2>/dev/null)
		return
	fi

	# 缓存为空，重新探测
	if command -v nft >/dev/null 2>&1; then
		firewall_mode="nft"
	else
		firewall_mode="iptables"
	fi
	echo "$firewall_mode" > ${dir}firewall_mode
	echo "`date "+%Y-%m-%d %H:%M:%S"` 【检测到防火墙：${firewall_mode}】" >> ${logfile}
}

# 主进程启动或 blacklist 命令时探测
if [ "$1" != "usage" ] && [ "$1" != "soc" ] && [ "$1" != "client" ] && [ "$1" != "test" ]; then
	init_traffic_source
	init_firewall_mode
fi

# usage 命令：只读取流量源缓存（不探测）
if [ "$1" = "usage" ]; then
	traffic_source="none"
	if [ -f "${dir}traffic_source" ]; then
		traffic_source=$(cat ${dir}traffic_source 2>/dev/null)
	fi
fi

# 供外部查询流量(LuCI 在线设备表格):pushbot usage list / pushbot usage get <mac> [bytes]
# 注意:必须放在 deltemp 之前,避免查询时误删主循环的 pushbot.lock
if [ "$1" = "usage" ]; then
	usage ${2} ${3} ${4}
	exit
fi

deltemp
pushbot_cron

# 限制并发进程
[ -z "$thread_num" ] || [ "$thread_num" -eq "0" ] && thread_num=5
[ -e ${dir}fd1 ] || mkfifo ${dir}fd1
exec 5<>${dir}fd1
rm -f ${dir}fd1 >/dev/null 2>&1
for i in `seq 1 $thread_num`; do
	echo >&5
done
unset i

# 启动参数
if [ "$1" ] ;then
	# blacklist 只需读取黑名单配置，不需要流量源探测
	if [ "$1" = "blacklist" ]; then
		get_config "pushbot_enable" "web_login_black" "pushbot_whitelist" "pushbot_blacklist" "pushbot_interface" "MAC_online_list" "MAC_offline_list" "ip_white_list" "ip_black_timeout" "ip_black_persist"
		# 只有拉黑功能启用时才执行
		if [ "$web_login_black" = "1" ]; then
			init_firewall_mode
			add_ip_black
		fi
		exit
	fi
	# 重检防火墙：清除缓存并重新探测
	if [ "$1" = "check_firewall" ]; then
		get_config "web_login_black"
		if [ "$web_login_black" = "1" ]; then
			rm -f ${dir}firewall_mode
			init_firewall_mode
		fi
		exit
	fi
	# 重检流量源：清除缓存并重新探测
	if [ "$1" = "check_traffic" ]; then
		rm -f ${dir}traffic_source
		init_traffic_source
		exit
	fi
	# 重检无线接口：清除缓存并重新探测
	if [ "$1" = "check_wireless" ]; then
		rm -f ${dir}wlan_interface
		[ "$iw_version" ] && wlan_interface=`iw dev|grep Interface|awk '{print $2}'` >/dev/null 2>&1
		local _wifi_sys=$(ls /sys/class/net/*/wireless 2>/dev/null | sed 's|/sys/class/net/||;s|/wireless||;s/:$//')
		for _w in $_wifi_sys; do
			echo "$wlan_interface" | grep -q -w "$_w" || wlan_interface="${wlan_interface} ${_w}"
		done
		echo "$wlan_interface" > ${dir}wlan_interface
		if [ ! -z "$wlan_interface" ]; then
			echo "`date "+%Y-%m-%d %H:%M:%S"` 【检测到无线接口：${wlan_interface}】" >> ${logfile}
		else
			echo "`date "+%Y-%m-%d %H:%M:%S"` 【未检测到无线接口】" >> ${logfile}
		fi
		exit
	fi
	[ $1 == "send" ] && send
	[ $1 == "soc" ] && echo `soc_temp` > ${dir}soc_tmp
	[ $1 == "client" ] && get_client
	[ $1 == "test" ] && send test
	exit
fi

# 载入在线设备
pushbot_init;[ $? -eq 1 ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】读取设置出错，请检查设置项 " >> ${logfile} && exit
echo "`date "+%Y-%m-%d %H:%M:%S"` 【初始化】载入在线设备" >> ${logfile}
> ${dir}send_enable.lock && pushbot_first && deltemp
echo "`date "+%Y-%m-%d %H:%M:%S"` 【初始化】初始化完成" >> ${logfile}

# 循环（仅当明确启用 =1 时运行；0/空/读取失败均不进入，脚本自然退出，不空转）
while [ "$pushbot_enable" = "1" ]; do
	deltemp
	usage update
	pushbot_disturb;disturb=$?

	# 外网IP变化检测
	[ -f ${dir}ipAddress ] && ipAddress_logrow=$(grep -c "" ${dir}ipAddress) || ipAddress_logrow="0";
	if [ $ipAddress_logrow -ne "0" ]; then
		online_list=`cat ${dir}ipAddress|awk '{print $2}'|grep -v "^$"|sort -u`
		for online_mac in $online_list; do
			[ ! -z "$online_mac" ] && mac_online_status="`echo "$mark_mac_list"|grep -i $online_mac|grep -v "^$"|sort -u|head -n1`${mac_online_status}"
		done
	fi

	if [ "$pushbot_ipv4" -ne "0" ] || [ "$pushbot_ipv6" -ne "0" ]; then
		rand_geturl
		ip_changes
	fi

	# 设备列表
	if [ ! -f "${dir}send_enable.lock" ]; then
		[ ! -z "$title" ] && echo "$title" > ${dir}title
		[ ! -z "$content" ] && echo "$content" > ${dir}content
		pushbot_first
		[ -f "${dir}title" ] && title=`cat ${dir}title` && rm -f ${dir}title >/dev/null 2>&1
		[ -f "${dir}content" ] && content=`cat ${dir}content` && rm -f ${dir}content >/dev/null 2>&1
	fi

	# 离线缓存区推送
	[ ! -f "${dir}send_enable.lock" ] && down_send

	# 当前设备列表
	[ ! -z "$content" ] && [ ! -f "${dir}send_enable.lock" ] && current_device

	# 无人值守任务
	[ ! -f "${dir}send_enable.lock" ] && unattended

	# CPU 检测
	[ ! -f "${dir}send_enable.lock" ] && cpu_load

	# 异常流量检测
	[ ! -f "${dir}send_enable.lock" ] && get_client_usage

	# 登录提醒通知
	[ ! -f "${dir}send_enable.lock" ] && login_send

	# 黑名单周期同步：内核 set 超时移除的元素同步回文件
	# （避免"超时已解除拉黑但文件仍保留"的文件/内核不一致）
	if [ "$web_login_black" = "1" ] && [ ! -f "${dir}send_enable.lock" ]; then
		if need_blacklist_sync; then
			add_ip_black
		fi
	fi

	# 通知
	if [ ! -f "${dir}send_enable.lock" ] && [ ! -z "$title" ] && [ ! -z "$content" ]; then
		[ ! -z "$device_name" ] && title="【$device_name】$title"
		( echo "$lite_enable"|grep -q "content" ) && content="$title"
		[ "$disturb" -eq "0" ] && diy_send "${title}" "${content}" "${jsonpath}" >/dev/null 2>&1
		[ $? -eq 1 ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】推送失败，请检查网络或设置信息 " >> ${logfile}
	fi
	
	while [ -f "${dir}send_enable.lock" ]; do
		sleep $sleeptime
	done
	sleep $sleeptime
done
