# 清理临时文件
function deltemp(){
	unset title	content ipAddress_logrow online_list online_mac mac_online_status
	rm -f ${dir}title ${dir}content ${dir}tmp_downlist ${dir}send_enable.lock ${tempjsonpath} >/dev/null 2>&1
	LockFile unlock
	if [ -f "${logfile}" ]; then
		local logrow=$(grep -c "" "${logfile}" 2>/dev/null)
		[ -z "$logrow" ] && logrow=0
	fi
	if [ "${logrow:-0}" -gt "500" ] 2>/dev/null; then
		local tmpf="/tmp/pushbot_log_$$.tmp"
		tail -n +101 "${logfile}" > "$tmpf" 2>/dev/null && mv "$tmpf" "${logfile}" && echo "$(date "+%Y-%m-%d %H:%M:%S")  【清理】日志超出上限，删除前 100 条" >> "${logfile}"
		rm -f "$tmpf" 2>/dev/null
	fi
}

# 检测程序开关：仅当明确关闭（=0）时停止服务；读取失败/未设置（空）不自杀，交由主循环条件自然退出
function enable_detection(){
	[ ! "$1" ] && local time_n=1
	for i in `seq 1 $time_n`; do
		get_config pushbot_enable
		[ "$pushbot_enable" = "0" ] && `/etc/init.d/pushbot stop` && return 0
		sleep 1
	done
	return 0
}

# 获取 ip
# 判断 IP 是否为私网/链路本地地址（与 LuCI 预览逻辑一致）
# 返回 0=私网 1=公网
function is_private_ip(){
	local ip="$1" fam="$2"
	[ -z "$ip" ] && return 0
	if [ "$fam" = "6" ] ;then
		case "$ip" in
			fe80:*|fe8[0-9a-f]:*|fe9[0-9a-f]:*|fea[0-9a-f]:*|feb[0-9a-f]:*) return 0 ;;  # link-local
			fc*|fd*) return 0 ;;  # ULA
			::1) return 0 ;;
		esac
		return 1
	else
		case "$ip" in
			10.*) return 0 ;;
			172.1[6-9].*|172.2[0-9].*|172.3[0-1].*) return 0 ;;
			192.168.*) return 0 ;;
			169.254.*) return 0 ;;  # link-local
			127.*) return 0 ;;     # loopback
			100.6[4-9].*|100.[7-9][0-9].*|100.1[0-2][0-7].*) return 0 ;;  # CGNAT
		esac
		return 1
	fi
}

# 判断指定接口是否为 WAN 接口：以 OpenWrt 防火墙区域（zone）为权威依据——
# 接口（或其所属 UCI 逻辑接口）出现在带 masq=1（NAT 出口）的 zone 的 network 列表
# 即视为 WAN。不依赖接口命名（用户可改名 telecom/mobile/unicom）与 IP 私网/公网。
# 判定链：
#   1) 接口名本身是逻辑接口（uci network.interface.<name> 存在）→ 直接用
#   2) 接口名是物理 device → 反查所有 device 等于它的逻辑接口
#   3) 逻辑接口 ∈ 某 zone 的 network 且该 zone masq=1 → WAN
# 返回 0=WAN 1=非WAN(LAN/未知)
function iface_is_wan(){
	local iface="$1"
	[ -z "$iface" ] && return 1
	local logical_ifaces=""
	# 1) 直接是逻辑接口名
	if uci get network.$iface >/dev/null 2>&1; then
		logical_ifaces="$iface"
	else
		# 2) 物理 device → 反查 device/ifname 等于它的逻辑接口；
		#    并补 l3_device 反查（PPPoE 拨号后逻辑接口的 l3_device 是虚拟接口名如 pppoe-wan）
		local ui dev l3
		for ui in $(uci show network 2>/dev/null | grep -oE "^network\.[^.]+\.(device|ifname)=" | sed 's/^network\.//; s/\.\(device\|ifname\)=$//' | sort -u); do
			dev=$(uci get network.$ui.device 2>/dev/null)
			[ "$dev" = "$iface" ] && logical_ifaces="$logical_ifaces $ui"
			[ -z "$dev" ] && dev=$(uci get network.$ui.ifname 2>/dev/null)
			[ "$dev" = "$iface" ] && logical_ifaces="$logical_ifaces $ui"
			l3=$(ubus call network.interface.$ui status 2>/dev/null | grep -oE "\"l3_device\": \"[^\"]*\"" | head -1 | cut -d'"' -f4)
			[ "$l3" = "$iface" ] && logical_ifaces="$logical_ifaces $ui"
		done
	fi
	[ -z "$logical_ifaces" ] && return 1
	# 3) 遍历 zone，找含该逻辑接口且 masq=1 的区域
	local zone_idx name zone_net masq
	zone_idx=0
	while :; do
		name=$(uci get firewall.@zone[$zone_idx].name 2>/dev/null)
		[ -z "$name" ] && break
		zone_net=$(uci get firewall.@zone[$zone_idx].network 2>/dev/null)
		masq=$(uci get firewall.@zone[$zone_idx].masq 2>/dev/null)
		if [ "$masq" = "1" ]; then
			for li in $logical_ifaces; do
				echo " $zone_net " | grep -q " $li " && return 0
			done
		fi
		zone_idx=$((zone_idx+1))
	done
	return 1
}

# 判断指定接口是否为 LAN/内网接口：UCI 角色非 WAN 即视为 LAN。
# 用于决定 URL 外网探测出口：LAN 接口走默认路由（如单臂路由），WAN 接口绑定该接口。
# 返回 0=LAN 1=WAN(或无法判定)
function iface_is_lan(){
	local iface="$1"
	[ -z "$iface" ] && return 1
	iface_is_wan "$iface" && return 1
	return 0
}

function getip(){
	[ ! "$1" ] && return
	if [ $1 == "wanipv4" ] ;then
		[ ! -z "$ipv4_interface" ] && local wanIP=$(/sbin/ifconfig ${ipv4_interface}|awk '/inet addr/ {print $2}'|awk -F: '{print $2}'|grep -oE '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}')
		[ -z "$ipv4_interface" ] && local wanIP=$(getinterfacelist|grep '\"address\"'|grep -oE '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}')
		[ -z "$wanIP" ] && echo "获取失败" && return
		echo "$wanIP"
	elif [ $1 == "hostipv4" ] ;then
		function get_hostipv4()
		{
			local url_number=`echo "$ipv4_urllist"|wc -l`
			[ "$url_number" -le 0 ] && echo "获取失败" && return
			# 随机起点，失败换列表内另一个，最多 3 次
			local start=$(rand 1 $url_number)
			for i in 1 2 3; do
				local line=$(( (start + i - 1) % url_number + 1 ))
				local ipv4_URL=`echo "$ipv4_urllist"| sed -n "${line}p"|sed -e 's/\r//g'`
				[ -z "$ipv4_URL" ] && continue
				local hostIP=""
				# 出口策略：显式配置的接口为 LAN(私网) 时走默认路由（如单臂路由，
				# LAN 接口即通往公网的路径）；为 WAN(公网) 或多 WAN 场景绑定该接口探测
				if [ ! -z "$ipv4_interface" ]; then
					if iface_is_lan "$ipv4_interface"; then
						local hostIP=$(curl -k -s -4 -m 8 ${ipv4_URL})
					else
						local hostIP=$(curl -k -s -4 --interface ${ipv4_interface} -m 8 ${ipv4_URL})
					fi
				else
					local hostIP=$(curl -k -s -4 -m 8 ${ipv4_URL})
				fi
				local out=`echo $hostIP|grep -oE '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}'|head -n1`
				[ ! -z "$out" ] && echo "$out" && return
			done
			echo "获取失败"
		}
		local hostIP=`get_hostipv4`
		echo $hostIP
	elif [ $1 == "wanipv6" ] ;then
		[ ! -z "$ipv6_interface" ] && local wanIPv6=$(ip addr show ${ipv6_interface}|grep -v deprecated|grep -A1 'inet6 [^f:]'|sed -nr ':a;N;s#^ +inet6 ([a-f0-9:]+)/.+? scope global .*? valid_lft ([0-9]+sec) .*#\2 \1#p;ta'|sort -nr|head -n1|awk '{print $2}')
		[ -z "$ipv6_interface" ] && local wanIPv6=$(ip addr show|grep -v deprecated|grep -A1 'inet6 [^f:]'|sed -nr ':a;N;s#^ +inet6 ([a-f0-9:]+)/.+? scope global .*? valid_lft ([0-9]+sec) .*#\2 \1#p;ta'|sort -nr|head -n1|awk '{print $2}')
		[ -z "$wanIPv6" ] && echo "获取失败" && return
		echo "$wanIPv6"
	elif [ $1 == "hostipv6" ] ;then
		function get_hostipv6()
		{
			local urlv6_number=`echo "$ipv6_urllist"|wc -l`
			[ "$urlv6_number" -le 0 ] && echo "获取失败" && return
			# 随机起点，失败换列表内另一个，最多 3 次
			local start=$(rand 1 $urlv6_number)
			for i in 1 2 3; do
				local line=$(( (start + i - 1) % urlv6_number + 1 ))
				local ipv6_URL=`echo "$ipv6_urllist"| sed -n "${line}p"|sed -e 's/\r//g'`
				[ -z "$ipv6_URL" ] && continue
				local hostIPv6=""
				# 出口策略：LAN(私网) 接口走默认路由，WAN(公网) 接口绑定该接口探测
				if [ ! -z "$ipv6_interface" ]; then
					if iface_is_lan "$ipv6_interface"; then
						local hostIPv6=$(curl -k -s -6 -m 8 ${ipv6_URL})
					else
						local hostIPv6=$(curl -k -s -6 --interface ${ipv6_interface} -m 8 ${ipv6_URL})
					fi
				else
					local hostIPv6=$(curl -k -s -6 -m 8 ${ipv6_URL})
				fi
				local out=`echo $hostIPv6|grep -oE '([\da-fA-F0-9]{1,4}(:{1,2})){1,15}[\da-fA-F0-9]{1,4}'|head -n1`
				[ ! -z "$out" ] && echo "$out" && return
			done
			echo "获取失败"
		}
		local hostIPv6=`get_hostipv6`
		echo $hostIPv6
	fi
}

# 获取接口信息
function getinterfacelist(){
	[ `ubus list|grep -w -i "network.interface.wan"|wc -l` -ge "1" ] && ubus call network.interface.wan status && return
	[ `ubus list|grep -i "network.interface."|grep -v "loopback"|grep -v "wan6"|wc -l` -eq "1" ] && ubus call `ubus list|grep "network.interface."|grep -v "loopback"` status && return
}

# 获取接口在线时间
function getinterfaceuptime(){
	getinterfacelist|grep \"uptime\"|sed $'s/\"uptime": //g'|sed $'s/\,//g'
}

# 查询 mac 地址
function getmac(){
	( echo "$tmp_mac"|grep -q "unknown" ) && unset tmp_mac # 为unknown时重新读取
	[ -f "${dir}ipAddress" ] && [ -z "$tmp_mac" ] && local tmp_mac=`cat ${dir}ipAddress|grep -w ${1}|awk '{print $2}'|grep -v "^$"|sort -u|head -n1`
	[ -f "${dir}tmp_downlist" ] && [ -z "$tmp_mac" ] && local tmp_mac=`cat ${dir}tmp_downlist|grep -w ${1}|awk '{print $2}'|grep -v "^$"|sort -u|head -n1`
	[ -f "/var/dhcp.leases" ] && [ -z "$tmp_mac" ] && local tmp_mac=`cat /var/dhcp.leases|grep -w ${1}|awk '{print $2}'|grep -v "^$"|sort -u|head -n1`
	[ -z "$tmp_mac" ] && local tmp_mac=`cat /proc/net/arp|grep "0x2\|0x6"|grep -w ${1}|awk '{print $4}'|grep -v "^$"|sort -u|head -n1`
	[ -z "$tmp_mac" ] && local tmp_mac="unknown"
	echo "$tmp_mac"
}

# 查询主机名
function getname(){
	[ -z "$tmp_name" ] && local tmp_name=`echo "$device_aliases"|grep -i $2|awk '{print $2}'|grep -v "^$"|sort -u|head -n1`
	[ -f "${dir}ipAddress" ] && [ -z "$tmp_name" ] && local tmp_name=`cat ${dir}ipAddress|grep -w ${1}|awk '{print $3}'|grep -v "^$"|sort -u|head -n1`
	[ -f "${dir}tmp_downlist" ] && [ -z "$tmp_name" ] && local tmp_name=`cat ${dir}tmp_downlist|grep -w ${1}|awk '{print $3}'|grep -v "^$"|sort -u|head -n1`
	( ! echo "$tmp_name"|grep -q -w "unknown\|*" ) && [ ! -z "$tmp_name" ] && echo "$tmp_name" && return || unset tmp_name # 为unknown时重新读取
	[ -f "/var/dhcp.leases" ] && [ -z "$tmp_name" ] && local tmp_name=`cat /var/dhcp.leases|grep -w ${1}|awk '{print $4}'|grep -v "^$"|sort -u|head -n1`
	( ! echo "$tmp_name"|grep -q -w "unknown\|*" ) && [ ! -z "$tmp_name" ] && echo "$tmp_name" && return || unset tmp_name # 为unknown时重新读取
	[ -z "$dhcp_config" ] && dhcp_config=`uci show dhcp|grep "ip\|mac\|name"`
	for dhcp_config_str in "host" "domain"; do
		local dhcp_ip_n=`echo "$dhcp_config"|grep -w ^dhcp.@${dhcp_config_str}.*ip=.${1}|sed -nr 's#^dhcp.(.*).ip.*#\1#gp'` 2>/dev/null
		[ ! -z "$dhcp_ip_n" ] && [ -z "$tmp_name" ] && local tmp_name=`uci get dhcp.${dhcp_ip_n}.name` 2>/dev/null
		local dhcp_mac_n=`echo "$dhcp_config"|grep -i ^dhcp.@${dhcp_config_str}.*mac=.${2}|sed -nr 's#^dhcp.(.*).mac.*#\1#gp'` 2>/dev/null
		[ ! -z "$dhcp_mac_n" ] && [ -z "$tmp_name" ] && local tmp_name=`uci get dhcp.${dhcp_ip_n}.name` 2>/dev/null
		[ ! -z "$tmp_name" ] && break
	done
	( ! echo "$tmp_name"|grep -q -w "unknown\|*" ) && [ ! -z "$tmp_name" ] && echo "$tmp_name" && return || unset tmp_name # 为unknown时重新读取
	[ -f "$oui_base" ] && local tmp_name=$(cat $oui_base|grep -i $(echo "$2"|cut -c 1,2,4,5,7,8)|sed -nr 's#^.*16)..(.*)#\1#gp'|sed 's/ /_/g')
	[ ! -z "$oui_data" ] && [ "$oui_data" -eq "4" ] && local tmp_name=$(curl -sS "https://standards-oui.ieee.org/oui/oui.txt"|grep -i $(echo "$2"|cut -c 1,2,4,5,7,8)|sed -nr 's#^.*16)..(.*)#\1#gp'|sed 's/ /_/g')
	[ -z "$tmp_name" ] && local tmp_name="unknown"
	echo "$tmp_name"
}

# 查询设备接口
function getinterface(){
	[ -f "${dir}ipAddress" ] && local ip_interface=`cat ${dir}ipAddress|grep -w ${1}|awk '{print $5}'|grep -v "^$"|sort -u|head -n1`
	[ -f "${dir}tmp_downlist" ] && [ -z "$ip_interface" ] && local ip_interface=`cat ${dir}tmp_downlist|grep -w ${1}|awk '{print $5}'|grep -v "^$"|sort -u|head -n1`
	if [ -z "$ip_interface" ] && [ ! -z "$wlan_interface" ]; then
		for interface in $wlan_interface; do
			local ip_interface=`iw dev $interface station dump 2>/dev/null|grep Station|grep -i -w ${1}|sed -nr 's#^.*on (.*))#\1#gp'` >/dev/null 2>&1
			[ ! -z "$ip_interface" ] && echo "$ip_interface" && return
		done
	fi
	[ -z "$ip_interface" ] && local ip_interface=`cat /proc/net/arp|grep "0x2\|0x6"|grep -i -w ${1}|awk '{print $6}'|grep -v "^$"|sort -u|head -n1`
	echo "$ip_interface"
}

# ping
function getping(){
	[ "$iw_version" ] && local wlan_online=`iw dev ${ip_interface} station dump|grep -i -w ${ip_mac}|grep Station` >/dev/null 2>&1
	[ "$wlan_online" ] && return 0
	for i in `seq 1 ${3}`; do
		( ! echo "$ip_ms"|grep -q "ms" ) && local ip_ms=$( arping -I `cat /proc/net/arp|grep -w ${1}|awk '{print $6}'|grep -v "^$"|sort -u|head -n1` -c 20 -f -w ${2} $1 ) 2>/dev/null
		( ! echo "$ip_ms"|grep -q "ms" ) && local ip_ms=`ping -c 5 -w ${2} ${1}|grep -v '100% packet loss'` 2>/dev/null
		( ! echo "$ip_ms"|grep -q "ms" ) && sleep 1
	done
	( echo "$ip_ms"|grep -q "ms" )
}

# CPU 占用率
function getcpu(){
	local AT=$(cat /proc/stat|grep "^cpu "|awk '{print $2+$3+$4+$5+$6+$7+$8 " " $2+$3+$4+$7+$8}')
	sleep 3
	local BT=$(cat /proc/stat|grep "^cpu "|awk '{print $2+$3+$4+$5+$6+$7+$8 " " $2+$3+$4+$7+$8}')
	printf "%.01f%%" $(echo ${AT} ${BT}|awk '{print (($4-$2)/($3-$1))*100}')
}

# 获取SOC温度 （取所有传感器温度最大值）
function soc_temp(){
	[ -z "$soc_code" ] && local soctemp=`sensors 2>/dev/null|grep °C|sed -nr 's#^.*:.*\+(.*)°C .*#\1#gp'|sort -nr|head -n1`
	[ -z "$soc_code" ] && [ -z "$soctemp" ] && local soctemp=`cat /sys/class/thermal/thermal_zone*/temp 2>/dev/null|sort -nr|head -n1|cut -c-2`
	[ "$soc_code" == "pve" ] && [ ! -z "$pve_host" ] && local soctemp=`ssh -i ~/.ssh/id_rsa root@${pve_host} -p ${pve_port} sensors 2>/dev/null|grep °C|sed -nr 's#^.*:.*\+(.*)°C .*#\1#gp'|sort -nr|head -n1`
	[ ! -z "$soctemp" ] && echo "$soctemp" && return
	[ ! -z "$soc_code" ] && eval `echo "$soc_code"` 2>/dev/null
}

# 流量数据查询（数据源由全局变量 traffic_source 决定，启动时一次性探测）
function usage(){
	[ ! "$1" ] && return
	if [ $1 == "update" ] ;then
		# nlbwmon 为实时 daemon（socket 查询），无需手动刷新；仅 wrtbwmon 时需要
		if [ "$traffic_source" = "nlbw" ]; then
			return
		fi
		# ---- wrtbwmon 路径 ----
		[ ! -f "/usr/sbin/wrtbwmon" ] && return
		function version_ge() {
			local a=$(echo "$1"|sed 's/-r[0-9]*$//;s/[^0-9.]//g') b=$(echo "$2"|sed 's/-r[0-9]*$//;s/[^0-9.]//g')
			local a1=$(echo "$a"|cut -d. -f1) a2=$(echo "$a"|cut -d. -f2) a3=$(echo "$a"|cut -d. -f3)
			local b1=$(echo "$b"|cut -d. -f1) b2=$(echo "$b"|cut -d. -f2) b3=$(echo "$b"|cut -d. -f3)
			[ "${a1:-0}" -gt "${b1:-0}" ] 2>/dev/null && return 0
			[ "${a1:-0}" -lt "${b1:-0}" ] 2>/dev/null && return 1
			[ "${a2:-0}" -gt "${b2:-0}" ] 2>/dev/null && return 0
			[ "${a2:-0}" -lt "${b2:-0}" ] 2>/dev/null && return 1
			[ "${a3:-0}" -ge "${b3:-0}" ] 2>/dev/null
		}
		local wrv=$(echo "$wr_version"|sed 's/-r[0-9]*$//')
		if [ ! -z "$wrv" ] && version_ge "$wrv" "1.2.0"; then
			wrtbwmon -f ${dir}usage.db >/dev/null 2>&1
		else
			wrtbwmon update ${dir}usage.db >/dev/null 2>&1
		fi
		local dbrows_after=$(grep -c "," ${dir}usage.db 2>/dev/null)
		[ -z "$dbrows_after" ] && dbrows_after="0"
		[ "$dbrows_after" -gt "1" ] && return
		if [ ! -z "$wrv" ] && version_ge "$wrv" "1.2.0"; then
			wrtbwmon update ${dir}usage.db >/dev/null 2>&1
		else
			wrtbwmon -f ${dir}usage.db >/dev/null 2>&1
		fi
		local dbrows_after2=$(grep -c "," ${dir}usage.db 2>/dev/null)
		[ -z "$dbrows_after2" ] && dbrows_after2="0"
		[ "$dbrows_after2" -gt "1" ] && return
		wrtbwmon setup ${dir}usage.db >/dev/null 2>&1
		wrtbwmon update ${dir}usage.db >/dev/null 2>&1
		return
	elif [ $1 == "get" ] ;then
		local tmptotal=""
		if [ "$traffic_source" = "nlbw" ] && [ ! -z "$2" ]; then
			tmptotal=$(nlbw -c csv -s, -q -n -g mac 2>/dev/null | awk -F',' -v m="$(echo "$2"|tr 'A-Z' 'a-z')" 'NR>1 && $1==m {print $3+$5; exit}')
		fi
		# wrtbw 回落（nlbw 模式下 MAC 不在 nlbw 中时回落，wrtbw 模式下直接走这里）
		if [ "$traffic_source" = "wrtbw" ] || [ -z "$tmptotal" ]; then
			local dbrows=$(grep -c "," ${dir}usage.db 2>/dev/null)
			[ -z "$dbrows" ] && dbrows="0"
			if [ "$dbrows" -gt "1" ]; then
				[ -z "$total_n" ] && total_n=`cat ${dir}usage.db|head -n1|grep "total"|sed 's/,/\n/g'|awk '/total/{print NR}'` 2>/dev/null
				[ -z "$total_n" ] && total_n="6"
				[ "$2" ] && local tmptotal2=`cat ${dir}usage.db|sed 's/,,,/,0,0,/g'|sed 's/,,/,0,/g'|sed 's/,/ /g'|grep -i -w ${2}|awk "{print "'$'$total_n"}"|grep -v "^$"|sort -u|head -n1` 2>/dev/null
			fi
			[ ! -z "$tmptotal2" ] && tmptotal="$tmptotal2"
		fi
		[ -z "$tmptotal" ] && local tmptotal="0"
		[ ! "$3" ] && echo `bytes_for_humans ${tmptotal}` || echo "$tmptotal"
	elif [ $1 == "list" ] ;then
		# 输出 "mac total_bytes" 列表(供 LuCI 在线设备表格)
		if [ "$traffic_source" = "nlbw" ]; then
			nlbw -c csv -s, -q -n -g mac 2>/dev/null | awk -F',' 'NR>1 && $1!="mac" {print tolower($1)" "$3+$5}'
			return
		fi
		# wrtbw 模式
		local dbrows=$(grep -c "," ${dir}usage.db 2>/dev/null)
		[ -z "$dbrows" ] && dbrows="0"
		if [ "$dbrows" -gt "1" ]; then
			[ -z "$total_n" ] && total_n=`cat ${dir}usage.db|head -n1|grep "total"|sed 's/,/\n/g'|awk '/total/{print NR}'` 2>/dev/null
			[ -z "$total_n" ] && total_n="6"
			cat ${dir}usage.db|sed 's/,,,/,0,0,/g'|sed 's/,,/,0,/g'|sed 's/,/ /g'|grep -v "^#"|grep -v "^$"|awk -v n="$total_n" 'NR>1 && $1!="mac" {print tolower($1)" "$n}'
		fi
	elif [ $1 == "down" ] ;then
		[ "$2" ] && sed -i "/,${2},/d" ${dir}usage.db 2>/dev/null
	fi
}

# 流量数据单位换算
function bytes_for_humans {
	[ ! "$1" ] && return
	[ "$1" -gt 1073741824 ] && echo "`awk 'BEGIN{printf "%.2f\n",'$1'/'1073741824'}'` G" && return
	[ "$1" -gt 1048576 ] && echo "`awk 'BEGIN{printf "%.2f\n",'$1'/'1048576'}'` M" && return
	[ "$1" -gt 1024 ] && echo "`awk 'BEGIN{printf "%.2f\n",'$1'/'1024'}'` K" && return
	echo "${1} bytes"
}

# 设备异常流量检测
function get_client_usage(){
	[ -z "$client_usage" ] && return
	[ "$client_usage" -ne "1" ] && return
	[ -z "$client_usage_max" ] && return
	[ -z "$get_client_usage_time" ] && get_client_usage_time=`date +%s`
	( echo $client_usage_max|sed -r 's/.*(.)$/\1/'|grep -q "K\|k" ) && client_usage_max=`expr ${client_usage_max%?} \* 1024`
	( echo $client_usage_max|sed -r 's/.*(.)$/\1/'|grep -q "M\|m" ) && client_usage_max=`expr ${client_usage_max%?} \* 1048576`
	( echo $client_usage_max|sed -r 's/.*(.)$/\1/'|grep -q "G\|g" ) && client_usage_max=`expr ${client_usage_max%?} \* 1073741824`
	[ -z "$client_usage_disturb" ] && client_usage_disturb="0"
	[ "$client_usage_disturb" -eq "0" ] && [ -f "${dir}ipAddress" ] && local MACLIST=`cat ${dir}ipAddress|awk '{print $2}'|grep -v "^$"|sort -u`
	[ "$client_usage_disturb" -eq "1" ] && [ ! -z "$client_usage_whitelist" ] && local MACLIST=`echo "$client_usage_whitelist"`
	[ -z "$MACLIST" ] && return

	if [ "$((`date +%s`-$get_client_usage_time))" -ge "$sleeptime" ] && [ "$sleeptime" -ge "10" ]; then
		> ${dir}client_usage_aliases
		local _now=$(date +%s)
		for mac in $MACLIST; do
			( ! cat ${dir}ipAddress|grep -q -i -w $mac|grep -v "^$"|sort -u|head -n1 ) && continue
			echo "$mac" `usage get ${mac} bytes` >> ${dir}client_usage_aliases
			[ -f "${dir}old_client_usage_aliases" ] && get_client_usage_bytes=`cat ${dir}old_client_usage_aliases|grep -i -w $mac|awk '{print $2}'|grep -v "^$"|sort -u|head -n1` || continue
			[ -z "$get_client_usage_bytes" ] && get_client_usage_bytes="0"
			# 上线首屏静默：设备在线时间不足 2 个检测周期，记录快照但不触发告警
			local _up_ts=$(cat ${dir}ipAddress|grep -i -w ${mac}|awk '{print $4}'|grep -v "^$"|sort -u|head -n1)
			[ ! -z "$_up_ts" ] && [ "$((_now - _up_ts))" -lt "$((sleeptime * 2))" ] && continue
			if [ "$((`usage get ${mac} bytes`-$get_client_usage_bytes))" -ge "$client_usage_max" ]; then
				local ip=`cat ${dir}ipAddress|grep -i -w $mac|awk '{print $1}'|grep -v "^$"|sort -u|head -n1`
				local ip_name=`getname ${ip} ${mac}`
				local tmp_usage=$(bytes_for_humans $(expr `usage get ${mac} bytes` - ${get_client_usage_bytes}))
