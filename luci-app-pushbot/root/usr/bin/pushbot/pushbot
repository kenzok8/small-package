#!/bin/sh

. /usr/bin/pushbot/package_manager.sh

# 读取设置文件
function get_config(){
	while [[ "$*" != "" ]]; do
		eval ${1}='`uci get pushbot.pushbot.$1`' 2>/dev/null
		shift
	done
}

# 初始化设置信息
function read_config(){
	get_config "pushbot_enable" "lite_enable" "device_name" "sleeptime" "oui_dir" "oui_data" "reset_regularly" "debuglevel" "device_aliases" \
	"pushbot_ipv4" "ipv4_interface" "pushbot_ipv6" "ipv6_interface" "pushbot_up" "pushbot_down" "cpuload_enable" "cpuload" "temperature_enable" "temperature" \
	"regular_time" "regular_time_2" "regular_time_3" "interval_time" "crontab" \
	"client_usage" "client_usage_max" "client_usage_disturb" "client_usage_whitelist" \
	"web_logged" "ssh_logged" "web_login_failed" "ssh_login_failed" "wifi_connected" "wifi_auth_failed" "login_max_num" "web_login_black" "ip_white_list" "ip_black_timeout" "ip_black_persist" \
	"pushbot_sheep" "starttime" "endtime" "pushbot_whitelist" "pushbot_blacklist" "pushbot_interface" "MAC_online_list" "MAC_offline_list" \
	"dnd_low_range" \
	"up_timeout" "down_timeout" "timeout_retry_count" "thread_num" "soc_code" "pve_host" "pve_port"\
	"err_enable" "err_sheep_enable" "err_device_aliases" "network_err_event" "system_time_event" "autoreboot_time" "network_restart_time" "public_ip_event" "public_ip_retry_count" \
	"jsonpath" "dd_webhook" "we_webhook" "pp_token" "pp_channel" "pp_webhook" "pp_topic_enable" "pp_topic" "fs_webhook" "pushdeer_key" "pushdeer_srv_enable" "pushdeer_srv" "bark_srv_enable" "bark_srv" "bark_token" "bark_sound" "bark_icon" "bark_icon_enable" "bark_level" "ntfy_srv_enable" "ntfy_server" "ntfy_topic" "ntfy_token_enable" "ntfy_token" "ntfy_priority" "gotify_server" "gotify_token" "gotify_priority" "wxpusher_app_token" "wxpusher_uids_enable" "wxpusher_uids" "wxpusher_topics_enable" "wxpusher_topics" \
	"font_title" "font_success" "font_fail" "font_client" "font_module"
	
	# WxPusher: 根据 enable 状态处理数组，未 enable 的直接设为空数组
	# 分隔符兼容中英文逗号、空格与制表符（与界面提示"逗号或空格分隔"一致）
	# UID 数量上限 20（插件自身限制，官方虽支持 2000，OpenWrt 场景无需那么多）
	if [ "$wxpusher_uids_enable" = "1" ] && [ ! -z "$wxpusher_uids" ]; then
		wxpusher_uids_json=$(printf '%s' "$wxpusher_uids" | sed 's/[,，]/\n/g' | tr ' \t' '\n\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^$' | head -20 | awk '{printf "\"%s\",", $0}' | sed 's/,$//')
		wxpusher_uids="[${wxpusher_uids_json}]"
	else
		wxpusher_uids="[]"
	fi
	if [ "$wxpusher_topics_enable" = "1" ] && [ ! -z "$wxpusher_topics" ]; then
		# 官方限制：单条消息最多 5 个 TopicID，超出部分忽略（只取前 5 个）
		wxpusher_topics_json=$(printf '%s' "$wxpusher_topics" | sed 's/[,，]/\n/g' | tr ' \t' '\n\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^$' | head -5 | awk '{printf "%s,", $0}' | sed 's/,$//')
		wxpusher_topics="[${wxpusher_topics_json}]"
	else
		wxpusher_topics="[]"
	fi
	
	for str_version in "wrtbwmon" "iputils-arping" "curl" "iw"; do
		pkg_var="${str_version:0:2}_version"
		eval "${pkg_var}=\$(get_package_version \"${str_version}\")"
	done
	dir="/tmp/pushbot/" && mkdir -p ${dir}
	tempjsonpath="/tmp/pushbot/temp.json"
	# 黑名单文件路径：根据拉黑时长动态化
	# 永久拉黑（ip_black_timeout=0）且持久化开启：使用持久目录
	# 非永久拉黑 或 持久化关闭：使用 /tmp（OpenWrt 重启后清空）
	local ip_black_persist="${ip_black_persist:-1}"
	[ "$ip_black_persist" = "undefined" ] && ip_black_persist="1"
	[ "$ip_black_persist" = "null" ] && ip_black_persist="1"
	if [ "$ip_black_timeout" = "0" ] && [ "$ip_black_persist" = "1" ]; then
		ip_blacklist_path="/usr/bin/pushbot/api/ip_blacklist"
	else
		ip_blacklist_path="${dir}ip_blacklist"
	fi
	# 收集本机所有接口地址（v4+v6）用于黑名单自我保护：本机地址与
	# 127.0.0.1/::1 永不进入黑名单（登录监控可能把本机探测/回环误判为
	# 失败来源，拉黑自己会断掉 Web/SSH 访问）。收集含回环与全部接口。
	local_addrs="127.0.0.1 ::1"
	local_addrs="$local_addrs $(ip -o addr show 2>/dev/null | awk '{print $4}' | cut -d'/' -f1 | grep -vE '^$' | tr '\n' ' ')"
	[ ! -z "$oui_dir" ] && [ "$oui_dir" -eq "1" ] && oui_base="${dir}oui_base.txt" || oui_base="/usr/bin/pushbot/oui_base.txt"
	debuglevel=`echo "$debuglevel"` && [ -z "$debuglevel" ] && logfile="/dev/null" || logfile="${dir}pushbot.log"
	pushbot_blacklist=`echo "$pushbot_blacklist"|sed 's/ /\n/g'` 2>/dev/null
	pushbot_whitelist=`echo "$pushbot_whitelist"|sed 's/ /\n/g'` 2>/dev/null
	device_aliases=`echo "$device_aliases"|sed 's/ /\n/g'|sed 's/-/ /'` 2>/dev/null
	err_device_aliases=`echo "$err_device_aliases"|sed 's/ /\n/g'` 2>/dev/null
	client_usage_whitelist=`echo "$client_usage_whitelist"|sed 's/ /\n/g'` 2>/dev/null
	ip_white_list=`echo "$ip_white_list"|sed 's/ /\n/g'` 2>/dev/null
	mark_mac_list="${MAC_online_list} ${MAC_offline_list}"
	mark_mac_list=`echo "$mark_mac_list"|sed 's/ /\n/g'|sed 's/-/ /'` 2>/dev/null
	ipv4_urllist=`cat /usr/bin/pushbot/api/ipv4.list` 2>/dev/null
	ipv6_urllist=`cat /usr/bin/pushbot/api/ipv6.list` 2>/dev/null
	[ -z "$pushbot_ipv4" ] && pushbot_ipv4=0
	[ -z "$pushbot_ipv6" ] && pushbot_ipv6=0
	# 无线接口检测（缓存到 /tmp，与防火墙/流量源探测一致）
	wlan_interface=""
	if [ -f "${dir}wlan_interface" ]; then
		# 读取缓存（启动后不再输出日志）
		wlan_interface=$(cat ${dir}wlan_interface 2>/dev/null)
	else
		# 缓存不存在，执行探测并输出日志
		[ "$iw_version" ] && wlan_interface=`iw dev|grep Interface|awk '{print $2}'` >/dev/null 2>&1
		# 补充检测：/sys/class/net/*/wireless 覆盖 MTK 闭源等 iw 无输出的平台
		local _wifi_sys=$(ls /sys/class/net/*/wireless 2>/dev/null | sed 's|/sys/class/net/||;s|/wireless||;s/:$//')
		for _w in $_wifi_sys; do
			echo "$wlan_interface" | grep -q -w "$_w" || wlan_interface="${wlan_interface} ${_w}"
		done
		echo "$wlan_interface" > ${dir}wlan_interface
		if [ ! -z "$wlan_interface" ]; then
			echo "`date "+%Y-%m-%d %H:%M:%S"` 【检测到无线接口：${wlan_interface}】" >> ${logfile}
		else
			echo "`date "+%Y-%m-%d %H:%M:%S"` 【未检测到无线接口】" >> ${logfile}
		fi
	fi
	[ -z "$up_timeout" ] || [ "$up_timeout" -eq "0" ] && up_timeout="2"
	[ -z "$down_timeout" ] || [ "$down_timeout" -eq "0" ] && down_timeout="20";down_timeout=`expr ${down_timeout} / 2 + 1`
	[ -z "$timeout_retry_count" ] && timeout_retry_count="2";[ "$timeout_retry_count" -eq "0" ] && timeout_retry_count="1"
	[ ! -z "$bark_token" ] && [ -z "$bark_srv" ] && bark_srv="https://api.day.app"
	[ ! -z "$pushdeer_key" ] && [ -z "$pushdeer_srv" ] && pushdeer_srv="https://api2.pushdeer.com"
	
# 字符串读取
	str_title_start=`/usr/bin/jq -r '.str_title_start' ${jsonpath}`
	str_title_end=`/usr/bin/jq -r '.str_title_end' ${jsonpath}`
	# 命令替换会剥离尾随换行; json 值为纯换行(如 ntfy 的 "\n")时会被剥成空, 加哨兵 X 保护
	str_linefeed=`/usr/bin/jq -r '.str_linefeed' ${jsonpath}; printf X`
	str_splitline=`/usr/bin/jq -r '.str_splitline' ${jsonpath}; printf X`
	str_linefeed="${str_linefeed%X}"
	str_splitline="${str_splitline%X}"
	str_space=`/usr/bin/jq -r '.str_space' ${jsonpath}`
	str_tab=`/usr/bin/jq -r '.str_tab' ${jsonpath}`
	# 颜色:预设取自 json 中的完整 <font color=...> 标签(缺失/空则保持无色);
	# uci 自定义合法色值优先组装,空/非法沿用预设,同时阻断注入
	_f=`/usr/bin/jq -r '.font_title' ${jsonpath}` 2>/dev/null; [ "$_f" = "null" ] && _f=""
	echo "$font_title"|grep -qE '^#[0-9a-fA-F]{6}$' 2>/dev/null && font_title="<font color=${font_title}>" || font_title="$_f"
	_f=`/usr/bin/jq -r '.font_success' ${jsonpath}` 2>/dev/null; [ "$_f" = "null" ] && _f=""
	echo "$font_success"|grep -qE '^#[0-9a-fA-F]{6}$' 2>/dev/null && font_success="<font color=${font_success}>" || font_success="$_f"
	_f=`/usr/bin/jq -r '.font_fail' ${jsonpath}` 2>/dev/null; [ "$_f" = "null" ] && _f=""
	echo "$font_fail"|grep -qE '^#[0-9a-fA-F]{6}$' 2>/dev/null && font_fail="<font color=${font_fail}>" || font_fail="$_f"
	_f=`/usr/bin/jq -r '.font_client' ${jsonpath}` 2>/dev/null; [ "$_f" = "null" ] && _f=""
	echo "$font_client"|grep -qE '^#[0-9a-fA-F]{6}$' 2>/dev/null && font_client="<font color=${font_client}>" || font_client="$_f"
	_f=`/usr/bin/jq -r '.font_module' ${jsonpath}` 2>/dev/null; [ "$_f" = "null" ] && _f=""
	echo "$font_module"|grep -qE '^#[0-9a-fA-F]{6}$' 2>/dev/null && font_module="<font color=${font_module}>" || font_module="$_f"
	unset _f
	# 兼容旧模板变量名:用户自定义 diy.json 的 data 模板若引用 font_green/font_red 等旧名仍可用
	font_green="$font_success"; font_green2="$font_client"; font_red="$font_fail"; font_blue="$font_module"; font_purple="$font_title"
	# pushplus 渠道(微信端 markdown)不支持表格内 <font> 颜色, 设备名颜色禁用(分段标题颜色保留)
	[ "$jsonpath" = "/usr/bin/pushbot/api/pushplus.json" ] && font_client=""
	font_end=`/usr/bin/jq -r '.font_end' ${jsonpath}`
	font_end2=`/usr/bin/jq -r '.font_end2' ${jsonpath}`
	percentsym=`/usr/bin/jq -r '.percentsym' ${jsonpath}`
	boldstar=`/usr/bin/jq -r '.boldstar' ${jsonpath}` 2>/dev/null; [ "$boldstar" = "null" ] && boldstar=""
	# 加粗结束标记：Markdown 渠道与 boldstar 相同（对称 **），HTML 渠道为 </b>
	boldend=`/usr/bin/jq -r '.boldend' ${jsonpath}` 2>/dev/null; [ "$boldend" = "null" ] && boldend="$boldstar"
	table_enable=`/usr/bin/jq -r '.table_enable' ${jsonpath}` 2>/dev/null; [ "$table_enable" = "null" ] && table_enable=""
	get_config "table_format"; [ "$table_format" = "0" ] && table_enable=""
	# 表格化实现方式：钉钉用 Markdown 表格，WxPusher 用 HTML 表格（无边框、无表头，卡片式）
	case "$jsonpath" in
		*wxpusher.json) table_mode="html" ;;
		*) table_mode="md" ;;
	esac
	# ntfy 纯文本: 不支持表格/markdown, 强制非表格
	( echo "${jsonpath}"|grep -q "ntfy" ) && table_enable=""
	( echo "$lite_enable"|grep -q "content" ) && str_title_start="" && str_title_end="" && str_splitline="" && str_linefeed="" && str_tab=""
}
	
	

# 初始化
function pushbot_init(){
	enable_detection
	if [ -f "/usr/bin/pushbot/errlog" ]; then
		cat /usr/bin/pushbot/errlog > ${logfile}
		echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】载入上次重启前日志" >> ${logfile}
		echo "--------------------------------------------------------" >> ${logfile}
	fi
	down_oui &
	deltemp
	get_syslog
	# 只有拉黑功能启用时才执行黑名单初始化（含防火墙模式探测）
	if [ "$web_login_black" = "1" ]; then
		init_firewall_mode
		# 检查是否有变化需要同步（避免每次启动都重复执行）
		if need_blacklist_sync; then
			add_ip_black
		fi
	fi
	
	rm -f ${dir}fd1 ${dir}sheep_usage ${dir}old_sheep_usage ${dir}client_usage_aliases ${dir}old_client_usage_aliases /usr/bin/pushbot/errlog >/dev/null 2>&1
	[ -f "/usr/sbin/wrtbwmon" ] || command -v nlbw >/dev/null 2>&1 || echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】未安装 wrtbwmon 且 nlbwmon 不可用，流量统计不可用" >> ${logfile}
	[ -z "$ip_version" ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】无法获取依赖项 iputils-arping 版本号，请确认插件是否正常运行" >> ${logfile}
	[ -z "$cu_version" ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】无法获取依赖项 curl 版本号，请确认插件是否正常运行" >> ${logfile}
	# 按当前渠道(jsonpath)检查该渠道的必填参数，精确报出缺哪个字段。
	# 相比旧的"全空才报"：消除漏报（选 WxPusher 没填 token 但其他渠道有残留时不报）
	# 与误报（ntfy_server 等存量残留值让检查失效）；ntfy 公共服务器兜底、diy 凭据在
	# diy.json 内，两者无固定必填字段，跳过。
	local _miss="" _ch=""
	case "$jsonpath" in
	*dingding.json)
		_ch="钉钉"; [ -z "$dd_webhook" ] && _miss="dd_webhook(Webhook)" ;;
	*ent_wechat.json)
		_ch="企业微信"; [ -z "$we_webhook" ] && _miss="we_webhook(Webhook)" ;;
	*pushplus.json)
		_ch="PushPlus"; [ -z "$pp_token" ] && _miss="pp_token(Token)" ;;
	*feishu.json)
		_ch="飞书"; [ -z "$fs_webhook" ] && _miss="fs_webhook(Webhook)" ;;
	*pushdeer.json)
		_ch="PushDeer"; [ -z "$pushdeer_key" ] && _miss="pushdeer_key(Key)" ;;
	*bark.json)
		_ch="Bark"; [ -z "$bark_token" ] && _miss="bark_token(Token)" ;;
	*gotify.json)
		_ch="Gotify"; { [ -z "$gotify_server" ] || [ -z "$gotify_token" ]; } && _miss="gotify_server/gotify_token" ;;
	*wxpusher.json)
		_ch="WxPusher"; [ -z "$wxpusher_app_token" ] && _miss="wxpusher_app_token(App Token)" ;;
	*ntfy.json | *diy.json)
		: ;;
	*)
		: ;;
	esac
	[ -n "$_miss" ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】请填写正确的Token/Webhook（当前渠道 ${_ch} 缺少：${_miss}）" >> ${logfile} && return 1
	local interfacelist=`getinterfacelist` && [ -z "$interfacelist" ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】无法正确获取接口信息，请确认插件是否正常运行" >> ${logfile}
	return 0
}

# ── 表格化辅助函数 ──
# 生成表格分隔线
md_table_sep() {
	echo "| --- | --- |"
}

# 生成表格数据行
# 用法: md_table_row "标签" "值"
md_table_row() {
	echo "| **${1}** | ${2} |"
}

# 生成表格体（首行 + 分隔线 + 其余数据行），输出以 \n 开头，供 content 直接拼接
# 用法: md_table_body "标签1" "值1" "标签2" "值2" ...
# 输出: \n| **标签1** | 值1 |\n| --- | --- |\n| **标签2** | 值2 |
md_table_body() {
	local LF='\n'
	local result=""
	if [ $# -ge 2 ]; then
		result="${LF}$(md_table_row "$1" "$2")"
		shift 2
		result="${result}${LF}$(md_table_sep)"
	fi
	while [ $# -ge 2 ]; do
		result="${result}${LF}$(md_table_row "$1" "$2")"
		shift 2
	done
	printf '%s' "$result"
}

# 生成多列表格分隔线
# 用法: md_table_sep_n 3
md_table_sep_n() {
	local n="${1:-2}"
	local result='|'
	local i=1
	while [ $i -le $n ]; do
		result="${result} --- |"
		i=$((i + 1))
	done
	echo "$result"
}

# 生成多列表格数据行（列内容原样输出，加粗由调用方控制）
# 用法: md_table_row_n "列1" "列2" "列3"
md_table_row_n() {
	local result='|'
	for v in "$@"; do
		result="${result} ${v} |"
	done
	echo "$result"
}

# 生成表格续行（仅数据行，不含分隔线），输出以 \n 开头
# 用法: md_table_rows "标签1" "值1" "标签2" "值2" ...
md_table_rows() {
	local LF='\n'
	local result=""
	while [ $# -ge 2 ]; do
		result="${result}${LF}$(md_table_row "$1" "$2")"
		shift 2
	done
	printf '%s' "$result"
}

# ── HTML 表格实现（无边框、无表头、卡片式，供 WxPusher 等 HTML 渠道使用）──
# 单元格内联样式：左列为浅色标签，右列为右对齐值
_html_td_l='padding:6px 10px;color:#888888;font-size:14px;white-space:nowrap'
_html_td_m='padding:6px 10px;font-size:14px'
_html_td_r='padding:6px 10px;text-align:right;font-size:14px;word-break:break-all'

# Markdown 粗体语法 **x** 转 HTML <b>x</b>（HTML 渠道不渲染 markdown 语法）
_md_bold2html() {
	printf '%s' "$1" | sed 's/\*\*\([^*][^*]*\)\*\*/<b>\1<\/b>/g; s/\*\*//g'
}

# 生成 HTML 表格数据行（左标签自动加粗，已有粗体则不重复包裹）
# 用法: html_table_row "标签" "值"
html_table_row() {
	local label value
	label=$(_md_bold2html "$1")
	value=$(_md_bold2html "$2")
	case "$label" in
		*'<b>'*) : ;;
		*) label="<b>${label}</b>" ;;
	esac
	printf '<tr><td style="%s">%s</td><td style="%s">%s</td></tr>' "$_html_td_l" "$label" "$_html_td_r" "$value"
}

# 把 <tr> 行包裹为无边框表格（所有参数为已生成的 tr 串）
html_table_wrap() {
	[ -z "$1" ] && return
	printf '<table border="0" cellspacing="0" cellpadding="0" style="width:100%%;border-collapse:collapse">%s</table>' "$1"
}

# 生成 HTML 表格体（无表头，全部作为数据行）
# 用法: html_table_body "标签1" "值1" "标签2" "值2" ...
html_table_body() {
	local rows=""
	while [ $# -ge 2 ]; do
		rows="${rows}$(html_table_row "$1" "$2")"
		shift 2
	done
	html_table_wrap "$rows"
}

# 生成 HTML 表格续行（独立无边框表格，视觉上与主表连续）
# 用法: html_table_rows "标签1" "值1" ...
html_table_rows() {
	html_table_body "$@"
}

# 生成 HTML 多列数据行（首列浅色标签，末列右对齐，中间列常规）
# 用法: html_table_row_n "列1" "列2" "列3"
html_table_row_n() {
	local result='<tr>'
	local total=$#
	local i=0
	local cv
	for v in "$@"; do
		i=$((i + 1))
		cv=$(_md_bold2html "$v")
		if [ $i -eq 1 ]; then
			# 首列：确保加粗；若已带 font 颜色则用常规样式（避免浅灰标签色覆盖）
			case "$cv" in
				*'<b>'*) : ;;
				*) cv="<b>${cv}</b>" ;;
			esac
			case "$cv" in
				*'<font'*) result="${result}<td style=\"${_html_td_m}\">${cv}</td>" ;;
				*) result="${result}<td style=\"${_html_td_l}\">${cv}</td>" ;;
			esac
		elif [ $i -eq $total ]; then
			result="${result}<td style=\"${_html_td_r}\">${cv}</td>"
		else
			result="${result}<td style=\"${_html_td_m}\">${cv}</td>"
		fi
	done
	printf '%s</tr>' "$result"
}

# ── 表格化分发层 ──
# 业务代码统一调用 table_*，由 table_mode 决定走 Markdown 还是 HTML 实现
table_sep()   { [ "$table_mode" = "html" ] && return 0; md_table_sep; }
table_row()   { if [ "$table_mode" = "html" ]; then html_table_row "$@"; else md_table_row "$@"; fi; }
table_body()  { if [ "$table_mode" = "html" ]; then html_table_body "$@"; else md_table_body "$@"; fi; }
table_rows()  { if [ "$table_mode" = "html" ]; then html_table_rows "$@"; else md_table_rows "$@"; fi; }
# 多列行/分隔线：Markdown 需补换行前缀，HTML 依靠标签结构不需换行
table_sep_n() { [ "$table_mode" = "html" ] && return 0; printf '\n%s' "$(md_table_sep_n "$@")"; }
table_row_n() { if [ "$table_mode" = "html" ]; then html_table_row_n "$@"; else printf '\n%s' "$(md_table_row_n "$@")"; fi; }

# 表格表头行 + 分隔线：仅 Markdown 需要（HTML 无表头概念，直接返回空）
# 用法: table_header "标签1" "值1" ...
table_header() {
	[ "$table_mode" = "html" ] && return 0
	printf '\n%s\n%s' "$(md_table_row "$@")" "$(md_table_sep)"
}

# 多列表格表头行 + 分隔线：仅 Markdown 需要
# 用法: table_header_n "列1" "列2" "列3"
table_header_n() {
	[ "$table_mode" = "html" ] && return 0
	printf '\n%s\n%s' "$(md_table_row_n "$@")" "$(md_table_sep_n "$#")"
}

# 多列表格收尾：把逐段累积的行串包装成完整表格
# HTML 包裹无边框 table；Markdown 各行已自带 \n 前缀，直接输出
# 用法: table_grid_wrap "<行串>"
table_grid_wrap() {
	[ -z "$1" ] && return
	if [ "$table_mode" = "html" ]; then
		html_table_wrap "$1"
	else
		printf '%s' "$1"
	fi
}

# 推送
function diy_send(){
	# ntfy: 纯文本消息(body=内容) + Title/Priority/Token headers(移动端不渲染 markdown, 用纯文本)
	if ( echo "${3}"|grep -q "ntfy" ); then
		# topic 固定使用设备名称(device_name)
		[ "$ntfy_srv_enable" != "1" ] && ntfy_server="https://ntfy.sh"
		[ "$ntfy_token_enable" != "1" ] && ntfy_token=""
		local ntfy_topic="$device_name"
		local ntfy_url=`/usr/bin/jq -r '.url' ${3}` && local ntfy_url=`eval echo ${ntfy_url} 2>/dev/null`
		[ -z "$ntfy_url" ] && return 1
		local ntfy_msg=`echo "$2"|sed 's/\*\*//g; s/<font[^>]*>//g; s/<\/font>//g'`
		local ntfy_ct=`/usr/bin/jq -r '.content_type' ${3}` 2>/dev/null; [ -z "$ntfy_ct" ] && local ntfy_ct="text/plain"
		local ntfy_extra=""
		[ ! -z "$ntfy_token" ] && local ntfy_extra="-H \"Authorization: Bearer ${ntfy_token}\""
		[ ! -z "$ntfy_priority" ] && [ "$ntfy_priority" != "default" ] && local ntfy_extra="${ntfy_extra} -H \"Priority: ${ntfy_priority}\""
		curl -s -m 15 --fail -H "Title: ${1}" -H "Content-Type: ${ntfy_ct}" ${ntfy_extra} -d "${ntfy_msg}" "${ntfy_url}"
		return $?
	fi
	# gotify: 自建服务器推送(调试中), X-Gotify-Key 认证 + JSON body
	if ( echo "${3}"|grep -q "gotify" ); then
		local gotify_url=`/usr/bin/jq -r '.url' ${3}` && local gotify_url=`eval echo ${gotify_url} 2>/dev/null`
		[ -z "$gotify_url" ] && return 1
		local gotify_msg=`echo "$2"|sed 's/\*\*//g; s/<font[^>]*>//g; s/<\/font>//g'`
		local gotify_title=`echo "$1"|sed 's/\*\*//g; s/<font[^>]*>//g; s/<\/font>//g'`
		[ -z "$gotify_priority" ] && local gotify_priority="5"
		curl -s -m 15 --fail -H "X-Gotify-Key: ${gotify_token}" -H "Content-Type: application/json" -d "{\"title\":\"${gotify_title}\",\"message\":\"${gotify_msg}\",\"priority\":${gotify_priority}}" "${gotify_url}"
		return $?
	fi
	# WxPusher: 每个模块用卡片包裹，提升观感（与是否表格化无关）
	# 模块间的 <hr/> 分隔符转为卡片边界，首尾补上卡片标签
	# 注意：样式必须用单引号——content 已由 send() 统一把双引号转为单引号，
	# 此处若引入双引号会破坏 eval 展开后的 JSON 结构
	if ( echo "${3}"|grep -q "wxpusher" ); then
		# 卡片样式：不设背景色（透明跟随宿主主题，兼容明暗模式），
		# 边框用半透明中性灰，明暗环境下均可见
		local _card_open="<div style='border:1px solid rgba(128,128,128,0.35);border-radius:10px;padding:10px 14px;margin:10px 0'>"
		# 先去换行：HTML 中换行会被折叠，且 <hr/> 常位于行尾，
		# 逐行 sed 会把它误当成"末尾分隔"删掉，导致模块无法拆分为独立卡片
		local _card_src=$(printf '%s' "$2" | tr -d '\n')
		# 去掉首尾多余的模块分隔（首段前、末段后）
		_card_src=$(printf '%s' "$_card_src" | sed 's|^<hr/>||; s|<hr/>$||')
		# 其余分隔符转为卡片边界，整体首尾补卡片标签
		local _card_body=$(printf '%s' "$_card_src" | sed "s|<hr/>|</div>${_card_open}|g")
		# 标题后紧邻的 <br/> 在卡片布局中会形成多余空行，去掉
		_card_body=$(printf '%s' "$_card_body" | sed "s|</div><br/>|</div>|g")
		set -- "$1" "${_card_open}${_card_body}</div>" "${3}"
	fi
	( ! echo "$lite_enable"|grep -q "content" ) && ( ! echo "$lite_enable"|grep -q "nowtime" ) && local nowtime=`date "+%Y-%m-%d %H:%M:%S"`
	local diyurl=`/usr/bin/jq -r .url ${3}` && local diyurl=`eval echo ${diyurl} 2>/dev/null`
	local type=`/usr/bin/jq -r '.type' ${3}` && local type=`eval echo ${type} 2>/dev/null`
	local data=`/usr/bin/jq -r '.data' ${3}` && local data=`eval echo ${data} 2>/dev/null`
	local content_type=`/usr/bin/jq -r '.content_type' ${3}`
	/usr/bin/jq ".type + $type" ${jsonpath} > ${tempjsonpath}
	/usr/bin/jq -r '.[]' ${tempjsonpath}|grep -w "null" && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】参数值错误，请检查设置项  `/usr/bin/jq -r '.' ${tempjsonpath}|grep "null"`" >> ${logfile} && return 1
	[ -f ${tempjsonpath} ] && local logrow=$(grep -c "" ${tempjsonpath}) || local logrow="0"
	[ $logrow -eq "0" ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】json 文件生成失败，请检查文件格式" >> ${logfile} && return 1
	/usr/bin/jq -r '.[]' ${tempjsonpath}|grep "null" && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】参数变量生成失败，请检查设置项 `/usr/bin/jq -r '.' ${tempjsonpath}|grep "null"`" >> ${logfile}
	
	curl -m 15 --fail -X POST -H "$content_type" -d "${data}" "${diyurl}"
}

