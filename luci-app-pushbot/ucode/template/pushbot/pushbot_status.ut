{% import { cursor } from 'uci' %}
{% import { readfile } from 'fs' %}
{% let pushbot_argon_mode = cursor().get_first('argon', 'global', 'mode') ?? '' %}
{% let pushbot_liquid_mode = cursor().get_first('liquid', 'theme', 'mode') ?? '' %}
{% let pushbot_def_ipv4 = readfile('/usr/bin/pushbot/api/ipv4.list') ?? '' %}
{% let pushbot_def_ipv6 = readfile('/usr/bin/pushbot/api/ipv6.list') ?? '' %}
{% include('header') %}
<script type="text/javascript">//<![CDATA[
if (typeof XHR === 'undefined') {
	var XHR = {};
	XHR.get = function(url, data, cb) {
		var x = new XMLHttpRequest();
		x.open('GET', url, true);
		x.onload = function() {
			var d = null;
			try { d = JSON.parse(x.responseText); } catch(e) {}
			if (cb) cb(x, d);
		};
		x.onerror = function() { if (cb) cb(x, null); };
		x.send();
	};
	XHR.poll = function(interval, url, data, cb) {
		XHR.get(url, null, cb);
		return setInterval(function() { XHR.get(url, null, cb); }, interval * 1000);
	};
}
/* suppress LuCI UI framework errors for missing CBI tabs */
try{if(typeof L!=='undefined'&&L.dom){var _hw=function(fn){return function(){try{return fn.apply(this,arguments)}catch(e){}}};if(L.dom.initTabGroup)L.dom.initTabGroup=_hw(L.dom.initTabGroup);if(L.dom.init)L.dom.init=_hw(L.dom.init);}}catch(e){}
(function() {
	var badge = document.getElementById('pushbot_status_badge');
	var text = document.getElementById('pushbot_status_text');
	if (!badge || !text) { setTimeout(arguments.callee, 200); return; }
	XHR.poll(3, '{{ dispatcher.build_url('admin', 'services', 'pushbot', 'status') }}', null,
	function(x, data) {
		if (data && data.running) {
			badge.classList.remove('is-stopped');
			badge.classList.add('is-running');
			text.textContent = '{{ _('RUNNING') }}';
		} else {
			badge.classList.remove('is-running');
			badge.classList.add('is-stopped');
			text.textContent = '{{ _('NOT RUNNING') }}';
		}
	}
	);
	/* 点击运行状态徽章 → 重启 pushbot 服务 */
	badge.style.cursor = 'pointer';
	badge.title = '{{ _('Click to restart the pushbot service') }}';
	badge.addEventListener('click', function() {
		badge.classList.add('is-restarting');
		text.textContent = '{{ _('Restarting...') }}';
		XHR.get('{{ dispatcher.build_url('admin', 'services', 'pushbot', 'restart') }}', null, function(x2) {
			if (x2 && x2.status == 200) {
				setTimeout(function() {
					XHR.get('{{ dispatcher.build_url('admin', 'services', 'pushbot', 'status') }}', null, function(x3, d3) {
						badge.classList.remove('is-restarting');
						if (d3 && d3.running) {
							badge.classList.remove('is-stopped');
							badge.classList.add('is-running');
							text.textContent = '{{ _('RUNNING') }}';
						} else {
							badge.classList.remove('is-running');
							badge.classList.add('is-stopped');
							text.textContent = '{{ _('NOT RUNNING') }}';
						}
					});
				}, 2000);
			} else {
				badge.classList.remove('is-restarting');
			}
		});
	});
})();
//]]></script>

<script type="text/javascript">//<![CDATA[
var PB_CONFIG = null;
var PB_READY = [];
function PB_onReady(fn) { if (PB_CONFIG) { fn(); } else { PB_READY.push(fn); } }
function PB_val(opt, def) { return (PB_CONFIG && PB_CONFIG.config && PB_CONFIG.config[opt] !== undefined) ? PB_CONFIG.config[opt] : (def !== undefined ? def : null); }
function PB_list(opt) { var v = PB_CONFIG && PB_CONFIG.lists && PB_CONFIG.lists[opt]; return Array.isArray(v) ? v : []; }
function PB_file(name) { var v = PB_CONFIG && PB_CONFIG.files && PB_CONFIG.files[name]; return (v && typeof v === 'string') ? v : ''; }
function PB_sys(name) { var v = PB_CONFIG && PB_CONFIG.system && PB_CONFIG.system[name]; return Array.isArray(v) ? v : []; }
function PB_bool(opt) { return PB_val(opt) === '1'; }

XHR.get('{{ dispatcher.build_url('admin', 'services', 'pushbot', 'get_config') }}', null, function(x, data) {
	PB_CONFIG = data;
	PB_READY.forEach(function(fn) { try { fn(); } catch(e) { console.warn('PB_onReady:', e); } });
	PB_READY = [];
});

/* auto-fill version badge from package database (apk/opkg) */
XHR.get('{{ dispatcher.build_url('admin', 'services', 'pushbot', 'version') }}', null, function(x, d) {
	var b = document.getElementById('pushbot_version_badge');
	if (b && d && d.version) b.textContent = 'v' + d.version;
});

/* click version badge → fetch upstream GitHub Makefile from browser (8s timeout), frosted toast */
(function() {
	function bindVersionCheck() {
		var badge = document.getElementById('pushbot_version_badge');
		if (!badge) { setTimeout(bindVersionCheck, 200); return; }
		if (badge._pbBound) return;
		badge._pbBound = true;
		badge.title = '{{ _('Click to check for updates') }}';

	function cmpVer(a, b) {
		a = String(a || '').replace(/^v/, '').replace(/-r/, '.');
		b = String(b || '').replace(/^v/, '').replace(/-r/, '.');
		var pa = a.split(/[.-]/), pb = b.split(/[.-]/), i, x, y;
		for (i = 0; i < Math.max(pa.length, pb.length); i++) {
			x = parseInt(pa[i], 10) || 0;
			y = parseInt(pb[i], 10) || 0;
			if (x > y) return 1;
			if (x < y) return -1;
		}
		return 0;
	}

	function showToast(msg, sub, cls) {
		var card = document.querySelector('.pushbot-header-card') || document.body;
		var ov = document.createElement('div');
		ov.className = 'pushbot-ver-overlay';
		var toast = document.createElement('div');
		toast.className = 'pushbot-ver-toast ' + cls;
		var tm = document.createElement('div');
		tm.className = 'pushbot-ver-toast-msg'; tm.textContent = msg; toast.appendChild(tm);
		if (sub) {
			var ts = document.createElement('div');
			ts.className = 'pushbot-ver-toast-sub'; ts.textContent = sub; toast.appendChild(ts);
		}
		ov.appendChild(toast);
		card.appendChild(ov);
		/* 0.5s frosted fade-in */
		setTimeout(function() { ov.classList.add('show'); }, 20);
		/* hold 4s, then fade back and remove */
		setTimeout(function() {
			ov.classList.remove('show');
			setTimeout(function() { ov.remove(); }, 550);
		}, 4000);
	}

	badge.addEventListener('click', function() {
		if (badge.classList.contains('is-checking')) return;
		badge.classList.add('is-checking');
		var local = (badge.textContent || '').replace(/^v/, '');
		var ctl = new AbortController();
		var timer = setTimeout(function() { ctl.abort(); }, 8000);
		fetch('https://raw.githubusercontent.com/zzsj0928/luci-app-pushbot/master/Makefile', { signal: ctl.signal })
			.then(function(r) {
				if (!r.ok) throw new Error('HTTP ' + r.status);
				return r.text();
			})
			.then(function(txt) {
				clearTimeout(timer);
				var mv = txt.match(/PKG_VERSION:=([0-9.]+)/);
				var mr = txt.match(/PKG_RELEASE:=([0-9]+)/);
				var remote = (mv && mr) ? mv[1] + '-r' + mr[1] : '';
				if (!remote) throw new Error('parse');
				var c = cmpVer(local, remote), msg = '', cls = 'is-update';
				if (c > 0) {
					msg = '{{ _('You already have the first-hand beta version!') }}';
					cls = 'is-ahead';
				} else if (c < 0) {
					msg = '{{ _('The author repository has a new version!') }}';
					cls = 'is-update';
				} else {
					msg = '{{ _('You are on the latest version!') }}';
					cls = 'is-latest';
				}
				showToast(msg, '📦 v' + local + '　☁️ v' + remote, cls);
			})
			.catch(function(e) {
				clearTimeout(timer);
				showToast('{{ _('Network problem, failed to access the author repository! ☹️') }}', '📦 v' + local, 'is-err');
			})
			.finally(function() { badge.classList.remove('is-checking'); });
	});
	}
	window.addEventListener('load', bindVersionCheck);
	setTimeout(bindVersionCheck, 200);
})();
//]]></script>

<script type="text/javascript">//<![CDATA[
	/* ── Global helper: update flag hidden input. Uses Value type which accepts "0". ── */
	function updateFlagInput(name, isOn) {
		var el = document.querySelector('[name="cbid.pushbot.pushbot.' + name + '"]');
		if (!el) {
			el = document.createElement('input'); el.type = 'hidden';
			el.name = 'cbid.pushbot.pushbot.' + name;
			var hb = document.getElementById('pushbot_hidden_fields');
			(hb || document.querySelector('form') || document.body || document.documentElement).appendChild(el);
		}
		el.value = isOn ? '1' : '0';
	}
(function() {
	var hiddenBox = document.createElement('div');
	hiddenBox.id = 'pushbot_hidden_fields';
	hiddenBox.style.display = 'none';
	var luciForm = document.querySelector('form');
	var target = luciForm || document.body || document.documentElement;
	target.appendChild(hiddenBox);

	function makeHidden(name, value) {
		var el = hiddenBox.querySelector('[name="cbid.pushbot.pushbot.' + name + '"]');
		if (!el) {
			el = document.createElement('input'); el.type = 'hidden';
			el.name = 'cbid.pushbot.pushbot.' + name;
			hiddenBox.appendChild(el);
		}
		el.value = (value !== null && value !== undefined) ? String(value) : '';
		return el;
	}
	function makeMultiHidden(name, value) {
		var el = document.createElement('input'); el.type = 'hidden';
		el.name = 'cbid.pushbot.pushbot.' + name;
		el.value = String(value);
		hiddenBox.appendChild(el);
		return el;
	}

	function makeField(name, cfg) {
		var value = cfg.value !== undefined ? cfg.value : (cfg.file ? PB_file(name) : PB_val(name, ''));
		var wrapper = document.createElement('div');
		wrapper.className = 'pushbot-inline-field';
		var title = document.createElement('div');
		title.className = 'pushbot-inline-title';
		title.textContent = cfg.label || name;
		wrapper.appendChild(title);
		var body = document.createElement('div');
		body.className = 'pushbot-inline-body';
		var input;
		if (cfg.type === 'select') {
			input = document.createElement('select');
			input.className = 'cbi-input-select';
			(cfg.choices || []).forEach(function(c) {
				var opt = document.createElement('option');
				opt.value = c.v; opt.textContent = c.l || c.v; input.appendChild(opt);
			});
			if (value !== null && value !== '' && value !== undefined) input.value = String(value);
		} else if (cfg.type === 'flag') {
			input = document.createElement('input');
			input.type = 'checkbox';
			input.checked = value === '1' || value === true;
		} else if (cfg.type === 'textarea') {
			input = document.createElement('textarea');
			input.className = 'cbi-input-textarea';
			if (cfg.rows) input.rows = cfg.rows;
			if (cfg.wrap) input.wrap = cfg.wrap;
			if (value != null) input.value = value;
		} else {
			input = document.createElement('input');
			input.type = 'text';
			input.className = 'cbi-input-text';
			if (cfg.placeholder) input.placeholder = cfg.placeholder;
			if (value !== null && value !== '' && value !== undefined) input.value = value;
		}
		body.appendChild(input);
		if (cfg.desc) {
			var d = document.createElement('div');
			d.className = 'pushbot-inline-description';
			d.innerHTML = cfg.desc;
			body.appendChild(d);
		}
		wrapper.appendChild(body);
		if (!cfg.noHidden) {
			var isFlag = cfg.type === 'flag';
			var hidden = makeHidden(name, isFlag ? (input.checked ? '1' : '0') : (value != null ? value : ''));
			input.addEventListener('change', function() {
				hidden.value = (input.type === 'checkbox') ? (input.checked ? '1' : '0') : input.value;
			});
		}
		wrapper._input = input;
		wrapper._hidden = hidden;
		return wrapper;
	}

	function makeChoiceToggle(name, label, iconHtml, onChange) {
		var hidden = makeHidden(name, PB_val(name, '0'));
		var on = hidden.value === '1';
		var btn = document.createElement('button');
		btn.type = 'button';
		btn.className = 'pushbot-choice-button ' + (on ? 'is-on' : 'is-off');
		if (iconHtml) {
			var sp = document.createElement('span'); sp.className = 'pushbot-choice-icon'; sp.innerHTML = iconHtml; btn.appendChild(sp);
		}
		var ls = document.createElement('span'); ls.className = 'pushbot-choice-label'; ls.textContent = label; btn.appendChild(ls);
		btn.addEventListener('click', function(e) {
			e.preventDefault();
			var now = hidden.value === '1';
			hidden.value = now ? '0' : '1';
			btn.className = 'pushbot-choice-button ' + (now ? 'is-off' : 'is-on');
			hidden.dispatchEvent(new Event('change', { bubbles: true }));
			if (onChange) onChange(!now);
		});
		return btn;
	}

	function makeChoiceButtons(name, choices, labels) {
		var hidden = makeHidden(name, PB_val(name, ''));
		var list = document.createElement('div');
		list.className = 'pushbot-choice-list';
		var btns = [];
		choices.forEach(function(v) {
			var b = document.createElement('button');
			b.type = 'button';
			var on = String(v) === String(hidden.value);
			b.className = 'pushbot-choice-button ' + (on ? 'is-on' : 'is-off');
			b.textContent = (labels && labels[v]) ? labels[v] : v;
			b.addEventListener('click', function(e) {
				e.preventDefault();
				hidden.value = String(v);
				btns.forEach(function(b2) {
					b2.className = 'pushbot-choice-button ' + (b2 === b ? 'is-on' : 'is-off');
				});
				if (labels && labels._onChange) labels._onChange(v);
			});
			btns.push(b);
			list.appendChild(b);
		});
		return list;
	}

	var CT_FLAG_NAMES = [
		'pushbot_up', 'pushbot_down', 'cpuload_enable', 'temperature_enable',
		'client_usage', 'client_usage_disturb', 'web_logged', 'ssh_logged',
		'web_login_failed', 'ssh_login_failed', 'wifi_connected', 'wifi_auth_failed', 'web_login_black'
	];
	PB_onReady(function() {
		CT_FLAG_NAMES.forEach(function(n) { makeHidden(n, PB_bool(n) ? '1' : '0'); });
		makeHidden('err_enable', PB_bool('err_enable') ? '1' : '0');
		makeHidden('err_sheep_enable', PB_bool('err_sheep_enable') ? '1' : '0');
		makeHidden('public_ip_event', PB_bool('public_ip_event') ? '1' : '0');
	});

	function hourChoices() {
		var a = []; for (var t = 0; t <= 23; t++) a.push({v: String(t), l: '{{ _('Every day at') }}' + t + '{{ _('h') }}'}); return a;
	}


/* ═══════════════════════════════════════════ */
/* Tab: Basic Settings - Run Control */
/* ═══════════════════════════════════════════ */
	function initCard() {
		if (document.getElementById('pushbot_mode_card')) return;
		if (!PB_CONFIG) { setTimeout(initCard, 200); return; }

		var enHidden = makeHidden('pushbot_enable', PB_val('pushbot_enable', '0'));
		var liteVals = PB_val('lite_enable', []);
		if (!Array.isArray(liteVals)) liteVals = typeof liteVals === 'string' ? (liteVals ? liteVals.split(' ') : []) : [];

		var liteOpts = ['device', 'nowtime', 'content'];
		liteOpts.forEach(function(v) {
			if (liteVals.indexOf(v) >= 0) makeMultiHidden('lite_enable', v);
		});

		var extraFlags = ['oui_dir', 'reset_regularly', 'debuglevel', 'table_format'];
		extraFlags.forEach(function(n) { makeHidden(n, PB_val(n, '0')); });

		var card = document.createElement('div');
		card.id = 'pushbot_mode_card';
		card.className = 'pushbot-mode-card';
		card.innerHTML = [
			'<div class="pushbot-card-top">',
				'<span class="pushbot-card-title">{{ _('Run Control') }}</span>',
				'<button type="button" class="pushbot-toggle-button is-off">',
					'<span class="pushbot-toggle-status">{{ _('Disabled') }}</span>',
				'</button>',
			'</div>',
			'<div class="pushbot-choice-list" style="margin:6px 0 8px 2px">',
				'<button type="button" class="pushbot-choice-button is-off" data-flag="oui_dir">',
					'<span class="pushbot-choice-icon"><svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" style="width:16px;height:16px"><path d="M5 20h14v-2H5v2zM19 9h-4V3H9v6H5l7 7 7-7z"/></svg></span>',
					'<span class="pushbot-choice-label">{{ _('Download to RAM') }}</span>',
				'</button>',
				'<button type="button" class="pushbot-choice-button is-off" data-flag="reset_regularly">',
					'<span class="pushbot-choice-icon"><svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" style="width:16px;height:16px"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 14h-2v-6h2v6zm0-8h-2V6h2v2z"/></svg></span>',
					'<span class="pushbot-choice-label">{{ _('Reset traffic at midnight') }}</span>',
				'</button>',
				'<button type="button" class="pushbot-choice-button is-off" data-flag="debuglevel">',
					'<span class="pushbot-choice-icon"><svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" style="width:16px;height:16px"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 14h-2v-2h2v2zm0-4h-2V8h2v4z"/></svg></span>',
					'<span class="pushbot-choice-label">{{ _('Enable logging') }}</span>',
				'</button>',
				'<button type="button" class="pushbot-choice-button is-off" data-flag="table_format" id="table_format_btn">',
					'<span class="pushbot-choice-icon"><svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" style="width:16px;height:16px"><path d="M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1zm2 3v2h10V7H7zm0 4v2h10v-2H7zm0 4v2h10v-2H7z"/></svg></span>',
					'<span class="pushbot-choice-label">{{ _('Table format') }}</span>',
				'</button>',
			'</div>',
			'<div class="pushbot-card-subtitle">{{ _('Compact Mode') }}</div>',
			'<div class="pushbot-choice-list">',
				'<button type="button" class="pushbot-choice-button is-off" data-value="device">',
					'<span class="pushbot-choice-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1zm2 3v10h12V7H6zm2 2h8v2H8V9zm0 4h5v2H8v-2z"/></svg></span>',
					'<span class="pushbot-choice-label">{{ _('Compact device list') }}</span>',
				'</button>',
				'<button type="button" class="pushbot-choice-button is-off" data-value="nowtime">',
					'<span class="pushbot-choice-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20zm1 4h-2v7l5.5 3.2 1-1.7-4.5-2.6V6z"/></svg></span>',
					'<span class="pushbot-choice-label">{{ _('Compact current time') }}</span>',
				'</button>',
				'<button type="button" class="pushbot-choice-button is-off" data-value="content">',
					'<span class="pushbot-choice-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1zm2 3v2h10V7H7zm0 4v2h6v-2H7zm0 4v2h8v-2H7z"/></svg></span>',
					'<span class="pushbot-choice-label">{{ _('Push title only') }}</span>',
				'</button>',
			'</div>'
		].join('');

		var hc = document.querySelector('.pushbot-header-card');
		if (hc && hc.parentNode) hc.parentNode.insertBefore(card, hc.nextSibling);

		var enEl = hiddenBox.querySelector('[name="cbid.pushbot.pushbot.pushbot_enable"]');
		var flagEls = extraFlags.map(function(n) { return hiddenBox.querySelector('[name="cbid.pushbot.pushbot.' + n + '"]'); });

		var toggleButton = card.querySelector('.pushbot-toggle-button');
		var liteChoiceBtns = Array.prototype.slice.call(card.querySelectorAll('[data-value]'));
		var flagChoiceBtns = Array.prototype.slice.call(card.querySelectorAll('[data-flag]'));

		function syncState() {
			var enabled = enEl.value === '1';
			toggleButton.classList.toggle('is-on', enabled);
			toggleButton.classList.toggle('is-off', !enabled);
			toggleButton.querySelector('.pushbot-toggle-status').textContent = enabled ? '{{ _('Enabled') }}' : '{{ _('Disabled') }}';

			liteChoiceBtns.forEach(function(b) {
				var v = b.getAttribute('data-value');
				var h = hiddenBox.querySelector('[name="cbid.pushbot.pushbot.lite_enable"][value="' + v + '"]');
				var active = !!h;
				b.className = 'pushbot-choice-button ' + (active ? 'is-on' : 'is-off');
			});

			flagChoiceBtns.forEach(function(b) {
				var n = b.getAttribute('data-flag');
				var h = hiddenBox.querySelector('[name="cbid.pushbot.pushbot.' + n + '"]');
				var active = h && h.value === '1';
				b.className = 'pushbot-choice-button ' + (active ? 'is-on' : 'is-off');
			});
		}

		toggleButton.addEventListener('click', function(e) {
			e.preventDefault();
			enEl.value = enEl.value === '1' ? '0' : '1';
			syncState();
		});

		liteChoiceBtns.forEach(function(b) {
			b.addEventListener('click', function(e) {
				e.preventDefault();
				var v = b.getAttribute('data-value');
				var h = hiddenBox.querySelector('[name="cbid.pushbot.pushbot.lite_enable"][value="' + v + '"]');
				if (h) {
					h.parentNode.removeChild(h);
				} else {
					makeMultiHidden('lite_enable', v);
				}
				syncState();
			});
		});

		flagChoiceBtns.forEach(function(b) {
			b.addEventListener('click', function(e) {
				e.preventDefault();
				var n = b.getAttribute('data-flag');
				var h = hiddenBox.querySelector('[name="cbid.pushbot.pushbot.' + n + '"]');
				if (h) h.value = h.value === '1' ? '0' : '1';
				syncState();
			});
		});

		syncState();
	}


/* ═══════════════════════════════════════════ */
/* Tab: Basic Settings - Push Mode */
/* ═══════════════════════════════════════════ */
	function initPushModeCard() {
		if (document.getElementById('pushbot_pushmode_card')) return;
		if (!PB_CONFIG) { setTimeout(initPushModeCard, 200); return; }

		makeHidden('jsonpath', PB_val('jsonpath', '/usr/bin/pushbot/api/dingding.json'));
		var modeHidden = hiddenBox.querySelector('[name="cbid.pushbot.pushbot.jsonpath"]');

		var card = document.createElement('div');
		card.id = 'pushbot_pushmode_card';
		card.className = 'pushbot-mode-card pushbot-pushmode-card';
		card.innerHTML = [
			'<div class="pushbot-card-top" style="margin-bottom:6px">',
				'<span class="pushbot-card-title" style="font-size:16px;font-weight:800">{{ _('Push Mode') }}</span>',
			'</div>',
			'<div class="pushbot-pushmode-row" id="pm_row1">',
				'<div class="pushbot-pushmode-column" id="pm_col_device"></div>',
				'<div class="pushbot-pushmode-column" id="pm_col_interval"></div>',
			'</div>',
			'<div class="pushbot-pushmode-row" id="pm_row2">',
				'<div class="pushbot-choice-list pushbot-pushmode-list" id="pm_mode_list"></div>',
			'</div>',
			'<div class="pushbot-pushmode-row" id="pm_row3">',
				'<div class="pushbot-pushmode-column" id="pm_col_settings">',
					'<div class="pushbot-inline-title">{{ _('Current Settings') }}</div>',
					'<div class="pushbot-pushmode-settings" id="pm_settings_body"></div>',
				'</div>',
				'<div class="pushbot-pushmode-column pushbot-pushmode-action-column" id="pm_col_test"></div>',
			'</div>'
		].join('');

		var runCard = document.getElementById('pushbot_mode_card');
		if (runCard && runCard.parentNode) {
			runCard.parentNode.insertBefore(card, runCard.nextSibling);
		} else {
			var hc = document.querySelector('.pushbot-header-card');
			if (hc && hc.parentNode) { hc.parentNode.insertBefore(card, hc.nextSibling); }
			else { document.querySelector('.pushbot-body').appendChild(card); }
		}

		/* ── device name ── */
		var devField = makeField('device_name', { label: '{{ _('Device name') }}', desc: '{{ _('Identifies this device in push message titles, to distinguish the source device') }}' });
		document.getElementById('pm_col_device').appendChild(devField);

		/* ── sleeptime ── */
		var intField = makeField('sleeptime', { label: '{{ _('Detection interval') }}', desc: '{{ _('A shorter interval responds faster but consumes more system resources') }}' });
		document.getElementById('pm_col_interval').appendChild(intField);

		/* ── mode select buttons ── */
		var modeList = document.getElementById('pm_mode_list');
		var modeSvgs = {
			'{{ _('DingTalk') }}': '<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" style="width:24px;height:24px"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 8.16c-.34.88-2.17 2.36-2.17 2.36l-.03.02h.03s.86 1.14 1.22 1.68c.36.54.04.68-.5.36l-1.7-1.14-.84-.56c-.02 0-.18.14-.18.14s-1.3 1.86-1.66 2.28c-.36.42-.72.24-.62-.22.1-.46.92-2.18.92-2.18l-2.32-3.46c-.24-.36.08-.54.48-.34L12 12l2.3-1.52c.4-.26.78.02.34.68z"/></svg>',
			'{{ _('WeCom') }}': '<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" style="width:24px;height:24px"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM8.5 6.5h7c.83 0 1.5.67 1.5 1.5v2c0 .83-.67 1.5-1.5 1.5h-7A1.5 1.5 0 0 1 7 10V8c0-.83.67-1.5 1.5-1.5zm0 6h4c.83 0 1.5.67 1.5 1.5v2c0 .83-.67 1.5-1.5 1.5h-4A1.5 1.5 0 0 1 7 16v-2c0-.83.67-1.5 1.5-1.5z"/></svg>',
			'{{ _('Feishu') }}': '<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" style="width:24px;height:24px"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm-1.5 6h3c.83 0 1.5.67 1.5 1.5v1c0 .83-.67 1.5-1.5 1.5h-3A1.5 1.5 0 0 1 9 10.5v-1c0-.83.67-1.5 1.5-1.5zm0 4h5c.83 0 1.5.67 1.5 1.5v1c0 .83-.67 1.5-1.5 1.5h-5A1.5 1.5 0 0 1 9 13v-1c0-.83.67-1.5 1.5-1.5z"/></svg>',
			'Bark': '<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" style="width:24px;height:24px"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>',
			'ntfy': '<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" style="width:24px;height:24px"><path d="M12 22a2 2 0 0 0 2-2h-4a2 2 0 0 0 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4a1.5 1.5 0 0 0-3 0v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg>',
			'{{ _('Gotify (debug)') }}': '<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" style="width:24px;height:24px"><path d="M12 22a2 2 0 0 0 2-2h-4a2 2 0 0 0 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4a1.5 1.5 0 0 0-3 0v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg>',
			'PushPlus': '<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" style="width:24px;height:24px"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 5h-2v5l4 2.4 1-1.6-3-1.8V7z"/></svg>',
			'PushDeer': '<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" style="width:24px;height:24px"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 16a6 6 0 1 1 0-12 6 6 0 0 1 0 12z"/></svg>',
			'{{ _('Custom push') }}': '<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" style="width:24px;height:24px"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm-1 14H9v-2h2v2zm0-4H9V8h2v4z"/></svg>'
		};
		var modeOpts = [
			{ v: '/usr/bin/pushbot/api/dingding.json', l: '{{ _('DingTalk') }}' },
			{ v: '/usr/bin/pushbot/api/ent_wechat.json', l: '{{ _('WeCom') }}' },
			{ v: '/usr/bin/pushbot/api/pushplus.json', l: '{{ _('PushPlus') }}' },
			{ v: '/usr/bin/pushbot/api/feishu.json', l: '{{ _('Feishu') }}' },
			{ v: '/usr/bin/pushbot/api/gotify.json', l: '{{ _('Gotify (debug)') }}' },
			{ v: '/usr/bin/pushbot/api/ntfy.json', l: '{{ _('ntfy') }}' },
			{ v: '/usr/bin/pushbot/api/bark.json', l: '{{ _('Bark') }}' },
			{ v: '/usr/bin/pushbot/api/pushdeer.json', l: '{{ _('PushDeer') }}' },
			{ v: '/usr/bin/pushbot/api/diy.json', l: '{{ _('Custom push') }}' }
		];
		var modeBtns = [];
		modeOpts.forEach(function(o) {
			var b = document.createElement('button');
			b.type = 'button';
			b.className = 'pushbot-choice-button';
			var svg = modeSvgs[o.l] || '';
			b.innerHTML = svg + '<span>' + o.l + '</span>';
			b.addEventListener('click', function(e) {
				e.preventDefault();
				modeHidden.value = o.v;
				syncModeBtns();
				renderModeSettings();
			});
			modeBtns.push(b);
			modeList.appendChild(b);
		});
		function syncModeBtns() {
			var v = modeHidden.value;
			modeBtns.forEach(function(b) { b.className = 'pushbot-choice-button ' + (b.textContent.indexOf(modeOpts.filter(function(o2){return o2.v===v;})[0]&&modeOpts.filter(function(o2){return o2.v===v;})[0].l||'') >=0 ? 'is-on' : 'is-off'); });
			modeBtns.forEach(function(b) {
				var idx = modeOpts.findIndex(function(o){return b.innerHTML.indexOf(o.l)>=0;});
				var on = idx >=0 && modeOpts[idx].v === v;
				b.className = 'pushbot-choice-button ' + (on ? 'is-on' : 'is-off');
			});
		}

		/* ── mode-field map with full field configs ── */
		var MODE_FIELD_CFG = {
			'/usr/bin/pushbot/api/dingding.json': [
				{ name: 'dd_webhook', type: 'text', label: '{{ _('Webhook') }}', desc: '{{ _('DingTalk bot Webhook, enter only the part after access_token=<br><a href="https://developers.dingtalk.com/document/robots/custom-robot-access" target="_blank">Get the code</a><br><br>') }}'},
			],
			'/usr/bin/pushbot/api/ent_wechat.json': [
				{ name: 'we_webhook', type: 'text', label: '{{ _('Webhook') }}', desc: '{{ _('WeCom bot Webhook, enter only the part after key=<br><a href="https://work.weixin.qq.com/api/doc/90000/90136/91770" target="_blank">Get the code</a><br><br>') }}'},
			],
			'/usr/bin/pushbot/api/feishu.json': [
				{ name: 'fs_webhook', type: 'text', label: '{{ _('WebHook') }}', desc: '{{ _('Feishu WebHook<br><a href="https://www.feishu.cn/hc/zh-CN/articles/360024984973" target="_blank">Get the code</a><br><br>') }}'},
			],
			'/usr/bin/pushbot/api/bark.json': [
				{ name: 'bark_token', type: 'text', label: '{{ _('Bark Token') }}', desc: '{{ _('Get the code') }} <a href=\'https://github.com/Finb/Bark\' target=\'_blank\'>{{ _('here') }}</a><br><br>'},
				{ name: 'bark_srv_enable', type: 'toggle', label: '{{ _('Self-hosted Bark server') }}' },
				{ name: 'bark_srv', type: 'text', label: '{{ _('Bark Server') }}', depends: 'bark_srv_enable', desc: '{{ _('Bark self-hosted server address<br>e.g. https://your.domain:port<br>See <a href="http://www.pushdeer.com/selfhosted.html" target="_blank">here</a> for the self-hosting guide<br><br>') }}'},
				{ name: 'bark_sound', type: 'text', label: '{{ _('Bark Sound') }}', desc: '{{ _('Bark notification sound<br>e.g. silence.caf<br>See <a href="https://github.com/Finb/Bark/tree/master/Sounds" target="_blank">here</a> for details<br><br>') }}'},
				{ name: 'bark_icon_enable', type: 'toggle', label: '{{ _('Bark notification icon') }}' },
				{ name: 'bark_icon', type: 'text', label: '{{ _('Bark Icon') }}', depends: 'bark_icon_enable', desc: '{{ _('Bark notification icon (iOS 15 or above)<br>e.g. http://day.app/assets/images/avatar.jpg<br>See <a href="https://github.com/Finb/Bark#%E5%85%B6%E4%BB%96%E5%8F%82%E6%95%B0" target="_blank">here</a> for details<br><br>') }}'},
				{ name: 'bark_level', type: 'select', label: '{{ _('Bark Level') }}', choices: [{v:'active',l:'{{ _('active: Default') }}'},{v:'timeSensitive',l:'{{ _('timeSensitive: Time-sensitive') }}'},{v:'passive',l:'{{ _('passive: Add to list only') }}'}], desc: '{{ _('Bark time-sensitive notification<br>Optional values:<br/>active: default, the system shows the notification immediately on the lock screen.<br/>timeSensitive: time-sensitive, can be shown in Focus mode.<br/>passive: only added to the notification list, no screen wake.') }}'},
			],
			'/usr/bin/pushbot/api/ntfy.json': [
				{ name: 'ntfy_srv_enable', type: 'toggle', label: '{{ _('Self-hosted ntfy server') }}' },
				{ name: 'ntfy_server', type: 'text', label: '{{ _('Server') }}', depends: 'ntfy_srv_enable', desc: '{{ _('ntfy server address<br>default https://ntfy.sh, or your self-hosted server') }}'},
				{ name: 'ntfy_token_enable', type: 'toggle', label: '{{ _('Access token') }}' },
				{ name: 'ntfy_token', type: 'text', label: '{{ _('Token') }}', depends: 'ntfy_token_enable', desc: '{{ _('ntfy access token (optional, for protected topics)<br>The topic is fixed to the device name') }}'},
				{ name: 'ntfy_priority', type: 'select', label: '{{ _('Priority') }}', choices: [{v:'default',l:'{{ _('default') }}'},{v:'min',l:'{{ _('min') }}'},{v:'low',l:'{{ _('low') }}'},{v:'high',l:'{{ _('high') }}'},{v:'max',l:'{{ _('max') }}'}], desc: '{{ _('ntfy notification priority') }}'},
			],
			'/usr/bin/pushbot/api/gotify.json': [
				{ name: 'gotify_server', type: 'text', label: '{{ _('Server') }}', desc: '{{ _('Gotify self-hosted server address (debug)<br>e.g. https://gotify.example.com') }}'},
				{ name: 'gotify_token', type: 'text', label: '{{ _('Token') }}', desc: '{{ _('Gotify app token (debug)') }}'},
				{ name: 'gotify_priority', type: 'select', label: '{{ _('Priority') }}', choices: [{v:'0',l:'0'},{v:'1',l:'1'},{v:'2',l:'2'},{v:'3',l:'3'},{v:'4',l:'4'},{v:'5',l:'5 ({{ _('default') }})'},{v:'6',l:'6'},{v:'7',l:'7'},{v:'8',l:'8'},{v:'9',l:'9'},{v:'10',l:'10'}], desc: '{{ _('Gotify message priority 0-10 (debug)') }}'},
			],
			'/usr/bin/pushbot/api/pushplus.json': [
				{ name: 'pp_token', type: 'text', label: '{{ _('PushPlus Token') }}', desc: '{{ _('Get the code') }} <a href=\'http://pushplus.plus/doc/\' target=\'_blank\'>{{ _('here') }}</a><br><br>'},
				{ name: 'pp_channel', type: 'select', label: '{{ _('PushPlus Channel') }}', choices: [{v:'wechat',l:'{{ _('wechat: WeChat Official Account') }}'},{v:'app',l:'{{ _('app: PushPlus App') }}'},{v:'extension',l:'{{ _('extension: Browser extension / desktop') }}'},{v:'webhook',l:'{{ _('webhook: Third-party webhook') }}'},{v:'clawbot',l:'{{ _('clawbot: WeChat ClawBot') }}'},{v:'cp',l:'{{ _('cp: WeCom app') }}'},{v:'mail',l:'{{ _('mail: Email') }}'},{v:'sms',l:'{{ _('sms: SMS (paid)') }}'},{v:'voice',l:'{{ _('voice: Voice call (paid)') }}'}], desc: '{{ _('wechat/app/extension/clawbot: only token required<br>webhook/cp: also need Channel Code below<br>mail: Channel Code optional (default official email)<br>sms/voice: paid channels (deduct credits)<br>See <a href="http://www.pushplus.plus/doc/channel.html" target="_blank">here</a> for all channels<br><br>') }}'},
				{ name: 'pp_webhook', type: 'text', label: '{{ _('PushPlus Channel Code') }}', showWhen: { field: 'pp_channel', values: ['webhook', 'cp', 'mail'] }, desc: '{{ _('Channel code configured in PushPlus console<br>webhook: third-party webhook code (WeCom/DingTalk/Feishu...)<br>cp: WeCom app code<br>mail: optional, email sender code (leave empty for official email)<br>See <a href="http://www.pushplus.plus/doc/guide/api.html" target="_blank">here</a> for details<br><br>') }}' },
				{ name: 'pp_topic_enable', type: 'toggle', label: '{{ _('PushPlus group push') }}' },
				{ name: 'pp_topic', type: 'text', label: '{{ _('PushPlus Topic') }}', depends: 'pp_topic_enable', desc: '{{ _('PushPlus group code<br>The group code used for group push<br>See <a href="http://www.pushplus.plus/push2.html" target="_blank">here</a> for details<br><br>') }}'},
			],
			'/usr/bin/pushbot/api/pushdeer.json': [
				{ name: 'pushdeer_key', type: 'text', label: '{{ _('PushDeer Key') }}', desc: '{{ _('Get the code') }} <a href=\'http://www.pushdeer.com/\' target=\'_blank\'>{{ _('here') }}</a><br><br>'},
				{ name: 'pushdeer_srv_enable', type: 'toggle', label: '{{ _('Self-hosted PushDeer server') }}' },
				{ name: 'pushdeer_srv', type: 'text', label: '{{ _('PushDeer Server') }}', depends: 'pushdeer_srv_enable', desc: '{{ _('PushDeer self-hosted server address<br>e.g. https://your.domain:port<br>See <a href="http://www.pushdeer.com/selfhosted.html" target="_blank">here</a> for details<br><br>') }}'},
			],
			'/usr/bin/pushbot/api/diy.json': [
				{ name: 'diy_json', type: 'textarea', label: '{{ _('Custom push') }}', desc: '', rows: 28, file: true }
			]
		};

		function renderModeSettings() {
			/* 渠道不支持表格化时自动关闭 table_format(目前仅钉钉支持) */
			var tfh = hiddenBox.querySelector('[name="cbid.pushbot.pushbot.table_format"]');
			var tfBtn = document.getElementById('table_format_btn');
			var supported = ['/usr/bin/pushbot/api/dingding.json'];
			if (tfh && supported.indexOf(modeHidden.value) < 0) {
				tfh.value = '0';
				if (tfBtn) tfBtn.className = 'pushbot-choice-button is-off';
			}
			var body = document.getElementById('pm_settings_body');
			body.innerHTML = '';
			var fields = MODE_FIELD_CFG[modeHidden.value] || [];
			if (!fields.length) {
				body.innerHTML = '<div class="pushbot-inline-description" style="margin-top:6px">{{ _('No additional configuration needed for the current mode.') }}</div>';
				return;
			}
			fields.forEach(function(cfg) {
				if (cfg.depends) {
					var parentHidden = hiddenBox.querySelector('[name="cbid.pushbot.pushbot.' + cfg.depends + '"]');
					var parentOn = parentHidden && parentHidden.value === '1';

					var depWrap = document.createElement('div');
					depWrap.style.cssText = 'margin:4px 0 4px 20px;padding-left:12px;border-left:2px solid rgba(148,163,184,0.2)';
					depWrap.style.display = parentOn ? '' : 'none';

					var childField = makeField(cfg.name, cfg);
					var ci = childField.querySelector('input, select, textarea');
					if (ci) ci.name = '';
					depWrap.appendChild(childField);
					body.appendChild(depWrap);

					if (parentHidden) {
						var origOnChange = parentHidden.onchange;
						parentHidden.onchange = null;
						var toggleVis = function() {
							depWrap.style.display = parentHidden.value === '1' ? '' : 'none';
						};
						var obs = new MutationObserver(toggleVis);
						obs.observe(parentHidden, { attributes: true, attributeFilter: ['value'] });
						parentHidden.addEventListener('change', toggleVis);
						toggleVis();
					}
					return;
				}
				if (cfg.showWhen) {
					var selHidden = hiddenBox.querySelector('[name="cbid.pushbot.pushbot.' + cfg.showWhen.field + '"]');
					var showWrap = document.createElement('div');
					showWrap.setAttribute('data-dep', cfg.name);
					var swField = makeField(cfg.name, cfg);
					var swCi = swField.querySelector('input, select, textarea');
					if (swCi) swCi.name = '';
					showWrap.appendChild(swField);
					body.appendChild(showWrap);
					var toggleSw = function() {
						if (selHidden) {
							var vals = cfg.showWhen.values || (cfg.showWhen.value != null ? [cfg.showWhen.value] : []);
							showWrap.style.display = vals.indexOf(selHidden.value) >= 0 ? '' : 'none';
						}
					};
					if (selHidden) {
						selHidden.addEventListener('change', toggleSw);
						var obsSw = new MutationObserver(toggleSw);
						obsSw.observe(selHidden, { attributes: true, attributeFilter: ['value'] });
					}
					toggleSw();
					return;
				}
				if (cfg.type === 'toggle') {
					var tb = makeChoiceToggle(cfg.name, cfg.label, '');
					var tbi = tb.querySelector('button');
					body.appendChild(tb);
					return;
				}
				if (cfg.type === 'flag') {
					var flagField = makeField(cfg.name, cfg);
					var fi = flagField.querySelector('input');
					if (fi) fi.name = '';
					body.appendChild(flagField);
					return;
				}
				var fw = makeField(cfg.name, cfg);
				var ci = fw.querySelector('input, select, textarea');
				if (ci) ci.name = '';
				body.appendChild(fw);
			});
		}

		/* ── test button (保存并执行原动作) ── */
		var tc = document.createElement('button');
		tc.type = 'button';
		tc.textContent = '{{ _('Test Channel') }}';
		tc.className = 'pushbot-sendtest-btn';
		tc.addEventListener('click', function(e) {
			e.preventDefault();
			tc.disabled = true;
			tc.textContent = '{{ _('Saving...') }}';
			var data = window.__pbCollectData ? __pbCollectData() : {};
			var x = new XMLHttpRequest();
			x.open('POST', '{{ dispatcher.build_url('admin', 'services', 'pushbot', 'save_config') }}', true);
			x.setRequestHeader('Content-Type', 'application/json');
			x.onload = function() {
				tc.textContent = '{{ _('Sending...') }}';
				var y = new XMLHttpRequest();
				y.open('GET', '{{ dispatcher.build_url('admin', 'services', 'pushbot', 'send_test') }}', true);
				y.onload = function() { tc.disabled = false; tc.textContent = '{{ _('Test Channel') }}'; };
				y.onerror = function() { tc.disabled = false; tc.textContent = '{{ _('Test Channel') }}'; };
				y.send();
			};
			x.onerror = function() { tc.disabled = false; tc.textContent = '{{ _('Test Channel') }}'; };
			x.send(JSON.stringify(data));
		});
		var tcDesc = document.createElement('div');
		tcDesc.className = 'pushbot-inline-description';
		tcDesc.textContent = '{{ _('Clicking the test button will save the current settings first') }}';
		document.getElementById('pm_col_test').appendChild(tc);
		document.getElementById('pm_col_test').appendChild(tcDesc);

		syncModeBtns();
		renderModeSettings();
	}


/* ═══════════════════════════════════════════ */
/* Tab: Basic Settings - Terminal Info */
/* ═══════════════════════════════════════════ */
	function initTerminalCard() {
		if (document.getElementById('pushbot_terminal_card')) return;
		if (!PB_CONFIG) { setTimeout(initTerminalCard, 200); return; }
		if (!document.getElementById('pushbot_pushmode_card')) {
			setTimeout(initTerminalCard, 200); return;
		}

		makeHidden('oui_data', PB_val('oui_data', ''));

		var card = document.createElement('div');
		card.id = 'pushbot_terminal_card';
		card.className = 'pushbot-mode-card';
		card.style.margin = '0 0 16px 0';

		var header = document.createElement('div');
		header.className = 'pushbot-card-top';
		header.innerHTML = '<span class="pushbot-card-title" style="font-size:16px;font-weight:800">{{ _('Terminal Info') }}</span>';
		card.appendChild(header);

		/* MAC database */
		var dbTitle = document.createElement('div');
		dbTitle.className = 'pushbot-inline-title';
		dbTitle.style.cssText = 'margin:8px 0 6px 2px;text-transform:none;font-size:13px';
		dbTitle.textContent = '{{ _('MAC device database') }}';
		card.appendChild(dbTitle);

		var ouiHidden = hiddenBox.querySelector('[name="cbid.pushbot.pushbot.oui_data"]');
		var ouiOpts = [
			{ v: '', l: '{{ _('Disabled') }}' },
			{ v: '1', l: '{{ _('Compact') }}' },
			{ v: '2', l: '{{ _('Full') }}' },
			{ v: '3', l: '{{ _('Network lookup') }}' }
		];
		var ouiBtns = [];
		ouiOpts.forEach(function(o) {
			var b = document.createElement('button');
			b.type = 'button';
			b.className = 'pushbot-choice-button ' + (String(ouiHidden.value) === o.v ? 'is-on' : 'is-off');
			b.textContent = o.l;
			b.addEventListener('click', function(e) {
				e.preventDefault();
				ouiHidden.value = o.v;
				ouiBtns.forEach(function(b2) {
					b2.className = 'pushbot-choice-button ' + (b2 === b ? 'is-on' : 'is-off');
				});
			});
			ouiBtns.push(b);
		});
		ouiBtns.forEach(function(b) { card.appendChild(b); });

		/* ── device aliases ── */
		var aliasTitle = document.createElement('div');
		aliasTitle.className = 'pushbot-inline-title';
		aliasTitle.style.cssText = 'margin:14px 0 6px 2px;text-transform:none;font-size:13px';
		aliasTitle.textContent = '{{ _('Device Aliases') }}';
		card.appendChild(aliasTitle);

		var aliasBox = document.createElement('div');
		aliasBox.className = 'pushbot-inline-field';
		aliasBox.style.cssText = 'padding:10px 12px;margin:0';

		var aliasRow2 = document.createElement('div');
		aliasRow2.style.cssText = 'display:flex;gap:8px;align-items:center';
		var aliasInp = document.createElement('input');
		aliasInp.type = 'text';
		aliasInp.placeholder = '{{ _('XX:XX:XX:XX:XX:XX-MyPhone') }}';
		aliasInp.style.cssText = 'flex:1;padding:7px 10px;border-radius:8px;border:1px solid rgba(148,163,184,0.3);font-size:13px;background:var(--pb-input-bg);color:inherit';
		aliasInp.className = 'pushbot-alias-input';
		var addBtn = document.createElement('button');
		addBtn.type = 'button';
		addBtn.textContent = '{{ _('Add') }}';
		addBtn.className = 'pushbot-choice-button is-on';
		addBtn.style.cssText = 'padding:7px 14px;font-size:12px';
		aliasRow2.appendChild(aliasInp);
		aliasRow2.appendChild(addBtn);
		aliasBox.appendChild(aliasRow2);

		var tagContainer = document.createElement('div');
		tagContainer.className = 'pushbot-alias-tags';
		tagContainer.style.cssText = 'display:flex;flex-wrap:wrap;gap:6px;margin-top:8px';

		var aliasHiddenBox = document.createElement('div');
		aliasHiddenBox.id = 'term_hidden_fields';
		aliasHiddenBox.style.display = 'none';

		function rebuildHiddenAliases(vals) {
			aliasHiddenBox.innerHTML = '';
			vals.forEach(function(v) {
				if (!v) return;
				var inp = document.createElement('input');
				inp.type = 'hidden';
				inp.name = 'cbid.pushbot.pushbot.device_aliases';
				inp.value = v;
				aliasHiddenBox.appendChild(inp);
			});
		}

		function addTag(text) {
			if (!text || text.indexOf('-') < 0) return;
			var tag = document.createElement('span');
			tag.className = 'pushbot-alias-tag';
			tag.style.cssText = 'display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:8px;font-size:12px;background:rgba(59,130,246,0.12);border:1px solid rgba(59,130,246,0.25);color:inherit';
			tag.textContent = text;
			var del = document.createElement('button');
			del.type = 'button';
			del.innerHTML = '✕';
			del.style.cssText = 'border:none;background:none;cursor:pointer;font-size:12px;color:#94a3b8;padding:0 2px';
			del.title = '{{ _('Remove') }}';
			del.addEventListener('click', function(e) { e.preventDefault(); tag.remove(); syncAliases(); });
			tag.appendChild(del);
			tagContainer.appendChild(tag);
			syncAliases();
		}

		function syncAliases() {
			var tags = tagContainer.querySelectorAll('.pushbot-alias-tag');
			var vals = [];
			tags.forEach(function(t) {
				var txt = t.textContent.replace('✕', '').trim();
				if (txt) vals.push(txt);
			});
			rebuildHiddenAliases(vals);
		}

		(PB_list('device_aliases') || []).forEach(function(v) { if (v) addTag(v); });

		addBtn.addEventListener('click', function(e) {
			e.preventDefault();
			var val = aliasInp.value.trim();
			if (val) { addTag(val); aliasInp.value = ''; }
		});
		aliasInp.addEventListener('keydown', function(e) {
			if (e.key === 'Enter') { e.preventDefault(); var val = aliasInp.value.trim(); if (val) { addTag(val); aliasInp.value = ''; } }
		});

		aliasBox.appendChild(tagContainer);
		aliasBox.appendChild(aliasHiddenBox);
		card.appendChild(aliasBox);

		var desc = document.createElement('div');
		desc.className = 'pushbot-inline-description';
		desc.style.cssText = 'margin:6px 0 0 2px';
		desc.textContent = '{{ _('Enter MAC-alias, e.g. XX:XX:XX:XX:XX:XX-MyPhone') }}';
		card.appendChild(desc);

		var pushCard = document.getElementById('pushbot_pushmode_card');
		if (pushCard && pushCard.parentNode) {
			pushCard.parentNode.insertBefore(card, pushCard.nextSibling);
		} else {
			document.querySelector('.pushbot-mode-card') && document.querySelector('.pushbot-mode-card').parentNode.appendChild(card);
		}
	}


/* ═══════════════════════════════════════════ */
/* Tab: Basic Settings - Do Not Disturb */
/* ═══════════════════════════════════════════ */
	function initDisturbCard() {
		if (document.getElementById('pushbot_disturb_card')) return;
		if (!PB_CONFIG) { setTimeout(initDisturbCard, 200); return; }
		if (!document.getElementById('pushbot_terminal_card')) {
			setTimeout(initDisturbCard, 200);
			return;
		}

		/* ── read config from PB_CONFIG (no CBI DOM) ── */
		var sheepCur     = PB_val('pushbot_sheep', '');
		var startCur     = PB_val('starttime', '0');
		var endCur       = PB_val('endtime', '8');
		var mac1Cur      = PB_val('macmechanism', '');
		var mac2Cur      = PB_val('macmechanism2', '');
		var ifaceCur     = PB_val('pushbot_interface', '');
		/* hidden input container for DynamicList submission */
		var macHiddenBox = document.createElement('div');
		macHiddenBox.id = 'disturb_hidden_fields';
		macHiddenBox.style.display = 'none';
		(document.getElementById('pushbot_hidden_fields') || document.querySelector('form') || document.body || document.documentElement).appendChild(macHiddenBox);
		function rebuildMacHidden(optionName, vals) {
			var sel = '[name="cbid.pushbot.pushbot.' + optionName + '"]';
			macHiddenBox.querySelectorAll(sel).forEach(function(el) { el.remove(); });
			vals.forEach(function(v) {
				if (!v) return;
				var inp = document.createElement('input');
				inp.type = 'hidden';
				inp.name = 'cbid.pushbot.pushbot.' + optionName;
				inp.value = v;
				macHiddenBox.appendChild(inp);
			});
		}

		var card = document.createElement('div');
		card.id = 'pushbot_disturb_card';
		card.className = 'pushbot-mode-card';
		card.style.margin = '0 0 16px 0';
		card.innerHTML = '<div class="pushbot-card-top"><span class="pushbot-card-title" style="font-size:16px;font-weight:800">{{ _('DND') }}</span></div>';

		/* helper: choice buttons backed by hidden input */
		function mkChoice(name, choices, labels, onChange) {
			var hi = makeHidden(name, PB_val(name, ''));
			var list = document.createElement('div');
			list.className = 'pushbot-choice-list';
			var btns = [];
			choices.forEach(function(v) {
				var b = document.createElement('button');
				b.type = 'button';
				var on = String(v) === String(hi.value);
				b.className = 'pushbot-choice-button ' + (on ? 'is-on' : 'is-off');
				b.textContent = (labels && labels[v] !== undefined) ? labels[v] : v;
				b.addEventListener('click', function(e) {
					e.preventDefault();
					hi.value = v;
					btns.forEach(function(b2) { b2.className = 'pushbot-choice-button ' + (b2 === b ? 'is-on' : 'is-off'); });
					if (onChange) onChange(v);
				});
				btns.push(b);
				list.appendChild(b);
			});
			return list;
		}

		/* DND settings */
		(function() {
			var title = document.createElement('div');
			title.className = 'pushbot-inline-title';
			title.style.cssText = 'margin:8px 0 6px 2px;text-transform:none;font-size:13px';
			title.textContent = '{{ _('Do Not Disturb') }}';
			card.appendChild(title);
			card.appendChild(mkChoice('pushbot_sheep', ['', '1', '2'],
				{'':'{{ _('Disabled') }}','1':'{{ _('Mode 1: Pause script') }}','2':'{{ _('Mode 2: Silent mode') }}'},
				function(v) {
					var tw = document.getElementById('pm_dnd_time');
					if (tw) tw.style.display = (v === '1' || v === '2') ? '' : 'none';
				}
			));
		})();

		/* DND time */
		(function() {
			var timeWrap = document.createElement('div');
			timeWrap.id = 'pm_dnd_time';
			timeWrap.style.display = (sheepCur === '1' || sheepCur === '2') ? '' : 'none';
			var tt = document.createElement('div');
			tt.className = 'pushbot-inline-title';
			tt.style.cssText = 'margin:12px 0 6px 2px;text-transform:none;font-size:13px';
			tt.textContent = '{{ _('DND Time (daily)') }}';
			timeWrap.appendChild(tt);
			var tr = document.createElement('div');
			tr.style.cssText = 'display:flex;align-items:center;gap:10px;flex-wrap:wrap';
			var stHi = makeHidden('starttime', startCur);
			var enHi = makeHidden('endtime', endCur);
			var stInp = document.createElement('input');
			stInp.type = 'number'; stInp.min = 0; stInp.max = 23;
			stInp.style.cssText = 'width:72px;padding:7px 10px;border-radius:8px;border:1px solid rgba(148,163,184,0.3);font-size:13px;text-align:center;background:var(--pb-input-bg);color:inherit';
			stInp.value = startCur;
			stInp.addEventListener('change', function() { stHi.value = this.value; });
			var dash = document.createElement('span');
			dash.textContent = '—';
			dash.style.cssText = 'font-size:16px;font-weight:700;color:#94a3b8';
			var enInp = document.createElement('input');
			enInp.type = 'number'; enInp.min = 0; enInp.max = 23;
			enInp.style.cssText = 'width:72px;padding:7px 10px;border-radius:8px;border:1px solid rgba(148,163,184,0.3);font-size:13px;text-align:center;background:var(--pb-input-bg);color:inherit';
			enInp.value = endCur;
			enInp.addEventListener('change', function() { enHi.value = this.value; });
			tr.appendChild(stInp); tr.appendChild(dash); tr.appendChild(enInp);
			timeWrap.appendChild(tr);
			card.appendChild(timeWrap);
		})();

		/* MAC Filter 1 — multi-toggle with mutex + coexist rules
		 *
		 * 3 toggle buttons (all off = Normal / no filtering):
		 *   whitelist — Ignore devices in list
		 *   blacklist — Notify only devices in list
		 *   iface     — Notify only on this interface
		 *
		 * Rules:
		 *   - whitelist ↔ blacklist: mutually exclusive
		 *   - interface is independent, can coexist with whitelist or blacklist
		 *   - all off = Normal (no filtering), no explicit disable button
		 */
		(function() {
			var title = document.createElement('div');
			title.className = 'pushbot-inline-title';
			title.style.cssText = 'margin:14px 0 6px 2px;text-transform:none;font-size:13px';
			title.textContent = '{{ _('MAC Filter') }}';
			card.appendChild(title);

			/* derive initial states from existing UCI config */
			var hasWhitelist = PB_list('pushbot_whitelist').length > 0;
			var hasBlacklist = PB_list('pushbot_blacklist').length > 0;
			var hasIface     = (PB_val('pushbot_interface', '') !== '');

			/* if macmechanism was set (legacy), map to new states */
			if (!hasWhitelist && !hasBlacklist && !hasIface) {
				if (mac1Cur === 'allow')     hasWhitelist = true;
				if (mac1Cur === 'block')      hasBlacklist = true;
				if (mac1Cur === 'interface')  hasIface = true;
			}

			var states = {
				whitelist:   hasWhitelist,
				blacklist:   hasBlacklist,
				iface:       hasIface
			};

			/* hidden input for macmechanism (kept for compat) */
			var macHi = makeHidden('macmechanism', '');

			/* status line */
			var statusEl = document.createElement('div');
			statusEl.style.cssText = 'margin:6px 0 8px 2px;font-size:12px;color:#64748b';
			card.appendChild(statusEl);

			/* build toggle buttons */
			var toggleWrap = document.createElement('div');
			toggleWrap.style.cssText = 'display:flex;flex-wrap:wrap;gap:6px;margin-bottom:4px';

			var toggleDefs = [
				{ key: 'whitelist', label: '{{ _('Ignore list') }}' },
				{ key: 'blacklist', label: '{{ _('Notify only list') }}' },
				{ key: 'iface', label: '{{ _('Notify only interface') }}' }
			];

			var toggleBtns = {};
			toggleDefs.forEach(function(def) {
				var b = document.createElement('button');
				b.type = 'button';
				b.className = 'pushbot-choice-button ' + (states[def.key] ? 'is-on' : 'is-off');
				b.textContent = def.label;
				toggleBtns[def.key] = b;
				toggleWrap.appendChild(b);
			});
			card.appendChild(toggleWrap);

			/* status summary */
			function updateStatus() {
				var parts = [];
				if (states.whitelist)   parts.push('{{ _('Ignore devices in list') }}');
				if (states.blacklist)   parts.push('{{ _('Notify only devices in list') }}');
				if (states.iface)       parts.push('{{ _('Notify only on this interface') }}');
				if (parts.length === 0) parts.push('{{ _('Normal notifications, no filtering') }}');
				statusEl.textContent = '→ ' + parts.join(' + ');
			}

			/* update hidden inputs + re-render body */
			var mac1Body = document.createElement('div');
			mac1Body.id = 'pm_mac1_body';
			card.appendChild(mac1Body);

			function syncHidden() {
				/* macmechanism compat value */
				if (states.whitelist && !states.blacklist) macHi.value = 'allow';
				else if (states.blacklist && !states.whitelist) macHi.value = 'block';
				else if (states.iface && !states.whitelist && !states.blacklist) macHi.value = 'interface';
				else macHi.value = '';
				/* clean up hidden inputs for options no longer active */
				if (!states.iface) {
					var old = macHiddenBox.querySelector('[name="cbid.pushbot.pushbot.pushbot_interface"]');
					if (old) old.remove();
				}
				if (!states.whitelist) {
					var sel2 = '[name="cbid.pushbot.pushbot.pushbot_whitelist"]';
					macHiddenBox.querySelectorAll(sel2).forEach(function(el) { el.remove(); });
				}
				if (!states.blacklist) {
					var sel3 = '[name="cbid.pushbot.pushbot.pushbot_blacklist"]';
					macHiddenBox.querySelectorAll(sel3).forEach(function(el) { el.remove(); });
				}
				updateStatus();
				renderBody();
			}

			function renderBody() {
				mac1Body.innerHTML = '';
				if (states.whitelist) makeTagField('pushbot_whitelist', '{{ _('Ignore list') }}');
				if (states.blacklist) makeTagField('pushbot_blacklist', '{{ _('Watchlist') }}');
				if (states.iface)     renderInterfaceSelector();
			}

			function makeTagField(opt, tag) {
				var t = document.createElement('div');
				t.className = 'pushbot-inline-title';
				t.style.cssText = 'margin:10px 0 4px 2px;text-transform:none;font-size:12px;color:#64748b';
				t.textContent = tag;
				mac1Body.appendChild(t);
				var box = document.createElement('div');
				box.className = 'pushbot-inline-field';
				box.style.cssText = 'padding:10px 12px;margin:0';
				var row = document.createElement('div');
				row.style.cssText = 'display:flex;gap:8px;align-items:center';
				var inp = document.createElement('input');
				inp.type = 'text'; inp.placeholder = 'XX:XX:XX:XX:XX:XX';
				inp.className = 'pushbot-mac-input';
				inp.style.cssText = 'flex:1;padding:7px 10px;border-radius:8px;border:1px solid rgba(148,163,184,0.3);font-size:13px;background:var(--pb-input-bg);color:inherit';
				var dlId = 'mh_' + opt;
				inp.setAttribute('list', dlId);
				var dlist = document.createElement('datalist');
				dlist.id = dlId;
				PB_sys('mac_hints').forEach(function(h) {
					var o = document.createElement('option');
					o.value = h.m; o.textContent = h.n ? h.m + ' (' + h.n + ')' : h.m;
					dlist.appendChild(o);
				});
				row.appendChild(inp); row.appendChild(dlist);
				var addBtn = document.createElement('button');
				addBtn.type = 'button'; addBtn.textContent = '{{ _('Add') }}';
				addBtn.className = 'pushbot-choice-button is-on';
				addBtn.style.cssText = 'padding:7px 14px;font-size:12px';
				row.appendChild(addBtn);
				box.appendChild(row);
				var tagC = document.createElement('div');
				tagC.style.cssText = 'display:flex;flex-wrap:wrap;gap:6px;margin-top:8px';
				box.appendChild(tagC);
				function sync() {
					var vals = [];
					tagC.querySelectorAll('[data-mactag]').forEach(function(el) {
						var txt = el.getAttribute('data-mactag');
						if (txt) vals.push(txt);
					});
					rebuildMacHidden(opt, vals);
				}
				function addTag(text) {
					if (!text) return;
					var el = document.createElement('span');
					el.className = 'pushbot-alias-tag';
					el.style.cssText = 'display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:8px;font-size:12px;background:rgba(59,130,246,0.12);border:1px solid rgba(59,130,246,0.25);color:inherit';
					el.textContent = text; el.setAttribute('data-mactag', text);
					var del = document.createElement('button');
					del.type = 'button'; del.innerHTML = '✕';
					del.style.cssText = 'border:none;background:none;cursor:pointer;font-size:12px;color:#94a3b8;padding:0 2px';
					del.addEventListener('click', function(e) { e.preventDefault(); el.remove(); sync(); });
					el.appendChild(del);
					tagC.appendChild(el);
					sync();
				}
				addBtn.addEventListener('click', function(e) {
					e.preventDefault();
					var val = inp.value.trim(); if (val) { addTag(val); inp.value = ''; }
				});
				inp.addEventListener('keydown', function(e) {
					if (e.key === 'Enter') { e.preventDefault(); var val = inp.value.trim(); if (val) { addTag(val); inp.value = ''; } }
				});
				var existing = PB_list(opt);
				if (existing.length > 0) {
					rebuildMacHidden(opt, existing);
					existing.forEach(function(v) { if (v) addTag(v); });
				}
				mac1Body.appendChild(box);
			}

			function renderInterfaceSelector() {
				var t = document.createElement('div');
				t.className = 'pushbot-inline-title';
				t.style.cssText = 'margin:10px 0 4px 2px;text-transform:none;font-size:12px;color:#64748b';
				t.textContent = '{{ _('Notify only interface:') }}';
				mac1Body.appendChild(t);
				var ifaces = PB_sys('ifaces');
				var hi = makeHidden('pushbot_interface', ifaceCur);
				if (ifaces.length > 0) {
					var sel = document.createElement('select');
					sel.style.cssText = 'width:100%;padding:7px;border-radius:8px;border:1px solid rgba(148,163,184,0.3)';
					ifaces.forEach(function(f) {
						var opt = document.createElement('option');
						opt.value = f; opt.textContent = f;
						if (f === ifaceCur) { opt.selected = true; hi.value = f; }
						sel.appendChild(opt);
					});
					sel.addEventListener('change', function() { hi.value = this.value; });
					mac1Body.appendChild(sel);
				} else {
					var inp = document.createElement('input');
					inp.type = 'text'; inp.placeholder = 'br-lan';
					inp.style.cssText = 'width:100%;padding:7px 10px;border-radius:8px;border:1px solid rgba(148,163,184,0.3);font-size:13px;box-sizing:border-box;background:var(--pb-input-bg);color:inherit';
					inp.value = ifaceCur;
					inp.addEventListener('change', function() { hi.value = this.value; });
					mac1Body.appendChild(inp);
				}
			}

			/* apply mutual-exclusion rules and refresh UI */
			function applyToggles() {
				for (var k in toggleBtns) {
					toggleBtns[k].className = 'pushbot-choice-button ' + (states[k] ? 'is-on' : 'is-off');
				}
				syncHidden();
			}

			/* whitelist ↔ blacklist mutex; interface independent */
			function modeClick(key) {
				return function(e) {
					e.preventDefault();
					if (states[key]) {
						/* toggling off */
						states[key] = false;
					} else {
						/* toggling on: enforce whitelist/blacklist mutex */
						if (key === 'whitelist') states.blacklist = false;
						if (key === 'blacklist') states.whitelist = false;
						states[key] = true;
					}
					applyToggles();
				};
			}
			toggleBtns.whitelist.addEventListener('click', modeClick('whitelist'));
			toggleBtns.blacklist.addEventListener('click', modeClick('blacklist'));
			toggleBtns.iface.addEventListener('click', modeClick('iface'));

			/* initial render */
			syncHidden();
		})();

		/* MAC Filter 2 */
		(function() {
			var title = document.createElement('div');
			title.className = 'pushbot-inline-title';
			title.style.cssText = 'margin:14px 0 6px 2px;text-transform:none;font-size:13px';
			title.textContent = '{{ _('MAC Filter 2') }}';
			card.appendChild(title);
			card.appendChild(mkChoice('macmechanism2', ['', 'MAC_online', 'MAC_offline'],
				{'':'{{ _('Disabled') }}','MAC_online':'{{ _('DND while any device in list is online') }}','MAC_offline':'{{ _('DND when all devices in list are offline') }}'},
				function(v) { renderMac2(v); }
			));

			var mac2Body = document.createElement('div');
			mac2Body.id = 'pm_mac2_body';
			card.appendChild(mac2Body);

			function makeTagField(opt, tag) {
				var t = document.createElement('div');
				t.className = 'pushbot-inline-title';
				t.style.cssText = 'margin:10px 0 4px 2px;text-transform:none;font-size:12px;color:#64748b';
				t.textContent = tag;
				mac2Body.appendChild(t);
				var box = document.createElement('div');
				box.className = 'pushbot-inline-field';
				box.style.cssText = 'padding:10px 12px;margin:0';
				var row = document.createElement('div');
				row.style.cssText = 'display:flex;gap:8px;align-items:center';
				var inp = document.createElement('input');
				inp.type = 'text'; inp.placeholder = 'XX:XX:XX:XX:XX:XX';
				inp.className = 'pushbot-mac-input';
				inp.style.cssText = 'flex:1;padding:7px 10px;border-radius:8px;border:1px solid rgba(148,163,184,0.3);font-size:13px;background:var(--pb-input-bg);color:inherit';
				var dlId = 'mh_' + opt;
				inp.setAttribute('list', dlId);
				var dlist = document.createElement('datalist');
				dlist.id = dlId;
				PB_sys('mac_hints').forEach(function(h) {
					var o = document.createElement('option');
					o.value = h.m; o.textContent = h.n ? h.m + ' (' + h.n + ')' : h.m;
					dlist.appendChild(o);
				});
				row.appendChild(inp); row.appendChild(dlist);
				var addBtn = document.createElement('button');
				addBtn.type = 'button'; addBtn.textContent = '{{ _('Add') }}';
				addBtn.className = 'pushbot-choice-button is-on';
				addBtn.style.cssText = 'padding:7px 14px;font-size:12px';
				row.appendChild(addBtn);
				box.appendChild(row);
				var tagC = document.createElement('div');
				tagC.style.cssText = 'display:flex;flex-wrap:wrap;gap:6px;margin-top:8px';
				box.appendChild(tagC);
				function sync() {
					var vals = [];
					tagC.querySelectorAll('[data-mactag]').forEach(function(el) {
						var txt = el.getAttribute('data-mactag');
						if (txt) vals.push(txt);
					});
					rebuildMacHidden(opt, vals);
				}
				function addTag(text) {
					if (!text) return;
					var el = document.createElement('span');
					el.className = 'pushbot-alias-tag';
					el.style.cssText = 'display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:8px;font-size:12px;background:rgba(59,130,246,0.12);border:1px solid rgba(59,130,246,0.25);color:inherit';
					el.textContent = text; el.setAttribute('data-mactag', text);
					var del = document.createElement('button');
					del.type = 'button'; del.innerHTML = '✕';
					del.style.cssText = 'border:none;background:none;cursor:pointer;font-size:12px;color:#94a3b8;padding:0 2px';
					del.addEventListener('click', function(e) { e.preventDefault(); el.remove(); sync(); });
					el.appendChild(del);
					tagC.appendChild(el);
					sync();
				}
				addBtn.addEventListener('click', function(e) {
					e.preventDefault();
					var val = inp.value.trim(); if (val) { addTag(val); inp.value = ''; }
				});
				inp.addEventListener('keydown', function(e) {
					if (e.key === 'Enter') { e.preventDefault(); var val = inp.value.trim(); if (val) { addTag(val); inp.value = ''; } }
				});
				var existing = PB_list(opt);
				if (existing.length > 0) {
					rebuildMacHidden(opt, existing);
					existing.forEach(function(v) { if (v) addTag(v); });
				}
				mac2Body.appendChild(box);
			}

			function renderMac2(v) {
				mac2Body.innerHTML = '';
				if (v === 'MAC_online') makeTagField('MAC_online_list', '{{ _('Online DND list') }}');
				if (v === 'MAC_offline') makeTagField('MAC_offline_list', '{{ _('Offline DND list') }}');
			}
			renderMac2(mac2Cur);
		})();

		/* insert after terminal card */
		var termCard = document.getElementById('pushbot_terminal_card');
		if (termCard && termCard.parentNode) {
			termCard.parentNode.insertBefore(card, termCard.nextSibling);
		}
	}

	/* register all init functions FIRST, before any direct call that might throw */

/* ═══════════════════════════════════════════ */
/* Tab: Push Content */
/* ═══════════════════════════════════════════ */
function initContentCard() {
	if (!PB_CONFIG) { setTimeout(initContentCard, 200); return; }
	var pane = document.getElementById('pushbot_pane_content');
	if (!pane) { setTimeout(initContentCard, 150); return; }
	if (document.getElementById('pushbot_content_card_container')) return;

	var hb = document.getElementById('con_hidden_fields') || (function(){
		var d=document.createElement('div'); d.id='con_hidden_fields'; d.style.display='none';
		(document.querySelector('form')||document.body||document.documentElement).appendChild(d); return d;
	})();
	hb.innerHTML = '';

	function mkH(name, val) {
		var i=document.createElement('input'); i.type='hidden';
		i.name='cbid.pushbot.pushbot.'+name; i.value=val; hb.appendChild(i); return i;
	}
	function mkBtn(label, isOn, onClick) {
		var on = !!isOn;
		var b=document.createElement('button'); b.type='button';
		b.className='pushbot-choice-button '+(on?'is-on':'is-off');
		b.innerHTML='<span>'+label+'</span>';
		b.addEventListener('click',function(e){
			e.preventDefault(); on=!on;
			b.className='pushbot-choice-button '+(on?'is-on':'is-off');
			if(onClick)onClick(on);
		}); return b;
	}
	function mkChoice(opts, cur, onChange) {
		var c=document.createElement('div');c.className='pushbot-choice-list';
		var btns=[];
		opts.forEach(function(o){
			var b=document.createElement('button');b.type='button';b.className='pushbot-choice-button';
			b.textContent=o.l;b.setAttribute('data-v',o.v);
			if(o.v===cur)b.className+=' is-on';
			b.addEventListener('click',function(e){
				e.preventDefault();cur=o.v;
				btns.forEach(function(b2){b2.className='pushbot-choice-button'+(b2.getAttribute('data-v')===cur?' is-on':'');});
				if(onChange)onChange(cur);
			});btns.push(b);c.appendChild(b);
		});return c;
	}
	function mkTxt(name, label, val, desc) {
		var w=document.createElement('div');w.className='pushbot-inline-field';w.style.cssText='margin:4px 0';
		var t=document.createElement('div');t.className='pushbot-inline-title';
		t.style.cssText='margin:0 0 4px 2px;text-transform:none;font-size:13px;font-weight:600;color:inherit';
		t.textContent=label;w.appendChild(t);
		var b=document.createElement('div');b.className='pushbot-inline-body';
		var inp=document.createElement('input');inp.type='text';inp.className='cbi-input-text';
		inp.value=val;
		inp.style.cssText='width:100%;padding:7px 10px;border-radius:8px;border:1px solid rgba(148,163,184,0.3);font-size:13px;box-sizing:border-box;background:var(--pb-input-bg);color:inherit';
		var hi=mkH(name,val);
		inp.addEventListener('change',function(){hi.value=this.value;});
		b.appendChild(inp);
		if(desc){var d=document.createElement('div');d.className='pushbot-inline-description';d.innerHTML=desc;b.appendChild(d);}
		w.appendChild(b);return w;
	}
	function mkSel(name, label, val, opts, desc, onChange) {
		var w=document.createElement('div');w.className='pushbot-inline-field';w.style.cssText='margin:4px 0';
		var t=document.createElement('div');t.className='pushbot-inline-title';
		t.style.cssText='margin:0 0 4px 2px;text-transform:none;font-size:13px;font-weight:600;color:inherit';
		t.textContent=label;w.appendChild(t);
		var b=document.createElement('div');b.className='pushbot-inline-body';
		var sel=document.createElement('select');sel.className='cbi-input-select';
		sel.style.cssText='width:100%;padding:6px 10px;border-radius:8px;border:1px solid rgba(148,163,184,0.3);font-size:13px;background:var(--pb-input-bg);color:inherit';
		opts.forEach(function(o){var op=document.createElement('option');op.value=o.v;op.textContent=o.l;if(o.v===val)op.selected=true;sel.appendChild(op);});
		var hi=mkH(name,val);
		/* LuCI 会把 select 替换为 .cbi-dropdown 并派发 cbi-dropdown-change（bubbles）。
		   原生 select 被移除后 change 不再触发，故同时监听 dropdown 事件；
		   两者可能同帧触发，用时间戳去重避免重复回调。 */
		var lastFire=0;
		function fireChange(){
			if(!onChange)return;
			var now=Date.now();
			if(now-lastFire<100)return;
			lastFire=now;
			var dd=w.querySelector('.cbi-dropdown');
			onChange(dd?dd.value:sel.value);
		}
		sel.addEventListener('change',function(){hi.value=this.value;fireChange();});
		w.addEventListener('cbi-dropdown-change',function(e){
			/* detail.value 为对象 {text,value,element}；空值（未选）为 null。
			   取 .value 属性写 hidden，空值则清空。 */
			var v='';
			if (e.detail && e.detail.value && e.detail.value.value !== undefined)
				v = '' + e.detail.value.value;
			hi.value=v;
			fireChange();
		});
		b.appendChild(sel);
		if(desc){var d=document.createElement('div');d.className='pushbot-inline-description';d.innerHTML=desc;b.appendChild(d);}
		w.appendChild(b);return w;
	}
	/* 拉黑时长组合控件：单位下拉（永久/秒/分/时/天/周/月）+ 数值输入框。
	   选择"永久"时隐藏数值框，保存 0（永久拉黑）；选其他单位显示数值框，
	   保存为 纯数字(秒) 或 数字+单位(30m/2h/3D/1W/2M)。兼容旧配置纯数字秒。 */
	/* 拉黑时长两级自绘下拉：先选单位（永久/秒/分/时/天/周/月），数值下拉随单位
	   限定范围（秒1-59、分1-59、时1-23、天1-29、周1-4、月1-12），最大约 1 年。
	   自绘（仿 mkSelS）绕开 LuCI select→dropdown 转换对选中项显示的错误；
	   保存值即所选档位原样（0 / 30 / 5m / 12h / 15D / 2W / 6M），不做换算。 */
	function mkTimeoutSel(name, label, val, desc) {
		var w=document.createElement('div');w.className='pushbot-inline-field';w.style.cssText='margin:4px 0';
		var t=document.createElement('div');t.className='pushbot-inline-title';
		t.style.cssText='margin:0 0 4px 2px;text-transform:none;font-size:13px;font-weight:600;color:inherit';
		t.textContent=label;w.appendChild(t);
		var b=document.createElement('div');b.className='pushbot-inline-body';
		b.style.cssText='position:relative;display:flex;flex-direction:row;gap:6px;align-items:center;flex-wrap:nowrap';
		var raw=''+(val==null?'':val);
		/* 单位定义：值=保存后缀, 范围上限 */
		var unitDefs=[['permanently','{{ _('Permanently') }}',0],['s','{{ _('Seconds') }}',59],['m','{{ _('Minutes') }}',59],['h','{{ _('Hours') }}',23],['D','{{ _('Days') }}',29],['W','{{ _('Weeks') }}',3],['M','{{ _('Months') }}',12]];
		/* 解析现有配置 → [单位, 数值]：0/空=永久；纯数字=秒；数字+单位 */
		function parse(raw){
			var m=/^(\d+)\s*([a-zA-Z]*)$/.exec(raw);
			if(raw==='0'||raw===''||!m) return ['permanently',1];
			var u=m[2]||'s';
			if(u==='H')u='h'; if(u==='d')u='D'; if(u==='w')u='W';
			return [u,parseInt(m[1],10)];
		}
		function maxFor(u){ for(var k=0;k<unitDefs.length;k++) if(unitDefs[k][0]===u) return unitDefs[k][2]; return 59; }
		function labelOf(u){ for(var k=0;k<unitDefs.length;k++) if(unitDefs[k][0]===u) return unitDefs[k][1]; return u; }
		var init=parse(raw);
		var hi=makeHidden(name, raw===''?'0':raw);
		var curUnit=''+(init[0]||'permanently');
		var curNum=init[1]>=1?init[1]:1;
		/* 单位自绘下拉 */
		var unitBtn=document.createElement('button');unitBtn.type='button';
		unitBtn.className='pushbot-choice-button pushbot-sel-btn';
		unitBtn.style.cssText='width:120px;flex:0 0 auto;padding:5px 10px;text-align:left;justify-content:space-between;white-space:nowrap;overflow:hidden;text-overflow:ellipsis';
		var unitLst=document.createElement('div');
		unitLst.className='pushbot-sel-list';
		unitLst.setAttribute('data-pb', 'unit');
		unitLst.style.cssText='display:none;position:absolute;z-index:1000;left:0;right:0;top:calc(100% + 4px);border-radius:10px;max-height:196px;overflow-y:auto;box-shadow:0 12px 32px rgba(0,0,0,0.25)';
		/* 数值自绘下拉 */
		var numBtn=document.createElement('button');numBtn.type='button';
		numBtn.className='pushbot-choice-button pushbot-sel-btn';
		numBtn.style.cssText='flex:0 1 auto;min-width:70px;padding:5px 10px;text-align:left;justify-content:space-between;white-space:nowrap;overflow:hidden;text-overflow:ellipsis';
		var numLst=document.createElement('div');
		numLst.className='pushbot-sel-list';
		numLst.setAttribute('data-pb', 'num');
		numLst.style.cssText='display:none;position:absolute;z-index:1000;left:0;right:0;top:calc(100% + 4px);border-radius:10px;max-height:196px;overflow-y:auto;box-shadow:0 12px 32px rgba(0,0,0,0.25)';
		function numOpts(){ var a=[]; var mx=maxFor(curUnit); for(var i=1;i<=mx;i++) a.push({v:''+i,l:''+i}); return a; }
		function renderUnit(){
			unitBtn.textContent=labelOf(curUnit);
			unitLst.innerHTML='';
			unitDefs.forEach(function(u){
				var item=document.createElement('div');
				item.className='pushbot-sel-item'+(u[0]===curUnit?' is-on':'');
				item.textContent=u[1];
				item.addEventListener('click',function(){curUnit=u[0];renderUnit();renderNum();compose();unitLst.style.display='none';});
				unitLst.appendChild(item);
			});
		}
		function renderNum(){
			var mx=maxFor(curUnit);
			var show=(curUnit!=='permanently');
			numBtn.style.display=show?'':'none';
			numBtn.textContent=show?''+curNum:'';
			numLst.innerHTML='';
			if(!show)return;
			numOpts().forEach(function(o){
				var item=document.createElement('div');
				item.className='pushbot-sel-item'+(String(o.v)===String(curNum)?' is-on':'');
				item.textContent=o.l;
				item.addEventListener('click',function(){curNum=parseInt(o.v,10);renderNum();compose();numLst.style.display='none';});
				numLst.appendChild(item);
			});
		}
		function compose(){
			if(curUnit==='permanently'){hi.value='0';return;}
			hi.value=(curUnit==='s')?''+curNum:''+curNum+curUnit;
		}
		unitBtn.addEventListener('click',function(e){e.preventDefault();var o=numLst.style.display;numLst.style.display='none';unitLst.style.display=(unitLst.style.display==='none')?'block':'none';});
		numBtn.addEventListener('click',function(e){e.preventDefault();var o=unitLst.style.display;unitLst.style.display='none';numLst.style.display=(numLst.style.display==='none')?'block':'none';});
		document.addEventListener('click',function(e){ if(!w.contains(e.target)){unitLst.style.display='none';numLst.style.display='none';} });
		renderUnit();renderNum();compose();
		b.appendChild(numBtn);b.appendChild(numLst);b.appendChild(unitBtn);b.appendChild(unitLst);
		if(desc){var d=document.createElement('div');d.className='pushbot-inline-description';d.innerHTML=desc;b.appendChild(d);}
		w.appendChild(b);return w;
	}

	var CT_IFACES = PB_sys('ifaces');
	var CT_IP_HINTS = PB_sys('ip_hints');
	var CT_IPV4 = PB_val('pushbot_ipv4', '');
	var CT_IPV4_IFACE = PB_val('ipv4_interface', '');
	var CT_IPV6 = PB_val('pushbot_ipv6', 'disable');
	var CT_IPV6_IFACE = PB_val('ipv6_interface', '');
	var CT_PUSH_UP = PB_bool('pushbot_up');
	var CT_PUSH_DOWN = PB_bool('pushbot_down');
	var CT_CPU_LOAD_EN = PB_bool('cpuload_enable');
	var CT_CPU_LOAD = PB_val('cpuload', '2');
	var CT_TEMP_EN = PB_bool('temperature_enable');
	var CT_TEMP = PB_val('temperature', '80');
	var CT_USAGE = PB_bool('client_usage');
	var CT_USAGE_MAX = PB_val('client_usage_max', '10M');
	var CT_USAGE_DISTURB = PB_bool('client_usage_disturb');
	var CT_WEB_LOG = PB_bool('web_logged');
	var CT_SSH_LOG = PB_bool('ssh_logged');
	var CT_WEB_FAIL = PB_bool('web_login_failed');
	var CT_SSH_FAIL = PB_bool('ssh_login_failed');
	var CT_LOGIN_MAX = PB_val('login_max_num', '3');
	var CT_AUTO_BAN = PB_bool('web_login_black');
	var CT_BAN_TIMEOUT = PB_val('ip_black_timeout', '1D');
	var CT_IP_WHITE = PB_list('ip_white_list');
	var CT_CLIENT_WHITE = PB_list('client_usage_whitelist');
	var CT_IPV4_LIST = PB_file('ipv4_list');
	var CT_IPV6_LIST = PB_file('ipv6_list');
	var CT_IP_BLACK = PB_file('ip_black_list');

	var container = document.createElement('div'); container.id = 'pushbot_content_card_container';

	/* CARD 1: Network Monitor */
	var c1 = document.createElement('div'); c1.className = 'pushbot-mode-card';
	c1.innerHTML = '<div class="pushbot-card-top"><span class="pushbot-card-title">{{ _('Network Monitor') }}</span></div>';
	var b1 = document.createElement('div'); b1.style.cssText = 'margin-top:6px';

	/* IPv4 row */
	var iv4Hi = mkH('pushbot_ipv4', CT_IPV4);
	var iv4Opts=[{v:'',l:'{{ _('Disabled') }}'},{v:'1',l:'{{ _('Via interface') }}'},{v:'2',l:'{{ _('Via URL') }}'}];
	var iv4Choices = mkChoice(iv4Opts, CT_IPV4, function(v){iv4Hi.value=v; toggleIPv4(v); iv4Fetch(v);});
	var iv4Lbl = document.createElement('div'); iv4Lbl.className='pushbot-inline-title';
	iv4Lbl.style.cssText='margin:0 0 4px 2px;text-transform:none;font-size:13px;font-weight:600;color:inherit';
	iv4Lbl.textContent='{{ _('IPv4 change notification') }}'; b1.appendChild(iv4Lbl);
	/* 三按钮右侧输出位：即时显示获取到的地址 */
	var iv4Row=document.createElement('div');iv4Row.style.cssText='display:flex;align-items:center;gap:12px;flex-wrap:wrap';
	iv4Row.appendChild(iv4Choices);
	var iv4Rl=document.createElement('span');iv4Rl.style.cssText='font-size:13px;font-weight:600';iv4Rl.textContent='{{ _('IPv4 result:') }}';iv4Row.appendChild(iv4Rl);
	var iv4Ro=document.createElement('span');iv4Ro.className='pushbot-ip-result';iv4Ro.style.cssText='padding:4px 10px;background:rgba(148,163,184,0.08);border-radius:6px;font-family:Menlo,Consolas,monospace;font-size:12px';iv4Ro.textContent='--';iv4Row.appendChild(iv4Ro);
	b1.appendChild(iv4Row);
	var iv4Sub = document.createElement('div'); iv4Sub.id='ct_ipv4_extra'; iv4Sub.style.cssText='margin-top:6px;display:none';
	/* interface selector */
	var iv4Sub1 = document.createElement('div'); iv4Sub1.id='ct_ipv4_iface'; iv4Sub1.style.cssText='display:none';
	var iv4IfOpts=[{v:'',l:'{{ _('-- Select interface --') }}'}];
	CT_IFACES.forEach(function(f){iv4IfOpts.push({v:f,l:f});});
	iv4Sub1.appendChild(mkSel('ipv4_interface','{{ _('Interface name') }}',CT_IPV4_IFACE,iv4IfOpts,'{{ _('Usually select the wan interface; choose yourself in multi-WAN environments') }}<br>{{ _('URL probing egress: LAN interface uses the default route; WAN interface is bound as the egress.') }}<br>{{ _('The selected interface is used as interface info for scheduled push.') }}',function(){iv4Fetch('1');}));
	iv4Sub.appendChild(iv4Sub1);
	/* URL list textarea */
	var iv4Sub2 = document.createElement('div'); iv4Sub2.id='ct_ipv4_url'; iv4Sub2.style.cssText='display:none';
	var iv4UrlLbl = document.createElement('div'); iv4UrlLbl.className='pushbot-inline-title';
	iv4UrlLbl.style.cssText='margin:0 0 4px 2px;text-transform:none;font-size:13px;font-weight:600;color:inherit';
	iv4UrlLbl.textContent='{{ _('IPv4 API list') }}'; iv4Sub2.appendChild(iv4UrlLbl);
	/* 标题下方提示 */
	var iv4UrlNote=document.createElement('div');iv4UrlNote.className='pushbot-inline-description';
	iv4UrlNote.style.cssText='margin:0 0 6px 2px;font-size:12px;color:inherit;opacity:0.75';
	iv4UrlNote.innerHTML='{{ _('[ Note: If you use a "Global Interconnect" style plugin, please add the following APIs to the whitelist to avoid being identified as an overseas IP. ]') }}';
	iv4Sub2.appendChild(iv4UrlNote);
	var iv4Ta=document.createElement('textarea');iv4Ta.className='cbi-input-textarea';iv4Ta.rows=4;
	iv4Ta.style.cssText='width:100%;padding:7px 10px;border-radius:8px;border:1px solid rgba(148,163,184,0.3);font-size:13px;box-sizing:border-box;background:var(--pb-input-bg);color:inherit;resize:vertical';
	iv4Ta.textContent=CT_IPV4_LIST;
	var iv4UrlHi=mkH('ipv4_list',CT_IPV4_LIST);
	iv4Ta.addEventListener('input',function(){iv4UrlHi.value=this.value;});
	iv4Ta.addEventListener('blur',function(){if(iv4Sub2.style.display!=='none')iv4Fetch('2');});
	iv4Sub2.appendChild(iv4Ta);
	/* URL 模式说明：定时推送时 WAN 信息探测 */
	var iv4UrlEgress=document.createElement('div');iv4UrlEgress.className='pushbot-inline-description';
	iv4UrlEgress.style.cssText='margin:2px 0 6px 2px;font-size:12px;color:inherit;opacity:0.75';
	iv4UrlEgress.textContent='{{ _('This API list is used for WAN info probing in scheduled push.') }}';
	iv4Sub2.appendChild(iv4UrlEgress);
	/* 恢复插件默认按钮 */
	var iv4Rst=document.createElement('div');iv4Rst.style.cssText='display:flex;justify-content:flex-end;margin-top:6px';
	var iv4RstBtn=document.createElement('button');iv4RstBtn.type='button';iv4RstBtn.className='cbi-button cbi-input-action';
	iv4RstBtn.style.cssText='padding:4px 12px;font-size:12px;border-radius:6px';
	iv4RstBtn.textContent='{{ _('Restore plugin default') }}';
	iv4RstBtn.addEventListener('click',function(){
		iv4Ta.value=iv4DefList;iv4UrlHi.value=iv4DefList;
		if(iv4Sub2.style.display!=='none')iv4Fetch('2');
	});
	iv4Rst.appendChild(iv4RstBtn);iv4Sub2.appendChild(iv4Rst);
	iv4Sub.appendChild(iv4Sub2);
	b1.appendChild(iv4Sub);
	/* 插件默认预置列表（与包内 api/ipv4.list 一致），供恢复默认按钮使用 */
	var iv4DefList={{ sprintf("%J", pushbot_def_ipv4) }};
	function toggleIPv4(v){
		iv4Sub.style.display=(v==='1'||v==='2')?'block':'none';
		iv4Sub1.style.display=(v==='1')?'block':'none';
		iv4Sub2.style.display=(v==='2')?'block':'none';
	}
	function ipResultStyle(ro, text, isErr) {
		/* 与检查更新一致的配色：公网=绿 / 非公网=橙 / 失败=红 */
		ro.classList.remove('is-ok','is-warn','is-err');
		if (isErr) { ro.classList.add('is-err'); return; }
		var t = text || '';
		if (t.indexOf('(') >= 0 || t.indexOf('Not a public') >= 0 || t.indexOf('非公网') >= 0) {
			ro.classList.add('is-warn');
		}
		else if (t.indexOf('Failed to obtain') >= 0 || t.indexOf('获取失败') >= 0 ||
		         t.indexOf('No output') >= 0 || t.indexOf('无输出') >= 0 || t == '') {
			ro.classList.add('is-err');
		}
		else {
			ro.classList.add('is-ok');
		}
	}
	function iv4Fetch(v){
		if(v!=='1'&&v!=='2'){iv4Ro.textContent='--';return;}
		var base='{{ dispatcher.build_url('admin','services','pushbot','get_ip') }}';
		var q='type=4&mode='+(v==='1'?'iface':'url');
		if(v==='1'){
			/* LuCI 将 select 替换为 .cbi-dropdown：优先读 dropdown 值 */
			var dd=iv4Sub1.querySelector('.cbi-dropdown');
			var iface=dd?dd.value:(iv4Sub1.querySelector('select')||{}).value;
			if(iface==null)iface=CT_IPV4_IFACE;
			if(!iface){iv4Ro.textContent='{{ _('Select an interface first') }}';iv4Ro.classList.remove('is-ok','is-warn');iv4Ro.classList.add('is-err');return;}
			q+='&iface='+encodeURIComponent(iface);
		}else{
			/* URL 模式：带配置的接口出口，适配多 WAN */
			q+='&url='+encodeURIComponent(iv4Ta.value||'');
			if(CT_IPV4_IFACE)q+='&iface='+encodeURIComponent(CT_IPV4_IFACE);
		}
		/* 打断：每次新触发使旧请求 token 失效（含重试中的请求） */
		var myTok=++iv4Tok;
		iv4Ro.textContent='{{ _('Loading...') }}';
		iv4Ro.classList.remove('is-ok','is-warn','is-err');
		var x=new XMLHttpRequest();
		x.open('GET',base+'?_='+Date.now()+'&'+q,true);
		x.onload=function(){if(myTok!==iv4Tok)return;iv4Ro.textContent=x.responseText||'{{ _('No output') }}';ipResultStyle(iv4Ro,x.responseText,false);};
		x.onerror=function(){if(myTok!==iv4Tok)return;iv4Ro.textContent='{{ _('No output') }}';ipResultStyle(iv4Ro,'',true);};
		x.send();
	}
	var iv4Tok=0;
	toggleIPv4(CT_IPV4);
	if(CT_IPV4==='1'||CT_IPV4==='2')iv4Fetch(CT_IPV4);

	/* IPv6 row */
	var iv6Hi = mkH('pushbot_ipv6', CT_IPV6);
	var iv6Opts=[{v:'0',l:'{{ _('Disabled') }}'},{v:'1',l:'{{ _('Via interface') }}'},{v:'2',l:'{{ _('Via URL') }}'}];
	var iv6Choices = mkChoice(iv6Opts, CT_IPV6, function(v){iv6Hi.value=v; toggleIPv6(v); iv6Fetch(v);});
	var iv6Lbl = document.createElement('div'); iv6Lbl.className='pushbot-inline-title';
	iv6Lbl.style.cssText='margin:8px 0 4px 2px;text-transform:none;font-size:13px;font-weight:600;color:inherit';
	iv6Lbl.textContent='{{ _('IPv6 change notification') }}'; b1.appendChild(iv6Lbl);
	/* 三按钮右侧输出位：即时显示获取到的地址 */
	var iv6Row=document.createElement('div');iv6Row.style.cssText='display:flex;align-items:center;gap:12px;flex-wrap:wrap';
	iv6Row.appendChild(iv6Choices);
	var iv6Rl=document.createElement('span');iv6Rl.style.cssText='font-size:13px;font-weight:600';iv6Rl.textContent='{{ _('IPv6 result:') }}';iv6Row.appendChild(iv6Rl);
	var iv6Ro=document.createElement('span');iv6Ro.className='pushbot-ip-result';iv6Ro.style.cssText='padding:4px 10px;background:rgba(148,163,184,0.08);border-radius:6px;font-family:Menlo,Consolas,monospace;font-size:12px';iv6Ro.textContent='--';iv6Row.appendChild(iv6Ro);
	b1.appendChild(iv6Row);
	var iv6Sub = document.createElement('div'); iv6Sub.id='ct_ipv6_extra'; iv6Sub.style.cssText='margin-top:6px;display:none';
	var iv6Sub1 = document.createElement('div'); iv6Sub1.style.cssText='display:none';
	var iv6IfOpts=[{v:'',l:'{{ _('-- Select interface --') }}'}];
	CT_IFACES.forEach(function(f){iv6IfOpts.push({v:f,l:f});});
	iv6Sub1.appendChild(mkSel('ipv6_interface','{{ _('Interface name') }}',CT_IPV6_IFACE,iv6IfOpts,'{{ _('Usually select the wan interface; choose yourself in multi-WAN environments') }}<br>{{ _('URL probing egress: LAN interface uses the default route; WAN interface is bound as the egress.') }}<br>{{ _('The selected interface is used as interface info for scheduled push.') }}',function(){iv6Fetch('1');}));
	iv6Sub.appendChild(iv6Sub1);
	var iv6Sub2 = document.createElement('div'); iv6Sub2.id='ct_ipv6_url'; iv6Sub2.style.cssText='display:none';
	var iv6UrlLbl = document.createElement('div'); iv6UrlLbl.className='pushbot-inline-title';
	iv6UrlLbl.style.cssText='margin:0 0 4px 2px;text-transform:none;font-size:13px;font-weight:600;color:inherit';
	iv6UrlLbl.textContent='{{ _('IPv6 API list') }}'; iv6Sub2.appendChild(iv6UrlLbl);
	/* 标题下方提示 */
	var iv6UrlNote=document.createElement('div');iv6UrlNote.className='pushbot-inline-description';
	iv6UrlNote.style.cssText='margin:0 0 6px 2px;font-size:12px;color:inherit;opacity:0.75';
	iv6UrlNote.innerHTML='{{ _('[ Note: If you use a "Global Interconnect" style plugin, please add the following APIs to the whitelist to avoid being identified as an overseas IP. ]') }}';
	iv6Sub2.appendChild(iv6UrlNote);
	var iv6Ta=document.createElement('textarea');iv6Ta.className='cbi-input-textarea';iv6Ta.rows=4;
	iv6Ta.style.cssText='width:100%;padding:7px 10px;border-radius:8px;border:1px solid rgba(148,163,184,0.3);font-size:13px;box-sizing:border-box;background:var(--pb-input-bg);color:inherit;resize:vertical';
	iv6Ta.textContent=CT_IPV6_LIST;
	var iv6UrlHi=mkH('ipv6_list',CT_IPV6_LIST);
	iv6Ta.addEventListener('input',function(){iv6UrlHi.value=this.value;});
	iv6Ta.addEventListener('blur',function(){if(iv6Sub2.style.display!=='none')iv6Fetch('2');});
	iv6Sub2.appendChild(iv6Ta);
	/* URL 模式说明：调用左侧接口设置作为出口 */
	var iv6UrlEgress=document.createElement('div');iv6UrlEgress.className='pushbot-inline-description';
	iv6UrlEgress.style.cssText='margin:2px 0 6px 2px;font-size:12px;color:inherit;opacity:0.75';
	iv6UrlEgress.textContent='{{ _('This API list is used for WAN info probing in scheduled push.') }}';
	iv6Sub2.appendChild(iv6UrlEgress);
	/* 恢复插件默认按钮 */
	var iv6Rst=document.createElement('div');iv6Rst.style.cssText='display:flex;justify-content:flex-end;margin-top:6px';
	var iv6RstBtn=document.createElement('button');iv6RstBtn.type='button';iv6RstBtn.className='cbi-button cbi-input-action';
	iv6RstBtn.style.cssText='padding:4px 12px;font-size:12px;border-radius:6px';
	iv6RstBtn.textContent='{{ _('Restore plugin default') }}';
	iv6RstBtn.addEventListener('click',function(){
		iv6Ta.value=iv6DefList;iv6UrlHi.value=iv6DefList;
		if(iv6Sub2.style.display!=='none')iv6Fetch('2');
	});
	iv6Rst.appendChild(iv6RstBtn);iv6Sub2.appendChild(iv6Rst);
	iv6Sub.appendChild(iv6Sub2);
	b1.appendChild(iv6Sub);
	/* 插件默认预置列表（与包内 api/ipv6.list 一致），供恢复默认按钮使用 */
	var iv6DefList={{ sprintf("%J", pushbot_def_ipv6) }};
	function toggleIPv6(v){
		iv6Sub.style.display=(v==='1'||v==='2')?'block':'none';
		iv6Sub1.style.display=(v==='1')?'block':'none';
		iv6Sub2.style.display=(v==='2')?'block':'none';
	}
	function iv6Fetch(v){
		if(v!=='1'&&v!=='2'){iv6Ro.textContent='--';return;}
		var base='{{ dispatcher.build_url('admin','services','pushbot','get_ip') }}';
		var q='type=6&mode='+(v==='1'?'iface':'url');
		if(v==='1'){
			/* LuCI 将 select 替换为 .cbi-dropdown：优先读 dropdown 值 */
			var dd=iv6Sub1.querySelector('.cbi-dropdown');
			var iface=dd?dd.value:(iv6Sub1.querySelector('select')||{}).value;
			if(iface==null)iface=CT_IPV6_IFACE;
			if(!iface){iv6Ro.textContent='{{ _('Select an interface first') }}';iv6Ro.classList.remove('is-ok','is-warn');iv6Ro.classList.add('is-err');return;}
			q+='&iface='+encodeURIComponent(iface);
		}else{
			/* URL 模式：带配置的接口出口，适配多 WAN */
			q+='&url='+encodeURIComponent(iv6Ta.value||'');
			if(CT_IPV6_IFACE)q+='&iface='+encodeURIComponent(CT_IPV6_IFACE);
		}
		/* 打断：每次新触发使旧请求 token 失效（含重试中的请求） */
		var myTok=++iv6Tok;
		iv6Ro.textContent='{{ _('Loading...') }}';
		iv6Ro.classList.remove('is-ok','is-warn','is-err');
		var x=new XMLHttpRequest();
		x.open('GET',base+'?_='+Date.now()+'&'+q,true);
		x.onload=function(){if(myTok!==iv6Tok)return;iv6Ro.textContent=x.responseText||'{{ _('No output') }}';ipResultStyle(iv6Ro,x.responseText,false);};
		x.onerror=function(){if(myTok!==iv6Tok)return;iv6Ro.textContent='{{ _('No output') }}';ipResultStyle(iv6Ro,'',true);};
		x.send();
	}
	var iv6Tok=0;
