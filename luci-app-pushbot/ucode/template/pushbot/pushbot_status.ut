	r2.appendChild(mkBtn('{{ _('Web failed attempt alert') }}',wfOn,function(on){updateFlagInput('web_login_failed',on);toggleFail();}));
	r2.appendChild(mkBtn('{{ _('SSH failed attempt alert') }}',sfOn,function(on){updateFlagInput('ssh_login_failed',on);toggleFail();}));
	b3.appendChild(r2);

	/* row3: WiFi connect + WiFi auth fail (only if wireless devices exist) */
	var CT_WIFI_IFS = PB_sys('wifi_ifs');
	var hasWifi = (CT_WIFI_IFS && CT_WIFI_IFS.length > 0);
	if (hasWifi) {
		var CT_WIFI_CONN = PB_bool('wifi_connected');
		var CT_WIFI_FAIL = PB_bool('wifi_auth_failed');
		var wcHi = document.querySelector('[name="cbid.pushbot.pushbot.wifi_connected"]');
		var wfHi2 = document.querySelector('[name="cbid.pushbot.pushbot.wifi_auth_failed"]');
		var r3=document.createElement('div');r3.style.cssText='display:flex;gap:12px;margin-top:4px';
		r3.appendChild(mkBtn('{{ _('WiFi connect alert') }}',CT_WIFI_CONN,function(on){updateFlagInput('wifi_connected',on);}));
		r3.appendChild(mkBtn('{{ _('WiFi auth failure alert') }}',CT_WIFI_FAIL,function(on){updateFlagInput('wifi_auth_failed',on);toggleFail();}));
		b3.appendChild(r3);
	}

	var failSub=document.createElement('div');failSub.id='ct_fail_sub';failSub.style.cssText='margin-top:8px';
	var failOn=CT_WEB_FAIL||CT_SSH_FAIL||(CT_WIFI_IFS&&CT_WIFI_IFS.length>0&&PB_bool('wifi_auth_failed'));
	failSub.style.display=failOn?'block':'none';
	failSub.appendChild(mkTxt('login_max_num','{{ _('Failed attempt threshold') }}',CT_LOGIN_MAX,'{{ _('Push alert after exceeding the threshold') }}'));

	var banHi = document.querySelector('[name="cbid.pushbot.pushbot.web_login_black"]');
	var banOn = CT_AUTO_BAN;
	failSub.appendChild(mkBtn('{{ _('Auto blacklist') }}',banOn,function(on){updateFlagInput('web_login_black',on);toggleBan(on);}));
	var banSub=document.createElement('div');banSub.id='ct_ban_sub';banSub.style.cssText='margin-top:4px;display:'+(CT_AUTO_BAN?'block':'none');
	banSub.appendChild(mkTimeoutSel('ip_black_timeout','{{ _('Blacklist duration') }}',CT_BAN_TIMEOUT,''));
	/* IP white list */
	var ipCtr=document.createElement('div');ipCtr.style.cssText='margin:4px 0';
	var ipLbl=document.createElement('div');ipLbl.className='pushbot-inline-title';
	ipLbl.style.cssText='margin:0 0 4px 2px;text-transform:none;font-size:13px;font-weight:600;color:inherit';
	ipLbl.textContent='{{ _('IP whitelist') }}';ipCtr.appendChild(ipLbl);
	var ipHint=document.createElement('div');ipHint.style.cssText='margin:0 0 4px 2px;font-size:11.5px;color:var(--text-color-low,#64748b)';
	ipHint.textContent='{{ _('Add one entry at a time; supports single IP or CIDR range, e.g. [192.168.1.5] [10.1.1.0/24] [2001:db8::1] [fd00::/32]') }}';
	ipCtr.appendChild(ipHint);
	var ipTags=document.createElement('div');ipTags.style.cssText='display:flex;flex-wrap:wrap;gap:4px;margin-bottom:4px';
	var ipIR=document.createElement('div');ipIR.style.cssText='display:flex;gap:4px';
	var ipInp=document.createElement('input');ipInp.type='text';ipInp.className='cbi-input-text';
	ipInp.placeholder='192.168.1.5 / 10.1.1.0/24 / 2001:db8::1 / fd00::/32';ipInp.style.cssText='flex:1;padding:7px 10px;border-radius:8px;border:1px solid rgba(148,163,184,0.3);font-size:13px;background:var(--pb-input-bg);color:inherit';
	ipInp.setAttribute('list','mh_ip_white');
	var ipDl=document.createElement('datalist');ipDl.id='mh_ip_white';
	(CT_IP_HINTS||[]).forEach(function(h){var o=document.createElement('option');o.value=h;ipDl.appendChild(o);});
	ipIR.appendChild(ipInp);ipIR.appendChild(ipDl);
	var ipAdd=document.createElement('button');ipAdd.type='button';ipAdd.className='pushbot-choice-button is-on';ipAdd.textContent='{{ _('Add') }}';ipIR.appendChild(ipAdd);
	ipCtr.appendChild(ipTags);ipCtr.appendChild(ipIR);banSub.appendChild(ipCtr);
	/* blacklist textarea (simplified as text input for now) */
	var blHi=mkH('ip_black_list',CT_IP_BLACK);
	var blTxt=document.createElement('div');blTxt.style.cssText='margin:4px 0';
	var blLbl=document.createElement('div');blLbl.className='pushbot-inline-title';
	blLbl.style.cssText='margin:0 0 4px 2px;text-transform:none;font-size:13px;font-weight:600;color:inherit';
	blLbl.textContent='{{ _('IP blacklist') }}';blTxt.appendChild(blLbl);
	var blHint=document.createElement('div');blHint.className='pushbot-inline-description';
	blHint.style.cssText='margin:0 0 4px 2px;font-size:12px;opacity:0.7';
	blHint.textContent='{{ _('One IP per line; IPv4 and IPv6 supported') }}';
	blTxt.appendChild(blHint);
	var blTa=document.createElement('textarea');blTa.className='cbi-input-textarea';blTa.rows=4;
	blTa.style.cssText='width:100%;padding:7px 10px;border-radius:8px;border:1px solid rgba(148,163,184,0.3);font-size:13px;box-sizing:border-box;background:var(--pb-input-bg);color:inherit;resize:vertical';
	blTa.value = CT_IP_BLACK;
	/* 同步 textarea → hidden input：input + change 双事件 + 初始立即同步
	   （单 input 事件在部分浏览器/粘贴场景不触发，导致保存值丢失/null） */
	function blSync(){ blHi.value=blTa.value; }
	blTa.addEventListener('input',blSync);
	blTa.addEventListener('change',blSync);
	blTa.addEventListener('keyup',blSync);
	blSync();
	blTxt.appendChild(blTa);banSub.appendChild(blTxt);
	/* IP white list tag logic */
	var ipVals=CT_IP_WHITE.slice();
	function ipSync(){
		var ex=hb.querySelectorAll('[name$=".ip_white_list"]');ex.forEach(function(el){el.remove();});
		ipVals.forEach(function(v){if(!v)return;var i=document.createElement('input');i.type='hidden';i.name='cbid.pushbot.pushbot.ip_white_list';i.value=v;hb.appendChild(i);});
	}
	function ipRender(){
		ipTags.innerHTML='';
		ipVals.forEach(function(v){if(!v)return;
			var t=document.createElement('span');t.style.cssText='display:inline-flex;align-items:center;gap:4px;padding:2px 8px;background:rgba(148,163,184,0.12);border-radius:4px;font-size:12px';
			t.textContent=v;
			var x=document.createElement('span');x.textContent='\u00d7';x.style.cssText='cursor:pointer;font-weight:bold;margin-left:2px;opacity:0.6';
			x.addEventListener('click',function(){var idx=ipVals.indexOf(v);if(idx>=0){ipVals.splice(idx,1);ipRender();ipSync();}});
			t.appendChild(x);ipTags.appendChild(t);
		});
	}
	ipAdd.addEventListener('click',function(){var v=ipInp.value.trim();if(v&&ipVals.indexOf(v)<0){ipVals.push(v);ipRender();ipSync();}ipInp.value='';ipInp.focus();});
	ipInp.addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();var v=ipInp.value.trim();if(v&&ipVals.indexOf(v)<0){ipVals.push(v);ipRender();ipSync();}ipInp.value='';}});
	ipRender();ipSync();

	failSub.appendChild(banSub);b3.appendChild(failSub);
	function toggleFail(){
		var wfEl = document.querySelector('[name="cbid.pushbot.pushbot.web_login_failed"]');
		var sfEl = document.querySelector('[name="cbid.pushbot.pushbot.ssh_login_failed"]');
		var wfiEl = document.querySelector('[name="cbid.pushbot.pushbot.wifi_auth_failed"]');
		var on = (wfEl && wfEl.value === '1') || (sfEl && sfEl.value === '1') || (wfiEl && wfiEl.value === '1');
		failSub.style.display=on?'block':'none';
	}
	function toggleBan(on){banSub.style.display=on?'block':'none';}

	c3.appendChild(b3); container.appendChild(c3);

	pane.innerHTML = '';
	pane.appendChild(container);
}

/* pre-load content card (1 retry if pane not ready) */
function tryContentOnce(){
	var p = document.getElementById('pushbot_pane_content');
	if (!p) { setTimeout(tryContentOnce, 300); return; }
	try{initContentCard();}catch(e){console.error('content card:',e);}
}
PB_onReady(function(){ tryContentOnce(); });


/* ═══════════════════════════════════════════ */
/* Tab: Scheduled Push */
/* ═══════════════════════════════════════════ */
	/* ── initScheduledPushCard inside IIFE to access helper functions ── */
	function initScheduledPushCard() {
	if (document.getElementById('pushbot_scheduled_card')) return;
	if (!PB_CONFIG) { setTimeout(initScheduledPushCard, 200); return; }
	var pane = document.getElementById('pushbot_pane_scheduled');
	if (!pane) { setTimeout(initScheduledPushCard, 150); return; }

	var crontab = PB_val('crontab', '');
	var regular_time = PB_val('regular_time', '8');
	var regular_time_2 = PB_val('regular_time_2', '');
	var regular_time_3 = PB_val('regular_time_3', '');
	var interval_time = PB_val('interval_time', '6');
	var send_title = PB_val('send_title', '');
	var router_status = PB_bool('router_status');
	var router_temp = PB_bool('router_temp');
	var router_wan = PB_bool('router_wan');
	var client_list = PB_bool('client_list');
	var google_check_count = PB_val('google_check_count', '3');

	var card = document.createElement('div');
	card.id = 'pushbot_scheduled_card';
	card.className = 'pushbot-mode-card';

	var header = document.createElement('div');
	header.className = 'pushbot-card-top';
	header.innerHTML = '<span class="pushbot-card-title" style="font-size:16px;font-weight:800">{{ _('Scheduled Push') }}</span>';
	card.appendChild(header);

	/* Row: Schedule Settings */
	var taskTitle = document.createElement('div');
	taskTitle.className = 'pushbot-inline-title';
	taskTitle.style.cssText = 'margin:6px 0 6px 2px;text-transform:none;font-size:13px';
	taskTitle.textContent = '{{ _('Schedule Settings') }}';
	card.appendChild(taskTitle);

	var crHi = makeHidden('crontab', crontab);
	var crOpts = [{v:'',l:'{{ _('Disabled') }}'},{v:'1',l:'{{ _('Scheduled send') }}'},{v:'2',l:'{{ _('Interval send') }}'}];
	var crCur = crontab;
	var crList = document.createElement('div');
	crList.className = 'pushbot-choice-list';
	var crBtns = [];
	crOpts.forEach(function(o){
		var b=document.createElement('button');b.type='button';b.className='pushbot-choice-button';
		b.textContent=o.l;b.setAttribute('data-v',o.v);
		if(o.v===crCur)b.className+=' is-on';
		b.addEventListener('click',function(e){
			e.preventDefault();crCur=o.v;crHi.value=o.v;
			crBtns.forEach(function(b2){b2.className='pushbot-choice-button'+(b2.getAttribute('data-v')===crCur?' is-on':'');});
			renderScheduledContent();
		});crBtns.push(b);crList.appendChild(b);
	});
	card.appendChild(crList);

	/* ── conditional content ── */
	var contentBody = document.createElement('div');
	contentBody.id = 'sp_content_body';
	card.appendChild(contentBody);

	function hourOpts(includeClose) {
		var a = [];
		if (includeClose) a.push({v:'',l:'{{ _('Disabled') }}'});
		for (var t=0;t<=23;t++) a.push({v:String(t),l:'{{ _('Every day at') }}'+t+'{{ _('h') }}'});
		return a;
	}

	function mkTxtS(opt, label, val, desc) {
		var w=document.createElement('div');w.className='pushbot-inline-field';w.style.cssText='margin:4px 0';
		var t=document.createElement('div');t.className='pushbot-inline-title';
		t.style.cssText='margin:0 0 4px 2px;text-transform:none;font-size:13px;font-weight:600;color:inherit';
		t.textContent=label;w.appendChild(t);
		var b=document.createElement('div');b.className='pushbot-inline-body';
		var inp=document.createElement('input');inp.type='text';inp.className='cbi-input-text';inp.value=val;
		inp.style.cssText='width:100%;padding:7px 10px;border-radius:8px;border:1px solid rgba(148,163,184,0.3);font-size:13px;box-sizing:border-box;background:var(--pb-input-bg);color:inherit';
		var hi=makeHidden(opt,val);
		inp.addEventListener('change',function(){hi.value=this.value;});
		b.appendChild(inp);
		if(desc){var d=document.createElement('div');d.className='pushbot-inline-description';d.innerHTML=desc;b.appendChild(d);}
		w.appendChild(b);return w;
	}
	function mkSelS(opt, label, val, opts, desc) {
		/* 自绘下拉（不依赖 LuCI select→dropdown 转换）：
		   LuCI 转换会丢弃空值 option、且空值(禁用)时误显示第一项。
		   自绘完全控制显示（禁用显示"禁用"）、互斥（选项可动态过滤）。 */
		var w=document.createElement('div');w.className='pushbot-inline-field';w.style.cssText='margin:4px 0;flex:1;min-width:160px';
		var t=document.createElement('div');t.className='pushbot-inline-title';
		t.style.cssText='margin:0 0 4px 2px;text-transform:none;font-size:13px;font-weight:600;color:inherit';
		t.textContent=label;w.appendChild(t);
		var b=document.createElement('div');b.className='pushbot-inline-body';
		var cur = String(val==null?'':val);
		var hi=makeHidden(opt,cur);
		var currentOpts = opts;
		/* 主按钮：复用插件 choice-button 样式（明暗自动适配） */
		var btn=document.createElement('button');btn.type='button';
		btn.className='pushbot-choice-button pushbot-sel-btn';
		btn.style.cssText='width:100%;text-align:left;justify-content:space-between;white-space:nowrap;overflow:hidden;text-overflow:ellipsis';
		/* 选项列表（绝对定位覆盖，样式走主题） */
		var lst=document.createElement('div');
		lst.className='pushbot-sel-list';
		lst.style.cssText='display:none;position:absolute;z-index:1000;left:0;right:0;margin-top:4px;border-radius:10px;max-height:240px;overflow-y:auto;box-shadow:0 12px 32px rgba(0,0,0,0.25)';
		b.style.cssText='position:relative';
		var onChange=null;
		function labelOf(v){for(var i=0;i<currentOpts.length;i++)if(String(currentOpts[i].v)===String(v))return currentOpts[i].l;return v;}
		function render(){
			btn.textContent = (cur==='') ? '{{ _('Disabled') }}' : labelOf(cur);
			lst.innerHTML='';
			currentOpts.forEach(function(o){
				var item=document.createElement('div');
				item.className='pushbot-sel-item'+(String(o.v)===cur?' is-on':'');
				item.textContent=o.l;
				item.addEventListener('click',function(){
					cur=String(o.v);hi.value=cur;render();lst.style.display='none';
					if(onChange)onChange(cur);
				});
				lst.appendChild(item);
			});
		}
		btn.addEventListener('click',function(e){e.preventDefault();lst.style.display=(lst.style.display==='none')?'block':'none';});
		/* 点击外部关闭 */
		document.addEventListener('click',function(e){ if(!w.contains(e.target)) lst.style.display='none'; });
		render();
		b.appendChild(btn);b.appendChild(lst);
		if(desc){var d=document.createElement('div');d.className='pushbot-inline-description';d.innerHTML=desc;b.appendChild(d);}
		w.appendChild(b);
		/* 供外部更新选项（互斥过滤）与取值 */
		w._pbSetOpts=function(o){currentOpts=o;render();};
		w._pbGetVal=function(){return cur;};
		w._pbSetVal=function(v){cur=String(v==null?'':v);hi.value=cur;render();};
		w._pbOnChange=function(fn){onChange=fn;};
		return w;
	}

	function renderScheduledContent() {
		contentBody.innerHTML = '';
		var mode = crCur;
		/* 模式互斥：切换/关闭时清空另一模式的 hidden 字段，避免残留值
		   让脚本 pushbot_cron 误判分支（定时 vs 间隔） */
		function clearHidden(name) {
			var el = document.querySelector('[name="cbid.pushbot.pushbot.' + name + '"]');
			if (el) el.value = '';
		}
		if (mode !== '1') { clearHidden('regular_time'); clearHidden('regular_time_2'); clearHidden('regular_time_3'); }
		if (mode !== '2') { clearHidden('interval_time'); }
		if (mode === '' || mode === null) return;

		/* ── time selectors（互斥：一个时段选定后，其他时段不出现该时段）── */
		if (mode === '1') {
			var ttl = document.createElement('div');
			ttl.className = 'pushbot-inline-title';
			ttl.style.cssText = 'margin:12px 0 6px 2px;text-transform:none;font-size:13px';
			ttl.textContent = '{{ _('Send time') }}';
			contentBody.appendChild(ttl);
			var tr = document.createElement('div');
			tr.style.cssText = 'display:flex;gap:12px;flex-wrap:wrap';
			var s1 = mkSelS('regular_time','{{ _('Time 1') }}', regular_time, hourOpts(false));
			var s2 = mkSelS('regular_time_2','{{ _('Time 2') }}', regular_time_2, hourOpts(true));
			var s3 = mkSelS('regular_time_3','{{ _('Time 3') }}', regular_time_3, hourOpts(true));
			tr.appendChild(s1);tr.appendChild(s2);tr.appendChild(s3);
			contentBody.appendChild(tr);
			/* 互斥刷新：每个下拉的选项 = 全部时段 - 其他下拉已选的值（禁用 '' 除外） */
			function refreshMutex() {
				var v1=s1._pbGetVal(), v2=s2._pbGetVal(), v3=s3._pbGetVal();
				var base1=hourOpts(false), base2=hourOpts(true), base3=hourOpts(true);
				var f1=base1.filter(function(o){return o.v===''||o.v!==v2&&o.v!==v3;});
				var f2=base2.filter(function(o){return o.v===''||o.v!==v1&&o.v!==v3;});
				var f3=base3.filter(function(o){return o.v===''||o.v!==v1&&o.v!==v2;});
				s1._pbSetOpts(f1);s2._pbSetOpts(f2);s3._pbSetOpts(f3);
			}
			s1._pbOnChange(refreshMutex);s2._pbOnChange(refreshMutex);s3._pbOnChange(refreshMutex);
			refreshMutex();
		}

		if (mode === '2') {
			var ittl = document.createElement('div');
			ittl.className = 'pushbot-inline-title';
			ittl.style.cssText = 'margin:12px 0 6px 2px;text-transform:none;font-size:13px';
			ittl.textContent = '{{ _('Send interval') }}';
			contentBody.appendChild(ittl);
			var intOpts = [];
			for (var t=1;t<=23;t++) intOpts.push({v:String(t),l:t+'{{ _('hr') }}'});
			contentBody.appendChild(mkSelS('interval_time','',interval_time,intOpts,'{{ _('Starting from 00:00, send once every * hours') }}'));
		}

		/* ── push content flags ── */
		var fl = document.createElement('div');
		fl.className = 'pushbot-inline-title';
		fl.style.cssText = 'margin:14px 0 6px 2px;text-transform:none;font-size:13px';
		fl.textContent = '{{ _('Push content') }}';
		contentBody.appendChild(fl);

		var fc = document.createElement('div');
		fc.className = 'pushbot-choice-list';
		/* WAN 信息说明：调用推送内容处选定的接口——仅 WAN 信息启用时显示 */
		var wanNote=document.createElement('div');
		wanNote.className='pushbot-inline-description';
		wanNote.style.cssText='margin:2px 0 0 2px;font-size:12px;color:inherit;opacity:0.75';
		wanNote.textContent='{{ _('WAN info uses the interface selected in the push content section.') }}';
		wanNote.style.display = router_wan ? '' : 'none';
		[
			{opt:'router_status',label:'{{ _('System status') }}',on:router_status},
			{opt:'router_temp',label:'{{ _('Device temperature') }}',on:router_temp},
			{opt:'router_wan',label:'{{ _('WAN info') }}',on:router_wan},
			{opt:'client_list',label:'{{ _('Client list') }}',on:client_list}
		].forEach(function(f){
			var b=document.createElement('button');b.type='button';b.className='pushbot-choice-button';
			var on=f.on;b.className+=' '+(on?'is-on':'is-off');
			b.innerHTML='<span>'+f.label+'</span>';
			b.addEventListener('click',function(e){
				e.preventDefault();on=!on;updateFlagInput(f.opt, on);
				b.className='pushbot-choice-button '+(on?'is-on':'is-off');
				if(f.opt==='router_wan') wanNote.style.display = on ? '' : 'none';
			});
			fc.appendChild(b);
		});
		contentBody.appendChild(fc);
		contentBody.appendChild(wanNote);

		/* bottom row: push title + global connectivity timeout */
		var br = document.createElement('div');
		br.style.cssText = 'display:flex;gap:12px;margin-top:14px;flex-wrap:wrap';

		var tw = document.createElement('div');
		tw.style.cssText = 'flex:2;min-width:200px';
		tw.appendChild(mkTxtS('send_title','{{ _('Push title') }}',send_title));
		br.appendChild(tw);

		var gw = document.createElement('div');
		gw.style.cssText = 'flex:1;min-width:150px';
		gw.appendChild(mkTxtS('google_check_count','{{ _('Global connectivity retries') }}',google_check_count,'{{ _('times') }}'));
		br.appendChild(gw);

		contentBody.appendChild(br);

		/* send-now button */
		var sr = document.createElement('div');
		sr.style.cssText = 'display:flex;justify-content:flex-end;margin-top:16px';
		var sb = document.createElement('button');
		sb.type = 'button'; sb.textContent = '{{ _('Test Schedule') }}';
		sb.className = 'pushbot-sendtest-btn';
		sb.addEventListener('click', function(e) {
			e.preventDefault(); sb.disabled = true; sb.textContent = '{{ _('Sending...') }}';
			var data = window.__pbCollectData ? __pbCollectData() : {};
			var x = new XMLHttpRequest();
			x.open('POST', '{{ dispatcher.build_url('admin', 'services', 'pushbot', 'save_config') }}', true);
			x.setRequestHeader('Content-Type', 'application/json');
			x.onload = function() {
				var y = new XMLHttpRequest();
				y.open('GET', '{{ dispatcher.build_url('admin', 'services', 'pushbot', 'send_manual') }}', true);
				y.onload = function() { sb.disabled = false; sb.textContent = '{{ _('Test Schedule') }}'; };
				y.onerror = function() { sb.disabled = false; sb.textContent = '{{ _('Test Schedule') }}'; };
				y.send();
			};
			x.onerror = function() { sb.disabled = false; sb.textContent = '{{ _('Test Schedule') }}'; };
			x.send(JSON.stringify(data));
		});
		sr.appendChild(sb);
		contentBody.appendChild(sr);
	}

	renderScheduledContent();
	pane.innerHTML = '';
	pane.appendChild(card);
}

	/* pre-load scheduled card */
	PB_onReady(function trySch() {
		var p = document.getElementById('pushbot_pane_scheduled');
		if (!p) { setTimeout(trySch, 300); return; }
		try{initScheduledPushCard();}catch(e){console.error('scheduled card:',e);}
	});

	window.addEventListener('load', initCard);
	window.addEventListener('load', initPushModeCard);
	window.addEventListener('load', initTerminalCard);
	window.addEventListener('load', initDisturbCard);
	window.addEventListener('load', initModernTabs);
	setTimeout(function(){try{initCard();}catch(e){console.error('initCard:',e);}}, 200);
	setTimeout(function(){try{initPushModeCard();}catch(e){console.error('initPushModeCard:',e);}}, 200);
	setTimeout(function(){try{initTerminalCard();}catch(e){console.error('initTerminalCard:',e);}}, 250);
	setTimeout(function(){try{initDisturbCard();}catch(e){console.error('initDisturbCard:',e);}}, 300);
	setTimeout(function(){try{initModernTabs();}catch(e){console.error('initModernTabs:',e);}}, 350);
	/* also try direct call if DOM ready, but guard against errors */
	if (document.readyState !== 'loading') {
		try { initCard(); } catch(e) {}
	}
	/* expose for initModernTabs (outside IIFE) */
	window.initContentCard = initContentCard;
})();





/* ═══════════════════════════════════════════ */
/* Tab: Advanced Settings */
/* ═══════════════════════════════════════════ */
function initMonitorCard() {
	if (document.getElementById('pushbot_monitor_card_container')) return;
	if (!PB_CONFIG) { setTimeout(initMonitorCard, 200); return; }
	var pane = document.getElementById('pushbot_pane_monitor');
	if (!pane) { setTimeout(initMonitorCard, 150); return; }

	var hb = document.getElementById('mon_hidden_fields') || (function(){
		var d=document.createElement('div'); d.id='mon_hidden_fields'; d.style.display='none';
		(document.querySelector('form')||document.body||document.documentElement).appendChild(d); return d;
	})();
	hb.innerHTML = '';

	function mkHidden(name, val) {
		var i = document.createElement('input'); i.type = 'hidden';
		i.name = 'cbid.pushbot.pushbot.' + name; i.value = val;
		hb.appendChild(i); return i;
	}
	function mkText(name, label, val, desc) {
		var w = document.createElement('div'); w.className = 'pushbot-inline-field'; w.style.cssText = 'margin:4px 0';
		var t = document.createElement('div'); t.className = 'pushbot-inline-title';
		t.style.cssText = 'margin:0 0 4px 2px;text-transform:none;font-size:13px;font-weight:600;color:inherit';
		t.textContent = label; w.appendChild(t);
		var b = document.createElement('div'); b.className = 'pushbot-inline-body';
		var inp = document.createElement('input'); inp.type = 'text'; inp.className = 'cbi-input-text';
		inp.value = val;
		inp.style.cssText = 'width:100%;padding:7px 10px;border-radius:8px;border:1px solid rgba(148,163,184,0.3);font-size:13px;box-sizing:border-box;background:var(--pb-input-bg);color:inherit';
		var hi = mkHidden(name, val);
		inp.addEventListener('change', function() { hi.value = this.value; });
		b.appendChild(inp);
		if (desc) { var d = document.createElement('div'); d.className = 'pushbot-inline-description'; d.innerHTML = desc; b.appendChild(d); }
		w.appendChild(b); return w;
	}
	function mkToggle(label, isOn, onToggle) {
		var b = document.createElement('button'); b.type = 'button';
		b.className = 'pushbot-choice-button ' + (isOn ? 'is-on' : 'is-off');
		b.innerHTML = '<span>' + label + '</span>';
		b.addEventListener('click', function(e) {
			e.preventDefault();
			var newOn = !isOn; isOn = newOn;
			b.className = 'pushbot-choice-button ' + (newOn ? 'is-on' : 'is-off');
			if (onToggle) onToggle(newOn);
		});
		return b;
	}
	function mkChoiceList(opts, curVal, onChange) {
		var c = document.createElement('div'); c.className = 'pushbot-choice-list';
		var btns = [];
		opts.forEach(function(o) {
			var b = document.createElement('button'); b.type = 'button'; b.className = 'pushbot-choice-button';
			b.textContent = o.l; b.setAttribute('data-v', o.v);
			if (o.v === curVal) b.className += ' is-on';
			b.addEventListener('click', function(e) {
				e.preventDefault(); curVal = o.v;
				btns.forEach(function(b2) { b2.className = 'pushbot-choice-button' + (b2.getAttribute('data-v') === curVal ? ' is-on' : ''); });
				if (onChange) onChange(curVal);
			});
			btns.push(b); c.appendChild(b);
		});
		return c;
	}

	var ADV_UP_TIMEOUT = PB_val('up_timeout', '2');
	var ADV_DOWN_TIMEOUT = PB_val('down_timeout', '20');
	var ADV_TIMEOUT_RETRY = PB_val('timeout_retry_count', '2');
	var ADV_THREAD_NUM = PB_val('thread_num', '3');
	var ADV_SOC_CODE = PB_val('soc_code', '');
	var ADV_PVE_HOST = PB_val('pve_host', '10.0.0.2');
	var ADV_PVE_PORT = PB_val('pve_port', '22');
	var ADV_PUBLIC_RETRY = PB_val('public_ip_retry_count', '10');
	var container = document.createElement('div'); container.id = 'pushbot_monitor_card_container';

	/* CARD 1: Device Monitor */
	var c1 = document.createElement('div'); c1.className = 'pushbot-mode-card';
	c1.innerHTML = '<div class="pushbot-card-top"><span class="pushbot-card-title">{{ _('Device Monitor') }}</span></div>';
	var b1 = document.createElement('div'); b1.style.cssText = 'margin-top:6px';
	var r1 = document.createElement('div'); r1.style.cssText = 'display:flex;gap:12px';
	[['up_timeout', '{{ _('Device online timeout (s)') }}', ADV_UP_TIMEOUT, null],
	 ['thread_num', '{{ _('Max concurrent processes') }}', ADV_THREAD_NUM, null],
	 ['down_timeout', '{{ _('Device offline timeout (s)') }}', ADV_DOWN_TIMEOUT, null],
	 	 ['timeout_retry_count', '{{ _('Offline detection count') }}', ADV_TIMEOUT_RETRY, '{{ _('No second-level router, good signal strength: you can reduce the above values') }}']].forEach(function(f) {
		var cc = document.createElement('div'); cc.style.cssText = 'flex:1;min-width:0';
		cc.appendChild(mkText(f[0], f[1], f[2], f[3]));
		r1.appendChild(cc);
	});
	b1.appendChild(r1); c1.appendChild(b1); container.appendChild(c1);

	/* CARD 2: Temperature Monitor */
	var c2 = document.createElement('div'); c2.className = 'pushbot-mode-card';
	c2.innerHTML = '<div class="pushbot-card-top"><span class="pushbot-card-title">{{ _('Temperature Monitor') }}</span></div>';
	var b2 = document.createElement('div'); b2.style.cssText = 'margin-top:6px';

	var socCur = ADV_SOC_CODE, socPVE = (socCur === 'pve'), socCust = (socCur !== '' && socCur !== 'pve');
	var socHi = mkHidden('soc_code', socCur);

	var sf = document.createElement('div'); sf.className = 'pushbot-inline-field'; sf.style.cssText = 'margin:4px 0';
	var st = document.createElement('div'); st.className = 'pushbot-inline-title';
	st.style.cssText = 'margin:0 0 4px 2px;text-transform:none;font-size:13px;font-weight:600;color:inherit';
	st.textContent = '{{ _('Custom temperature command') }}'; sf.appendChild(st);
	var sb = document.createElement('div'); sb.className = 'pushbot-inline-body';
	var ss = document.createElement('select'); ss.className = 'cbi-input-select';
	ss.style.cssText = 'width:100%;padding:6px 10px;border-radius:8px;border:1px solid rgba(148,163,184,0.3);font-size:13px;background:var(--pb-input-bg);color:inherit';
	[{v:'',l:'{{ _('Default') }}'},{v:'pve',l:'{{ _('PVE VM') }}'},{v:'__custom__',l:'{{ _('Custom command') }}'}].forEach(function(o) {
		var op = document.createElement('option'); op.value = o.v; op.textContent = o.l;
		if (o.v === socCur || (socCust && o.v === '__custom__')) op.selected = true;
		ss.appendChild(op);
	});
	var ci = document.createElement('input'); ci.type='text'; ci.className='cbi-input-text';
	ci.placeholder = '{{ _('Enter custom temperature command') }}'; ci.value = socCust ? socCur : '';
	ci.style.cssText = 'width:100%;padding:7px 10px;border-radius:8px;border:1px solid rgba(148,163,184,0.3);font-size:13px;box-sizing:border-box;background:var(--pb-input-bg);color:inherit;margin-top:6px;display:'+(socCust?'block':'none');
	function syncSoc() {
		var v = ss.value==='__custom__' ? ci.value : ss.value;
		socHi.value = v; togPVE();
	}
	ss.addEventListener('change', function() {
		if (this.value==='__custom__') { ci.style.display='block'; ci.focus(); syncSoc(); }
		else { ci.style.display='none'; ci.value=''; syncSoc(); }
	});
	ci.addEventListener('change', syncSoc);
	var socDesc = '{{ _('Avoid special characters such as double quotes, $, ! etc. The result must be a number for temperature comparison') }}';
	var sd = document.createElement('div'); sd.className='pushbot-inline-description'; sd.innerHTML=socDesc; sb.appendChild(sd);
	sb.appendChild(ss); sb.appendChild(ci); sf.appendChild(sb); b2.appendChild(sf);

	/* PVE fields */
	var pveDescHost = '{{ _('Make sure SSH key login is configured, otherwise the script may fail to run!<br/>Install the sensors command on PVE yourself<br/>SSH key login example:<br/>opkg update #update package list<br/>opkg install openssh-client openssh-keygen #install openssh client<br/>ssh-keygen -t rsa #generate a key pair (set a password etc.)<br/>ssh root@10.0.0.2 "tee -a ~/.ssh/id_rsa.pub" < ~/.ssh/id_rsa.pub #transfer the public key to PVE<br/>ssh -i ~/.ssh/id_rsa root@10.0.0.2 sensors #test the temperature command') }}';
	var pveDescPort = '{{ _('Default is 22; enter a custom SSH port if changed') }}';
	var pc = document.createElement('div'); pc.id='mon_pve_fields'; pc.style.cssText='margin-top:6px';
	var pvg = document.createElement('div'); pvg.style.cssText='display:flex;gap:12px';
	pvg.appendChild(mkText('pve_host', '{{ _('Host address') }}', ADV_PVE_HOST, pveDescHost));
	pvg.appendChild(mkText('pve_port', '{{ _('SSH port') }}', ADV_PVE_PORT, pveDescPort));
	pc.appendChild(pvg); b2.appendChild(pc);
	function togPVE() { pc.style.display = ((socHi && socHi.value) === 'pve') ? 'block' : 'none'; }
	togPVE();

	/* Test button */
	var tr = document.createElement('div'); tr.style.cssText='display:flex;align-items:center;gap:12px;margin-top:10px';
	var tb = document.createElement('a'); tb.className='cbi-button cbi-input-apply';
	tb.href='{{ dispatcher.build_url('admin', 'services', 'pushbot', 'soc_test') }}'; tb.textContent='{{ _('Test temperature') }}';
	tb.style.cssText='white-space:nowrap;padding:6px 16px;text-decoration:none';
	tr.appendChild(tb);
	var rl = document.createElement('span'); rl.style.cssText='font-size:13px;font-weight:600'; rl.textContent='{{ _('Temperature result:') }}';
	tr.appendChild(rl);
	var ro = document.createElement('span'); ro.style.cssText='padding:4px 10px;background:rgba(148,163,184,0.08);border-radius:6px;font-family:Menlo,Consolas,monospace;font-size:12px';
	ro.textContent = '{{ _('Loading...') }}';
	(function(){
		var x = new XMLHttpRequest();
		x.open('GET', '{{ dispatcher.build_url('admin', 'services', 'pushbot', 'soc_result') }}?_=' + Date.now(), true);
		x.onload = function() { ro.textContent = x.responseText || '{{ _('No output') }}'; };
		x.onerror = function() { ro.textContent = '{{ _('No output') }}'; };
		x.send();
	})();
	tr.appendChild(ro);
	b2.appendChild(tr);
	c2.appendChild(b2); container.appendChild(c2);

	/* CARD 2.5: Color Settings */
	(function(){
		var FONT_KEYS = ['font_title','font_success','font_fail','font_client','font_module'];
		var FONT_DEFAULTS = {font_title:'#6A65FF', font_success:'#92D050', font_fail:'#FF6666', font_client:'#92D050', font_module:'#76CCFF'};
		var FONT_LABELS = {font_title:'{{ _('Title color') }}', font_success:'{{ _('Success message color') }}', font_fail:'{{ _('Failure message color') }}', font_client:'{{ _('Client name color') }}', font_module:'{{ _('Module title color') }}'};
		var card = document.createElement('div'); card.className = 'pushbot-mode-card';
		card.innerHTML = '<div class="pushbot-card-top"><span class="pushbot-card-title">{{ _('Color Settings') }}</span></div>';
		var body = document.createElement('div'); body.style.cssText = 'margin-top:6px';
		var row = document.createElement('div'); row.style.cssText = 'display:flex;gap:12px;flex-wrap:wrap';
		var left = document.createElement('div'); left.style.cssText = 'flex:4;min-width:220px';
		var mid = document.createElement('div'); mid.style.cssText = 'flex:3;min-width:280px;display:flex;flex-direction:column';
		var right = document.createElement('div'); right.style.cssText = 'flex:3;min-width:280px;display:flex;flex-direction:column';
		var inputs = {};

		function normColor(v) { v = String(v || '').trim(); return /^#[0-9a-fA-F]{6}$/.test(v) ? v.toUpperCase() : ''; }
		function curColors() {
			var c = {};
			FONT_KEYS.forEach(function(k) {
				var v = normColor(inputs[k] ? inputs[k].value : '');
				c[k] = v || FONT_DEFAULTS[k];
			});
			return c;
		}

		FONT_KEYS.forEach(function(k) {
			var cur = PB_val(k) || '';
			if (cur && !normColor(cur)) cur = '';   // normalize legacy invalid values on load
			var w = mkText(k, FONT_LABELS[k], cur, '{{ _('Enter a #RRGGBB hex color code, leave empty to use the default') }} ' + FONT_DEFAULTS[k]);
			var inp = w.querySelector('input[type=text]');
			inputs[k] = inp;
			if (!cur) { inp.value = ''; inp.placeholder = FONT_DEFAULTS[k]; }
			inp.addEventListener('input', refreshPreviews);
			inp.addEventListener('change', function() {
				var v = normColor(this.value);
				var hi = document.querySelector('[name="cbid.pushbot.pushbot.' + k + '"]');
				if (this.value.trim() !== '' && !v) {
					// invalid color values are not saved: clear input and fall back to defaults
					this.value = '';
					if (hi) hi.value = '';
				} else if (v) {
					// normalize valid values (trim, uppercase) before saving for consistency
					this.value = v;
					if (hi) hi.value = v;
				}
				refreshPreviews();
			});
			left.appendChild(w);
		});
		var tip = document.createElement('div'); tip.className = 'pushbot-inline-description';
		tip.innerHTML = '{{ _('Push message fields: title (purple), success (device connected/login, green), failure (disconnected/login failed, red), client name (green), module title (system status/device temp/WAN info/online devices, light blue). Title color only applies when the push template references ${font_title}; invalid colors are ignored and fall back to defaults.') }}';
		left.appendChild(tip);

		function previewBox(title) {
			var box = document.createElement('div');
			box.style.cssText = 'flex:1;display:flex;flex-direction:column;min-width:0';
			var t = document.createElement('div'); t.className = 'pushbot-inline-title';
			t.style.cssText = 'margin:0 0 6px 2px;text-transform:none;font-size:13px;font-weight:600;color:inherit';
			t.textContent = title;
			var pre = document.createElement('div');
			pre.className = 'pushbot-preview-box';
			pre.style.cssText = 'flex:1;border-radius:8px;padding:10px 12px;font-family:Menlo,Consolas,monospace;font-size:12px;line-height:1.7;white-space:pre-wrap;word-break:break-all;overflow:auto';
			box.appendChild(t); box.appendChild(pre);
			return {box: box, pre: pre};
		}
		var im = previewBox('{{ _('Instant notification preview (example, updates with colors)') }}');
		var sch = previewBox('{{ _('Scheduled push preview (example, updates with colors)') }}');

		// monospace display width (CJK = 2 cells) with right-padding alignment
		function dispW(s) { var w = 0; for (var i = 0; i < s.length; i++) w += s.charCodeAt(i) > 255 ? 2 : 1; return w; }
		function padR(s, n) { s = String(s); return s + ' '.repeat(Math.max(0, n - dispW(s))); }

		function renderImmediate(c) {
			var L = [];
			L.push('<span style="color:' + c.font_title + ';font-weight:bold;font-size:14px">{{ _('[Zed-OP] Device status changed') }}</span>');
			L.push('2026-09-28 17:17:17');
			L.push('<div class="pushbot-preview-divider"></div>');
			L.push('<span style="color:' + c.font_success + ';font-weight:bold">{{ _('New device connected') }}</span>');
			L.push('{{ _('Client name: Zed-PC') }}');
			L.push('{{ _('Client IP: 192.168.1.2') }}');
			L.push('{{ _('Client MAC: a1:b2:c3:d4:e5:f6') }}');
			L.push('{{ _('Network interface: br-lan') }}');
			L.push('<div class="pushbot-preview-divider"></div>');
			L.push('{{ _('Client name: Zed-Mi17PM') }}');
			L.push('{{ _('Client IP: 192.168.1.7') }}');
			L.push('{{ _('Client MAC: f1:e2:d3:c4:b5:a6') }}');
			L.push('{{ _('Network interface: br-lan') }}');
			L.push('<div class="pushbot-preview-divider"></div>');
			L.push('<span style="color:' + c.font_fail + ';font-weight:bold">{{ _('Device disconnected') }}</span>');
			L.push('{{ _('Client name: Zed-iPhone17PM') }}');
			L.push('{{ _('Client IP: 192.168.1.5') }}');
			L.push('{{ _('Client MAC: a6:b5:c4:d3:e2:f1') }}');
			L.push('{{ _('Network interface: br-lan') }}');
			L.push('<div class="pushbot-preview-divider"></div>');
			L.push('<span style="color:' + c.font_module + ';font-weight:bold">{{ _('3 devices online:') }}</span>');
			L.push(padR('{{ _('IP address') }}', 28) + '{{ _('Client name') }}');
			L.push(padR('192.168.1.2', 16) + padR('928bytes', 12) + 'Zed-PC');
			L.push(padR('192.168.1.7', 16) + padR('9.28G', 12) + 'Zed-Mi17PM');
			L.push(padR('192.168.1.9', 16) + padR('9.28M', 12) + 'Zed-MacBook');
			L.push('<div class="pushbot-preview-divider"></div>');
			L.push('<span style="color:' + c.font_success + ';font-weight:bold">{{ _('Login source') }}</span>');
			L.push('{{ _('Time:            09:28:00') }}');
			L.push('{{ _('Device IP:        192.168.1.28') }}');
			L.push('{{ _('Login method:    Pubkey') }}');
			L.push('<span style="color:' + c.font_title + '">{{ _('[Zed-OP] Device status changed') }}</span>');
			return L.join('\n');
		}
		function renderScheduled(c) {
			var L = [];
			L.push('<span style="color:' + c.font_title + ';font-weight:bold;font-size:14px">{{ _('[Zed-OP] Test-OpenWRT status:') }}</span>');
			L.push('2026-09-28 17:17:17');
			L.push('<div class="pushbot-preview-divider"></div>');
			L.push('<span style="color:' + c.font_module + ';font-weight:bold">{{ _('System status') }}</span>');
			L.push('{{ _('Average load: 0.09 0.28 0.16') }}');
			L.push('{{ _('CPU usage: 92.8%') }}');
			L.push('{{ _('Memory usage: 9.28%') }}');
			L.push('{{ _('Uptime: 1d 9h 28m 0s') }}');
			L.push('<div class="pushbot-preview-divider"></div>');
			L.push('<span style="color:' + c.font_fail + ';font-weight:bold">{{ _('Device temperature') }}</span>');
			L.push('{{ _('Unable to obtain device temperature') }}');
			L.push('<div class="pushbot-preview-divider"></div>');
			L.push('<span style="color:' + c.font_module + ';font-weight:bold">{{ _('3 devices online') }}</span>');
			L.push('<span style="color:' + c.font_client + '">' + padR('【Zed-PC】', 20) + '</span>192.168.1.2');
			L.push('{{ _('Total traffic:') }} ' + padR('928bytes', 12) + '{{ _('online 9d 28h') }}');
			L.push('<span style="color:' + c.font_client + '">' + padR('【Zed-iPhone17PM】', 20) + '</span>192.168.1.5');
			L.push('{{ _('Total traffic:') }} ' + padR('9.28M', 12) + '{{ _('online 1d 9h') }}');
			L.push('<span style="color:' + c.font_client + '">' + padR('【Zed-Mi17PM】', 20) + '</span>192.168.1.7');
			L.push('{{ _('Total traffic:') }} ' + padR('9.28G', 12) + '{{ _('online 92d 8h') }}');
			L.push('<span style="color:' + c.font_title + '">{{ _('[Zed-OP] Test-OpenWRT status:') }}</span>');
			return L.join('\n');
		}
		function refreshPreviews() {
			var c = curColors();
			im.pre.innerHTML = renderImmediate(c);
			sch.pre.innerHTML = renderScheduled(c);
		}

		row.appendChild(left); row.appendChild(mid); row.appendChild(right);
		body.appendChild(row);

		/* bottom-left: test color button (same action as Test Schedule) */
		var foot = document.createElement('div');
		foot.style.cssText = 'display:flex;justify-content:flex-start;margin-top:14px';
		var tb = document.createElement('button');
		tb.type = 'button'; tb.textContent = '{{ _('Test Color') }}';
		tb.className = 'pushbot-sendtest-btn';
		tb.addEventListener('click', function(e) {
			e.preventDefault(); tb.disabled = true; tb.textContent = '{{ _('Sending...') }}';
			var data = window.__pbCollectData ? __pbCollectData() : {};
			var x = new XMLHttpRequest();
			x.open('POST', '{{ dispatcher.build_url('admin', 'services', 'pushbot', 'save_config') }}', true);
			x.setRequestHeader('Content-Type', 'application/json');
			x.onload = function() {
				var y = new XMLHttpRequest();
				y.open('GET', '{{ dispatcher.build_url('admin', 'services', 'pushbot', 'send_manual') }}', true);
				y.onload = function() { tb.disabled = false; tb.textContent = '{{ _('Test Color') }}'; };
				y.onerror = function() { tb.disabled = false; tb.textContent = '{{ _('Test Color') }}'; };
				y.send();
			};
			x.onerror = function() { tb.disabled = false; tb.textContent = '{{ _('Test Color') }}'; };
			x.send(JSON.stringify(data));
		});
		foot.appendChild(tb);
		body.appendChild(foot);

		card.appendChild(body);
		mid.appendChild(im.box); right.appendChild(sch.box);
		container.appendChild(card);
		refreshPreviews();
	})();

	/* CARD 3: Unattended */
	var c3 = document.createElement('div'); c3.className = 'pushbot-mode-card';

	/* Use hidden input for err_enable Flag form submission */
	var errHi = document.querySelector('[name="cbid.pushbot.pushbot.err_enable"]');
	var errOn = PB_bool('err_enable');
	var errDesc = '{{ _('Make sure the script runs normally, otherwise it may cause frequent reboots!') }}';
	var errToggle = mkToggle('{{ _('Unattended task') }}', errOn, function(on) {
		updateFlagInput('err_enable', on);
		var ec = document.getElementById('mon_err_content');
		if (ec) ec.style.display = on ? 'block' : 'none';
	});
	c3.appendChild(errToggle);
	var dDesc = document.createElement('div'); dDesc.className = 'pushbot-inline-description'; dDesc.innerHTML = errDesc;
	c3.appendChild(dDesc);

	var ec = document.createElement('div'); ec.id = 'mon_err_content'; ec.style.cssText = 'margin-top:10px';
	ec.style.display = errOn ? 'block' : 'none';
	c3.appendChild(ec);

	/* err_sheep_enable */
	(function(){
		var d = document.createElement('div'); d.className = 'pushbot-inline-description';
		d.innerHTML = '{{ _('Avoid redialing during the day when the DDNS domain waits for resolution; this does not affect outage detection<br/>May be unstable due to night traffic') }}';
		ec.appendChild(d);
		/* use hidden input for err_sheep_enable */
		var shHi = document.querySelector('[name="cbid.pushbot.pushbot.err_sheep_enable"]');
		var shOn = PB_bool('err_sheep_enable');
		var shTog = mkToggle('{{ _('Redial only during DND hours') }}', shOn, function(on) {
			updateFlagInput('err_sheep_enable', on);
		});
		ec.appendChild(shTog);
	})();
	ec.appendChild(document.createElement('hr')).style.cssText = 'border:none;border-top:1px solid rgba(148,163,184,0.2);margin:10px 0';

	/* network_err_event */
	(function(){
		var nl = document.createElement('div'); nl.className = 'pushbot-inline-title';
		nl.style.cssText = 'margin:0 0 4px 2px;text-transform:none;font-size:13px;font-weight:600;color:inherit';
		nl.textContent = '{{ _('Network Down Action') }}'; ec.appendChild(nl);
		var ADV_NET_ERR = PB_val('network_err_event', '');
		var netHi = mkHidden('network_err_event', ADV_NET_ERR);
		var netL = [
			{v:'',l:'{{ _('No action') }}'},
			{v:'1',l:'{{ _('Reboot router') }}'},
			{v:'2',l:'{{ _('Redial') }}'},
			{v:'3',l:'{{ _('Modify settings and try to auto-repair the network') }}'}
		];
		ec.appendChild(mkChoiceList(netL, ADV_NET_ERR, function(v) { netHi.value = v; }));
		var netDesc = '{{ _('Options 1 and 2 do not modify settings and try at most 2 times.<br/>Option 3 backs up settings to /usr/bin/pushbot/configbak and restores them on failure.<br/>Compatibility is not guaranteed! Do not use if you are unfamiliar with system settings') }}';
		var nd = document.createElement('div'); nd.className = 'pushbot-inline-description'; nd.innerHTML = netDesc; ec.appendChild(nd);
	})();
	ec.appendChild(document.createElement('hr')).style.cssText = 'border:none;border-top:1px solid rgba(148,163,184,0.2);margin:10px 0';

	/* err_device_aliases */
	(function(){
		var dl = document.createElement('div'); dl.className = 'pushbot-inline-title';
		dl.style.cssText = 'margin:0 0 4px 2px;text-transform:none;font-size:13px;font-weight:600;color:inherit';
		dl.textContent = '{{ _('Watchlist') }}'; ec.appendChild(dl);
		var dc = document.createElement('div'); dc.style.cssText = 'margin:4px 0';
		var tl = document.createElement('div'); tl.style.cssText = 'display:flex;flex-wrap:wrap;gap:4px;margin-bottom:4px';
		var ir = document.createElement('div'); ir.style.cssText = 'display:flex;gap:4px';
		var inp = document.createElement('input'); inp.type='text'; inp.className='cbi-input-text';
		inp.placeholder = 'XX:XX:XX:XX:XX:XX';
		inp.style.cssText = 'flex:1;padding:7px 10px;border-radius:8px;border:1px solid rgba(148,163,184,0.3);font-size:13px;background:var(--pb-input-bg);color:inherit';
		/* datalist for MAC hints */
		var listId = 'mh_err_device';
		inp.setAttribute('list', listId);
		var dlist = document.createElement('datalist');
		dlist.id = listId;
		PB_sys('mac_hints').forEach(function(h) {
			var o = document.createElement('option');
			o.value = h.m;
			o.textContent = h.n ? h.m + ' (' + h.n + ')' : h.m;
			dlist.appendChild(o);
		});
		var addB = document.createElement('button'); addB.type='button'; addB.className='pushbot-choice-button is-on';
		addB.textContent = '{{ _('Add') }}';
		ir.appendChild(inp); ir.appendChild(dlist); ir.appendChild(addB);
		dc.appendChild(tl); dc.appendChild(ir); ec.appendChild(dc);

		var curVals = PB_list('err_device_aliases').slice();
		function renderTags(){
			tl.innerHTML='';
			curVals.forEach(function(v){if(!v)return;
				var t=document.createElement('span');
				t.style.cssText='display:inline-flex;align-items:center;gap:4px;padding:2px 8px;background:rgba(148,163,184,0.12);border-radius:4px;font-size:12px';
				t.textContent=v;
				var x=document.createElement('span');x.textContent='\u00d7';
				x.style.cssText='cursor:pointer;font-weight:bold;margin-left:2px;opacity:0.6';
				x.addEventListener('click',function(){var idx=curVals.indexOf(v);if(idx>=0){curVals.splice(idx,1);renderTags();syncH();}});
				t.appendChild(x);tl.appendChild(t);
			});
		}
		function syncH(){
			/* remove old hidden inputs */
			var ex=hb.querySelectorAll('input[name$=".err_device_aliases"]');
			ex.forEach(function(el){el.remove();});
			curVals.forEach(function(v){if(!v)return;
				var i2=document.createElement('input');i2.type='hidden';i2.name='cbid.pushbot.pushbot.err_device_aliases';i2.value=v;
				hb.appendChild(i2);
			});
		}
		function addTag(v){v=v.trim().toUpperCase();if(!v||curVals.indexOf(v)>=0)return;curVals.push(v);renderTags();syncH();}
		addB.addEventListener('click',function(){addTag(inp.value);inp.value='';inp.focus();});
		inp.addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();addTag(inp.value);inp.value='';}});
		renderTags();
		syncH();

		var devDesc = '{{ _('Only runs when all devices in the list are offline<br/>After DND hours, watched devices with low traffic for 5 minutes (~100kb/m) are considered offline') }}';
		var d2 = document.createElement('div'); d2.className = 'pushbot-inline-description'; d2.innerHTML = devDesc; ec.appendChild(d2);
	})();
	ec.appendChild(document.createElement('hr')).style.cssText = 'border:none;border-top:1px solid rgba(148,163,184,0.2);margin:10px 0';

	/* system_time_event */
	(function(){
		var sl = document.createElement('div'); sl.className = 'pushbot-inline-title';
		sl.style.cssText = 'margin:0 0 4px 2px;text-transform:none;font-size:13px;font-weight:600;color:inherit';
		sl.textContent = '{{ _('Scheduled Reboot') }}'; ec.appendChild(sl);
		var ADV_SYS_TIME = PB_val('system_time_event', '');
		var sysHi = mkHidden('system_time_event', ADV_SYS_TIME);
		var sysL = [{v:'',l:'{{ _('No action') }}'},{v:'1',l:'{{ _('Reboot router') }}'},{v:'2',l:'{{ _('Redial') }}'}];
		ec.appendChild(mkChoiceList(sysL, ADV_SYS_TIME, function(v) {
			sysHi.value = v;
			var rf=document.getElementById('mon_autoreboot');
			var nrf=document.getElementById('mon_netrestart');
			if(rf)rf.style.display=(v==='1')?'block':'none';
			if(nrf)nrf.style.display=(v==='2')?'block':'none';
		}));
		var stc = document.createElement('div'); stc.style.cssText = 'margin-top:6px';
		var ADV_AUTOREBOOT = PB_val('autoreboot_time', '24');
		var ADV_NETRESTART = PB_val('network_restart_time', '24');
		var ar = document.createElement('div'); ar.id = 'mon_autoreboot';
		ar.style.display = (ADV_SYS_TIME === '1') ? 'block' : 'none';
		ar.appendChild(mkText('autoreboot_time', '{{ _('System uptime greater than') }}', ADV_AUTOREBOOT, '{{ _('in hours') }}'));
		stc.appendChild(ar);
		var nr = document.createElement('div'); nr.id = 'mon_netrestart';
		nr.style.display = (ADV_SYS_TIME === '2') ? 'block' : 'none';
		nr.appendChild(mkText('network_restart_time', '{{ _('Network uptime greater than') }}', ADV_NETRESTART, '{{ _('in hours') }}'));
		stc.appendChild(nr);
		ec.appendChild(stc);
	})();
	ec.appendChild(document.createElement('hr')).style.cssText = 'border:none;border-top:1px solid rgba(148,163,184,0.2);margin:10px 0';

	/* public_ip_event */
	(function(){
		var pubDesc = '{{ _('No IP change notification is pushed on redial, and your domain may fail to update its IP in time<br/>Make sure you can obtain a public IP by redialing, otherwise this is futile and may cause frequent disconnects<br/>Do not struggle on large carrier-grade NAT networks!') }}';
		var pd = document.createElement('div'); pd.className = 'pushbot-inline-description'; pd.innerHTML = pubDesc; ec.appendChild(pd);
		/* use hidden input for public_ip_event */
		var pubHi = document.querySelector('[name="cbid.pushbot.pushbot.public_ip_event"]');
		var pubOn = PB_bool('public_ip_event');
		var pubRow = document.createElement('div'); pubRow.style.cssText = 'display:flex;align-items:center;gap:12px;margin-top:6px';
		var pubToggle = mkToggle('{{ _('Redial to obtain public IP') }}', pubOn, function(on) {
			updateFlagInput('public_ip_event', on);
			var prc = document.getElementById('mon_pubretry');
			if (prc) prc.style.display = on ? 'flex' : 'none';
		});
		pubRow.appendChild(pubToggle);
		var prc = document.createElement('div'); prc.id = 'mon_pubretry';
		prc.style.cssText = 'display:'+(pubOn?'flex':'none')+';align-items:center;gap:12px;flex:1';
		prc.appendChild(mkText('public_ip_retry_count', '{{ _('Max retries per day') }}', PB_val('public_ip_retry_count', '10')));
		pubRow.appendChild(prc);
		ec.appendChild(pubRow);
	})();

	container.appendChild(c3);
	pane.innerHTML = '';
	pane.appendChild(container);
	}

/* pre-load monitor card content (1 retry if pane not ready) */
function tryMonOnce(){
	var p = document.getElementById('pushbot_pane_monitor');
	if (!p) { setTimeout(tryMonOnce, 300); return; }
	try{initMonitorCard();}catch(e){console.error('monitor card:',e);}
}
PB_onReady(function(){ tryMonOnce(); });


/* ═══════════════════════════════════════════ */
/* Tab Navigation System */
function initModernTabs() {
	if (document.getElementById('pushbot_modern_tabs')) return;

	var headerCard = document.querySelector('.pushbot-header-card');
	if (!headerCard || !headerCard.parentNode) return;

	/* wait for cards to exist before building tabs */
	if (!document.getElementById('pushbot_mode_card') || !document.getElementById('pushbot_pushmode_card')) {
		setTimeout(initModernTabs, 100);
		return;
	}

	/* build tab bar */
	var tabBar = document.createElement('div');
	tabBar.id = 'pushbot_modern_tabs';
	tabBar.className = 'pushbot-tab-bar';
	tabBar.innerHTML =
		'<button type="button" class="pushbot-tab is-active" data-tab="basic" title="{{ _('Basic Settings') }}"><span class="pb-txt"><span>{{ _('Basic') }}</span><span>{{ _('Settings') }}</span></span></button>' +
		'<button type="button" class="pushbot-tab" data-tab="content" title="{{ _('Push Content') }}"><span class="pb-txt"><span>{{ _('Push') }}</span><span>{{ _('Content') }}</span></span></button>' +
		'<button type="button" class="pushbot-tab" data-tab="scheduled" title="{{ _('Scheduled Push') }}"><span class="pb-txt"><span>{{ _('Scheduled') }}</span><span>{{ _('Push') }}</span></span></button>' +
		'<button type="button" class="pushbot-tab" data-tab="monitor" title="{{ _('Advanced Settings') }}"><span class="pb-txt"><span>{{ _('Advanced') }}</span><span>{{ _('Settings') }}</span></span></button>' +
		'<button type="button" class="pushbot-tab" data-tab="client" title="{{ _('Online Devices') }}"><span class="pb-txt"><span>{{ _('Online') }}</span><span>{{ _('Devices') }}</span></span></button>' +
		'<button type="button" class="pushbot-tab" data-tab="log" title="{{ _('Log') }}"><span class="pb-txt"><span>{{ _('Log') }}</span></span></button>';

	headerCard.parentNode.insertBefore(tabBar, headerCard.nextSibling);

	/* content containers after tab bar */
	var basicPane = document.createElement('div');
	basicPane.id = 'pushbot_pane_basic';
	basicPane.className = 'pushbot-tab-pane is-visible';

	var contentPane = document.createElement('div');
	contentPane.id = 'pushbot_pane_content';
	contentPane.className = 'pushbot-tab-pane';
	contentPane.innerHTML = '<div class="pushbot-mode-card" style="padding:32px;text-align:center;color:#94a3b8;font-size:14px">{{ _('Loading...') }}</div>';

	var scheduledPane = document.createElement('div');
	scheduledPane.id = 'pushbot_pane_scheduled';
	scheduledPane.className = 'pushbot-tab-pane';
	scheduledPane.innerHTML = '<div class="pushbot-mode-card" style="padding:32px;text-align:center;color:#94a3b8;font-size:14px">{{ _('Loading...') }}</div>';

	var monitorPane = document.createElement('div');
	monitorPane.id = 'pushbot_pane_monitor';
	monitorPane.className = 'pushbot-tab-pane';
	monitorPane.innerHTML = '<div class="pushbot-mode-card" style="padding:32px;text-align:center;color:#94a3b8;font-size:14px">{{ _('Loading...') }}</div>';

	var clientPane = document.createElement('div');
	clientPane.id = 'pushbot_pane_client';
	clientPane.className = 'pushbot-tab-pane';
	clientPane.innerHTML = '<div class="pushbot-mode-card" style="padding:0;overflow:hidden"><div class="pushbot-log-container"><div class="pushbot-log-header"><div class="pushbot-log-controls"><label class="pushbot-log-switch" id="client_auto_switch"><span class="pushbot-log-switch-text">{{ _('Auto refresh') }}</span><input type="checkbox" id="client_auto_toggle" checked><span class="pushbot-log-switch-track"></span></label><span id="client_traffic_src" style="display:none"></span><button class="pushbot-log-btn" id="client_refresh_btn" style="margin-left:auto">{{ _('Refresh') }}</button></div></div><div class="pushbot-log-content" id="pushbot_client_content"><p style="padding:12px;margin:0;color:#94a3b8;text-align:center">{{ _('Loading...') }}</p></div></div></div>';

	var logPane = document.createElement('div');
	logPane.id = 'pushbot_pane_log';
	logPane.className = 'pushbot-tab-pane';
	logPane.innerHTML = [
		'<div class="pushbot-mode-card" style="padding:0;overflow:hidden">',
			'<div class="pushbot-log-container">',
				'<div class="pushbot-log-header">',
					'<div class="pushbot-log-controls">',
						'<label class="pushbot-log-switch" id="log_auto_switch">',
							'<span class="pushbot-log-switch-text">{{ _('Auto refresh') }}</span>',
							'<input type="checkbox" id="log_auto_toggle" checked>',
							'<span class="pushbot-log-switch-track"></span>',
						'</label>',
						'<button class="pushbot-log-btn" id="log_clear_btn">{{ _('Clear log') }}</button>',
					'</div>',
				'</div>',
				'<div class="pushbot-log-content" id="pushbot_log_content"><pre style="margin:0;padding:12px;font-family:Menlo,Consolas,monospace;font-size:12px;line-height:1.6;white-space:pre-wrap;word-break:break-all">{{ _('Loading...') }}</pre></div>',
			'</div>',
		'</div>'
	].join('');

	tabBar.parentNode.insertBefore(basicPane, tabBar.nextSibling);
	tabBar.parentNode.insertBefore(contentPane, basicPane.nextSibling);
	tabBar.parentNode.insertBefore(scheduledPane, contentPane.nextSibling);
	tabBar.parentNode.insertBefore(monitorPane, scheduledPane.nextSibling);
	tabBar.parentNode.insertBefore(clientPane, monitorPane.nextSibling);
	tabBar.parentNode.insertBefore(logPane, clientPane.nextSibling);

	/* move cards (Run Control + Push Mode + Terminal Info) into basic pane */
	var runCard = document.getElementById('pushbot_mode_card');
	var pushCard = document.getElementById('pushbot_pushmode_card');
	var termCard = document.getElementById('pushbot_terminal_card');
	var distCard = document.getElementById('pushbot_disturb_card');
	if (runCard) basicPane.appendChild(runCard);
	if (pushCard) basicPane.appendChild(pushCard);
	if (termCard) basicPane.appendChild(termCard);
	if (distCard) basicPane.appendChild(distCard);

	/* hide old LuCI tabs, switch to the custom tab bar */
	var oldTabMenu = document.querySelector('.cbi-tabmenu');
	if (oldTabMenu) {
		var links = oldTabMenu.querySelectorAll('a');
		links.forEach(function(a) {
			if (a.textContent.indexOf('{{ _('Basic settings') }}') >= 0 || a.textContent.indexOf('{{ _('Log') }}') >= 0 || a.textContent.indexOf('{{ _('DND') }}') >= 0 || a.textContent.indexOf('{{ _('Online devices') }}') >= 0 || a.textContent.indexOf('{{ _('Scheduled Push') }}') >= 0 || a.textContent.indexOf('{{ _('Advanced settings') }}') >= 0 || a.textContent.indexOf('{{ _('Push content') }}') >= 0) {
				var li = a.parentNode;
				if (li) li.style.display = 'none';
			}
		});
		/* hide the entire old tab container (menu + all tab content) */
		var tabParent = oldTabMenu.parentNode;
		if (tabParent) {
			tabParent.style.display = 'none';
			/* Ensure all form elements inside remain enabled for submission */
			tabParent.querySelectorAll('input, select, textarea').forEach(function(el) {
				el.disabled = false;
			});
		}
	}

	/* tab switching — old tabs remain visible below */
	var tabs = tabBar.querySelectorAll('.pushbot-tab');
	tabs.forEach(function(tab) {
		tab.addEventListener('click', function(e) {
			e.preventDefault();
			var name = tab.getAttribute('data-tab');
			tabs.forEach(function(t) { t.classList.remove('is-active'); });
			tab.classList.add('is-active');
		document.getElementById('pushbot_pane_basic').classList.toggle('is-visible', name === 'basic');
		document.getElementById('pushbot_pane_content').classList.toggle('is-visible', name === 'content');
		document.getElementById('pushbot_pane_scheduled').classList.toggle('is-visible', name === 'scheduled');
		document.getElementById('pushbot_pane_monitor').classList.toggle('is-visible', name === 'monitor');
		document.getElementById('pushbot_pane_client').classList.toggle('is-visible', name === 'client');
		document.getElementById('pushbot_pane_log').classList.toggle('is-visible', name === 'log');
		if (name === 'content') { try { initContentCard(); } catch(e) { console.error('content tab:',e); } }
		if (name === 'monitor') { try { initMonitorCard(); } catch(e) { console.error('monitor tab:',e); } }
		if (name === 'log') { _logInit(); }
		if (name === 'client') loadClients();
		});
	});

	/* tab 追踪滑块: 跟随 hover/选中项平滑滑动(liquid 同款) */
	var tabInd = document.createElement('span');
	tabInd.className = 'pushbot-tab-indicator';
	tabBar.appendChild(tabInd);
	function moveTabInd(el) {
		if (!el || !tabBar.contains(el)) { tabInd.style.opacity = '0'; return; }
		var r = el.getBoundingClientRect();
		var ur = tabBar.getBoundingClientRect();
		tabInd.style.width = r.width + 'px';
		tabInd.style.height = r.height + 'px';
		tabInd.style.transform = 'translate(' + (r.left - ur.left) + 'px, ' + (r.top - ur.top) + 'px)';
		tabInd.style.opacity = '1';
	}
	moveTabInd(tabBar.querySelector('.pushbot-tab.is-active'));
	tabBar.addEventListener('mouseover', function(e) {
		var t = e.target.closest ? e.target.closest('.pushbot-tab') : null;
		if (t && tabBar.contains(t)) moveTabInd(t);
	});
	tabBar.addEventListener('mouseleave', function() {
		moveTabInd(tabBar.querySelector('.pushbot-tab.is-active'));
	});

	/* ── responsive tab resize handler ── */
	function _updateTabLayout() {
		var bw = tabBar.clientWidth;
		if (bw < 540) { tabBar.classList.add('pb-tabs-row2'); } else { tabBar.classList.remove('pb-tabs-row2'); }
		if (bw < 360) { tabBar.classList.add('pb-tabs-narrow'); } else { tabBar.classList.remove('pb-tabs-narrow'); }
	}
	if (window.ResizeObserver) {
		var tabRO = new ResizeObserver(_updateTabLayout);
		tabRO.observe(tabBar);
	} else {
		window.addEventListener('resize', _updateTabLayout);
	}
	_updateTabLayout();

	/* ── log viewer ── */
	var logTimer = null;
	var _logInitialized = false;
	function _logInit() {
		if (_logInitialized) return;
		_logInitialized = true;
		var toggle = document.getElementById('log_auto_toggle');
		var clearBtn = document.getElementById('log_clear_btn');
		if (toggle) {
			toggle.addEventListener('change', function() {
				if (this.checked) {
					logTimer = setInterval(loadLog, 3000);
					loadLog();
				} else {
					if (logTimer) { clearInterval(logTimer); logTimer = null; }
				}
			});
			toggle.checked = true;
			logTimer = setInterval(loadLog, 3000);
			loadLog();
		}
		if (clearBtn) {
			clearBtn.addEventListener('click', function(e) {
				e.preventDefault();
				XHR.get('{{ dispatcher.build_url('admin', 'services', 'pushbot', 'clear_log') }}', null,
					function() {
						var pre = document.querySelector('#pushbot_log_content pre');
						if (pre) pre.textContent = '{{ _('(empty)') }}';
					}
				);
			});
		}
	}
	function loadLog() {
		var pre = document.querySelector('#pushbot_log_content pre');
		if (!pre) return;
		XHR.get('{{ dispatcher.build_url('admin', 'services', 'pushbot', 'get_log') }}', null,
			function(x) {
				if (x && x.status == 200) {
					var txt = x.responseText || '{{ _('(empty)') }}';
					var lines = txt.split('\n');
					if (lines.length > 2) {
						lines.pop();
						lines.reverse();
						txt = lines.join('\n');
					}
					pre.textContent = txt;
					pre.scrollTop = 0;
				}
			}
		);
	}

	/* client (online devices) viewer */
	var clientTimer = null;
	function timeForHumans(seconds) {
		if (seconds < 60) return seconds + '{{ _('sec') }}';
		if (seconds < 3600) return Math.floor(seconds / 60) + '{{ _('minute') }}' + (seconds % 60) + '{{ _('sec') }}';
		if (seconds < 86400) return Math.floor(seconds / 3600) + '{{ _('hour') }}' + Math.floor((seconds % 3600) / 60) + '{{ _('minute') }}';
		return Math.floor(seconds / 86400) + '{{ _('day') }}' + Math.floor((seconds % 86400) / 3600) + '{{ _('hour') }}';
	}
	/* ── Online devices ── */
	var _clientData = [];
	var _clientSortKey = 'uptime';
	var _clientSortAsc = false;
	var _clientTrafficSrc = 'wrtbw';
	function renderClientSrc() {
		var el = document.getElementById('client_traffic_src');
		if (!el) return;
		var isNlbw = _clientTrafficSrc === 'nlbw';
		var pillColor = isNlbw ? 'background:rgba(34,197,94,0.15);color:#16a34a;border:1px solid rgba(34,197,94,0.3)' : 'background:rgba(249,115,22,0.15);color:#ea580c;border:1px solid rgba(249,115,22,0.3)';
		el.style.display = '';
		el.innerHTML = '{{ _('Traffic source') }}: <span style="display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:600;white-space:nowrap;vertical-align:middle;margin-left:4px;' + pillColor + '">' + (isNlbw ? 'nlbwmon' : 'wrtbwmon') + '</span>';
	}
	function renderClientTable() {
		var container = document.getElementById('pushbot_client_content');
		if (!container) return;
		var data = _clientData;
		if (!data || !data.length) {
			container.innerHTML = '<p style="padding:12px;margin:0;color:#94a3b8;text-align:center">{{ _('No online devices') }}</p>';
			return;
		}
		var sorted = data.slice();
		/* 解析格式化流量字符串为字节数用于排序（"500.00 M" → 524288000） */
		function parseBytes(s) {
			if (typeof s === 'number') return s;
			s = String(s || '0');
			var m = s.match(/([\d.]+)\s*([KMG]?)/i);
			if (!m) return 0;
			var n = parseFloat(m[1]) || 0;
			var u = (m[2] || '').toUpperCase();
			if (u === 'K') return n * 1024;
			if (u === 'M') return n * 1048576;
			if (u === 'G') return n * 1073741824;
			return n;
		}
		sorted.sort(function(a, b) {
			var va = a[_clientSortKey], vb = b[_clientSortKey];
			if (_clientSortKey === 'usage') { va = parseBytes(va); vb = parseBytes(vb); }
			if (typeof va === 'number' && typeof vb === 'number') return _clientSortAsc ? va - vb : vb - va;
			va = String(va || ''); vb = String(vb || '');
			return _clientSortAsc ? va.localeCompare(vb) : vb.localeCompare(va);
		});
		/* 只在当前排序列显示方向箭头，其他列不显示 */
		function arrow(key) { return key === _clientSortKey ? (_clientSortAsc ? ' ↑' : ' ↓') : ''; }
		var html = '<div style="overflow-x:auto"><table class="pushbot-client-table"><thead><tr>' +
			'<th class="pushbot-sortable" data-key="hostname">{{ _('Hostname') }}' + arrow('hostname') + '</th>' +
			'<th class="pushbot-sortable" data-key="mac">{{ _('MAC address') }}' + arrow('mac') + '</th>' +
			'<th class="pushbot-sortable" data-key="ip">{{ _('IP address') }}' + arrow('ip') + '</th>' +
			'<th class="pushbot-sortable" data-key="usage">{{ _('Traffic') }}' + arrow('usage') + '</th>' +
			'<th class="pushbot-sortable" data-key="uptime">{{ _('Online time') }}' + arrow('uptime') + '</th>' +
			'</tr></thead><tbody>';
		sorted.forEach(function(c) {
			var h = c.hostname || '-';
			if (h.indexOf('?') === 0) h = h.substring(1);
			if (!h || h === '?') h = '-';
			html += '<tr><td>' + escHtml(h) + '</td><td class="pushbot-cell-mac">' + escHtml(c.mac) + '</td><td>' + escHtml(c.ip) + '</td><td>' + escHtml(c.usage) + '</td><td>' + timeForHumans(Math.max(0, c.uptime)) + '</td></tr>';
		});
		html += '</tbody></table></div>';
		container.innerHTML = html;
		container.querySelectorAll('.pushbot-sortable').forEach(function(th) {
			th.style.cssText = 'cursor:pointer;user-select:none';
			th.addEventListener('click', function() {
				var key = th.getAttribute('data-key');
				if (key === _clientSortKey) { _clientSortAsc = !_clientSortAsc; } else { _clientSortKey = key; _clientSortAsc = (key === 'usage' || key === 'uptime' || key === 'ip') ? false : true; }
				renderClientTable();
			});
		});
	}
	function loadClients() {
		var container = document.getElementById('pushbot_client_content');
		if (!container) return;
		XHR.get('{{ dispatcher.build_url('admin', 'services', 'pushbot', 'client_list') }}', null,
			function(x) {
				if (!x || x.status != 200) { container.innerHTML = '<p style="padding:12px;margin:0;color:#ef4444;text-align:center">{{ _('Load failed') }}</p>'; return; }
				try {
					var raw = JSON.parse(x.responseText);
					if (raw && raw.list) { _clientData = raw.list; _clientTrafficSrc = raw.src || 'wrtbw'; }
					else { _clientData = raw || []; _clientTrafficSrc = 'wrtbw'; }
				} catch(e) { _clientData = []; _clientTrafficSrc = 'wrtbw'; }
				renderClientSrc();
				renderClientTable();
			}
		);
	}
	function escHtml(s) {
		return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
	}
	/* auto-refresh */
	function startClientTimer() {
		if (clientTimer) clearInterval(clientTimer);
		clientTimer = setInterval(function() {
			var pane = document.getElementById('pushbot_pane_client');
			if (pane && pane.classList.contains('is-visible')) loadClients();
		}, 5000);
	}
	function stopClientTimer() {
		if (clientTimer) { clearInterval(clientTimer); clientTimer = null; }
	}
	startClientTimer();
	/* 刷新按钮事件 */
	var autoToggle = document.getElementById('client_auto_toggle');
	var refreshBtn = document.getElementById('client_refresh_btn');
	if (autoToggle) {
		autoToggle.addEventListener('change', function() {
			if (autoToggle.checked) { startClientTimer(); } else { stopClientTimer(); }
		});
	}
	if (refreshBtn) {
		refreshBtn.addEventListener('click', function() {
			refreshBtn.textContent = '{{ _('Loading...') }}';
			loadClients();
			setTimeout(function() { refreshBtn.textContent = '{{ _('Refresh') }}'; }, 1000);
		});
	}
}


/* ═══════════════════════════════════════════ */
/* Submit + Preview + Helpers */
/* ═══════════════════════════════════════════ */
/* ── Collect hidden input data from all containers ── */
window.__pbCollectData = function() {
	/* 收集前强制同步 textarea → hidden（防 input 事件缺失导致保存值丢失/null） */
	document.querySelectorAll('textarea').forEach(function(ta) {
		var hid = null;
		document.querySelectorAll('input[type="hidden"]').forEach(function(inp) {
			if (inp.name && inp.name.indexOf('ip_black_list') >= 0) hid = inp;
		});
		if (hid) hid.value = ta.value;
	});
	var ids = ['pushbot_hidden_fields','con_hidden_fields','mon_hidden_fields','term_hidden_fields','disturb_hidden_fields'];
	var data = {};
	ids.forEach(function(id) {
		var ct = document.getElementById(id);
		if (!ct) return;
		ct.querySelectorAll('input[type="hidden"]').forEach(function(inp) {
			if (!inp.name || inp.name.indexOf('.') < 0) return;
			var opt = inp.name.split('.').pop();
			if (opt.endsWith('[]')) opt = opt.slice(0, -2);
			if (!opt || inp.value === undefined || inp.value === null) return;
			if (data[opt] === undefined) {
				data[opt] = inp.value;
			} else if (typeof data[opt] === 'string') {
				data[opt] = [data[opt], inp.value];
			} else {
				data[opt].push(inp.value);
			}
		});
	});
	for (var k in data) {
		if (Array.isArray(data[k])) {
			var u = [];
			data[k].forEach(function(v) { if (u.indexOf(v) < 0) u.push(v); });
			data[k] = u.length === 1 ? u[0] : u;
		}
	}
	return data;
};
/* ── Toast notification ── */
var pbToast = null;
function pbShowToast(ok) {
	var old = document.querySelector('.pushbot-toast-overlay');
	if (old) old.remove();
	var o = document.createElement('div');
	o.className = 'pushbot-toast-overlay';
	var b = document.createElement('div');
	b.className = 'pushbot-toast-banner ' + (ok ? 'is-ok' : 'is-err');
	b.textContent = ok ? '{{ _('Saved') }}' : '{{ _('Save failed') }}';
	o.appendChild(b);
	document.body.appendChild(o);
	setTimeout(function() { o.classList.add('show'); }, 10);
	setTimeout(function() { o.classList.remove('show'); setTimeout(function() { o.remove(); }, 300); }, ok ? 500 : 1000);
}
/* ── Option labels for preview ── */
var PB_LABELS = {
	pushbot_enable:'{{ _('Enabled') }}', lite_enable:'{{ _('Compact Mode') }}', device_name:'{{ _('Device name') }}', sleeptime:'{{ _('Detection interval') }}',
	jsonpath:'{{ _('Push Mode') }}', dd_webhook:'{{ _('DingTalk Webhook') }}', we_webhook:'{{ _('WeCom Webhook') }}', fs_webhook:'{{ _('Feishu Webhook') }}',
	pp_token:'PushPlus Token', pp_channel:'PushPlus Channel', pp_webhook:'PushPlus Webhook',
	pp_topic_enable:'{{ _('PushPlus group push') }}', pp_topic:'PushPlus Topic',
	pushdeer_key:'PushDeer Key', pushdeer_srv_enable:'{{ _('Self-hosted PushDeer') }}', pushdeer_srv:'PushDeer Server',
	bark_token:'Bark Token', bark_srv_enable:'{{ _('Self-hosted Bark') }}', bark_srv:'Bark Server',
	bark_sound:'Bark Sound', bark_icon_enable:'{{ _('Bark icon') }}', bark_icon:'Bark Icon', bark_level:'Bark Level',
	diy_json:'{{ _('Custom push') }}', oui_data:'{{ _('OUI data') }}', oui_dir:'{{ _('OUI directory') }}', reset_regularly:'{{ _('Scheduled reset') }}', debuglevel:'{{ _('Debug') }}',
	pushbot_sheep:'{{ _('DND') }}', starttime:'{{ _('DND start') }}', endtime:'{{ _('DND end') }}',
	macmechanism:'{{ _('MAC filter') }}', pushbot_interface:'{{ _('Interface') }}', macmechanism2:'{{ _('MAC filter 2') }}',
	crontab:'{{ _('Scheduled tasks') }}', regular_time:'{{ _('Scheduled time') }}', regular_time_2:'{{ _('Scheduled time 2') }}', regular_time_3:'{{ _('Scheduled time 3') }}',
	interval_time:'{{ _('Interval send') }}', send_title:'{{ _('Push title') }}',
	router_status:'{{ _('Router status') }}', router_temp:'{{ _('Router temperature') }}', router_wan:'{{ _('WAN status') }}', client_list:'{{ _('Device list') }}',
	google_check_count:'{{ _('Network check retries') }}',
	pushbot_up:'{{ _('WAN redial') }}', pushbot_down:'{{ _('WAN offline') }}', cpuload_enable:'{{ _('CPU load') }}', cpuload:'{{ _('CPU threshold') }}',
	temperature_enable:'{{ _('Temperature monitor') }}', temperature:'{{ _('Temperature threshold') }}',
	client_usage:'{{ _('Abnormal traffic') }}', client_usage_max:'{{ _('Traffic limit') }}', client_usage_disturb:'{{ _('Traffic DND') }}',
	pushbot_ipv4:'{{ _('IPv4 change') }}', ipv4_interface:'{{ _('IPv4 interface') }}', pushbot_ipv6:'{{ _('IPv6 change') }}', ipv6_interface:'{{ _('IPv6 interface') }}',
	web_logged:'{{ _('Web login') }}', ssh_logged:'{{ _('SSH login') }}', web_login_failed:'{{ _('Web failed attempt') }}', ssh_login_failed:'{{ _('SSH failed attempt') }}',
	login_max_num:'{{ _('Failed attempts') }}', web_login_black:'{{ _('Auto blacklist') }}', ip_black_timeout:'{{ _('Blacklist time') }}',
	up_timeout:'{{ _('Redial timeout') }}', down_timeout:'{{ _('Offline timeout') }}', timeout_retry_count:'{{ _('Retry count') }}', thread_num:'{{ _('Threads') }}',
	soc_code:'{{ _('SOC code') }}', pve_host:'{{ _('PVE host') }}', pve_port:'{{ _('PVE port') }}',
	err_enable:'{{ _('Unattended') }}', err_sheep_enable:'{{ _('Unattended DND') }}', err_device_aliases:'{{ _('Watchlist') }}',
	network_err_event:'{{ _('Network error') }}', system_time_event:'{{ _('Scheduled Reboot') }}', autoreboot_time:'{{ _('Reboot time') }}', network_restart_time:'{{ _('Redial time') }}',
	public_ip_event:'{{ _('Public IP event') }}', public_ip_retry_count:'{{ _('Public IP retry') }}',
	pushbot_whitelist:'{{ _('Ignore list') }}', pushbot_blacklist:'{{ _('Watchlist') }}',
	MAC_online_list:'{{ _('Online DND list') }}', MAC_offline_list:'{{ _('Offline DND list') }}',
	ip_white_list:'{{ _('IP whitelist') }}', client_usage_whitelist:'{{ _('Traffic watchlist') }}',
	device_aliases:'{{ _('Device Aliases') }}', ipv4_list:'{{ _('IPv4 API list') }}', ipv6_list:'{{ _('IPv6 API list') }}', ip_black_list:'{{ _('IP blacklist') }}',
	pushbot_enable:'{{ _('Enabled') }}', err_enable:'{{ _('Unattended') }}', err_sheep_enable:'{{ _('Unattended DND') }}', public_ip_event:'{{ _('Public IP event') }}',
	pushbot_up:'{{ _('WAN redial') }}', pushbot_down:'{{ _('WAN offline') }}', cpuload_enable:'{{ _('CPU load') }}', temperature_enable:'{{ _('Temperature monitor') }}',
	client_usage:'{{ _('Abnormal traffic') }}', client_usage_disturb:'{{ _('Traffic DND') }}', web_logged:'{{ _('Web login') }}', ssh_logged:'{{ _('SSH login') }}',
	web_login_failed:'{{ _('Web failed attempt') }}', ssh_login_failed:'{{ _('SSH failed attempt') }}', web_login_black:'{{ _('Auto blacklist') }}'
};
function pbFmtVal(v) {
	if (v === null || v === undefined) return '<span class="pb-pv-null">{{ _('(empty)') }}</span>';
	if (Array.isArray(v)) return v.length ? v.join('<span class="pb-pv-arrsep">, </span>') : '<span class="pb-pv-null">{{ _('(empty)') }}</span>';
	if (v === '1' || v === true) return '<span class="pb-pv-on">{{ _('Enabled') }}</span>';
	if (v === '0' || v === false) return '<span class="pb-pv-off">{{ _('Disabled') }}</span>';
	return '<span class="pb-pv-str">' + String(v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</span>';
}
function pbShowPreview() {
	var oldOv = document.querySelector('.pb-preview-overlay');
	if (oldOv) { oldOv.remove(); return; }
	var pend = window.__pbCollectData();
	var changes = [];
	for (var k in pend) {
		var oldV = (PB_CONFIG && PB_CONFIG.lists && PB_CONFIG.lists[k] !== undefined) ? PB_CONFIG.lists[k]
			: (PB_CONFIG && PB_CONFIG.config && PB_CONFIG.config[k] !== undefined) ? PB_CONFIG.config[k]
			: (PB_CONFIG && PB_CONFIG.files && PB_CONFIG.files[k] !== undefined) ? PB_CONFIG.files[k] : undefined;
		var newV = pend[k];
		if (JSON.stringify(oldV) === JSON.stringify(newV)) continue;
		if (!oldV && (!newV || (Array.isArray(newV) && !newV.length))) continue;
		changes.push({ opt: k, label: PB_LABELS[k] || k, old: oldV, new: newV });
	}
	var ov = document.createElement('div');
	ov.className = 'pb-preview-overlay';
	var box = document.createElement('div');
	box.className = 'pb-preview-box';
	var tit = document.createElement('div');
	tit.className = 'pb-preview-title'; tit.textContent = '{{ _('Preview changes') }}';
	box.appendChild(tit);
	if (changes.length === 0) {
		var emp = document.createElement('div');
		emp.className = 'pb-preview-empty'; emp.textContent = '{{ _('No changes yet') }}';
		box.appendChild(emp);
	} else {
		var lst = document.createElement('div');
		lst.className = 'pb-preview-list';
		changes.forEach(function(c) {
			var r = document.createElement('div');
			r.className = 'pb-preview-item';
			var lb = document.createElement('div');
			lb.className = 'pb-preview-item-label'; lb.textContent = c.label;
			r.appendChild(lb);
			var dv = document.createElement('div');
			dv.className = 'pb-preview-item-diff';
			dv.innerHTML = '<span class="pb-pv-arrow">←</span> ' + pbFmtVal(c.old) + ' <span class="pb-pv-arrow">→</span> ' + pbFmtVal(c.new);
			r.appendChild(dv);
			lst.appendChild(r);
		});
		box.appendChild(lst);
	}
	var btns = document.createElement('div');
	btns.className = 'pb-preview-btns';
	var disc = document.createElement('button');
	disc.type = 'button'; disc.className = 'pb-preview-btn pb-preview-btn-disc'; disc.textContent = '{{ _('Discard changes') }}';
	disc.addEventListener('click', function() { ov.remove(); });
	btns.appendChild(disc);
	var conf = document.createElement('button');
	conf.type = 'button'; conf.className = 'pb-preview-btn pb-preview-btn-conf'; conf.textContent = '{{ _('Apply changes') }}';
	conf.addEventListener('click', function() {
		ov.remove();
		var btn = document.getElementById('pushbot_save_btn');
		if (btn && !btn.disabled) submitAll();
	});
	btns.appendChild(conf);
	box.appendChild(btns);
	ov.appendChild(box);
	document.body.appendChild(ov);
	setTimeout(function() { ov.classList.add('show'); }, 10);
}
/* ── Save all hidden inputs via API ── */
function submitAll() {
	var btn = document.getElementById('pushbot_save_btn');
	if (!btn) return;
	btn.disabled = true; btn.textContent = '{{ _('Saving...') }}';
	var data = window.__pbCollectData();
	var x = new XMLHttpRequest();
	x.open('POST', '{{ dispatcher.build_url('admin', 'services', 'pushbot', 'save_config') }}', true);
	x.setRequestHeader('Content-Type', 'application/json');
	x.onload = function() { btn.disabled = false; btn.textContent = '{{ _('Save & Apply') }}'; pbShowToast(x.status == 200); };
	x.onerror = function() { btn.disabled = false; btn.textContent = '{{ _('Save & Apply') }}'; pbShowToast(false); };
	x.send(JSON.stringify(data));
}

/* ═══════════════════════════════════════════ */
/* DOMContentLoaded startup */
/* ═══════════════════════════════════════════ */
window.addEventListener('DOMContentLoaded', function() {
	var btn = document.getElementById('pushbot_save_btn');
	if (btn) btn.addEventListener('click', submitAll);
	var pv = document.getElementById('pushbot_preview_btn');
	if (pv) pv.addEventListener('click', pbShowPreview);
});
//]]&gt;
</script>
<style>
/* CBI elements — hidden: pushbot uses custom JS UI, not CBI forms */
.cbi-tabmenu { display: none !important; }
.mar-10 {margin-left: 50px; margin-right: 10px;}

:root {
	--pb-input-bg: rgba(255, 255, 255, 0.7);
}

.pushbot-mode-card {
	margin: 10px 0 16px 0;
	padding: 16px 18px 18px;
	border: 1px solid rgba(148, 163, 184, 0.22);
	border-radius: 16px;
	background: #ffffff;
	box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06), 0 1px 3px rgba(15, 23, 42, 0.04);
}

