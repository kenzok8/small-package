	clRow.appendChild(mkBtn('{{ _('CPU load alert') }}',clOn,function(on){updateFlagInput('cpuload_enable',on);toggleCl(on);}));
	b2.appendChild(clRow);
	var clSub=document.createElement('div');clSub.id='ct_cpuload_sub';clSub.style.cssText='margin-top:4px;display:'+(CT_CPU_LOAD_EN?'block':'none');
	clSub.appendChild(mkTxt('cpuload','{{ _('Load alert threshold') }}',CT_CPU_LOAD));b2.appendChild(clSub);
	function toggleCl(on){clSub.style.display=on?'block':'none';}

	/* CPU temp */
	var tmHi = document.querySelector('[name="cbid.pushbot.pushbot.temperature_enable"]');
	var tmOn = CT_TEMP_EN;
var tmRow=document.createElement('div');tmRow.style.cssText='margin-bottom:8px';
tmRow.appendChild(mkBtn('{{ _('CPU temperature alert') }}',tmOn,function(on){updateFlagInput('temperature_enable',on);toggleTm(on);}));
b2.appendChild(tmRow);
	var tmSub=document.createElement('div');tmSub.id='ct_temp_sub';tmSub.style.cssText='margin-top:4px;display:'+(CT_TEMP_EN?'block':'none');
	tmSub.appendChild(mkTxt('temperature','{{ _('Temperature alert threshold') }}',CT_TEMP,'{{ _('Alerts are only pushed when the threshold is exceeded for 5 consecutive minutes<br/>and will not repeat within an hour') }}'));b2.appendChild(tmSub);
	function toggleTm(on){tmSub.style.display=on?'block':'none';}

	/* client usage */
	var cuHi = document.querySelector('[name="cbid.pushbot.pushbot.client_usage"]');
	var cuOn = CT_USAGE;
	var cuRow=document.createElement('div');cuRow.style.cssText='margin-bottom:8px';
	cuRow.appendChild(mkBtn('{{ _('Abnormal device traffic') }}',cuOn,function(on){updateFlagInput('client_usage',on);toggleCu(on);}));
	b2.appendChild(cuRow);
	var cuSub=document.createElement('div');cuSub.id='ct_usage_sub';cuSub.style.cssText='margin-top:4px;display:'+(CT_USAGE?'block':'none');
	cuSub.appendChild(mkTxt('client_usage_max','{{ _('Traffic limit per interval') }}',CT_USAGE_MAX,'{{ _('Abnormal device traffic alert (bytes); you can append K, M or G') }}'));
	/* disturb toggle */
/* client usage disturb - use hidden input */
var cdHi = document.querySelector('[name="cbid.pushbot.pushbot.client_usage_disturb"]');
var cdOn = CT_USAGE_DISTURB;
cuSub.appendChild(mkBtn('{{ _('Traffic DND') }}',cdOn,function(on){updateFlagInput('client_usage_disturb',on);toggleCd(on);}));
	var cdSub=document.createElement('div');cdSub.id='ct_disturb_sub';cdSub.style.cssText='margin-top:4px;display:'+(CT_USAGE_DISTURB?'block':'none');
	/* whitelist with MAC dropdown */
	var wlCtr=document.createElement('div');wlCtr.style.cssText='margin:4px 0';
	var wlLbl=document.createElement('div');wlLbl.className='pushbot-inline-title';
	wlLbl.style.cssText='margin:0 0 4px 2px;text-transform:none;font-size:13px;font-weight:600;color:inherit';
	wlLbl.textContent='{{ _('Traffic watchlist') }}';wlCtr.appendChild(wlLbl);
	var wlTags=document.createElement('div');wlTags.style.cssText='display:flex;flex-wrap:wrap;gap:4px;margin-bottom:4px';
	var wlIR=document.createElement('div');wlIR.style.cssText='display:flex;gap:4px';
	var wlInp=document.createElement('input');wlInp.type='text';wlInp.className='cbi-input-text';
	wlInp.placeholder='XX:XX:XX:XX:XX:XX';wlInp.className='cbi-input-text pushbot-mac-input';wlInp.style.cssText='flex:1;padding:7px 10px;border-radius:8px;border:1px solid rgba(148,163,184,0.3);font-size:13px;background:var(--pb-input-bg);color:inherit';
	wlInp.setAttribute('list','mh_client_white');
	var wlDl=document.createElement('datalist');wlDl.id='mh_client_white';
	PB_sys('mac_hints').forEach(function(h){var o=document.createElement('option');o.value=h.m;o.textContent=h.n?h.m+' ('+h.n+')':h.m;wlDl.appendChild(o);});
	wlIR.appendChild(wlInp);wlIR.appendChild(wlDl);
	var wlAdd=document.createElement('button');wlAdd.type='button';wlAdd.className='pushbot-choice-button is-on';wlAdd.textContent='{{ _('Add') }}';wlIR.appendChild(wlAdd);
	wlCtr.appendChild(wlTags);wlCtr.appendChild(wlIR);cdSub.appendChild(wlCtr);
	var wlVals=CT_CLIENT_WHITE.slice();
	function wlSync(){
		var ex=hb.querySelectorAll('[name$=".client_usage_whitelist"]');ex.forEach(function(el){el.remove();});
		wlVals.forEach(function(v){if(!v)return;var i=document.createElement('input');i.type='hidden';i.name='cbid.pushbot.pushbot.client_usage_whitelist';i.value=v;hb.appendChild(i);});
	}
	function wlRender(){
		wlTags.innerHTML='';
		wlVals.forEach(function(v){if(!v)return;
			var t=document.createElement('span');t.style.cssText='display:inline-flex;align-items:center;gap:4px;padding:2px 8px;background:rgba(148,163,184,0.12);border-radius:4px;font-size:12px';
			t.textContent=v;
			var x=document.createElement('span');x.textContent='\u00d7';x.style.cssText='cursor:pointer;font-weight:bold;margin-left:2px;opacity:0.6';
			x.addEventListener('click',function(){var idx=wlVals.indexOf(v);if(idx>=0){wlVals.splice(idx,1);wlRender();wlSync();}});
			t.appendChild(x);wlTags.appendChild(t);
		});
	}
	wlAdd.addEventListener('click',function(){var v=wlInp.value.trim().toUpperCase();if(v&&wlVals.indexOf(v)<0){wlVals.push(v);wlRender();wlSync();}wlInp.value='';wlInp.focus();});
	wlInp.addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();var v=wlInp.value.trim().toUpperCase();if(v&&wlVals.indexOf(v)<0){wlVals.push(v);wlRender();wlSync();}wlInp.value='';}});
	wlRender();wlSync();
	cuSub.appendChild(cdSub);b2.appendChild(cuSub);
	function toggleCu(on){cuSub.style.display=on?'block':'none';}
	function toggleCd(on){cdSub.style.display=on?'block':'none';}

