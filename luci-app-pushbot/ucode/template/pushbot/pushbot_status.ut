	dRow.appendChild(mkBtn('{{ _('Device online notification') }}',upOn,function(on){ updateFlagInput('pushbot_up', on); }));
	dRow.appendChild(mkBtn('{{ _('Device offline notification') }}',dnOn,function(on){ updateFlagInput('pushbot_down', on); }));
	b1.appendChild(dRow);

	c1.appendChild(b1); container.appendChild(c1);

	/* CARD 2: Performance Monitor */
	var c2 = document.createElement('div'); c2.className = 'pushbot-mode-card';
	c2.innerHTML = '<div class="pushbot-card-top"><span class="pushbot-card-title">{{ _('Performance Monitor') }}</span></div>';
	var b2 = document.createElement('div'); b2.style.cssText = 'margin-top:6px';

