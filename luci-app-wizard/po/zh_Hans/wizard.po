msgid "Setup Wizard"
msgstr "设置向导"

msgid "Quickly configure common network, wireless, and system settings."
msgstr "快速配置常用网络、无线与系统设置。"

msgid "Net Settings"
msgstr "网络设置"

msgid "Firmware Settings"
msgstr "固件与系统"

msgid "Wireless Settings"
msgstr "无线设置"

msgid "Shortcuts"
msgstr "快捷方式"

msgid "WAN Protocol / Mode"
msgstr "WAN 协议 / 工作模式"

msgid "DHCP Client (Default Router)"
msgstr "DHCP 客户端 (标准主路由模式)"

msgid "PPPoE Dial-up"
msgstr "PPPoE 拨号上网"

msgid "Side-Router Mode (Bypass Gateway)"
msgstr "旁路由模式 (网关旁路)"

msgid "PPPoE Username"
msgstr "宽带拨号账号"

msgid "PPPoE Password"
msgstr "宽带拨号密码"

msgid "LAN IPv4 Address"
msgstr "LAN 口 IPv4 地址"

msgid "Custom DNS Server(s)"
msgstr "自定义 DNS 服务器，留空默认运营商DNS"

msgid "Gateway Address"
msgstr "网关地址"

msgid "Primary router IP address used when operating in side-router mode."
msgstr "处于旁路由模式时的主路由 IP 地址。"

msgid "Enable DHCP Server"
msgstr "启用 DHCP 服务"

msgid "Usually disabled in side-router mode to avoid IP address assignment conflicts with the main router."
msgstr "在旁路由模式下通常关闭此项，避免与主路由的 IP 分配冲突。"

msgid "IPv6 Support"
msgstr "IPv6 支持"

msgid "Enable or disable IPv6 router advertisements and DHCPv6."
msgstr "启用或关闭 IPv6 路由通告与 DHCPv6 服务。"

msgid "Firmware Upgrade Notice"
msgstr "固件升级提示"

msgid "Check and display notices for newer firmware versions."
msgstr "检查并显示新版本固件更新提示。"

msgid "Run CoreMark on Boot"
msgstr "开机 CoreMark 跑分"

msgid "Run CPU benchmark asynchronously upon router initialization."
msgstr "在路由器初始化启动时运行 CPU 基准测试。"

msgid "Persistent Cookie Session"
msgstr "持久 Cookie 登录"

msgid "Maintain persistent login sessions in the web browser."
msgstr "在浏览器中保持登录会话状态，避免频繁重复登录。"

msgid "Enforce HTTPS Access"
msgstr "强制 HTTPS 访问"

msgid "Automatically redirect HTTP requests to secure HTTPS."
msgstr "将所有 HTTP 请求自动重定向至安全加密的 HTTPS。"

msgid "Landing Dashboard Mode"
msgstr "主页展示模式"

msgid "Default"
msgstr "默认"

msgid "RouterDog"
msgstr "路由狗"

msgid "NAS"
msgstr "NAS 模式"

msgid "Next-NAS"
msgstr "Next-NAS 模式"

msgid "Router"
msgstr "路由器模式"

msgid "Wireless Network Name (SSID)"
msgstr "无线网络名称 (SSID)"

msgid "Wireless Password (Key)"
msgstr "无线网络密码"

msgid "Leave empty for open network or 8+ characters"
msgstr "留空为开放无密码网络，或输入 8 位以上密码"

msgid "URL Shortcuts"
msgstr "快捷方式列表"

msgid "Applying Changes"
msgstr "正在应用修改"

msgid "Applying modified settings: %s..."
msgstr "正在应用已修改的设置项: %s..."

msgid "No settings were modified. Services remain uninterrupted."
msgstr "未检测到任何修改，无需保存或重启服务。"

msgid "Settings successfully applied: %s"
msgstr "已成功应用并重载修改项: %s"

msgid "Failed to apply settings: %s"
msgstr "应用设置失败: %s"

msgid "LAN IP Address Changed"
msgstr "LAN 口 IP 地址已变更"

msgid "LAN IP changed to %s. Redirecting to the new address in %d seconds..."
msgstr "LAN 口 IP 已变更为 %s。将在 %d 秒后自动跳转至新地址..."

msgid "Redirect Now"
msgstr "立即跳转"
