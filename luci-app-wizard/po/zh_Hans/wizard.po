msgid "Home"
msgstr "首页"

msgid "Setup Wizard"
msgstr "快速设置向导"

msgid "Quickly configure common network, wireless, and system settings."
msgstr "快速配置常用网络、无线与系统运行设置。"

msgid "Net Settings"
msgstr "网络设置"

msgid "Firmware Settings"
msgstr "固件设置"

msgid "Wireless Settings"
msgstr "无线设置"

msgid "Shortcuts"
msgstr "域名快捷跳转"

msgid "比如设置google.com的快捷方式为字母g,则在此路由器网络的任何浏览器中输入g/即可访问google.com"
msgstr "比如设置 google.com 的快捷方式为字母 g，则在此路由器网络的任何浏览器中输入 g/ 即可访问 google.com"

msgid "WAN Protocol / Mode"
msgstr "WAN 协议 / 工作模式"

msgid "DHCP Client (Default Router)"
msgstr "DHCP 客户端（标准主路由模式）"

msgid "PPPoE Dial-up"
msgstr "PPPoE 拨号"

msgid "Side-Router Mode (Bypass Gateway)"
msgstr "旁路由模式（网关旁路）"

msgid "PPPoE Username"
msgstr "PPPoE 用户名"

msgid "PPPoE Password"
msgstr "PPPoE 密码"

msgid "LAN IPv4 Address"
msgstr "LAN IPv4 地址"

msgid "Custom DNS Server(s)"
msgstr "自定义 DNS 服务器"

msgid "Gateway Address"
msgstr "网关地址"

msgid "Primary router IP address used when operating in side-router mode."
msgstr "在旁路由模式下工作时填写的上级主路由 IP 地址。"

msgid "Enable DHCP Server"
msgstr "启用 DHCP 服务器"

msgid "Enable or disable LAN DHCP server (usually disabled in side-router mode to avoid IP address conflicts)."
msgstr "开启或关闭局域网 DHCP 服务（旁路由模式下通常建议关闭，避免局域网 IP 分配冲突）。"

msgid "IPv6 Support"
msgstr "IPv6 支持"

msgid "Enable or disable IPv6 router advertisements and DHCPv6."
msgstr "开启或关闭 IPv6 路由通告 (RA) 与 DHCPv6 服务。"

msgid "Firmware Upgrade Notice"
msgstr "固件更新检测提示"

msgid "Check and display notices for newer firmware versions."
msgstr "开机或访问时检测并提示可用的新版本固件。"

msgid "Run CoreMark on Boot"
msgstr "开机自动运行 CoreMark 跑分"

msgid "Run CPU benchmark asynchronously upon router initialization."
msgstr "路由器启动完成后在后台异步运行 CPU 性能基准测试。"

msgid "Persistent Cookie Session"
msgstr "保持登录会话 (Persistent Cookie)"

msgid "Maintain persistent login sessions in the web browser."
msgstr "关闭浏览器后仍保持管理后台登录状态。"

msgid "Enforce HTTPS Access"
msgstr "强制 HTTPS 访问"

msgid "Automatically redirect HTTP requests to secure HTTPS."
msgstr "自动将普通 HTTP 请求重定向到加密的 HTTPS 连接。"

msgid "Landing Dashboard Mode"
msgstr "管理首页展示模式"

msgid "Default"
msgstr "默认"

msgid "RouterDog"
msgstr "路由狗"

msgid "NAS"
msgstr "NAS"

msgid "Next-NAS"
msgstr "Next-NAS"

msgid "Router"
msgstr "Router"

msgid "Wireless Network Name (SSID)"
msgstr "无线网络名称 (SSID)"

msgid "无线名称基准前缀，系统将自动识别并为 2.4G 追加 _2.4G、5G 追加 _5G、6G 追加 _6G。"
msgstr "无线名称基准前缀，系统将自动识别并为 2.4G 追加 _2.4G、5G 追加 _5G、6G 追加 _6G。"

msgid "Wireless Password (Key)"
msgstr "无线密码"

msgid "Leave empty for open network or 8+ characters"
msgstr "留空表示无密码开放网络，或输入至少 8 位密码"

msgid "Wireless key must be between 8 and 64 characters long"
msgstr "无线密码长度必须在 8 到 64 个字符之间"

msgid "Shortcut"
msgstr "快捷短语"

msgid "Shortcut phrase cannot be empty"
msgstr "快捷短语不能为空"

msgid "Only alphanumeric characters, dashes and underscores are allowed"
msgstr "仅允许输入字母、数字、破折号 (-) 和下划线 (_)"

msgid "Target URL"
msgstr "目标网址 (URL)"

msgid "Please enter a valid URL starting with http:// or https://"
msgstr "请输入以 http:// 或 https:// 开头的有效网址"

msgid "Comments"
msgstr "备注说明"

msgid "Optional"
msgstr "可选"

msgid "There are no changes to apply"
msgstr "没有需要应用的更改"

msgid "LAN IP Address Changed"
msgstr "LAN 口 IP 地址已变更"

msgid "LAN IP has been changed to "
msgstr "LAN 口 IP 地址已更改为 "

msgid "Applying changes without rollback. Redirecting to the new address in "
msgstr "正在永久应用更改（已禁用回滚保护）。将在 "

msgid " seconds..."
msgstr " 秒后自动跳转至新地址..."

msgid "提示：更改网段后，若未能自动加载新页面，请尝试重新插拔网线或断开重连 Wi-Fi，以获取新网段的 IP 地址。"
msgstr "提示：更改网段后，若未能自动加载新页面，请尝试重新插拔网线或断开重连 Wi-Fi，以获取新网段的 IP 地址。"

msgid "Redirect Now"
msgstr "立即跳转"
