{
	"luci-app-wizard": {
		"description": "Grant UCI and filesystem access for LuCI Setup Wizard",
		"read": {
			"uci": [
				"network",
				"wireless",
				"dhcp",
				"uhttpd",
				"firewall",
				"luci",
				"wizard"
			],
			"file": {
				"/etc/nginx/uci.conf": [ "stat" ]
			}
		},
		"write": {
			"uci": [
				"network",
				"wireless",
				"dhcp",
				"uhttpd",
				"firewall",
				"luci",
				"wizard"
			]
		}
	}
}
