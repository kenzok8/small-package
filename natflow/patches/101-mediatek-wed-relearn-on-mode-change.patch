From: PTPT52.AI <ptpt52@gmail.com>
Subject: [PATCH] natflow: normalize the MTK WED switch and invalidate old learning

Serialize MTK WED mode changes, normalize them to boolean values, and
invalidate the old software generation so keepalive retires stale FOEs.

---
--- a/natflow_main.c
+++ b/natflow_main.c
@@ -228,11 +228,7 @@
 		int d;
 		n = sscanf(data, "hwnat_wed_disabled=%u", &d);
 		if (n == 1) {
-#if defined(NATFLOW_OFFLOAD_AIROHA_NPU)
 			return natflow_hwnat_wed_disabled_set(d);
-#else
-			hwnat_wed_disabled = d;
-#endif
 			goto done;
 		}
 #endif
--- a/natflow_path.c
+++ b/natflow_path.c
@@ -6054,6 +6054,23 @@
 	mutex_unlock(&natflow_wlan_mode_lock);
 	return err;
 }
+#elif defined(CONFIG_NET_MEDIATEK_SOC_WED) && NATFLOW_HAVE_HW_OFFLOAD
+static DEFINE_MUTEX(natflow_wlan_mode_lock);
+
+int natflow_hwnat_wed_disabled_set(unsigned int value)
+{
+	value = !!value;
+	mutex_lock(&natflow_wlan_mode_lock);
+	if (READ_ONCE(hwnat_wed_disabled) != value) {
+		WRITE_ONCE(hwnat_wed_disabled, value);
+		/* Old FOEs are retired by keepalive; software paths must relearn
+		 * instead of reusing the previous WED/extdev associations.
+		 */
+		natflow_update_magic(0);
+	}
+	mutex_unlock(&natflow_wlan_mode_lock);
+	return 0;
+}
 #endif
 
 static struct nf_hook_ops path_hooks[] = {
--- a/natflow_path.h
+++ b/natflow_path.h
@@ -31,7 +31,7 @@
 extern unsigned int go_slowpath_if_no_qos;
 
 extern void natflow_disabled_set(int v);
-#if defined(NATFLOW_OFFLOAD_AIROHA_NPU)
+#if defined(NATFLOW_OFFLOAD_AIROHA_NPU) || defined(CONFIG_NET_MEDIATEK_SOC_WED)
 extern int natflow_hwnat_wed_disabled_set(unsigned int disabled);
 #endif
 extern int natflow_disabled_get(void);
--- a/README.md
+++ b/README.md
@@ -285,7 +285,7 @@
 | `debug=<num>` | 设置日志 bitmask：`1=error`、`2=warn`、`4=info`、`8=debug`、`16=fixme`、`32=debug_ratelimited`。 |
 | `disabled=0/1` | 开启或关闭 fast path。模块加载后默认关闭。 |
 | `hwnat=0/1` | 支持 HWNAT 的平台上开启或关闭硬件 offload。 |
-| `hwnat_wed_disabled=0/1` | 支持 WED 的 MTK 平台上控制 WED 分支。 |
+| `hwnat_wed_disabled=0/1` | MTK WED 平台上，0 允许 WED，非零强制 extdev；模式变化触发连接重学，旧硬件规则由 keepalive 撤销，不保证写入时同步清空。 |
 | `delay_pkts=<n>` | fastnat 建立前延迟若干包。 |
 | `go_slowpath_if_no_qos=0/1` | 无 QoS 命中时是否走慢路径。 |
 | `ifname_group_type=<n>` | 接口组过滤模式。 |
--- a/SYSTEM_DESIGN_SPEC.md
+++ b/SYSTEM_DESIGN_SPEC.md
@@ -924,7 +924,7 @@
 - 支持原始/回复方向不同设备组合。
 - 支持 VLAN、PPPoE、DSA、bridge、WED 标志。
 - `hwnat` 总开关控制是否尝试。
-- `hwnat_wed_disabled` 控制 WED 使用。
+- `hwnat_wed_disabled` 控制 WED 使用。MTK WED 平台将写入值布尔化，并在模式变化时推进 path magic，强制软件连接重学；已有硬件项在后续 keepalive 中因 generation 失配撤销，不保证控制命令返回时已同步清空。
 - `CONFIG_HWNAT_EXTDEV_DISABLED` 会禁用部分外部设备路径。
 - 硬件 offload keepalive 会回写流量并延长 conntrack timeout。
 
