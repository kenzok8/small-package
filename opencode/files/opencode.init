#!/bin/sh /etc/rc.common

USE_PROCD=1
START=94
STOP=10

start_service() {
	config_load opencode
	config_get_bool enabled main enabled 0
	config_get data_dir main data_dir ""
	config_get workspace_dir main workspace_dir ""
	config_get terminal_port main terminal_port "7685"

	[ "$enabled" -eq 1 ] || return 0
	case "$terminal_port" in ''|*[!0-9]*) return 1 ;; esac
	[ "$terminal_port" -gt 1024 ] 2>/dev/null && [ "$terminal_port" -le 65535 ] 2>/dev/null || return 1
	[ -x /usr/bin/ttyd ] || return 1
	[ -x /usr/libexec/opencode-runtime ] || return 1
	id opencode >/dev/null 2>&1 || return 1
	[ "$(id -u opencode)" -gt 0 ] || return 1

	/usr/libexec/opencode-runtime prepare "$data_dir" >/dev/null || return 1
	/usr/libexec/opencode-runtime installed "$data_dir" >/dev/null || return 0
	[ -n "$workspace_dir" ] || workspace_dir="$data_dir/workspace"

	procd_open_instance terminal
	procd_set_param command /usr/bin/ttyd -i 127.0.0.1 -p "$terminal_port" -b /apps/opencode -W /usr/libexec/opencode-runtime terminal "$data_dir" "$workspace_dir"
	procd_set_param env OPENCODE_DATA_DIR="$data_dir" OPENCODE_WORKSPACE_DIR="$workspace_dir"
	procd_set_param user opencode
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger opencode
}
