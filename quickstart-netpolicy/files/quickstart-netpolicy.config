# Legacy main keeps its original endpoint and data directory.
config quickstart-netpolicy 'main'
	option network 'lan'
	option enabled '0'
	option interface 'br-lan'
	option port '8765'
	option data_dir '/usr/share/quickstart-netpolicy'
	option log_level 'info'
	option traffic_history '0'
	option dns_monitoring '0'

# Additional networks are opt-in and require explicit stable resources:
# config quickstart-netpolicy 'office'
#   option enabled '0'
#   option network 'office'
#   option interface 'br-office'
#   option port '8766'
#   option data_dir '/usr/share/quickstart-netpolicy/networks/office'
