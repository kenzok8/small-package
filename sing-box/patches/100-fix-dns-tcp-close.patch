Subject: [PATCH] dns: drain TCP replies before closing on EOF

Wait for accepted DNS queries and serialized writes when the peer
half-closes its stream. Bound response writes with the DNS deadline.
Close normal resolved sessions without invoking handshake-failure
cleanup, which can reset the TCP stream before replies are read.

--- a/protocol/dns/handle.go
+++ b/protocol/dns/handle.go
@@ -3,6 +3,8 @@ package dns
 import (
 	"context"
 	"encoding/binary"
+	"errors"
+	"io"
 	"net"
 	"sync"
 	"time"
@@ -24,11 +26,17 @@ import (
 func NewDNSConnection(ctx context.Context, router adapter.DNSRouter, conn net.Conn, metadata adapter.InboundContext) error {
 	metadata.Destination = M.Socksaddr{}
 	var writeAccess sync.Mutex
+	var responses sync.WaitGroup
 	for {
 		conn.SetReadDeadline(time.Now().Add(C.DNSTimeout))
 		var queryLength uint16
 		err := binary.Read(conn, binary.BigEndian, &queryLength)
 		if err != nil {
+			if errors.Is(err, io.EOF) {
+				// Drain replies accepted before the peer closed its write side.
+				conn.SetWriteDeadline(time.Now().Add(C.DNSTimeout))
+				responses.Wait()
+			}
 			return err
 		}
 		if queryLength == 0 {
@@ -47,12 +55,17 @@ func NewDNSConnection(ctx context.Contex
 			return err
 		}
 		metadataInQuery := metadata
+		responses.Add(1)
 		router.ExchangeAsync(adapter.WithContext(ctx, &metadataInQuery), &message, adapter.DNSQueryOptions{}, func(response *mDNS.Msg, err error) {
 			if err != nil {
 				conn.Close()
+				responses.Done()
 				return
 			}
-			go writeStreamResponse(conn, &writeAccess, response)
+			go func() {
+				defer responses.Done()
+				writeStreamResponse(conn, &writeAccess, response)
+			}()
 		})
 	}
 }
--- a/service/resolved/service.go
+++ b/service/resolved/service.go
@@ -126,7 +126,12 @@ func (i *Service) Start(stage adapter.St
 func (i *Service) NewConnection(ctx context.Context, conn net.Conn, metadata adapter.InboundContext, onClose N.CloseHandlerFunc) {
 	metadata.Inbound = i.Tag()
 	metadata.InboundType = i.Type()
-	N.CloseOnHandshakeFailure(conn, onClose, dnsOutbound.NewDNSConnection(ctx, i.dnsRouter, conn, metadata))
+	err := dnsOutbound.NewDNSConnection(ctx, i.dnsRouter, conn, metadata)
+	if E.IsClosedOrCanceled(err) {
+		conn.Close()
+		err = nil
+	}
+	N.CloseOnHandshakeFailure(conn, onClose, err)
 }
 
 func (i *Service) NewPacket(buffer *buf.Buffer, oob []byte, source M.Socksaddr) {
