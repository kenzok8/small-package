Subject: [PATCH] dns: filter IPv6 answers for IPv4-only proxy exits

Adapt the outbound-aware DNS filtering from hiddify/hiddify-sing-box.
Probe selected outbounds directly and apply the policy to copies of replies
so switching nodes does not leave a filtered answer in the DNS cache.

--- /dev/null
+++ b/dns/ipv6_by_outbound.go
@@ -0,0 +1,228 @@
+package dns
+
+import (
+	"context"
+	"slices"
+	"sync"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/urltest"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	N "github.com/sagernet/sing/common/network"
+
+	mDNS "github.com/miekg/dns"
+)
+
+type ipv6Reachability uint8
+
+const (
+	ipv6Unknown ipv6Reachability = iota
+	ipv6Reachable
+	ipv6Unreachable
+)
+
+const (
+	ipv6ProbeInterval = 10 * time.Minute
+	ipv6ProbeRetry    = time.Minute
+	ipv6ProbeTimeout  = 8 * time.Second
+	ipv6ProbeLimit    = 2
+)
+
+// Literal HTTPS destinations avoid DNS and SNI-based rewrites at the proxy exit.
+var ipv6ProbeTargets = [][2]string{
+	{"https://[2606:4700:4700::1111]/dns-query", "https://1.1.1.1/dns-query"},
+	{"https://[2606:4700:4700::1001]/dns-query", "https://1.0.0.1/dns-query"},
+}
+
+type outboundIPv6State struct {
+	result     ipv6Reachability
+	probing    bool
+	nextProbe  time.Time
+	validUntil time.Time
+}
+
+type outboundIPv6Filter struct {
+	ctx      context.Context
+	cancel   context.CancelFunc
+	logger   log.ContextLogger
+	outbound adapter.OutboundManager
+	detours  map[string]string
+	probeURL func(context.Context, string, N.Dialer) (uint16, error)
+	access   sync.Mutex
+	states   map[string]outboundIPv6State
+	active   int
+	workers  sync.WaitGroup
+}
+
+func newOutboundIPv6Filter(ctx context.Context, logger log.ContextLogger, outbound adapter.OutboundManager, detours map[string]string) *outboundIPv6Filter {
+	ctx, cancel := context.WithCancel(ctx)
+	return &outboundIPv6Filter{
+		ctx: ctx, cancel: cancel, logger: logger, outbound: outbound, detours: detours,
+		probeURL: urltest.URLTest, states: make(map[string]outboundIPv6State),
+	}
+}
+
+func (f *outboundIPv6Filter) close() error {
+	f.access.Lock()
+	f.cancel()
+	f.access.Unlock()
+	f.workers.Wait()
+	return nil
+}
+
+func (f *outboundIPv6Filter) selectedOutbound(tag string, network string) adapter.Outbound {
+	current, _ := f.outbound.Outbound(tag)
+	for depth := 0; depth < 16 && current != nil; depth++ {
+		if group, isGroup := current.(adapter.OutboundGroup); isGroup {
+			current = group.Selected(network)
+			continue
+		}
+		if current.Type() != C.TypeDirect && slices.Contains(current.Network(), N.NetworkTCP) {
+			return current
+		}
+		return nil
+	}
+	return nil
+}
+
+func (f *outboundIPv6Filter) ipv4Only(outbound adapter.Outbound) bool {
+	tag := outbound.Tag()
+	now := time.Now()
+	f.access.Lock()
+	defer f.access.Unlock()
+	state := f.states[tag]
+	if f.ctx.Err() == nil && f.active < ipv6ProbeLimit && !state.probing && !now.Before(state.nextProbe) {
+		state.probing = true
+		f.states[tag] = state
+		f.active++
+		f.workers.Add(1)
+		go f.probe(outbound)
+	}
+	return state.result == ipv6Unreachable && now.Before(state.validUntil)
+}
+
+func (f *outboundIPv6Filter) testURL(outbound adapter.Outbound, link string) bool {
+	ctx, cancel := context.WithTimeout(f.ctx, ipv6ProbeTimeout)
+	defer cancel()
+	_, err := f.probeURL(ctx, link, outbound)
+	return err == nil
+}
+
+func (f *outboundIPv6Filter) detect(outbound adapter.Outbound) ipv6Reachability {
+	for _, targets := range ipv6ProbeTargets {
+		if f.testURL(outbound, targets[0]) {
+			return ipv6Reachable
+		}
+		if f.ctx.Err() != nil || !f.testURL(outbound, targets[1]) {
+			return ipv6Unknown
+		}
+	}
+	return ipv6Unreachable
+}
+
+func (f *outboundIPv6Filter) probe(outbound adapter.Outbound) {
+	defer f.workers.Done()
+	result := f.detect(outbound)
+	tag := outbound.Tag()
+	now := time.Now()
+	f.access.Lock()
+	f.active--
+	state := f.states[tag]
+	changed := result != ipv6Unknown && state.result != result
+	state.probing = false
+	if result == ipv6Unknown {
+		state.nextProbe = now.Add(ipv6ProbeRetry)
+	} else {
+		state.result = result
+		state.nextProbe = now.Add(ipv6ProbeInterval)
+		state.validUntil = now.Add(2 * ipv6ProbeInterval)
+	}
+	f.states[tag] = state
+	f.access.Unlock()
+	if changed && f.ctx.Err() == nil {
+		if result == ipv6Unreachable {
+			f.logger.Info("outbound ", tag, " failed both IPv6 probes while IPv4 worked, using IPv4-only DNS answers")
+		} else {
+			f.logger.Debug("outbound ", tag, " passed an IPv6 probe")
+		}
+	}
+}
+
+func (f *outboundIPv6Filter) filter(message, response *mDNS.Msg, transport adapter.DNSTransport) *mDNS.Msg {
+	if f == nil || response == nil || response.Rcode != mDNS.RcodeSuccess || transport == nil {
+		return response
+	}
+	qtype := message.Question[0].Qtype
+	if qtype != mDNS.TypeA && qtype != mDNS.TypeAAAA && qtype != mDNS.TypeHTTPS && qtype != mDNS.TypeSVCB {
+		return response
+	}
+	tag := f.detours[transport.Tag()]
+	if tag == "" {
+		return response
+	}
+	tcp := f.selectedOutbound(tag, N.NetworkTCP)
+	udp := f.selectedOutbound(tag, N.NetworkUDP)
+	onlyIPv4 := tcp != nil && f.ipv4Only(tcp)
+	if udp != nil && udp != tcp {
+		onlyIPv4 = f.ipv4Only(udp) || onlyIPv4
+	}
+	if !onlyIPv4 || qtype == mDNS.TypeA {
+		return response
+	}
+	if qtype == mDNS.TypeAAAA {
+		return FixedResponseStatus(message, mDNS.RcodeSuccess)
+	}
+	// The original response remains usable from cache when the group's selection changes.
+	filtered := response.Copy()
+	var answerChanged, extraChanged bool
+	filtered.Answer, answerChanged = removeIPv6Hints(filtered.Answer)
+	filtered.Extra, extraChanged = removeIPv6Hints(filtered.Extra)
+	if !answerChanged && !extraChanged {
+		return response
+	}
+	filtered.Answer = slices.DeleteFunc(filtered.Answer, coversIPv6Records)
+	filtered.Extra = slices.DeleteFunc(filtered.Extra, coversIPv6Records)
+	filtered.AuthenticatedData = false
+	return filtered
+}
+
+func removeIPv6Hints(records []mDNS.RR) ([]mDNS.RR, bool) {
+	var changed bool
+	filtered := slices.DeleteFunc(records, func(record mDNS.RR) bool {
+		var service *mDNS.SVCB
+		switch rr := record.(type) {
+		case *mDNS.AAAA:
+			changed = true
+			return true
+		case *mDNS.HTTPS:
+			service = &rr.SVCB
+		case *mDNS.SVCB:
+			service = rr
+		}
+		if service == nil {
+			return false
+		}
+		for _, value := range service.Value {
+			if mandatory, ok := value.(*mDNS.SVCBMandatory); ok && slices.Contains(mandatory.Code, mDNS.SVCB_IPV6HINT) {
+				changed = true
+				return true
+			}
+		}
+		count := len(service.Value)
+		service.Value = slices.DeleteFunc(service.Value, func(value mDNS.SVCBKeyValue) bool {
+			return value.Key() == mDNS.SVCB_IPV6HINT
+		})
+		if len(service.Value) != count {
+			changed = true
+		}
+		return false
+	})
+	return filtered, changed
+}
+
+func coversIPv6Records(record mDNS.RR) bool {
+	signature, ok := record.(*mDNS.RRSIG)
+	return ok && (signature.TypeCovered == mDNS.TypeAAAA || signature.TypeCovered == mDNS.TypeHTTPS || signature.TypeCovered == mDNS.TypeSVCB)
+}
