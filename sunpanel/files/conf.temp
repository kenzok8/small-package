# ======================
# Basic configuration
# ======================
[base]
# Web run port. Default:3002
http_port=<%=port%>
# Web run https port. Default:3003
https_port=3003
# Web run address Default: 0.0.0.0
http_address=0.0.0.0
# Database driver [mysql/sqlite(Default)]
database_drive=sqlite
# Cache driver [redis/memory(Default)]
cache_drive=memory
# Queue driver [redis/memory(Default)]
queue_drive=memory
# File cache path
source_path=<%=config_path%>/uploads
# File cache temp path
source_temp_path=<%=config_path%>/runtime/temp
# Front -end path.
web_path=/www/luci-static/sunpanel
# Custom JS and CSS.
custom_style_path=<%=config_path%>/custom
# Token expires (hour). defalut 168
token_expires=168

# ==============================
# SSL certificate configuration
# ==============================
[cert]
cert_path=
key_path=

# ======================
# Mysql database driver
# ======================
[mysql]
host=127.0.0.1
port=3306
username=root
password=root
db_name=sun_panel
wait_timeout=100

# ======================
# sqlite database driver
# ======================
[sqlite]
file_path=<%=config_path%>/database/database.db

# ======================
# redis database driver
# ======================
[redis]
address=127.0.0.1:6379
password=
prefix=sun_panel:
db=0
